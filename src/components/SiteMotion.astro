---
/* =========================================================
   SITE MOTION — SHARED ENTRANCE & SCROLL EFFECTS

   PURPOSE:
   Gives every page the same light-touch movement: the hero
   fades up on load, cards and headings rise in as they scroll
   into view, and a thin progress bar tracks reading position.

   NOTES:
   Content stays fully visible without JavaScript, and all
   movement is switched off for visitors who prefer reduced motion.
   ========================================================= */
---

<style is:global>
    @keyframes site-rise {
        from {
            opacity: 0;
            translate: 0 18px;
        }
        to {
            opacity: 1;
            translate: 0 0;
        }
    }

    main > .hero > *,
    main > header.hero > *,
    main > .dashboard-hero > *,
    main > * > header.hero > *,
    main > * > .dashboard-hero > * {
        animation: site-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    main .hero > *:nth-child(2) { animation-delay: 0.06s; }
    main .hero > *:nth-child(3) { animation-delay: 0.12s; }
    main .hero > *:nth-child(4) { animation-delay: 0.18s; }
    main .hero > *:nth-child(n + 5) { animation-delay: 0.24s; }

    .motion-reveal {
        opacity: 0;
        translate: 0 26px;
        transition:
            opacity 0.7s ease,
            translate 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
        transition-delay: var(--reveal-delay, 0s);
    }

    .motion-reveal.is-visible {
        opacity: 1;
        translate: 0 0;
    }

    .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #168dff, #65baff 55%, #ff8a00);
        transform: scaleX(var(--progress, 0));
        transform-origin: left center;
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        main .hero > *,
        main .dashboard-hero > * {
            animation: none !important;
        }

        .motion-reveal {
            opacity: 1;
            translate: none;
            transition: none;
        }
    }
</style>

<script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function setUpProgressBar() {
        const bar = document.createElement("div");
        bar.className = "scroll-progress";
        bar.setAttribute("aria-hidden", "true");
        document.body.append(bar);

        let queued = false;
        const update = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.setProperty("--progress", max > 0 ? String(window.scrollY / max) : "0");
            queued = false;
        };

        window.addEventListener(
            "scroll",
            () => {
                if (!queued) {
                    queued = true;
                    requestAnimationFrame(update);
                }
            },
            { passive: true },
        );
        update();
    }

    function setUpReveal() {
        if (reduceMotion || !("IntersectionObserver" in window)) return;

        const targets = document.querySelectorAll<HTMLElement>(
            "main section article, main section figure, main .section-heading, main [data-reveal]",
        );

        let observerResponded = false;

        const observer = new IntersectionObserver(
            (entries) => {
                observerResponded = true;
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                }
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );

        for (const element of targets) {
            // Skip nested matches and anything already on screen at load.
            if (element.parentElement?.closest(".motion-reveal")) continue;
            if (element.getBoundingClientRect().top < window.innerHeight) continue;

            const siblings = Array.from(element.parentElement?.children ?? []);
            const index = Math.min(siblings.indexOf(element), 4);
            element.style.setProperty("--reveal-delay", `${Math.max(index, 0) * 70}ms`);
            element.classList.add("motion-reveal");
            observer.observe(element);
        }

        // Safety net: if the observer never reports back, show everything.
        window.setTimeout(() => {
            if (observerResponded) return;
            observer.disconnect();
            document.querySelectorAll(".motion-reveal").forEach((element) => element.classList.add("is-visible"));
        }, 2500);
    }

    setUpProgressBar();
    setUpReveal();
</script>
