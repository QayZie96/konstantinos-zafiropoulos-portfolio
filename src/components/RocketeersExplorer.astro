        --rx-orange: #ff8a00;
        --rx-green: #26d5a2;
        --rx-muted: #a9bbcc;
        --rx-subtle: #71869a;

        display: grid;
        gap: 1.25rem;
        width: 100%;
        min-width: 0;
    }

    .rx *,
    .rx *::before,
    .rx *::after {
        box-sizing: border-box;
    }

    .rx-intro {
        max-width: 860px;
    }

    .rx-eyebrow,
    .rx-kicker {
        margin: 0 0 0.6rem;
        color: var(--rx-orange);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .rx-intro h2 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(1.9rem, 4.2vw, 3.2rem);
        line-height: 1.04;
    }

    .rx-intro > p:last-child {
        margin: 1rem 0 0;
        color: var(--rx-muted);
        line-height: 1.75;
    }

    .rx-card {
        min-width: 0;
        padding: clamp(1rem, 2.6vw, 1.6rem);
        border: 1px solid var(--rx-border);
        border-radius: 14px;
        background:
            linear-gradient(150deg, rgba(22, 141, 255, 0.07), transparent 55%),
            var(--rx-card);
    }

    .rx-card-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem 1rem;
        margin-bottom: 1.1rem;
    }

    .rx-card-head h3 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(1.1rem, 2.2vw, 1.45rem);
        line-height: 1.25;
    }

    .rx h4 {
        margin: 0 0 0.75rem;
        color: #ffffff;
        font-size: 0.86rem;
    }

    .rx-toggle,
    .rx-presets {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        padding: 0.25rem;
        border: 1px solid #1f3b55;
        border-radius: 10px;
        background: #071626;
    }

    .rx-toggle button,
    .rx-presets button {
        min-height: 36px;
        padding: 0.45rem 0.75rem;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: var(--rx-muted);
        font: inherit;
        font-size: 0.76rem;
        font-weight: 700;
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }

    .rx-toggle button[aria-pressed="true"],
    .rx-presets button[aria-pressed="true"] {
        background: var(--rx-blue);
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(22, 141, 255, 0.28);
    }

    .rx-presets button[aria-pressed="true"] {
        background: rgba(255, 138, 0, 0.16);
        box-shadow: inset 0 0 0 1px var(--rx-orange);
    }

    .rx-toggle button:hover:not([aria-pressed="true"]),
    .rx-presets button:hover:not([aria-pressed="true"]) {
        color: #ffffff;
        background: rgba(22, 141, 255, 0.1);
    }

    .rx :global(button:focus-visible),
    .rx select:focus-visible,
    .rx-chart:focus-visible,
    .rx summary:focus-visible {
        outline: 2px solid var(--rx-orange);
        outline-offset: 2px;
    }

    /* ---------- range ---------- */

    .rx-range {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .rx-range-selects {
        display: flex;
        gap: 0.6rem;
    }

    .rx-range label {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--rx-subtle);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .rx-range select {
        min-height: 36px;
        padding: 0.35rem 0.6rem;
        border: 1px solid #284b69;
        border-radius: 8px;
        background: #091a2a;
        color: #ffffff;
        font: inherit;
        font-size: 0.8rem;
