    }

    .rx-range-totals :global(strong) {
        display: block;
        color: #ffffff;
        font-size: clamp(1rem, 2vw, 1.3rem);
        font-variant-numeric: tabular-nums;
    }

    .rx-range-totals :global(span) {
        color: var(--rx-subtle);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    /* ---------- chart ---------- */

    .rx-chart-wrap {
        position: relative;
    }

    .rx-chart {
        min-height: 270px;
        border-radius: 10px;
        background: linear-gradient(180deg, rgba(4, 13, 24, 0.6), rgba(4, 13, 24, 0.2));
        touch-action: pan-y;
    }

    .rx-chart :global(svg) {
        display: block;
    }

    .rx :global(.rx-grid) {
        stroke: rgba(113, 134, 154, 0.18);
    }

    .rx :global(.rx-year-line) {
        stroke: rgba(113, 134, 154, 0.25);
        stroke-dasharray: 2 4;
    }

    .rx :global(.rx-axis) {
        fill: #7f95aa;
        font-size: 10.5px;
        font-family: inherit;
    }

    .rx :global(.rx-bar-rect) {
        transition: opacity 0.15s ease;
    }

    .rx :global(.rx-bar-rect.is-peak) {
        fill: var(--rx-orange);
    }

    .rx :global(.rx-bar-rect.is-dim) {
        opacity: 0.45;
    }

    .rx :global(.rx-hover) {
        fill: rgba(255, 255, 255, 0.05);
    }

    .rx :global(.rx-note) {
        fill: #b8c7d6;
        font-size: 10.5px;
        font-weight: 700;
    }

    .rx :global(.rx-note.is-peak) {
        fill: var(--rx-orange);
    }

    .rx :global(.rx-note-line) {
        stroke: rgba(184, 199, 214, 0.45);
        stroke-dasharray: 2 3;
    }

    .rx :global(.rx-note-line.is-peak) {
        stroke: rgba(255, 138, 0, 0.7);
    }

    .rx-tooltip {
