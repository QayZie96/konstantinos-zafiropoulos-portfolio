---
import {
    annualEbayPerformance,
    platformPerformance,
    rocketeersSummary,
} from "../data/rocketeers";

const formatUsd = (value: number) =>
    new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
    }).format(value);

const formatCompactUsd = (value: number) =>
    `$${new Intl.NumberFormat("en-US", {
        notation: "compact",
        maximumFractionDigits: 1,
    }).format(value)}`;

const formatNumber = (value: number) =>
    new Intl.NumberFormat("en-US").format(value);

const chartMetrics = [
    {
        id: "sales",
        label: "USD sales",
        valueKey: "usdSales",
        format: formatCompactUsd,
    },
    {
        id: "units",
        label: "Units sold",
        valueKey: "units",
        format: formatNumber,
    },
    {
        id: "buyers",
        label: "Unique buyers",
        valueKey: "buyers",
        format: formatNumber,
    },
] as const;

const annualMaximums = Object.fromEntries(
    chartMetrics.map((metric) => [
        metric.id,
        Math.max(...annualEbayPerformance.map((row) => row[metric.valueKey])),
    ]),
);

const platformMaximum = Math.max(
    ...platformPerformance.map((row) => row.usdSales),
);
---

<div class="performance-dashboard" data-performance-dashboard>
    <div class="dashboard-intro">
        <p class="dashboard-eyebrow">Documented eBay performance</p>
        <h2>Operating scale supported by transaction-level records.</h2>
        <p>
            The figures below come from the available eBay export. They cover
            21,463 units through May 2022, while the verified 23,000+ lifetime
            total also includes later and additional marketplace activity.
        </p>
    </div>

    <div class="dashboard-kpis" aria-label="Documented Rocketeers performance">
        <article>
            <strong>$219.8K</strong>
            <span>USD gross sales documented</span>
        </article>
        <article>
            <strong>6,944</strong>
            <span>unique buyer IDs</span>
        </article>
        <article>
            <strong>47.3%</strong>
            <span>of buyers made repeat purchases</span>
        </article>
        <article>
            <strong>80.2%</strong>
            <span>of USD sales came from repeat buyers</span>
        </article>
    </div>

    <section class="chart-card annual-card" aria-labelledby="annual-performance-title">
        <div class="chart-heading">
            <div>
                <p class="chart-kicker">Annual performance</p>
                <h3 id="annual-performance-title">Sales, volume and customers</h3>
            </div>

            <div class="chart-tabs" role="tablist" aria-label="Annual metric">
                {
                    chartMetrics.map((metric, index) => (
                        <button
                            type="button"
                            role="tab"
                            id={`annual-tab-${metric.id}`}
                            aria-controls={`annual-panel-${metric.id}`}
                            aria-selected={index === 0 ? "true" : "false"}
                            tabindex={index === 0 ? "0" : "-1"}
                            data-chart-tab={metric.id}
                        >
                            {metric.label}
                        </button>
                    ))
                }
            </div>
        </div>

        {
            chartMetrics.map((metric, index) => (
                <div
                    class="chart-panel"
                    id={`annual-panel-${metric.id}`}
                    role="tabpanel"
                    aria-labelledby={`annual-tab-${metric.id}`}
                    hidden={index !== 0}
                    data-chart-panel={metric.id}
                >
                    <ul class="bar-list">
                        {annualEbayPerformance.map((row) => {
                            const value = row[metric.valueKey];
                            const width = Math.max(
                                2.5,
                                (value / annualMaximums[metric.id]) * 100,
                            );

                            return (
                                <li>
                                    <div class="bar-label">
                                        <span>
                                            {row.year}
                                            {row.scope === "Partial" && <small>partial</small>}
                                        </span>
                                        <strong>{metric.format(value)}</strong>
                                    </div>
                                    <div class="bar-track" aria-hidden="true">
                                        <span style={`width: ${width}%`}></span>
                                    </div>
                                </li>
                            );
                        })}
                    </ul>
                </div>
            ))
        }

        <p class="chart-note">
            2017 begins with the available February records. 2022 ends on 20 May,
            so those two years should not be compared with complete years.
        </p>
    </section>

    <div class="dashboard-lower-grid">
        <section class="chart-card" aria-labelledby="platform-mix-title">
            <div class="chart-heading">
                <div>
                    <p class="chart-kicker">Platform mix</p>
                    <h3 id="platform-mix-title">Documented USD gross sales</h3>
                </div>
            </div>

            <ul class="bar-list platform-list">
                {
                    platformPerformance.map((row) => (
                        <li>
                            <div class="bar-label">
                                <span>{row.platform}</span>
                                <strong>{formatUsd(row.usdSales)}</strong>
                            </div>
                            <div class="bar-track" aria-hidden="true">
                                <span
                                    style={`width: ${Math.max(2.5, (row.usdSales / platformMaximum) * 100)}%`}
                                ></span>
                            </div>
                            <small>{(row.salesShare * 100).toFixed(1)}% of documented USD sales</small>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="chart-card customer-card" aria-labelledby="customer-strength-title">
            <div class="chart-heading">
                <div>
                    <p class="chart-kicker">Customer strength</p>
                    <h3 id="customer-strength-title">Repeat business mattered</h3>
                </div>
            </div>

            <div class="retention-comparison">
                <article>
                    <span>Repeat buyers</span>
                    <strong>47.3%</strong>
                    <div class="percentage-track" aria-hidden="true">
                        <span style="width: 47.3%"></span>
                    </div>
                </article>
                <article>
                    <span>USD sales from repeat buyers</span>
                    <strong>80.2%</strong>
                    <div class="percentage-track" aria-hidden="true">
                        <span style="width: 80.2%"></span>
                    </div>
                </article>
            </div>

            <p>
                Nearly half of documented buyers returned, and those repeat
                customers generated four-fifths of the recorded USD sales.
            </p>

            <dl class="service-rates">
                <div>
                    <dt>Seller-side return cases</dt>
                    <dd>{rocketeersSummary.returnCases} · 0.45%</dd>
                </div>
                <div>
                    <dt>Dispute claims</dt>
                    <dd>{rocketeersSummary.disputeClaims} · 0.24%</dd>
                </div>
            </dl>
        </section>
    </div>

    <p class="scope-note">
        Currency scope: charts use USD records only. The export also contains
        €3,189.13 and £9.99, retained separately rather than converted using an
        assumed exchange rate. Gross sales are not profit or net revenue.
    </p>
</div>

<script is:inline>
    document.querySelectorAll("[data-performance-dashboard]").forEach((dashboard) => {
        const tabs = Array.from(dashboard.querySelectorAll("[data-chart-tab]"));
        const panels = Array.from(dashboard.querySelectorAll("[data-chart-panel]"));

        const activateTab = (tab, moveFocus = false) => {
            const selectedMetric = tab.dataset.chartTab;

            tabs.forEach((candidate) => {
                const selected = candidate === tab;
                candidate.setAttribute("aria-selected", String(selected));
                candidate.tabIndex = selected ? 0 : -1;
            });

            panels.forEach((panel) => {
                panel.hidden = panel.dataset.chartPanel !== selectedMetric;
            });

            if (moveFocus) tab.focus();
        };

        tabs.forEach((tab, index) => {
            tab.addEventListener("click", () => activateTab(tab));
            tab.addEventListener("keydown", (event) => {
                let nextIndex = index;

                if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
                if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
                if (event.key === "Home") nextIndex = 0;
                if (event.key === "End") nextIndex = tabs.length - 1;

                if (nextIndex !== index) {
                    event.preventDefault();
                    activateTab(tabs[nextIndex], true);
                }
            });
        });
    });
</script>

<style>
    .performance-dashboard {
        display: grid;
        gap: 1.4rem;
        width: 100%;
    }

    .dashboard-intro {
        max-width: 820px;
    }

    .dashboard-eyebrow,
    .chart-kicker {
        margin: 0 0 0.7rem;
        color: #ff8a00;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .dashboard-intro h2,
    .chart-heading h3 {
        margin: 0;
        color: #ffffff;
    }

    .dashboard-intro h2 {
        font-size: clamp(1.55rem, 3vw, 2.15rem);
        line-height: 1.18;
    }

    .dashboard-intro > p:last-child {
        margin: 1rem 0 0;
        color: #a9bbcc;
        line-height: 1.75;
    }

    .dashboard-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.8rem;
    }

    .dashboard-kpis article,
    .chart-card {
        border: 1px solid #1d354a;
        border-radius: 12px;
        background: rgba(7, 21, 34, 0.88);
    }

    .dashboard-kpis article {
        min-width: 0;
        padding: 1.15rem;
    }

    .dashboard-kpis strong {
        display: block;
        color: #ffffff;
        font-size: clamp(1.35rem, 2.7vw, 1.9rem);
        line-height: 1;
    }

    .dashboard-kpis span {
        display: block;
        margin-top: 0.65rem;
        color: #9fb1c1;
        font-size: 0.78rem;
        line-height: 1.45;
    }

    .chart-card {
        min-width: 0;
        padding: clamp(1rem, 3vw, 1.5rem);
    }

    .chart-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.35rem;
    }

    .chart-heading h3 {
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        line-height: 1.3;
    }

    .chart-tabs {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.4rem;
    }

    .chart-tabs button {
        min-height: 42px;
        padding: 0.55rem 0.75rem;
        border: 1px solid #284b69;
        border-radius: 7px;
        background: #091a2a;
        color: #a9bbcc;
        font: inherit;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
    }

    .chart-tabs button:hover,
    .chart-tabs button[aria-selected="true"] {
        border-color: #168dff;
        color: #ffffff;
        background: rgba(22, 141, 255, 0.14);
    }

    .chart-tabs button:focus-visible {
        outline: 2px solid #ff8a00;
        outline-offset: 3px;
    }

    .bar-list {
        display: grid;
        gap: 0.9rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .bar-label {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.38rem;
        color: #c7d5e1;
        font-size: 0.8rem;
    }

    .bar-label span {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    .bar-label small {
        color: #71869a;
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .bar-label strong {
        color: #ffffff;
        font-size: 0.82rem;
    }

    .bar-track,
    .percentage-track {
        width: 100%;
        overflow: hidden;
        border-radius: 999px;
        background: #0c2235;
    }

    .bar-track {
        height: 10px;
    }

    .bar-track span,
    .percentage-track span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #168dff, #65baff);
    }

    .chart-note,
    .scope-note,
    .platform-list > li > small {
        color: #71869a;
        font-size: 0.7rem;
        line-height: 1.55;
    }

    .chart-note {
        margin: 1.2rem 0 0;
    }

    .dashboard-lower-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
        gap: 1.4rem;
    }

    .platform-list > li > small {
        display: block;
        margin-top: 0.35rem;
    }

    .retention-comparison {
        display: grid;
        gap: 1rem;
    }

    .retention-comparison article {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.65rem 1rem;
        align-items: center;
    }

    .retention-comparison span {
        color: #c7d5e1;
        font-size: 0.8rem;
    }

    .retention-comparison strong {
        color: #ffffff;
        font-size: 1rem;
    }

    .percentage-track {
        grid-column: 1 / -1;
        height: 8px;
    }

    .customer-card > p {
        margin: 1.3rem 0;
        color: #a9bbcc;
        font-size: 0.84rem;
        line-height: 1.65;
    }

    .service-rates {
        display: grid;
        gap: 0;
        margin: 0;
        border-top: 1px solid #1d354a;
    }

    .service-rates div {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid #1d354a;
    }

    .service-rates dt,
    .service-rates dd {
        margin: 0;
        font-size: 0.75rem;
    }

    .service-rates dt {
        color: #9fb1c1;
    }

    .service-rates dd {
        color: #ffffff;
        font-weight: 750;
        white-space: nowrap;
    }

    .scope-note {
        margin: 0;
        padding-left: 1rem;
        border-left: 2px solid rgba(255, 138, 0, 0.65);
    }

    @media (max-width: 820px) {
        .dashboard-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-lower-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 620px) {
        .chart-heading {
            display: grid;
        }

        .chart-tabs {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            justify-content: stretch;
        }

        .chart-tabs button {
            padding-inline: 0.35rem;
        }
    }

    @media (max-width: 430px) {
        .dashboard-kpis {
            grid-template-columns: minmax(0, 1fr);
        }

        .bar-label {
            align-items: flex-start;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .chart-tabs button {
            transition: none;
        }
    }
</style>
