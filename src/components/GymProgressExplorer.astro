---
/* =========================================================
   GYM PROGRESS — INTERACTIVE DATA EXPLORER

   Every number here is computed from the real workbook
   (src/data/gym-progress.json, extracted from
   Gym_Progress_Master.xlsm). The browser recomputes weekly
   volume from raw sets and checks it against the values the
   workbook's own VBA dashboard cached in its chart XML.
   ========================================================= */

import data from "../data/gym-progress.json";

type Week = [number, number | null, number | null, number | null, number | null];

interface Exercise {
    day: string;
    name: string;
    weeks: Week[];
    history?: { label: string; weeks: [number, number][] };
}

const exercises = data.exercises as Exercise[];
const workbook = data.workbook;

const epley = (weight: number | null, reps: number | null) =>
    weight && reps && weight > 0 && reps > 0 ? weight * (1 + reps / 30) : null;

const setVolume = (week: Week) =>
    (week[1] ?? 0) * (week[2] ?? 0) + (week[3] ?? 0) * (week[4] ?? 0);

const format = (value: number, digits = 0) =>
    new Intl.NumberFormat("en-US", {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits,
    }).format(value);

const uniqueNames = new Set(exercises.map((exercise) => exercise.name.toLowerCase())).size;
const sessions = exercises.reduce((sum, exercise) => sum + exercise.weeks.length, 0);
const setsLogged = exercises.reduce(
    (sum, exercise) =>
        sum +
        exercise.weeks.reduce(
            (count, week) =>
                count +
                (week[1] && week[2] ? 1 : 0) +
                (week[3] && week[4] ? 1 : 0),
            0,
        ),
    0,
);
const totalVolume = exercises.reduce(
    (sum, exercise) => sum + exercise.weeks.reduce((acc, week) => acc + setVolume(week), 0),
    0,
);

/* Per-exercise summary used by the no-JavaScript table. */
const summaries = exercises.map((exercise) => {
    const e1rms = exercise.weeks
        .map((week) => ({ week: week[0], value: epley(week[1], week[2]) }))
        .filter((point): point is { week: number; value: number } => point.value !== null);
    const first = e1rms[0];
    const latest = e1rms[e1rms.length - 1];
    const change = first && latest ? latest.value / first.value - 1 : null;
    return { ...exercise, sessions: exercise.weeks.length, first, latest, change };
});

const kpis = [
    { value: exercises.length, label: `exercise rows across six workout sheets (${uniqueNames} unique names)` },
    { value: sessions, label: "exercise sessions logged (W1–W33)" },
    { value: setsLogged, label: "working sets with weight and reps" },
    { value: Math.round(totalVolume), label: "kg × reps of recorded volume", suffix: "" },
    { value: workbook.historicalRecords, label: `historical records across ${workbook.historicalExercises} older exercise labels` },
];

const vbaModules = workbook.vba.modules as [string, string, number, number][];
const maxModuleLines = Math.max(...vbaModules.map((module) => module[2]));
---

<div class="gx" data-gym-explorer>
    <script type="application/json" data-gym-data set:html={JSON.stringify(data)} />

    <div class="gx-intro">
        <p class="gx-eyebrow">Interactive data explorer</p>
        <h2>Real training data, straight from the workbook.</h2>
        <p>
            Every set below was extracted from the original
            <code>Gym_Progress_Master.xlsm</code>. Text cells such as
            “42.50 kgs” and “5.0 Reps” were normalised the same way the
            workbook's own <code>GYM_TryGetNumber</code> routine reads them.
            Pick an exercise, switch the metric, and hover or tap any point.
        </p>
    </div>

    <div class="gx-kpis" aria-label="Workbook totals">
        {
            kpis.map((kpi) => (
                <article>
                    <strong data-count={kpi.value}>{format(kpi.value)}</strong>
                    <span>{kpi.label}</span>
                </article>
            ))
        }
    </div>

    <!-- ===================== EXERCISE EXPLORER ===================== -->

    <article class="gx-card gx-explorer" aria-labelledby="gx-explorer-title">
        <div class="gx-card-head">
            <div>
                <p class="gx-kicker">Exercise explorer</p>
                <h3 id="gx-explorer-title" data-gx-title>Progress by exercise</h3>
            </div>
            <div class="gx-toggle" role="group" aria-label="Chart metric" data-gx-metric>
                <button type="button" data-value="weight" aria-pressed="false">Top-set weight</button>
                <button type="button" data-value="e1rm" aria-pressed="true">Est. 1RM</button>
                <button type="button" data-value="volume" aria-pressed="false">Volume</button>
            </div>
        </div>

        <div class="gx-picker">
            <div class="gx-days" role="group" aria-label="Training day" data-gx-days>
                {
                    data.days.map((day, index) => (
                        <button type="button" data-value={day} aria-pressed={index === 0 ? "true" : "false"}>
                            {day}
                            <small>{exercises.filter((exercise) => exercise.day === day).length}</small>
                        </button>
                    ))
                }
            </div>
            <div class="gx-exercise-list" role="group" aria-label="Exercise" data-gx-exercises></div>
        </div>

        <div class="gx-chart-meta">
            <label class="gx-check" data-gx-history-label>
                <input type="checkbox" data-gx-history />
                <span>Show older historical log (top-set weight only)</span>
            </label>
            <ul class="gx-legend" aria-hidden="true">
                <li><i class="lg-line"></i>Selected metric</li>
                <li><i class="lg-trend"></i>Linear trend</li>
                <li><i class="lg-band"></i>W1–W27 week placement rebalanced</li>
            </ul>
        </div>

        <div class="gx-chart-wrap">
            <div
                class="gx-chart"
                data-gx-chart
                tabindex="0"
                role="group"
                aria-roledescription="interactive chart"
                aria-label="Exercise progress chart. Use left and right arrow keys to move between sessions."
                aria-describedby="gx-chart-summary"
            ></div>
            <div class="gx-tooltip" data-gx-tooltip hidden role="status"></div>
        </div>

        <dl class="gx-stats" data-gx-stats></dl>
        <p class="gx-summary" id="gx-chart-summary" aria-live="polite" data-gx-summary></p>

        <div class="sr-only">
            <table data-gx-table>
                <caption>Data for the selected exercise</caption>
            </table>
        </div>

        <p class="gx-footnote">
            <strong>Definitions.</strong> Top-set weight = Set 1 weight (the
            workbook logs the heavier working set first). Estimated 1RM uses
            the Epley formula, <code>1RM = weight × (1 + reps ÷ 30)</code>,
            on Set 1, matching the workbook procedure
            <code>PB_E1RMForWeek</code>. Volume = Set 1 weight × reps + Set 2
            weight × reps (<code>DB3_RecordVolume</code>).
        </p>
    </article>

    <div class="gx-grid">
        <!-- ===================== LEADERBOARD ===================== -->

        <article class="gx-card gx-leaders" aria-labelledby="gx-leaders-title">
            <div class="gx-card-head">
                <div>
                    <p class="gx-kicker">Leaderboard</p>
                    <h3 id="gx-leaders-title">Biggest movers by est. 1RM</h3>
                </div>
                <div class="gx-toggle" role="group" aria-label="Leaderboard direction" data-gx-leader-mode>
                    <button type="button" data-value="up" aria-pressed="true">Gains</button>
                    <button type="button" data-value="down" aria-pressed="false">Declines</button>
                </div>
            </div>
            <div class="gx-tally" data-gx-tally></div>
            <ol class="gx-leader-list" data-gx-leaders></ol>
            <p class="gx-footnote">
                First valid session vs latest valid session, W1–W33, exercises
                with at least three sessions. Changes within ±0.5% count as
                unchanged, the same rule as the workbook's “Overall progress”
                macro. Select a row to open it in the explorer.
            </p>
        </article>

        <!-- ===================== HEATMAP ===================== -->

        <article class="gx-card gx-heat" aria-labelledby="gx-heat-title">
            <div class="gx-card-head">
                <div>
                    <p class="gx-kicker">Training calendar</p>
                    <h3 id="gx-heat-title">Weekly heatmap by workout</h3>
                </div>
                <div class="gx-toggle" role="group" aria-label="Heatmap measure" data-gx-heat-mode>
                    <button type="button" data-value="volume" aria-pressed="true">Volume</button>
                    <button type="button" data-value="count" aria-pressed="false">Exercises</button>
                </div>
            </div>
            <div class="gx-heat-scroll">
                <div class="gx-heatmap" data-gx-heatmap></div>
                <div class="gx-tooltip" data-gx-heat-tooltip hidden role="status"></div>
            </div>
            <p class="gx-summary" aria-live="polite" data-gx-heat-summary></p>
            <div class="gx-verify" data-gx-verify>
                <span class="gx-verify-badge" aria-hidden="true">✓</span>
                <p data-gx-verify-text>Checking recomputed weekly volume against the workbook…</p>
            </div>
        </article>
    </div>

    <!-- ===================== INSIDE THE WORKBOOK ===================== -->

    <article class="gx-card gx-inside" aria-labelledby="gx-inside-title">
        <div class="gx-card-head">
            <div>
                <p class="gx-kicker">Inside the workbook</p>
                <h3 id="gx-inside-title">What the .xlsm actually contains</h3>
            </div>
        </div>

        <p class="gx-inside-lead">
            Read directly from the file: the sheet list, chart XML, button
            shapes and the VBA project. The module source was decompressed from
            <code>vbaProject.bin</code>, so the figures below are counted, not
            estimated.
        </p>

        <div class="gx-inside-grid">
            <section aria-labelledby="gx-sheets-title">
                <h4 id="gx-sheets-title">8 worksheets</h4>
                <ul class="gx-chip-list">
                    {workbook.sheets.map((sheet) => <li>{sheet}</li>)}
                </ul>
                <p>
                    Each workout sheet carries one button per exercise
                    ({exercises.length} in total) wired to
                    <code>PointA_ButtonClicked</code>, plus
                    <code>OverallProgress_ButtonClicked</code> and
                    <code>PointA_HideAll</code>.
                </p>
            </section>

            <section aria-labelledby="gx-dash-title">
                <h4 id="gx-dash-title">Dashboard KPIs present</h4>
                <ul class="gx-chip-list">
                    <li>Current week</li>
                    <li>Latest closed week</li>
                    <li>Current exercises · {workbook.cache.uniqueCurrentExercises}</li>
                    <li>Current volume</li>
                    <li>Best complete week</li>
                    <li>Last completed change</li>
                </ul>
                <p>
                    Refreshed automatically by <code>Workbook_Open</code> and
                    <code>Workbook_SheetActivate</code> whenever the dashboards
                    sheet is opened.
                </p>
            </section>

            <section aria-labelledby="gx-charts-title">
                <h4 id="gx-charts-title">4 dashboard charts</h4>
                <ol class="gx-chart-list">
                    <li>Historical strength trend (reconstructed)</li>
                    <li>Current weekly volume (recorded)</li>
                    <li>Volume by workout, W31</li>
                    <li>Highest-volume exercises, W31</li>
                </ol>
                <figure class="gx-spark">
                    <div data-gx-spark></div>
                    <figcaption>
                        Chart 1 as cached in the file: a strength index that
                        starts at 100 and reaches
                        {` ${workbook.cache.historicalIndex[workbook.cache.historicalIndex.length - 1].toFixed(1)} `}
                        over 37 historical weeks (geometric mean of per-exercise
                        Set 1 weight ratios; reps ignored because some were imputed).
                    </figcaption>
                </figure>
            </section>

            <section aria-labelledby="gx-vba-title" class="gx-vba">
                <h4 id="gx-vba-title">
                    {`VBA project · ${format(workbook.vba.lines)} lines · ${workbook.vba.procedures} procedures`}
                </h4>
                <ul class="gx-module-list">
                    {
                        vbaModules.map(([name, role, lines, procedures]) => (
                            <li>
                                <div>
                                    <strong>{name}</strong>
                                    <span>{role}</span>
                                </div>
                                <div class="gx-module-bar" aria-hidden="true">
                                    <span style={`--w: ${(lines / maxModuleLines).toFixed(3)}`}></span>
                                </div>
                                <small>{format(lines)} lines · {procedures} procs</small>
                            </li>
                        ))
                    }
                </ul>
                <p>
                    Non-blank lines including {format(workbook.vba.comments)} comment
                    lines. Eight sheet modules are empty.
                </p>
            </section>
        </div>

        <details class="gx-details">
            <summary>Data-quality and repair logic found in the code</summary>
            <ul>
                <li>
                    <strong>Numeric text.</strong> {`${workbook.textCellsNormalised} of ${format(workbook.filledCells)}`} filled weight/rep cells are stored as
                    text (“42.50 kgs”, “5.0 Reps”). <code>GYM_TryGetNumber</code>
                    converts them; the explorer applies the same rule.
                </li>
                <li>
                    <strong>Historical aliases.</strong> <code>GYM_HistoricalAlias</code>
                    links ten older labels to current exercises (for example
                    “incline press” → Grey Incline Press) and otherwise requires an
                    exact, case-insensitive name match.
                </li>
                <li>
                    <strong>Week placement.</strong> <code>GYM_FinalOneTimeRepair</code>
                    evenly redistributed W1–W27 records across weeks while keeping
                    each exercise's sessions in order and never inventing data; W28
                    onward is untouched. The shaded band in the chart marks that period.
                </li>
                <li>
                    <strong>Incomplete sets.</strong> <code>DB3_CountIncompleteSets</code>
                    stops a week with half-filled sets from being crowned “best
                    complete week”.
                </li>
            </ul>
        </details>
    </article>

    <details class="gx-details gx-table-details">
        <summary>View every exercise as a table</summary>
        <div class="gx-table-scroll">
            <table>
                <caption>Estimated 1RM, first vs latest session (Epley, Set 1)</caption>
                <thead>
                    <tr>
                        <th scope="col">Exercise</th>
                        <th scope="col">Day</th>
                        <th scope="col">Sessions</th>
                        <th scope="col">First est. 1RM</th>
                        <th scope="col">Latest est. 1RM</th>
                        <th scope="col">Change</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        summaries.map((row) => (
                            <tr>
                                <th scope="row">{row.name}</th>
                                <td>{row.day}</td>
                                <td>{row.sessions}</td>
                                <td>{row.first ? `${row.first.value.toFixed(1)} kg (W${row.first.week})` : "—"}</td>
                                <td>{row.latest ? `${row.latest.value.toFixed(1)} kg (W${row.latest.week})` : "—"}</td>
                                <td>{row.change === null ? "—" : `${row.change >= 0 ? "+" : ""}${(row.change * 100).toFixed(1)}%`}</td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </details>
</div>

<script>
    import {
        bindToggleGroup,
        el,
        formatNumber,
        heatColor,
        niceTicks,
        onReveal,
        onWidthChange,
        placeTooltip,
        prefersReducedMotion,
        setUpBarGrowth,
        setUpCountUps,
        svg,
    } from "../scripts/explorer-utils";

    type Week = [number, number | null, number | null, number | null, number | null];
    interface Exercise {
        day: string;
        name: string;
        weeks: Week[];
        history?: { label: string; weeks: [number, number][] };
    }
    interface Point {
        slot: number;
        label: string;
        value: number;
        week?: Week;
        historical?: boolean;
    }

    const HIST_WEEKS = 37;
    const CURRENT_WEEKS = 33;
    const REBALANCED_UNTIL = 27;

    const epley = (weight: number | null, reps: number | null) =>
        weight && reps && weight > 0 && reps > 0 ? weight * (1 + reps / 30) : null;

    const volumeOf = (week: Week) => {
        const a = week[1] && week[2] ? week[1] * week[2] : 0;
        const b = week[3] && week[4] ? week[3] * week[4] : 0;
        return a || b ? a + b : null;
    };

    const metricLabels: Record<string, { name: string; unit: string; digits: number }> = {
        weight: { name: "Top-set weight", unit: "kg", digits: 1 },
        e1rm: { name: "Estimated 1RM", unit: "kg", digits: 1 },
        volume: { name: "Volume", unit: "kg × reps", digits: 0 },
    };

    const setText = (week: Week, set: 1 | 2) => {
        const weight = set === 1 ? week[1] : week[3];
        const reps = set === 1 ? week[2] : week[4];
        if (!weight && !reps) return "—";
        return `${weight ?? "?"} kg × ${reps ?? "?"}`;
    };

    document.querySelectorAll<HTMLElement>("[data-gym-explorer]").forEach((root) => {
        const dataNode = root.querySelector("[data-gym-data]");
        if (!dataNode?.textContent) return;
        const data = JSON.parse(dataNode.textContent);
        const exercises: Exercise[] = data.exercises;

        const reduce = prefersReducedMotion();

        /* ---------------- state ---------------- */
        const state = {
            day: data.days[0] as string,
            index: exercises.findIndex((exercise) => exercise.day === data.days[0]),
            metric: "e1rm",
            history: false,
            focus: -1,
            points: [] as Point[],
        };

        // Default to the most-logged exercise of the first day for a richer first view.
        const firstDay = exercises
            .map((exercise, index) => ({ exercise, index }))
            .filter(({ exercise }) => exercise.day === state.day)
            .sort((a, b) => b.exercise.weeks.length - a.exercise.weeks.length)[0];
        if (firstDay) state.index = firstDay.index;

        const titleNode = root.querySelector<HTMLElement>("[data-gx-title]")!;
        const listNode = root.querySelector<HTMLElement>("[data-gx-exercises]")!;
        const chartNode = root.querySelector<HTMLElement>("[data-gx-chart]")!;
        const tooltip = root.querySelector<HTMLElement>("[data-gx-tooltip]")!;
        const statsNode = root.querySelector<HTMLElement>("[data-gx-stats]")!;
        const summaryNode = root.querySelector<HTMLElement>("[data-gx-summary]")!;
        const tableNode = root.querySelector<HTMLTableElement>("[data-gx-table]")!;
        const historyInput = root.querySelector<HTMLInputElement>("[data-gx-history]")!;
        const historyLabel = root.querySelector<HTMLElement>("[data-gx-history-label]")!;

        /* ---------------- exercise list ---------------- */
        const renderExerciseList = () => {
            listNode.replaceChildren();
            exercises.forEach((exercise, index) => {
                if (exercise.day !== state.day) return;
                const button = el("button", "gx-ex", exercise.name, listNode);
                button.type = "button";
                button.dataset.index = String(index);
                button.setAttribute("aria-pressed", String(index === state.index));
                const count = el("small", "", String(exercise.weeks.length), button);
                count.setAttribute("aria-label", `${exercise.weeks.length} sessions`);
                button.addEventListener("click", () => selectExercise(index));
            });
        };

        const selectExercise = (index: number, scroll = false) => {
            state.index = index;
            state.focus = -1;
            const exercise = exercises[index];
            if (exercise.day !== state.day) {
                state.day = exercise.day;
                root.querySelectorAll<HTMLButtonElement>("[data-gx-days] button").forEach((button) =>
                    button.setAttribute("aria-pressed", String(button.dataset.value === state.day)),
                );
                renderExerciseList();
            }
            listNode.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
                button.setAttribute("aria-pressed", String(Number(button.dataset.index) === index)),
            );
            renderChart(true);
            if (scroll) {
                root.querySelector(".gx-explorer")?.scrollIntoView({
                    behavior: reduce ? "auto" : "smooth",
                    block: "start",
                });
            }
        };

        bindToggleGroup(root.querySelector("[data-gx-days]")!, "button", (value) => {
            state.day = value;
            const candidates = exercises
                .map((exercise, index) => ({ exercise, index }))
                .filter(({ exercise }) => exercise.day === value)
                .sort((a, b) => b.exercise.weeks.length - a.exercise.weeks.length);
            state.index = candidates[0]?.index ?? 0;
            state.focus = -1;
            renderExerciseList();
            renderChart(true);
        });

        bindToggleGroup(root.querySelector("[data-gx-metric]")!, "button", (value) => {
            state.metric = value;
            state.focus = -1;
            renderChart(true);
        });

        historyInput.addEventListener("change", () => {
            state.history = historyInput.checked;
            state.focus = -1;
            renderChart(true);
        });

        /* ---------------- points ---------------- */
        const buildPoints = (exercise: Exercise): Point[] => {
            const withHistory = state.history && state.metric === "weight" && !!exercise.history;
            const offset = withHistory ? HIST_WEEKS + 1 : 0;
            const points: Point[] = [];
            if (withHistory && exercise.history) {
                exercise.history.weeks.forEach(([week, weight]) => {
                    points.push({ slot: week - 1, label: `H${week}`, value: weight, historical: true });
                });
            }
            exercise.weeks.forEach((week) => {
                let value: number | null = null;
                if (state.metric === "weight") value = week[1] && week[1] > 0 ? week[1] : null;
                if (state.metric === "e1rm") value = epley(week[1], week[2]);
                if (state.metric === "volume") value = volumeOf(week);
                if (value === null) return;
                points.push({ slot: offset + week[0] - 1, label: `W${week[0]}`, value, week });
            });
            return points;
        };

        /* ---------------- chart ---------------- */
        const renderChart = (animate = false) => {
            const exercise = exercises[state.index];
            const metric = metricLabels[state.metric];
            const hasHistory = !!exercise.history;
            historyInput.disabled = !hasHistory || state.metric !== "weight";
            historyLabel.classList.toggle("is-disabled", historyInput.disabled);
            historyLabel.title = !hasHistory
                ? "No matching historical label for this exercise"
                : state.metric !== "weight"
                  ? "History is weight-only: some historical reps were imputed"
                  : "";

            const withHistory = state.history && state.metric === "weight" && hasHistory;
            const points = buildPoints(exercise);
            state.points = points;
            titleNode.textContent = exercise.name;

            const width = Math.max(280, chartNode.clientWidth);
            const height = width < 560 ? 250 : 330;
            const pad = { top: 22, right: 14, bottom: 34, left: width < 560 ? 40 : 50 };
            const innerW = width - pad.left - pad.right;
            const innerH = height - pad.top - pad.bottom;
            const slots = withHistory ? HIST_WEEKS + 1 + CURRENT_WEEKS : CURRENT_WEEKS;
            const x = (slot: number) => pad.left + (slots === 1 ? innerW / 2 : (slot / (slots - 1)) * innerW);

            const values = points.map((point) => point.value);
            const min = values.length ? Math.min(...values) : 0;
            const max = values.length ? Math.max(...values) : 1;
            const spread = max - min || Math.max(1, max * 0.1);
            const ticks = niceTicks(Math.max(0, min - spread * 0.15), max + spread * 0.15, 4);
            const yMin = ticks[0];
            const yMax = ticks[ticks.length - 1];
            const y = (value: number) => pad.top + innerH - ((value - yMin) / (yMax - yMin || 1)) * innerH;

            const root2 = svg("svg", {
                width,
                height,
                viewBox: `0 0 ${width} ${height}`,
                class: "gx-svg",
                "aria-hidden": "true",
                focusable: "false",
            });

            // Rebalanced band (W1–W27 of the current sheets).
            const currentStart = withHistory ? HIST_WEEKS + 1 : 0;
            const bandStart = x(currentStart) - (innerW / (slots - 1)) * 0.5;
            const bandEnd = x(currentStart + REBALANCED_UNTIL - 1) + (innerW / (slots - 1)) * 0.5;
            svg("rect", {
                x: Math.max(pad.left, bandStart),
                y: pad.top,
                width: Math.min(bandEnd, pad.left + innerW) - Math.max(pad.left, bandStart),
                height: innerH,
                class: "gx-band",
            }, root2);

            if (withHistory) {
                svg("rect", {
                    x: pad.left,
                    y: pad.top,
                    width: x(HIST_WEEKS - 1) - pad.left + 4,
                    height: innerH,
                    class: "gx-hist-band",
                }, root2);
                const boundary = x(HIST_WEEKS);
                svg("line", { x1: boundary, x2: boundary, y1: pad.top - 6, y2: pad.top + innerH, class: "gx-boundary" }, root2);
                const label = svg("text", { x: boundary - 6, y: pad.top + 4, class: "gx-axis-note", "text-anchor": "end" }, root2);
                label.textContent = "Historical ←";
                const label2 = svg("text", { x: boundary + 6, y: pad.top + 4, class: "gx-axis-note" }, root2);
                label2.textContent = "→ Current";
            }

            // Grid + y labels.
            ticks.forEach((tick) => {
                svg("line", { x1: pad.left, x2: pad.left + innerW, y1: y(tick), y2: y(tick), class: "gx-grid" }, root2);
                const text = svg("text", { x: pad.left - 8, y: y(tick) + 4, class: "gx-axis", "text-anchor": "end" }, root2);
                text.textContent = tick >= 10_000 ? `${tick / 1000}k` : formatNumber(tick, tick % 1 ? 1 : 0);
            });

            // X labels.
            const xLabels: [number, string][] = [];
            const step = width < 560 ? 8 : 4;
            if (withHistory) {
                for (let week = 1; week <= HIST_WEEKS; week += step * 2) xLabels.push([week - 1, `H${week}`]);
                for (let week = 1; week <= CURRENT_WEEKS; week += step) xLabels.push([HIST_WEEKS + week, `W${week}`]);
            } else {
                for (let week = 1; week <= CURRENT_WEEKS; week += step) xLabels.push([week - 1, `W${week}`]);
                if ((CURRENT_WEEKS - 1) % step !== 0) xLabels.push([CURRENT_WEEKS - 1, `W${CURRENT_WEEKS}`]);
            }
            xLabels.forEach(([slot, label]) => {
                const text = svg("text", { x: x(slot), y: height - 10, class: "gx-axis", "text-anchor": "middle" }, root2);
                text.textContent = label;
            });

            // Trend line over current points.
            const current = points.filter((point) => !point.historical);
            if (current.length >= 3) {
                const n = current.length;
                const mx = current.reduce((sum, p) => sum + p.slot, 0) / n;
                const my = current.reduce((sum, p) => sum + p.value, 0) / n;
                const sxy = current.reduce((sum, p) => sum + (p.slot - mx) * (p.value - my), 0);
                const sxx = current.reduce((sum, p) => sum + (p.slot - mx) ** 2, 0) || 1;
                const slope = sxy / sxx;
                const a = current[0].slot;
                const b = current[n - 1].slot;
                const clampY = (v: number) => Math.max(yMin, Math.min(yMax, v));
                svg("line", {
                    x1: x(a), y1: y(clampY(my + slope * (a - mx))),
                    x2: x(b), y2: y(clampY(my + slope * (b - mx))),
                    class: "gx-trend",
                }, root2);
            }

            // Area + line, drawn per segment (historical / current).
            const segments = [points.filter((p) => p.historical), current].filter((segment) => segment.length);
            segments.forEach((segment) => {
                const d = segment.map((p, i) => `${i ? "L" : "M"}${x(p.slot).toFixed(1)},${y(p.value).toFixed(1)}`).join("");
                if (segment.length > 1) {
                    const area = `${d}L${x(segment[segment.length - 1].slot).toFixed(1)},${pad.top + innerH}L${x(segment[0].slot).toFixed(1)},${pad.top + innerH}Z`;
                    svg("path", { d: area, class: segment[0].historical ? "gx-area is-hist" : "gx-area" }, root2);
                }
                const path = svg("path", { d, class: segment[0].historical ? "gx-line is-hist" : "gx-line" }, root2);
                if (animate && !reduce && segment.length > 1) {
                    requestAnimationFrame(() => {
                        const length = path.getTotalLength();
                        path.style.strokeDasharray = `${length}`;
                        path.style.strokeDashoffset = `${length}`;
                        path.getBoundingClientRect();
                        path.style.transition = "stroke-dashoffset 0.9s cubic-bezier(0.3, 0.7, 0.2, 1)";
                        path.style.strokeDashoffset = "0";
                    });
                }
            });

            // Points.
            const best = current.reduce<Point | null>((top, p) => (!top || p.value > top.value ? p : top), null);
            points.forEach((point, i) => {
                const dot = svg("circle", {
                    cx: x(point.slot),
                    cy: y(point.value),
                    r: point === best ? 5.5 : 3.6,
                    class: `gx-dot${point.historical ? " is-hist" : ""}${point === best ? " is-best" : ""}`,
                    "data-i": i,
                }, root2);
                if (animate && !reduce) {
                    dot.style.opacity = "0";
                    dot.style.transition = `opacity 0.35s ease ${0.25 + (i / Math.max(1, points.length)) * 0.6}s`;
                    requestAnimationFrame(() => requestAnimationFrame(() => (dot.style.opacity = "1")));
                }
            });

            // Focus marker.
            const marker = svg("g", { class: "gx-marker", visibility: "hidden" }, root2);
            const markerLine = svg("line", { y1: pad.top, y2: pad.top + innerH, class: "gx-marker-line" }, marker);
            const markerDot = svg("circle", { r: 7, class: "gx-marker-dot" }, marker);

            if (!points.length) {
                const text = svg("text", { x: width / 2, y: height / 2, class: "gx-axis-note", "text-anchor": "middle" }, root2);
                text.textContent = "No sessions with this metric";
            }

            chartNode.replaceChildren(root2);
            tooltip.hidden = true;

            const showPoint = (i: number, announce = false) => {
                if (i < 0 || i >= points.length) return;
                state.focus = i;
                const point = points[i];
                const px = x(point.slot);
                const py = y(point.value);
                marker.setAttribute("visibility", "visible");
                markerLine.setAttribute("x1", String(px));
                markerLine.setAttribute("x2", String(px));
                markerDot.setAttribute("cx", String(px));
                markerDot.setAttribute("cy", String(py));

                tooltip.replaceChildren();
                el("strong", "", point.historical ? `${point.label} · historical log` : `${point.label} · ${exercise.day}`, tooltip);
                if (point.historical) {
                    el("span", "", `Top-set weight: ${formatNumber(point.value, 1)} kg`, tooltip);
                    el("span", "gx-tip-note", `Logged as “${exercise.history?.label}”`, tooltip);
                } else if (point.week) {
                    const week = point.week;
                    el("span", "", `Set 1: ${setText(week, 1)}`, tooltip);
                    el("span", "", `Set 2: ${setText(week, 2)}`, tooltip);
                    const e1 = epley(week[1], week[2]);
                    if (e1) el("span", "", `Est. 1RM: ${formatNumber(e1, 1)} kg`, tooltip);
                    const vol = volumeOf(week);
                    if (vol) el("span", "", `Volume: ${formatNumber(vol, 0)} kg × reps`, tooltip);
                    if (week[0] <= REBALANCED_UNTIL) el("span", "gx-tip-note", "Week position rebalanced in workbook", tooltip);
                }
                const scrollParent = chartNode;
                placeTooltip(tooltip, tooltip.parentElement as HTMLElement, px - scrollParent.scrollLeft, py);
                if (announce) {
                    summaryNode.textContent = `${point.label}: ${metric.name} ${formatNumber(point.value, metric.digits)} ${metric.unit}.`;
                }
            };

            const nearest = (clientX: number) => {
                const rect = root2.getBoundingClientRect();
                const px = clientX - rect.left;
                let bestIndex = -1;
                let bestDistance = Infinity;
                points.forEach((point, i) => {
                    const distance = Math.abs(x(point.slot) - px);
                    if (distance < bestDistance) {
                        bestDistance = distance;
                        bestIndex = i;
                    }
                });
                return bestIndex;
            };

            root2.addEventListener("pointermove", (event) => showPoint(nearest(event.clientX)));
            root2.addEventListener("pointerdown", (event) => showPoint(nearest(event.clientX)));
            root2.addEventListener("pointerleave", (event) => {
                if (event.pointerType === "mouse") {
                    tooltip.hidden = true;
                    marker.setAttribute("visibility", "hidden");
                }
            });

            chartNode.onkeydown = (event) => {
                if (!points.length) return;
                let next = state.focus;
                if (event.key === "ArrowRight") next = Math.min(points.length - 1, state.focus + 1);
                else if (event.key === "ArrowLeft") next = Math.max(0, state.focus < 0 ? points.length - 1 : state.focus - 1);
                else if (event.key === "Home") next = 0;
                else if (event.key === "End") next = points.length - 1;
                else if (event.key === "Escape") {
                    tooltip.hidden = true;
                    marker.setAttribute("visibility", "hidden");
                    return;
                } else return;
                event.preventDefault();
                showPoint(next, true);
            };
            chartNode.onblur = () => {
                tooltip.hidden = true;
                marker.setAttribute("visibility", "hidden");
            };

            renderStats(exercise, current, best);
            renderTable(points, metric);
        };

        /* ---------------- stats + summary ---------------- */
        const renderStats = (exercise: Exercise, current: Point[], best: Point | null) => {
            const metric = metricLabels[state.metric];
            const first = current[0];
            const latest = current[current.length - 1];
            const change = first && latest ? latest.value / first.value - 1 : null;
            const fmt = (point?: Point | null) =>
                point ? `${formatNumber(point.value, metric.digits)}` : "—";
            const items: [string, string, string?][] = [
                ["Sessions logged", String(exercise.weeks.length)],
                [`First (${first?.label ?? "—"})`, fmt(first), metric.unit],
                [`Latest (${latest?.label ?? "—"})`, fmt(latest), metric.unit],
                [`Best (${best?.label ?? "—"})`, fmt(best), metric.unit],
                ["Change", change === null ? "—" : `${change >= 0 ? "+" : ""}${(change * 100).toFixed(1)}%`],
            ];
            statsNode.replaceChildren();
            items.forEach(([label, value, unit], i) => {
                const wrap = el("div", i === 4 && change !== null ? (change > 0.005 ? "is-up" : change < -0.005 ? "is-down" : "") : "", undefined, statsNode);
                el("dt", "", label, wrap);
                const dd = el("dd", "", value, wrap);
                if (unit && value !== "—") el("small", "", ` ${unit}`, dd);
            });

            summaryNode.textContent = current.length
                ? `${exercise.name} (${exercise.day}): ${current.length} sessions with ${metric.name.replace(/^[A-Z](?=[a-z])/, (c) => c.toLowerCase())}. ` +
                  `From ${fmt(first)} ${metric.unit} in ${first.label} to ${fmt(latest)} ${metric.unit} in ${latest.label}` +
                  `${change === null ? "" : ` (${change >= 0 ? "+" : ""}${(change * 100).toFixed(1)}%)`}; best ${fmt(best)} ${metric.unit} in ${best?.label}.`
                : `${exercise.name}: no sessions with ${metric.name.replace(/^[A-Z](?=[a-z])/, (c) => c.toLowerCase())}.`;
        };

        const renderTable = (points: Point[], metric: { name: string; unit: string; digits: number }) => {
            const caption = el("caption", "", `${exercises[state.index].name} — ${metric.name} (${metric.unit})`);
            const head = el("thead");
            const headRow = el("tr", "", undefined, head);
            ["Week", "Set 1", "Set 2", metric.name].forEach((label) => {
                const th = el("th", "", label, headRow);
                th.scope = "col";
            });
            const body = el("tbody");
            points.forEach((point) => {
                const row = el("tr", "", undefined, body);
                const th = el("th", "", point.label, row);
                th.scope = "row";
                el("td", "", point.week ? setText(point.week, 1) : "—", row);
                el("td", "", point.week ? setText(point.week, 2) : "—", row);
                el("td", "", formatNumber(point.value, metric.digits), row);
            });
            tableNode.replaceChildren(caption, head, body);
        };

        /* ---------------- leaderboard ---------------- */
        const leaderRows = exercises
            .map((exercise, index) => {
                const e1rms = exercise.weeks
                    .map((week) => ({ week: week[0], value: epley(week[1], week[2]) }))
                    .filter((point): point is { week: number; value: number } => point.value !== null);
                if (!e1rms.length) return null;
                const first = e1rms[0];
                const latest = e1rms[e1rms.length - 1];
                return { index, exercise, first, latest, change: latest.value / first.value - 1, sessions: e1rms.length };
            })
            .filter((row): row is NonNullable<typeof row> => row !== null);

        const tallyNode = root.querySelector<HTMLElement>("[data-gx-tally]")!;
        const tracked = leaderRows.filter((row) => row.sessions >= 3);
        const improved = tracked.filter((row) => row.change > 0.005).length;
        const declined = tracked.filter((row) => row.change < -0.005).length;
        const unchanged = tracked.length - improved - declined;
        [
            ["Improved", improved, "is-up"],
            ["Unchanged", unchanged, ""],
            ["Declined", declined, "is-down"],
        ].forEach(([label, value, cls]) => {
            const item = el("div", `gx-tally-item ${cls}`, undefined, tallyNode);
            el("strong", "", String(value), item);
            el("span", "", String(label), item);
        });
        el("p", "gx-tally-note", `${tracked.length} exercises with 3+ sessions`, tallyNode);

        const leadersNode = root.querySelector<HTMLElement>("[data-gx-leaders]")!;
        const renderLeaders = (mode: string) => {
            const sorted = [...tracked].sort((a, b) => (mode === "up" ? b.change - a.change : a.change - b.change)).slice(0, 8);
            const maxAbs = Math.max(...sorted.map((row) => Math.abs(row.change)), 0.01);
            leadersNode.replaceChildren();
            leadersNode.classList.remove("bars-ready");
            sorted.forEach((row) => {
                const li = el("li", "", undefined, leadersNode);
                const button = el("button", "gx-leader", undefined, li);
                button.type = "button";
                button.setAttribute(
                    "aria-label",
                    `${row.exercise.name}, ${row.exercise.day}: ${row.change >= 0 ? "+" : ""}${(row.change * 100).toFixed(1)}% est. 1RM, from ${row.first.value.toFixed(1)} kg in W${row.first.week} to ${row.latest.value.toFixed(1)} kg in W${row.latest.week}. Open in explorer.`,
                );
                const top = el("span", "gx-leader-top", undefined, button);
                const name = el("span", "gx-leader-name", row.exercise.name, top);
                el("small", "", row.exercise.day, name);
                el("strong", row.change >= 0 ? "is-up" : "is-down", `${row.change >= 0 ? "+" : ""}${(row.change * 100).toFixed(1)}%`, top);
                const track = el("span", "gx-leader-track", undefined, button);
                const fill = el("span", row.change >= 0 ? "is-up" : "is-down", undefined, track);
                fill.style.setProperty("--w", (Math.abs(row.change) / maxAbs).toFixed(3));
                el("span", "gx-leader-sub", `${row.first.value.toFixed(1)} → ${row.latest.value.toFixed(1)} kg · W${row.first.week}–W${row.latest.week}`, button);
                button.addEventListener("click", () => selectExercise(row.index, true));
            });
            requestAnimationFrame(() => requestAnimationFrame(() => leadersNode.classList.add("bars-ready")));
        };
        bindToggleGroup(root.querySelector("[data-gx-leader-mode]")!, "button", renderLeaders);

        /* ---------------- heatmap ---------------- */
        const heatNode = root.querySelector<HTMLElement>("[data-gx-heatmap]")!;
        const heatTooltip = root.querySelector<HTMLElement>("[data-gx-heat-tooltip]")!;
        const heatSummary = root.querySelector<HTMLElement>("[data-gx-heat-summary]")!;
        const dayWeek = new Map<string, { volume: number; count: number }>();
        const weekTotals = new Array(CURRENT_WEEKS + 1).fill(0);
        exercises.forEach((exercise) =>
            exercise.weeks.forEach((week) => {
                const key = `${exercise.day}|${week[0]}`;
                const cell = dayWeek.get(key) ?? { volume: 0, count: 0 };
                const raw = (week[1] ?? 0) * (week[2] ?? 0) + (week[3] ?? 0) * (week[4] ?? 0);
                cell.volume += raw;
                cell.count += 1;
                dayWeek.set(key, cell);
                weekTotals[week[0]] += raw;
            }),
        );

        let heatMode = "volume";
        const renderHeatmap = () => {
            const width = Math.max(480, heatNode.clientWidth);
            const labelW = 54;
            const cols = CURRENT_WEEKS;
            const gap = 3;
            const cell = Math.max(10, (width - labelW - gap * cols) / cols);
            const rowH = Math.min(30, Math.max(18, cell));
            const height = (rowH + gap) * data.days.length + 30;
            const values = [...dayWeek.values()].map((v) => (heatMode === "volume" ? v.volume : v.count));
            const max = Math.max(...values, 1);

            const map = svg("svg", { width, height, viewBox: `0 0 ${width} ${height}`, class: "gx-heat-svg", "aria-hidden": "true" });
            data.days.forEach((day: string, r: number) => {
                const label = svg("text", { x: 0, y: r * (rowH + gap) + rowH / 2 + 4, class: "gx-axis gx-heat-label" }, map);
                label.textContent = day;
                for (let w = 1; w <= cols; w++) {
                    const v = dayWeek.get(`${day}|${w}`);
                    const value = v ? (heatMode === "volume" ? v.volume : v.count) : 0;
                    const rect = svg("rect", {
                        x: labelW + (w - 1) * (cell + gap),
                        y: r * (rowH + gap),
                        width: cell,
                        height: rowH,
                        rx: 3,
                        class: v ? "gx-cell" : "gx-cell is-empty",
                        fill: v ? heatColor(0.12 + (value / max) * 0.88) : undefined,
                        "data-day": day,
                        "data-week": w,
                    }, map);
                    if (!reduce) rect.style.setProperty("--d", `${(w * 18 + r * 40)}ms`);
                }
            });
            for (let w = 1; w <= cols; w += 4) {
                const text = svg("text", { x: labelW + (w - 1) * (cell + gap) + (w === cols ? cell : cell / 2), y: height - 8, class: "gx-axis", "text-anchor": w === cols ? "end" : "middle" }, map);
                text.textContent = `W${w}`;
            }
            // Bracket for the rebalanced period.
            const bx2 = labelW + (REBALANCED_UNTIL - 1) * (cell + gap) + cell;
            svg("line", { x1: labelW, x2: bx2, y1: height - 24, y2: height - 24, class: "gx-bracket" }, map);
            svg("line", { x1: bx2 + gap, x2: width, y1: height - 24, y2: height - 24, class: "gx-bracket is-exact" }, map);

            heatNode.replaceChildren(map);

            const show = (target: Element | null) => {
                if (!(target instanceof SVGRectElement) || !target.dataset.day) return;
                const day = target.dataset.day;
                const week = Number(target.dataset.week);
                const v = dayWeek.get(`${day}|${week}`);
                heatTooltip.replaceChildren();
                el("strong", "", `${day} · W${week}`, heatTooltip);
                el("span", "", v ? `${v.count} exercises logged` : "No sessions logged", heatTooltip);
                if (v) el("span", "", `${formatNumber(v.volume)} kg × reps`, heatTooltip);
                if (week <= REBALANCED_UNTIL) el("span", "gx-tip-note", "Week position rebalanced", heatTooltip);
                const scroller = heatNode.parentElement as HTMLElement;
                const box = target.getBoundingClientRect();
                const parent = scroller.getBoundingClientRect();
                placeTooltip(heatTooltip, scroller, box.left - parent.left + box.width / 2 + scroller.scrollLeft, box.top - parent.top);
                heatSummary.textContent = `${day}, week ${week}: ${v ? `${v.count} exercises, ${formatNumber(v.volume)} kg × reps` : "no sessions"}.`;
            };
            map.addEventListener("pointermove", (event) => show(event.target as Element));
            map.addEventListener("pointerdown", (event) => show(event.target as Element));
            map.addEventListener("pointerleave", (event) => {
                if (event.pointerType === "mouse") heatTooltip.hidden = true;
            });
        };

        bindToggleGroup(root.querySelector("[data-gx-heat-mode]")!, "button", (value) => {
            heatMode = value;
            renderHeatmap();
        });

        const busiest = [...dayWeek.entries()].sort((a, b) => b[1].volume - a[1].volume)[0];
        heatSummary.textContent = `Six workouts × ${CURRENT_WEEKS} weeks. Highest-volume workout week: ${busiest[0].replace("|", " · W")} with ${formatNumber(busiest[1].volume)} kg × reps. Hover or tap a cell for details.`;

        /* ---------------- verification against workbook cache ---------------- */
        const cache: number[] = data.workbook.cache.weeklyVolume;
        const matches = cache.filter((value, i) => Math.abs(value - weekTotals[i + 1]) < 0.01).length;
        const workoutCache: Record<string, number> = data.workbook.cache.workoutVolumeW31;
        const workoutMatches = Object.entries(workoutCache).filter(
            ([day, value]) => Math.abs((dayWeek.get(`${day}|31`)?.volume ?? 0) - value) < 0.01,
        ).length;
        const verifyText = root.querySelector<HTMLElement>("[data-gx-verify-text]")!;
        const verify = root.querySelector<HTMLElement>("[data-gx-verify]")!;
        verify.classList.toggle("is-ok", matches === cache.length && workoutMatches === 6);
        verifyText.innerHTML = "";
        el("strong", "", `${matches} of ${cache.length} weekly totals match`, verifyText);
        verifyText.append(
            `, recomputed in your browser from raw sets and compared with the values the workbook's VBA dashboard cached in its “Current weekly volume” chart. W31 by workout: ${workoutMatches} of 6 match.`,
        );

        /* ---------------- historical index sparkline ---------------- */
        const sparkNode = root.querySelector<HTMLElement>("[data-gx-spark]");
        const renderSpark = () => {
            if (!sparkNode) return;
            const values: number[] = data.workbook.cache.historicalIndex;
            const width = Math.max(220, sparkNode.clientWidth);
            const height = 74;
            const min = Math.min(...values);
            const max = Math.max(...values);
            const px = (i: number) => 4 + (i / (values.length - 1)) * (width - 8);
            const py = (v: number) => 8 + (1 - (v - min) / (max - min)) * (height - 16);
            const spark = svg("svg", { width, height, viewBox: `0 0 ${width} ${height}`, "aria-hidden": "true", class: "gx-spark-svg" });
            const d = values.map((v, i) => `${i ? "L" : "M"}${px(i).toFixed(1)},${py(v).toFixed(1)}`).join("");
            svg("path", { d: `${d}L${px(values.length - 1)},${height}L${px(0)},${height}Z`, class: "gx-area is-orange" }, spark);
            svg("path", { d, class: "gx-line is-orange" }, spark);
            svg("circle", { cx: px(values.length - 1), cy: py(values[values.length - 1]), r: 3.5, class: "gx-dot is-orange" }, spark);
            sparkNode.replaceChildren(spark);
        };

        /* ---------------- boot ---------------- */
        renderExerciseList();
        let booted = false;
        const boot = () => {
            if (booted) return;
            booted = true;
            renderChart(true);
            renderLeaders("up");
            renderHeatmap();
            renderSpark();
            onWidthChange(chartNode, () => renderChart(false));
            onWidthChange(heatNode, renderHeatmap);
            if (sparkNode) onWidthChange(sparkNode, renderSpark);
        };
        // Render immediately (so the no-animation state is correct), animate on reveal.
        renderChart(false);
        renderLeaders("up");
        renderHeatmap();
        renderSpark();
        onReveal(chartNode, () => {
            booted = false;
            boot();
        }, 0.25);

        setUpCountUps(root);
        setUpBarGrowth(root.querySelector(".gx-module-list")!);
        root.classList.add("is-ready");
    });
</script>

<style>
    .gx {
        --gx-card: rgba(7, 21, 34, 0.88);
        --gx-border: #1d354a;
        --gx-blue: #168dff;
        --gx-blue-light: #65baff;
        --gx-orange: #ff8a00;
        --gx-green: #26d5a2;
        --gx-red: #ff6b6b;
        --gx-muted: #a9bbcc;
        --gx-subtle: #71869a;

        display: grid;
        gap: 1.25rem;
        width: 100%;
        min-width: 0;
    }

    .gx *,
    .gx *::before,
    .gx *::after {
        box-sizing: border-box;
    }

    .gx code {
        padding: 0.05em 0.35em;
        border-radius: 4px;
        background: rgba(22, 141, 255, 0.12);
        color: #cfe6ff;
        font-size: 0.88em;
        overflow-wrap: anywhere;
    }

    .gx-intro {
        max-width: 820px;
    }

    .gx-eyebrow,
    .gx-kicker {
        margin: 0 0 0.6rem;
        color: var(--gx-orange);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .gx-intro h2 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(2rem, 4.4vw, 3.4rem);
        line-height: 1.02;
    }

    .gx-intro > p:last-child {
        margin: 1rem 0 0;
        color: var(--gx-muted);
        line-height: 1.75;
    }

    /* ---------- KPIs ---------- */

    .gx-kpis {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .gx-kpis article,
    .gx-card {
        min-width: 0;
        border: 1px solid var(--gx-border);
        border-radius: 14px;
        background:
            linear-gradient(150deg, rgba(22, 141, 255, 0.07), transparent 55%),
            var(--gx-card);
    }

    .gx-kpis article {
        padding: 1.05rem;
    }

    .gx-kpis strong {
        display: block;
        color: #ffffff;
        font-size: clamp(1.35rem, 2.6vw, 1.9rem);
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .gx-kpis span {
        display: block;
        margin-top: 0.55rem;
        color: #9fb1c1;
        font-size: 0.74rem;
        line-height: 1.45;
    }

    /* ---------- cards ---------- */

    .gx-card {
        padding: clamp(1rem, 2.6vw, 1.6rem);
    }

    .gx-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem 1rem;
        margin-bottom: 1.1rem;
    }

    .gx-card-head h3 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(1.1rem, 2.2vw, 1.45rem);
        line-height: 1.25;
    }

    .gx-toggle {
        display: inline-flex;
        flex-wrap: nowrap;
        gap: 0.25rem;
        padding: 0.25rem;
        border: 1px solid #1f3b55;
        border-radius: 10px;
        background: #071626;
    }

    .gx-toggle button,
    .gx-days button,
    .gx :global(.gx-ex) {
        min-height: 36px;
        padding: 0.45rem 0.75rem;
        border: 1px solid transparent;
        border-radius: 7px;
        background: transparent;
        color: var(--gx-muted);
        font: inherit;
        font-size: 0.76rem;
        font-weight: 700;
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .gx-toggle button[aria-pressed="true"] {
        background: var(--gx-blue);
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(22, 141, 255, 0.28);
    }

    .gx-toggle button:hover:not([aria-pressed="true"]),
    .gx-days button:hover:not([aria-pressed="true"]),
    .gx :global(.gx-ex:hover:not([aria-pressed="true"])) {
        color: #ffffff;
        background: rgba(22, 141, 255, 0.1);
    }

    .gx :global(button:focus-visible),
    .gx-chart:focus-visible,
    .gx-check input:focus-visible,
    .gx summary:focus-visible {
        outline: 2px solid var(--gx-orange);
        outline-offset: 2px;
    }

    /* ---------- picker ---------- */

    .gx-picker {
        display: grid;
        gap: 0.7rem;
        margin-bottom: 1rem;
    }

    .gx-days {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .gx-days button {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border-color: #1f3b55;
        background: #08192a;
    }

    .gx-days button small,
    .gx :global(.gx-ex small) {
        color: var(--gx-subtle);
        font-size: 0.66rem;
        font-weight: 800;
    }

    .gx-days button[aria-pressed="true"] {
        border-color: var(--gx-orange);
        color: #ffffff;
        background: rgba(255, 138, 0, 0.12);
    }

    .gx-days button[aria-pressed="true"] small {
        color: var(--gx-orange);
    }

    .gx-exercise-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        min-height: 40px;
    }

    .gx :global(.gx-ex) {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        max-width: 100%;
        min-height: 32px;
        padding: 0.35rem 0.6rem;
        border-color: #183048;
        font-size: 0.72rem;
        font-weight: 650;
        text-align: left;
        animation: gx-pop 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .gx :global(.gx-ex[aria-pressed="true"]) {
        border-color: var(--gx-blue);
        color: #ffffff;
        background: rgba(22, 141, 255, 0.18);
    }

    @keyframes gx-pop {
        from {
            opacity: 0;
            transform: scale(0.94);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    /* ---------- chart ---------- */

    .gx-chart-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem 1rem;
        margin-bottom: 0.6rem;
    }

    .gx-check {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #c7d5e1;
        font-size: 0.76rem;
        cursor: pointer;
    }

    .gx-check input {
        width: 16px;
        height: 16px;
        accent-color: var(--gx-orange);
    }

    .gx-check.is-disabled {
        color: var(--gx-subtle);
        cursor: not-allowed;
    }

    .gx-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 0.9rem;
        margin: 0;
        padding: 0;
        color: var(--gx-subtle);
        font-size: 0.68rem;
        list-style: none;
    }

    .gx-legend li {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .gx-legend i {
        display: inline-block;
        width: 16px;
        height: 3px;
        border-radius: 2px;
    }

    .lg-line {
        background: var(--gx-blue-light);
    }

    .lg-trend {
        background: repeating-linear-gradient(90deg, var(--gx-orange) 0 4px, transparent 4px 7px);
    }

    .lg-band {
        height: 10px !important;
        background: rgba(101, 186, 255, 0.12);
        border: 1px dashed rgba(101, 186, 255, 0.35);
    }

    .gx-chart-wrap,
    .gx-heat-scroll {
        position: relative;
    }

    .gx-chart {
        position: relative;
        min-height: 250px;
        border-radius: 10px;
        background: linear-gradient(180deg, rgba(4, 13, 24, 0.6), rgba(4, 13, 24, 0.2));
        touch-action: pan-y;
    }

    .gx-chart :global(svg),
    .gx-heatmap :global(svg) {
        display: block;
        overflow: visible;
    }

    .gx :global(.gx-grid) {
        stroke: rgba(113, 134, 154, 0.18);
        stroke-width: 1;
    }

    .gx :global(.gx-axis) {
        fill: #7f95aa;
        font-size: 10.5px;
        font-family: inherit;
    }

    .gx :global(.gx-axis-note) {
        fill: #9fb1c1;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .gx :global(.gx-band) {
        fill: rgba(101, 186, 255, 0.06);
        stroke: rgba(101, 186, 255, 0.22);
        stroke-dasharray: 3 4;
    }

    .gx :global(.gx-hist-band) {
        fill: rgba(255, 138, 0, 0.05);
    }

    .gx :global(.gx-boundary) {
        stroke: rgba(255, 138, 0, 0.6);
        stroke-dasharray: 4 4;
    }

    .gx :global(.gx-area) {
        fill: url(#none);
        fill: rgba(22, 141, 255, 0.12);
    }

    .gx :global(.gx-area.is-hist) {
        fill: rgba(255, 138, 0, 0.08);
    }

    .gx :global(.gx-area.is-orange) {
        fill: rgba(255, 138, 0, 0.12);
    }

    .gx :global(.gx-line) {
        fill: none;
        stroke: var(--gx-blue-light);
        stroke-width: 2.4;
        stroke-linejoin: round;
        stroke-linecap: round;
    }

    .gx :global(.gx-line.is-hist) {
        stroke: #ffb35c;
        stroke-width: 1.8;
    }

    .gx :global(.gx-line.is-orange) {
        stroke: var(--gx-orange);
        stroke-width: 2;
    }

    .gx :global(.gx-trend) {
        stroke: var(--gx-orange);
        stroke-width: 1.6;
        stroke-dasharray: 5 5;
        opacity: 0.85;
    }

    .gx :global(.gx-dot) {
        fill: #06111e;
        stroke: var(--gx-blue-light);
        stroke-width: 2;
    }

    .gx :global(.gx-dot.is-hist) {
        stroke: #ffb35c;
    }

    .gx :global(.gx-dot.is-best) {
        fill: var(--gx-orange);
        stroke: #ffffff;
    }

    .gx :global(.gx-dot.is-orange) {
        fill: var(--gx-orange);
        stroke: none;
    }

    .gx :global(.gx-marker-line) {
        stroke: rgba(255, 255, 255, 0.28);
        stroke-dasharray: 2 3;
    }

    .gx :global(.gx-marker-dot) {
        fill: none;
        stroke: #ffffff;
        stroke-width: 2;
    }

    .gx-tooltip {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 5;
        display: grid;
        gap: 0.15rem;
        min-width: 150px;
        max-width: 230px;
        padding: 0.6rem 0.75rem;
        border: 1px solid #2b5277;
        border-radius: 9px;
        background: rgba(5, 16, 28, 0.96);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45);
        color: #c7d5e1;
        font-size: 0.72rem;
        line-height: 1.45;
        pointer-events: none;
    }

    .gx-tooltip[hidden] {
        display: none;
    }

    .gx-tooltip :global(strong) {
        color: #ffffff;
        font-size: 0.78rem;
    }

    .gx-tooltip :global(.gx-tip-note) {
        color: var(--gx-subtle);
        font-size: 0.66rem;
    }

    .gx-stats {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.5rem;
        margin: 1rem 0 0;
    }

    .gx-stats :global(div) {
        min-width: 0;
        padding: 0.7rem 0.75rem;
        border: 1px solid #172f45;
        border-radius: 9px;
        background: rgba(4, 14, 25, 0.6);
    }

    .gx-stats :global(dt) {
        color: var(--gx-subtle);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .gx-stats :global(dd) {
        margin: 0.3rem 0 0;
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 750;
        font-variant-numeric: tabular-nums;
    }

    .gx-stats :global(dd small) {
        color: var(--gx-subtle);
        font-size: 0.66rem;
        font-weight: 600;
    }

    .gx-stats :global(.is-up dd),
    .gx :global(strong.is-up),
    .gx-tally :global(.is-up strong) {
        color: var(--gx-green);
    }

    .gx-stats :global(.is-down dd),
    .gx :global(strong.is-down),
    .gx-tally :global(.is-down strong) {
        color: var(--gx-red);
    }

    .gx-summary {
        margin: 0.85rem 0 0;
        color: #b8c7d6;
        font-size: 0.8rem;
        line-height: 1.6;
    }

    .gx-footnote {
        margin: 0.9rem 0 0;
        padding-top: 0.85rem;
        border-top: 1px solid #142a3e;
        color: var(--gx-subtle);
        font-size: 0.72rem;
        line-height: 1.6;
    }

    .gx-footnote strong {
        color: #c7d5e1;
    }

    /* ---------- lower grid ---------- */

    .gx-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: 1.25rem;
    }

    .gx-tally {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .gx-tally :global(.gx-tally-item) {
        padding: 0.65rem;
        border: 1px solid #172f45;
        border-radius: 9px;
        background: rgba(4, 14, 25, 0.6);
        text-align: center;
    }

    .gx-tally :global(strong) {
        display: block;
        color: #ffffff;
        font-size: 1.35rem;
    }

    .gx-tally :global(span) {
        color: var(--gx-subtle);
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .gx-tally :global(.gx-tally-note) {
        grid-column: 1 / -1;
        margin: 0;
        color: var(--gx-subtle);
        font-size: 0.7rem;
    }

    .gx-leader-list {
        display: grid;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .gx-leader-list :global(.gx-leader) {
        display: grid;
        gap: 0.35rem;
        width: 100%;
        padding: 0.6rem 0.7rem;
        border: 1px solid transparent;
        border-radius: 9px;
        background: rgba(4, 14, 25, 0.5);
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition:
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .gx-leader-list :global(.gx-leader:hover) {
        border-color: #2b5277;
        transform: translateX(3px);
    }

    .gx-leader-list :global(.gx-leader-top) {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .gx-leader-list :global(.gx-leader-name) {
        min-width: 0;
        color: #e8eef5;
        font-size: 0.8rem;
        font-weight: 650;
    }

    .gx-leader-list :global(.gx-leader-name small) {
        margin-left: 0.4rem;
        color: var(--gx-subtle);
        font-size: 0.66rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .gx-leader-list :global(.gx-leader-top strong) {
        font-size: 0.85rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .gx-leader-list :global(.gx-leader-track) {
        height: 6px;
        overflow: hidden;
        border-radius: 999px;
        background: #0c2235;
    }

    .gx-leader-list :global(.gx-leader-track span) {
        display: block;
        width: calc(var(--w) * 100%);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #168dff, var(--gx-green));
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .gx-leader-list :global(.gx-leader-track span.is-down) {
        background: linear-gradient(90deg, #ff8a00, var(--gx-red));
    }

    .gx-leader-list:global(.bars-ready) :global(.gx-leader-track span) {
        transform: scaleX(1);
    }

    .gx-leader-list :global(.gx-leader-sub) {
        color: var(--gx-subtle);
        font-size: 0.68rem;
        font-variant-numeric: tabular-nums;
    }

    /* ---------- heatmap ---------- */

    .gx-heat-scroll {
        overflow-x: auto;
        overscroll-behavior-x: contain;
        padding-bottom: 0.25rem;
    }

    .gx-heatmap {
        min-width: 480px;
    }

    .gx :global(.gx-cell) {
        stroke: rgba(255, 255, 255, 0.04);
        transform-box: fill-box;
        transform-origin: center;
        transition: stroke 0.15s ease;
    }

    .gx :global(.gx-cell:hover) {
        stroke: #ffffff;
        stroke-width: 1.5;
    }

    .gx :global(.gx-cell.is-empty) {
        fill: rgba(255, 255, 255, 0.025);
        stroke: rgba(113, 134, 154, 0.12);
    }

    .gx:global(.is-ready) :global(.gx-cell) {
        animation: gx-cell-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        animation-delay: var(--d, 0ms);
    }

    @keyframes gx-cell-in {
        from {
            opacity: 0;
            transform: scale(0.4);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    .gx :global(.gx-heat-label) {
        font-weight: 700;
        fill: #b8c7d6;
    }

    .gx :global(.gx-bracket) {
        stroke: rgba(101, 186, 255, 0.4);
        stroke-dasharray: 3 3;
    }

    .gx :global(.gx-bracket.is-exact) {
        stroke: var(--gx-orange);
        stroke-dasharray: none;
        stroke-width: 2;
    }

    .gx-verify {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.75rem;
        align-items: start;
        margin-top: 1rem;
        padding: 0.85rem;
        border: 1px solid #1f3b55;
        border-radius: 10px;
        background: rgba(4, 14, 25, 0.6);
    }

    .gx-verify p {
        margin: 0;
        color: #a9bbcc;
        font-size: 0.74rem;
        line-height: 1.55;
    }

    .gx-verify p :global(strong) {
        color: #ffffff;
    }

    .gx-verify-badge {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(113, 134, 154, 0.2);
        color: #ffffff;
        font-weight: 800;
    }

    .gx-verify.is-ok {
        border-color: rgba(38, 213, 162, 0.45);
    }

    .gx-verify.is-ok .gx-verify-badge {
        background: var(--gx-green);
        color: #032116;
        box-shadow: 0 0 0 0 rgba(38, 213, 162, 0.5);
        animation: gx-pulse 2.4s ease-out 1s 2;
    }

    @keyframes gx-pulse {
        to {
            box-shadow: 0 0 0 14px rgba(38, 213, 162, 0);
        }
    }

    /* ---------- inside the workbook ---------- */

    .gx-inside-lead {
        max-width: 760px;
        margin: 0 0 1.2rem;
        color: var(--gx-muted);
        font-size: 0.85rem;
        line-height: 1.65;
    }

    .gx-inside-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .gx-inside-grid > section {
        min-width: 0;
        padding: 1rem;
        border: 1px solid #172f45;
        border-radius: 11px;
        background: rgba(4, 14, 25, 0.55);
    }

    .gx-inside-grid h4 {
        margin: 0 0 0.75rem;
        color: #ffffff;
        font-size: 0.9rem;
    }

    .gx-inside-grid p,
    .gx-chart-list,
    .gx-spark figcaption {
        margin: 0.75rem 0 0;
        color: #94a8ba;
        font-size: 0.74rem;
        line-height: 1.6;
    }

    .gx-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .gx-chip-list li {
        padding: 0.3rem 0.55rem;
        border: 1px solid #234560;
        border-radius: 999px;
        color: #c7d5e1;
        font-size: 0.7rem;
    }

    .gx-chart-list {
        margin-top: 0;
        padding-left: 1.1rem;
    }

    .gx-spark {
        margin: 0.75rem 0 0;
    }

    .gx-module-list {
        display: grid;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .gx-module-list li {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.25rem 0.75rem;
        align-items: center;
    }

    .gx-module-list li > div:first-child {
        min-width: 0;
        font-size: 0.74rem;
    }

    .gx-module-list strong {
        margin-right: 0.45rem;
        color: #ffffff;
    }

    .gx-module-list span {
        color: #94a8ba;
    }

    .gx-module-list small {
        color: var(--gx-subtle);
        font-size: 0.66rem;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .gx-module-bar {
        grid-column: 1 / -1;
        height: 5px;
        overflow: hidden;
        border-radius: 999px;
        background: #0c2235;
        order: 3;
    }

    .gx-module-bar span {
        display: block;
        width: calc(var(--w) * 100%);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #168dff, #65baff);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .gx-module-list:global(.bars-ready) .gx-module-bar span {
        transform: scaleX(1);
    }

    .gx-module-list li:nth-child(2) .gx-module-bar span { transition-delay: 0.06s; }
    .gx-module-list li:nth-child(3) .gx-module-bar span { transition-delay: 0.12s; }
    .gx-module-list li:nth-child(4) .gx-module-bar span { transition-delay: 0.18s; }
    .gx-module-list li:nth-child(5) .gx-module-bar span { transition-delay: 0.24s; }
    .gx-module-list li:nth-child(6) .gx-module-bar span { transition-delay: 0.3s; }
    .gx-module-list li:nth-child(7) .gx-module-bar span { transition-delay: 0.36s; }
