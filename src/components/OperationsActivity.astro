---
/* =========================================================
   OPERATIONS ACTIVITY — MONTHLY WORKLOAD CALENDAR

   A year × month heat calendar of the eBay export
   (April 2017 – May 2022) with a measure toggle and
   annual totals. Aggregated monthly data only.
   ========================================================= */

import data from "../data/rocketeers-ebay.json";

type Month = [string, number, number, number, number, number, number, number, number];

const months = data.monthly as Month[];
const years = [...new Set(months.map((row) => row[0].slice(0, 4)))];
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

const measures = [
    { key: "lines", label: "Sale lines", index: 1 },
    { key: "usd", label: "USD gross", index: 5 },
    { key: "active", label: "Active buyers", index: 3 },
    { key: "first", label: "New buyers", index: 4 },
];

const lookup = new Map(months.map((row) => [row[0], row]));
const busiest = months.reduce((top, row) => (row[1] > top[1] ? row : top), months[0]);
---

<div class="oa" data-ops-activity>
    <script type="application/json" data-oa-data set:html={JSON.stringify({ months })} />

    <div class="oa-head">
        <div>
            <p class="oa-kicker">Monthly workload · eBay export</p>
            <h3>Five years of orders, month by month</h3>
        </div>
        <div class="oa-toggle" role="group" aria-label="Calendar measure" data-oa-measure>
            {
                measures.map((measure, index) => (
                    <button type="button" data-value={measure.key} data-index={measure.index} aria-pressed={index === 0 ? "true" : "false"}>
                        {measure.label}
                    </button>
                ))
            }
        </div>
    </div>

    <div class="oa-scroll">
        <table class="oa-grid" data-oa-grid>
            <caption class="oa-sr">Monthly eBay activity, April 2017 to May 2022</caption>
            <thead>
                <tr>
                    <th scope="col"><span class="oa-sr">Year</span></th>
                    {MONTHS.map((month) => <th scope="col" abbr={month}><span class="oa-m-long">{month}</span><span class="oa-m-short" aria-hidden="true">{month[0]}</span></th>)}
                    <th scope="col" class="oa-total-head">Year</th>
                </tr>
            </thead>
            <tbody>
                {
                    years.map((year, r) => (
                        <tr>
                            <th scope="row">{year}</th>
                            {MONTHS.map((month, c) => {
                                const key = `${year}-${String(c + 1).padStart(2, "0")}`;
                                const row = lookup.get(key);
                                return row ? (
                                    <td>
                                        <button
                                            type="button"
                                            class="oa-cell"
                                            data-month={key}
                                            style={`--d: ${(r * 12 + c) * 14}ms`}
                                            aria-label={`${month} ${year}: ${row[1].toLocaleString("en-US")} sale lines`}
                                        >
                                            <span class="oa-sr">{row[1].toLocaleString("en-US")}</span>
                                        </button>
                                    </td>
                                ) : (
                                    <td class="oa-empty" aria-label="no data"></td>
                                );
                            })}
                            <td class="oa-total" data-oa-total={year}></td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>

    <div class="oa-foot">
        <div class="oa-scale" aria-hidden="true">
            <span>Low</span>
            <i></i>
            <span>High</span>
        </div>
        <p class="oa-readout" aria-live="polite" data-oa-readout>
            Busiest month: {MONTHS[Number(busiest[0].slice(5)) - 1]} {busiest[0].slice(0, 4)} —
            {` ${busiest[1].toLocaleString("en-US")}`} sale lines. Hover, tap or tab through any month.
        </p>
    </div>
</div>

<script>
    type Month = [string, number, number, number, number, number, number, number, number];
    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const LABELS: Record<string, string> = {
        "1": "sale lines",
        "5": "USD gross",
        "3": "active buyers",
        "4": "new buyers",
    };

    const mix = (t: number) => {
        // Deep navy → brand blue → light blue
        const stops = [
            [13, 42, 68],
            [22, 141, 255],
            [159, 214, 255],
        ];
        const x = Math.max(0, Math.min(1, t)) * 2;
        const i = Math.min(1, Math.floor(x));
        const f = x - i;
        const c = stops[i].map((v, k) => Math.round(v + (stops[i + 1][k] - v) * f));
        return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
    };

    document.querySelectorAll<HTMLElement>("[data-ops-activity]").forEach((root) => {
        const { months } = JSON.parse(root.querySelector("[data-oa-data]")?.textContent ?? "{}") as { months: Month[] };
        const byKey = new Map(months.map((row) => [row[0], row]));
        const readout = root.querySelector<HTMLElement>("[data-oa-readout]")!;
        let index = 1;

        const fmt = (value: number, i = index) =>
            i === 5
                ? new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value)
                : value.toLocaleString("en-US");

        const describe = (key: string) => {
            const row = byKey.get(key);
            if (!row) return "";
            const [year, month] = key.split("-");
            return `${MONTHS[Number(month) - 1]} ${year}: ${fmt(row[1], 1)} sale lines · ${fmt(row[5], 5)} USD gross · ${fmt(row[3], 3)} active buyers · ${fmt(row[4], 4)} new buyers.`;
        };

        const render = () => {
            const max = Math.max(...months.map((row) => row[index]));
            root.querySelectorAll<HTMLButtonElement>(".oa-cell").forEach((cell) => {
                const row = byKey.get(cell.dataset.month ?? "");
                if (!row) return;
                const t = (row[index] / max) ** 0.85;
                cell.style.background = mix(0.08 + t * 0.92);
                const [year, month] = row[0].split("-");
                cell.setAttribute("aria-label", `${MONTHS[Number(month) - 1]} ${year}: ${fmt(row[index])} ${LABELS[String(index)]}`);
                const sr = cell.querySelector("span");
                if (sr) sr.textContent = fmt(row[index]);
            });
            root.querySelectorAll<HTMLElement>("[data-oa-total]").forEach((cell) => {
                const year = cell.dataset.oaTotal;
                const rows = months.filter((row) => row[0].startsWith(`${year}-`));
                const total =
                    index === 3
                        ? Math.round(rows.reduce((sum, row) => sum + row[index], 0) / rows.length)
                        : rows.reduce((sum, row) => sum + row[index], 0);
                cell.textContent = index === 3 ? `${fmt(total)}/mo` : index === 5 ? `$${(total / 1000).toFixed(1)}K` : fmt(total);
                cell.title = index === 3 ? "Average active buyers per month" : `Total ${LABELS[String(index)]}`;
            });
        };

        root.querySelectorAll<HTMLButtonElement>("[data-oa-measure] button").forEach((button, i, all) => {
            button.addEventListener("click", () => {
                all.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
                index = Number(button.dataset.index);
                render();
            });
            button.addEventListener("keydown", (event) => {
                let next = -1;
                if (event.key === "ArrowRight") next = (i + 1) % all.length;
                if (event.key === "ArrowLeft") next = (i - 1 + all.length) % all.length;
                if (next < 0) return;
                event.preventDefault();
                all[next].click();
                all[next].focus();
            });
        });

        root.querySelectorAll<HTMLButtonElement>(".oa-cell").forEach((cell) => {
            const show = () => {
                root.querySelectorAll(".oa-cell.is-active").forEach((node) => node.classList.remove("is-active"));
                cell.classList.add("is-active");
                readout.textContent = describe(cell.dataset.month ?? "");
            };
            cell.addEventListener("mouseenter", show);
            cell.addEventListener("focus", show);
            cell.addEventListener("click", show);
        });

        render();

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !("IntersectionObserver" in window)) {
            root.classList.add("is-in");
            return;
        }
        const observer = new IntersectionObserver(
            (entries) => {
                if (!entries.some((entry) => entry.isIntersecting)) return;
                observer.disconnect();
                root.classList.add("is-in");
            },
            { threshold: 0.2 },
        );
        observer.observe(root);
    });
</script>

<style>
    .oa {
        box-sizing: border-box;
        width: 100%;
        max-width: 1100px;
        min-width: 0;
        margin: 0 auto;
        padding: clamp(1rem, 2.8vw, 1.6rem);
        border: 1px solid #1d354a;
        border-radius: 14px;
        background:
            linear-gradient(150deg, rgba(22, 141, 255, 0.08), transparent 55%),
            rgba(7, 21, 34, 0.9);
    }

    .oa *,
    .oa *::before,
    .oa *::after {
        box-sizing: border-box;
    }

    .oa-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem 1rem;
        margin-bottom: 1.25rem;
    }

    .oa-kicker {
        margin: 0 0 0.45rem;
        color: #ff8a00;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .oa-head h3 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    }

    .oa-toggle {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        padding: 0.25rem;
        border: 1px solid #1f3b55;
        border-radius: 10px;
        background: #071626;
    }

    .oa-toggle button {
        min-height: 36px;
        padding: 0.45rem 0.7rem;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: #a9bbcc;
        font: inherit;
        font-size: 0.74rem;
        font-weight: 700;
        cursor: pointer;
    }

    .oa-toggle button[aria-pressed="true"] {
        background: #168dff;
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(22, 141, 255, 0.28);
    }

    .oa-toggle button:focus-visible,
    .oa-cell:focus-visible {
        outline: 2px solid #ff8a00;
        outline-offset: 2px;
    }

    .oa-scroll {
        position: relative;
        overflow-x: auto;
        overscroll-behavior-x: contain;
    }

    .oa-grid {
        width: 100%;
        min-width: 560px;
        border-collapse: separate;
        border-spacing: 4px;
        table-layout: fixed;
    }

    .oa-grid th {
        color: #71869a;
        font-size: 0.68rem;
        font-weight: 700;
        text-align: center;
    }

    .oa-grid thead th:first-child {
        width: 3rem;
    }

    .oa-grid tbody th {
        color: #ffffff;
        font-size: 0.78rem;
        text-align: left;
    }

    .oa-grid td {
        height: 38px;
        padding: 0;
    }

    .oa-total-head,
    .oa-total {
        width: 4.6rem;
    }

    .oa-total {
        padding-left: 0.4rem !important;
        color: #c7d5e1;
        font-size: 0.74rem;
        font-weight: 750;
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .oa-cell {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 6px;
        background: #0d2a44;
        cursor: pointer;
        opacity: 0;
        transform: scale(0.5);
        transition:
            background-color 0.45s ease,
            opacity 0.4s ease,
            transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
            box-shadow 0.2s ease;
        transition-delay: 0s, var(--d), var(--d), 0s;
    }

    .oa.is-in .oa-cell {
        opacity: 1;
        transform: none;
    }

    .oa-cell:hover,
    .oa-cell.is-active {
        box-shadow: 0 0 0 2px #ffffff;
    }

    .oa-empty {
        background: repeating-linear-gradient(135deg, rgba(113, 134, 154, 0.1) 0 4px, transparent 4px 9px);
        border-radius: 6px;
    }

    .oa-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.5rem;
        margin-top: 1rem;
    }

    .oa-scale {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #71869a;
        font-size: 0.68rem;
    }

    .oa-scale i {
        width: 90px;
        height: 8px;
        border-radius: 999px;
        background: linear-gradient(90deg, rgb(13, 42, 68), rgb(22, 141, 255), rgb(159, 214, 255));
    }

    .oa-readout {
        flex: 1 1 260px;
        margin: 0;
        color: #b8c7d6;
        font-size: 0.8rem;
        line-height: 1.55;
    }

    .oa-m-short {
        display: none;
    }

    .oa-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }

    @media (max-width: 560px) {
        .oa-head {
            display: grid;
        }

        .oa-grid {
            min-width: 0;
            border-spacing: 2px;
        }

        .oa-grid thead th:first-child {
            width: 2.3rem;
        }

        .oa-grid th {
            font-size: 0.62rem;
        }

        .oa-m-long {
            display: none;
        }

        .oa-m-short {
            display: inline;
        }

        .oa-grid tbody th {
            font-size: 0.68rem;
        }

        .oa-grid td {
            height: 30px;
        }

        .oa-total-head,
        .oa-total {
            width: 3.3rem;
        }

        .oa-total {
            font-size: 0.62rem;
        }

        .oa-cell {
            border-radius: 4px;
        }

        .oa-toggle {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .oa-cell {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>
