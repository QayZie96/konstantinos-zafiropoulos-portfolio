---
/* =========================================================
   PAGE METADATA
   ========================================================= */

const title = "Konstantinos Zafiropoulos | Operations, Automation, Data & Web";

const description =
    "Portfolio of Konstantinos Zafiropoulos — marketplace operations, automation, data analysis, web development, and practical systems.";
---

<html lang="en">
    <!-- =====================================================
         HEAD / SEO
         ===================================================== -->

    <head>
        <meta charset="utf-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta name="description" content={description} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>{title}</title>
    </head>

    <body>
        <main>
            <!-- =================================================
                 PRIMARY NAVIGATION
                 ================================================= -->

            <nav aria-label="Primary navigation">
                <a class="wordmark" href="/" aria-label="Homepage">
                    KZ<span>.</span>
                </a>

                <div class="nav-links">
                    <a href="#projects">Projects</a>
                    <a href="#about">About</a>
                    <a href="#contact">Contact</a>
                </div>
            </nav>

            <!-- =================================================
                 HERO
                 ================================================= -->

            <section class="hero" aria-labelledby="intro-title">
                <div class="hero-copy">
                    <p class="eyebrow">Hello, I'm Konstantinos</p>

                    <h1 id="intro-title">
                        I build practical systems with{" "}
                        <span class="hero-accent">data, automation,</span>{" "}
                        and the web.
                    </h1>

                    <p class="intro">
                        A portfolio of real projects spanning marketplace
                        operations, Excel/VBA, web development, analytics, and
                        practical AI implementation.
                    </p>

                    <div class="hero-actions">
                        <a class="button button-primary" href="#projects">
                            View my projects
                            <span aria-hidden="true">→</span>
                        </a>

                        <a class="button button-secondary" href="#about">
                            About me
                        </a>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 PROJECTS
                 ================================================= -->

            <section
                id="projects"
                class="section projects"
                aria-labelledby="projects-title"
            >
                <!-- =============================================
                     PROJECTS INTRODUCTION
                     ============================================= -->

                <div class="section-heading">
                    <p class="eyebrow">01 — Projects</p>

                    <h2 id="projects-title">Featured Projects</h2>

                    <p class="section-intro">
                        Real projects, real operating experience, and practical
                        systems built around actual problems.
                    </p>
                </div>

                <!-- =============================================
                     ROCKETEERS UMBRELLA
                     ============================================= -->

                <section
                    class="rocketeers-feature"
                    aria-labelledby="rocketeers-title"
                >
                    <!-- =========================================
                         ROCKETEERS OVERVIEW
                         ========================================= -->

                    <div class="rocketeers-hero">
                        <div class="rocketeers-copy">
                            <p class="featured-label">
                                Featured project · 2017–2024
                            </p>

                            <!--
                                The title leads to the Rocketeers
                                umbrella/overview page.
                            -->

                            <a
                                class="rocketeers-title-link"
                                href="/projects/rocketeers/"
                            >
                                <h3 id="rocketeers-title">
                                    Rocketeers
                                    <span aria-hidden="true">↗</span>
                                </h3>
                            </a>

                            <p class="rocketeers-tagline">
                                A real marketplace business and the systems
                                behind it.
                            </p>

                            <p class="rocketeers-description">
                                I founded and operated Rocketeers, a digital
                                marketplace business focused on Rocket League
                                items. The project combined business planning,
                                marketplace execution, pricing, inventory,
                                customer operations, automation, analytics, and
                                commercial decision-making.
                            </p>

                            <p class="rocketeers-description">
                                Explore the business itself and the operational
                                systems I built to help manage and scale it.
                            </p>

                            <!--
                                Main Rocketeers overview button.
                                Orange makes this distinct from the
                                individual project links below.
                            -->

                            <a
                                class="button button-primary rocketeers-overview-button"
                                href="/projects/rocketeers/"
                            >
                                Explore the Rocketeers project hub
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>

                        <!--
                            The entire visual panel is clickable and
                            leads to the Rocketeers overview.

                            This is a temporary visual until genuine
                            Rocketeers imagery is added.
                        -->

                        <a
                            class="rocketeers-visual rocketeers-visual-link"
                            href="/projects/rocketeers/"
                            aria-label="Explore the Rocketeers project hub"
                        >
                            <span class="visual-label"> The Rocketeers </span>

                            <div class="visual-center">
                                <strong>23K+</strong>
                                <span>items sold</span>
                            </div>

                            <span class="visual-footer">
                                Business · Marketplace · Systems
                            </span>

                            <span
                                class="visual-link-indicator"
                                aria-hidden="true"
                            >
                                Explore project hub ↗
                            </span>
                        </a>
                    </div>

                    <!-- =========================================
                         THREE ROCKETEERS PROJECTS
                         ========================================= -->

                    <div class="rocketeers-grid">
                        <!-- =====================================
                             01 — BUSINESS & MARKETPLACE OPERATIONS
                             ===================================== -->

                        <a
                            class="rocketeers-card card-business"
                            href="/projects/rocketeers/business-operations/"
                            aria-label="View the Business and Marketplace Operations case study"
                        >
                            <div class="card-top">
                                <span class="card-number orange"> 01 </span>

                                <span
                                    class="card-symbol orange"
                                    aria-hidden="true"
                                >
                                    ◫
                                </span>
                            </div>

                            <h4>
                                Business & Marketplace Operations
                                <span
                                    class="inline-arrow orange"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </h4>

                            <p>
                                How Rocketeers was planned, launched, operated,
                                and scaled — covering marketplace strategy,
                                sourcing, listings, pricing, inventory,
                                fulfilment, customer experience, disputes, and
                                seller performance.
                            </p>

                            <div class="metrics">
                                <div>
                                    <strong>23K+</strong>
                                    <span>items sold</span>
                                </div>

                                <div>
                                    <strong>6,455</strong>
                                    <span>feedback entries</span>
                                </div>

                                <div>
                                    <strong>807</strong>
                                    <span>followers</span>
                                </div>
                            </div>

                            <div class="view-link">View case study ↗</div>
                        </a>

                        <!-- =====================================
                             02 — MARKETPLACE REPRICING ENGINE
                             ===================================== -->

                        <a
                            class="rocketeers-card card-repricing"
                            href="/projects/rocketeers/repricing/"
                            aria-label="View the Marketplace Repricing Engine case study"
                        >
                            <div class="card-top">
                                <span class="card-number blue"> 02 </span>

                                <span
                                    class="card-symbol blue"
                                    aria-hidden="true"
                                >
                                    ⚙
                                </span>
                            </div>

                            <h4>
                                Marketplace Repricing Engine
                                <span
                                    class="inline-arrow blue"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </h4>

                            <p>
                                An Excel-based pricing system built to manage
                                1,000+ live listings and 10,000+ priced
                                variations using imported market data,
                                structured pricing logic, and bulk-update
                                workflows.
                            </p>

                            <div class="tags">
                                <span>Excel</span>
                                <span>Pricing Logic</span>
                                <span>Process Scaling</span>
                            </div>

                            <div class="view-link">View case study ↗</div>
                        </a>

                        <!-- =====================================
                             03 — FINANCIAL & OPERATIONS TRACKER
                             ===================================== -->

                        <a
                            class="rocketeers-card card-finance"
                            href="/projects/rocketeers/financial-tracker/"
                            aria-label="View the Financial and Operations Tracker case study"
                        >
                            <div class="card-top">
                                <span class="card-number green"> 03 </span>

                                <span
                                    class="card-symbol green"
                                    aria-hidden="true"
                                >
                                    ↗
                                </span>
                            </div>

                            <h4>
                                Financial & Operations Tracker
                                <span
                                    class="inline-arrow green"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </h4>

                            <p>
                                A multi-sheet Excel tracker covering turnover,
                                orders, inventory, trading activity, fees,
                                cancellations, and approximate profitability
                                across the growing operation.
                            </p>

                            <!--
                                Financial totals are intentionally not
                                displayed here until the newer workbook
                                has been reconciled and verified.
                            -->

                            <div class="tags">
                                <span>Excel</span>
                                <span>Commercial Analytics</span>
                                <span>Operational Reporting</span>
                            </div>

                            <div class="view-link">View case study ↗</div>
                        </a>
                    </div>
                </section>

                <!-- =============================================
                     OTHER PROJECTS
                     ============================================= -->

                <section
                    class="other-projects"
                    aria-labelledby="other-projects-title"
                >
                    <div class="other-projects-heading">
                        <p class="eyebrow">Other projects</p>

                        <h3 id="other-projects-title">
                            Different problems. The same mindset.
                        </h3>

                        <p>Web development, data, AI, and automation.</p>
                    </div>

                    <div class="other-project-grid">
                        <!-- =====================================
                             RAME
                             ===================================== -->

                        <article class="other-project-card">
                            <div class="project-visual rame-visual">
                                <span>RAME</span>
                            </div>

                            <div class="other-project-body">
                                <h4>Rame</h4>

                                <p>
                                    A real e-commerce business website currently
                                    being developed for an active commercial
                                    project, covering frontend design, site
                                    structure, deployment, and practical web
                                    development.
                                </p>

                                <div class="tags">
                                    <span>E-commerce</span>
                                    <span>Web Development</span>
                                    <span>Frontend</span>
                                </div>

                                <div class="card-status">Coming Soon</div>
                            </div>
                        </article>

                        <!-- =====================================
                             DATA ANALYSIS PROJECT
                             ===================================== -->

                        <article class="other-project-card">
                            <div class="project-visual data-visual">
                                <div class="bar-chart" aria-hidden="true">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            </div>

                            <div class="other-project-body">
                                <h4>Data Analysis Project</h4>

                                <p>
                                    A focused analytics project using SQL,
                                    Python, and Power BI to investigate
                                    real-world data and communicate meaningful
                                    findings.
                                </p>

                                <div class="tags">
                                    <span>SQL</span>
                                    <span>Python</span>
                                    <span>Power BI</span>
                                </div>

                                <div class="card-status">Coming Soon</div>
                            </div>
                        </article>

                        <!-- =====================================
                             AI JOB DISCOVERY & OUTREACH AUTOMATION
                             ===================================== -->

                        <a
                            class="other-project-card project-link"
                            href="/projects/ai-job-outreach/"
                            aria-label="View the AI Job Discovery and Outreach Automation case study"
                        >
                            <div class="project-visual ai-visual">
                                <div class="ai-circle" aria-hidden="true">
                                    AI
                                </div>
                            </div>

                            <div class="other-project-body">
                                <h4>
                                    AI Job Discovery & Outreach Automation
                                    <span
                                        class="inline-arrow blue"
                                        aria-hidden="true"
                                    >
                                        →
                                    </span>
                                </h4>

                                <p>
                                    A Python automation that discovers job
                                    vacancies across three APIs, uses Google
                                    Gemini to evaluate suitability and generate
                                    personalized outreach drafts, and organizes
                                    qualifying results in Google Sheets.
                                </p>

                                <div class="tags">
                                    <span>Python</span>
                                    <span>Gemini</span>
                                    <span>APIs</span>
                                    <span>Automation</span>
                                </div>

                                <div class="view-link">View case study ↗</div>
                            </div>
                        </a>

                        <!-- =====================================
                             GYM PROGRESS SYSTEM
                             ===================================== -->

                        <a
                            class="other-project-card project-link"
                            href="/projects/gym-progress/"
                            aria-label="View the Gym Progress System case study"
                        >
                            <div class="project-visual gym-visual">
                                <span aria-hidden="true"> KG </span>
                            </div>

                            <div class="other-project-body">
                                <h4>
                                    Gym Progress System
                                    <span
                                        class="inline-arrow blue"
                                        aria-hidden="true"
                                    >
                                        →
                                    </span>
                                </h4>

                                <p>
                                    An Excel/VBA analytics system for tracking
                                    workouts, progression, historical data,
                                    diagnostics, and performance trends.
                                </p>

                                <div class="tags">
                                    <span>Excel</span>
                                    <span>VBA</span>
                                    <span>Analytics</span>
                                </div>

                                <div class="view-link">View case study ↗</div>
                            </div>
                        </a>
                    </div>
                </section>
            </section>

            <!-- =================================================
                 ABOUT ME
                 ================================================= -->

            <section
                id="about"
                class="section about"
                aria-labelledby="about-title"
            >
                <p class="eyebrow">02 — About Me</p>

                <h2 id="about-title">
                    From running a business to building better systems.
                </h2>

                <p class="section-lead">
                    I'm Konstantinos, an operations-focused professional with a
                    background in e-commerce, marketplace management, data,
                    automation, and practical technology.
                </p>

                <p>
                    From 2017 to 2024, I founded and operated Rocketeers, a
                    digital marketplace business that sold more than 23,000
                    items. Running the business gave me hands-on experience
                    across sourcing, pricing, inventory, order management,
                    customer experience, and commercial decision-making.
                </p>

                <p>
                    As the operation grew, I became increasingly interested in
                    solving the problems behind the work itself. I developed
                    Excel-based systems to streamline repricing, organize
                    inventory, and track business performance. That same
                    interest has since expanded into Python, AI-assisted
                    workflows, data analysis, and web development.
                </p>

                <p>
                    I enjoy combining an understanding of real operational
                    problems with the technical tools needed to solve them.
                    Whether I'm working with spreadsheets, code, data, or
                    marketplace systems, my goal is to make processes clearer,
                    more reliable, and easier to scale.
                </p>

                <!-- Professional focus areas -->
                <div class="about-highlights">
                    <span>Marketplace & Business Operations</span>
                    <span>Excel / VBA</span>
                    <span>Python & AI Automation</span>
                    <span>Data Analysis</span>
                    <span>Web Development</span>
                </div>
            </section>

            <!-- =================================================
                 CONTACT
                 ================================================= -->

            <section
                id="contact"
                class="section contact"
                aria-labelledby="contact-title"
            >
                <p class="eyebrow">03 — Contact</p>

                <h2 id="contact-title">Let’s connect.</h2>

                <p class="section-lead">
                    Open to operations, marketplace, analyst, implementation,
                    automation, and technical-operations opportunities.
                </p>

                <p>
                    If you’d like to discuss a role, a project, or my work, feel
                    free to reach out.
                </p>

                <!-- Contact links -->
                <div class="contact-links">
                    <a class="text-link" href="mailto:kwstaszaf@hotmail.com">
                        Email me
                        <span aria-hidden="true">↗</span>
                    </a>

                    <a
                        class="text-link"
                        href="https://www.linkedin.com/in/konstantinos-zafeiropoulos-18011996/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        LinkedIn
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </section>
        </main>

        <!-- ===================================================
             FOOTER
             =================================================== -->

        <footer>
            <div class="footer-left">
                <strong>KZ</strong>

                <div>
                    <span> Konstantinos Zafiropoulos </span>

                    <small> Operations · Automation · Data · Web </small>
                </div>
            </div>

            <div class="footer-right">
                Built with Astro · Git/GitHub · VS Code · Netlify
            </div>
        </footer>
    </body>
</html>

<style>
    /* =========================================================
       DESIGN TOKENS
       ========================================================= */

    :root {
        --bg: #050d18;
        --bg-card: #071522;
        --bg-card-soft: #0a1928;

        --text: #e8eef5;
        --heading: #ffffff;

        --muted: #a9bbcc;
        --subtle: #71869a;

        --border: #1d354a;

        --blue: #168dff;
        --blue-light: #65baff;

        --orange: #ff8a00;
        --green: #26d5a2;

        --page-width: 1380px;

        color: var(--text);
        background: var(--bg);

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    /* =========================================================
       GLOBAL RESET / BASICS
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;
        margin: 0;

        color: var(--text);

        background:
            radial-gradient(
                circle at top right,
                rgba(22, 141, 255, 0.08),
                transparent 38rem
            ),
            var(--bg);
    }

    main,
    footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;

        padding-left: clamp(1.5rem, 5vw, 5rem);
        padding-right: clamp(1.5rem, 5vw, 5rem);
    }

    a {
        color: inherit;
    }

    a:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
    }

    ::selection {
        color: white;
        background: rgba(255, 138, 0, 0.65);
    }

    /* =========================================================
       TYPOGRAPHY
       ========================================================= */

    h1,
    h2,
    h3,
    h4,
    p {
        margin-top: 0;
    }

    h1,
    h2,
    h3 {
        color: var(--heading);
        letter-spacing: -0.04em;
    }

    h1 {
        max-width: 900px;
        margin-bottom: 1.6rem;

        font-size: clamp(3.2rem, 7vw, 6.2rem);
        line-height: 1.02;
    }

    h2 {
        margin-bottom: 0.8rem;
        font-size: clamp(2.4rem, 4.5vw, 4rem);
        line-height: 1.08;
    }

    h3 {
        font-size: clamp(2rem, 3vw, 2.8rem);
        line-height: 1.1;
    }

    h4 {
        margin-bottom: 0.8rem;
        color: var(--heading);
        font-size: 1.2rem;
        line-height: 1.3;
    }

    .eyebrow,
    .featured-label {
        margin-bottom: 1rem;

        color: var(--orange);

        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    /* =========================================================
       NAVIGATION
       ========================================================= */

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 74px;

        border-bottom: 1px solid rgba(29, 53, 74, 0.65);
    }

    .wordmark {
        color: white;
        font-size: 1.4rem;
        font-weight: 850;
        letter-spacing: -0.08em;
        text-decoration: none;
    }

    .wordmark span {
        color: var(--orange);
    }

    .nav-links {
        display: flex;
        gap: clamp(1rem, 3vw, 2.8rem);
    }

    .nav-links a {
        position: relative;
        color: var(--muted);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -0.35rem;

        width: 0;
        height: 1px;

        background: var(--blue);
        transition: width 0.2s ease;
    }

    .nav-links a:hover {
        color: white;
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    /* =========================================================
       HERO — CENTERED LAYOUT
       ========================================================= */

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
        align-items: center;

        min-height: auto;
        padding: clamp(5rem, 10vw, 8rem) 0;

        text-align: center;
    }

    .hero-copy {
        width: 100%;
        max-width: 980px;
    }

    .hero h1,
    .hero .intro {
        margin-inline: auto;
    }

    .hero-accent {
        color: var(--blue);
    }

    .intro {
        max-width: 700px;
        color: var(--muted);

        font-size: clamp(1.02rem, 1.6vw, 1.25rem);
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;

        gap: 0.8rem;
        margin-top: 2rem;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 0.55rem;
        min-height: 48px;
        padding: 0.85rem 1.3rem;

        border: 1px solid var(--blue);
        border-radius: 8px;

        font-size: 0.87rem;
        font-weight: 750;
        text-decoration: none;

        transition:
            transform 0.2s ease,
            background 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .button:hover {
        transform: translateY(-2px);
    }

    .button-primary {
        color: white;
        background: var(--blue);

        box-shadow: 0 10px 30px rgba(22, 141, 255, 0.14);
    }

    .button-primary:hover {
        background: #2397ff;

        box-shadow: 0 14px 34px rgba(22, 141, 255, 0.2);
    }

    .button-secondary {
        color: #dbe7f0;
        background: rgba(7, 21, 34, 0.75);
    }

    .button-secondary:hover {
        border-color: var(--blue-light);
    }

    /* =========================================================
       GENERAL SECTIONS
       ========================================================= */

    .section {
        padding: clamp(5rem, 9vw, 8rem) 0;
        border-top: 1px solid var(--border);

        scroll-margin-top: 2rem;
    }

    .section-heading {
        max-width: 850px;
        margin-inline: auto;
        text-align: center;
    }

    .section-intro {
        max-width: 680px;
        margin-inline: auto;

        color: var(--muted);
        font-size: 1rem;
        line-height: 1.6;
    }

    .section-lead {
        max-width: 760px;
        margin-bottom: 1rem;

        color: #dbe5ee;
        font-size: 1.08rem;
        font-weight: 500;
        line-height: 1.65;
    }

    /* =========================================================
       ROCKETEERS UMBRELLA
       ========================================================= */

    .rocketeers-feature {
        margin-top: 3rem;
        padding: clamp(1.3rem, 2.5vw, 2rem);

        border: 1px solid #1f5685;
        border-radius: 16px;

        background:
            radial-gradient(
                circle at 85% 10%,
                rgba(22, 141, 255, 0.15),
                transparent 34rem
            ),
            linear-gradient(135deg, #071624, #050e18);

        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
    }

    /* =========================================================
       ROCKETEERS HEADER — CENTERED
       ========================================================= */

    .rocketeers-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
        gap: 1.5rem;

        margin-bottom: 1.4rem;
    }

    .rocketeers-copy {
        width: 100%;
        max-width: 880px;
        padding: clamp(0.7rem, 2vw, 1.3rem);
