---
/* =========================================================
   PAGE METADATA
   ========================================================= */

import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import SkillLinks from "../components/SkillLinks.astro";
import SkillTagList from "../components/SkillTagList.astro";

const title =
    "Konstantinos Zafeiropoulos | Marketplace Operations, Automation, Data & Web";

const toolbelt = [
    "Excel & VBA",
    "Python",
    "SQL",
    "PostgreSQL",
    "n8n",
    "Google Apps Script",
    "Power BI",
    "DuckDB",
    "WooCommerce",
    "WordPress",
    "Gemini API",
    "Astro",
    "Git & GitHub",
];

// Decorative card art for the maths lab (computed at build time).
const mathOrbitPath = Array.from({ length: 361 }, (_, i) => {
    const t = (i / 360) * Math.PI * 2;
    const x = 100 + 82 * Math.sin(3 * t + Math.PI / 2);
    const y = 60 + 46 * Math.sin(4 * t);
    return `${i === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`;
}).join(" ");

const mandalaPetals = Array.from({ length: 12 }, (_, i) => i * 30);

const description =
    "Portfolio of Konstantinos Zafeiropoulos: marketplace and e-commerce operations, pricing systems, Excel/VBA, data analysis, and process automation.";
---

<html lang="en">
    <!-- =====================================================
         HEAD / SEO
         ===================================================== -->

    <head>
        <SeoHead {title} {description} />
    </head>

    <body>
        <main>
            <!-- =================================================
                 PRIMARY NAVIGATION
                 ================================================= -->

            <SiteHeader />

            <!-- =================================================
                 HERO
                 ================================================= -->

            <section class="hero" aria-labelledby="intro-title">
                <div class="hero-copy">
                    <p class="eyebrow">Hello, I'm Konstantinos</p>

                    <p class="hero-role">Operations systems · Automation · Data</p>

                    <h1 id="intro-title">
                        I combine <span class="hero-accent">marketplace experience</span>{" "}
                        with data, automation, and the web.
                    </h1>

                    <p class="intro">
                        Seven years of marketplace ownership, supported by real
                        projects in Excel/VBA, AI workflow implementation, data
                        analysis, and web development.
                    </p>

                    <ul class="proof-strip" aria-label="Career highlights">
                        <li><strong>7 years</strong><span>operating Rocketeers</span></li>
                        <li><strong>23K+</strong><span>marketplace items sold</span></li>
                        <li><strong>$219.8K</strong><span>documented eBay USD sales</span></li>
                    </ul>

                    <div class="hero-actions">
                        <a class="button button-primary" href="#projects">
                            View my projects
                            <span aria-hidden="true">→</span>
                        </a>

                        <a class="button button-secondary" href="#about">
                            About me
                        </a>
                    </div>
                </div>
            </section>

            <div class="toolbelt" aria-label="Tools I work with">
                <ul class="toolbelt-track">
                    {toolbelt.map((tool) => <li>{tool}</li>)}
                </ul>
                <ul class="toolbelt-track" aria-hidden="true">
                    {toolbelt.map((tool) => <li>{tool}</li>)}
                </ul>
            </div>

            <!-- =================================================
                 PROJECTS
                 ================================================= -->

            <section
                id="projects"
                class="section projects"
                aria-labelledby="projects-title"
            >
                <!-- =============================================
                     PROJECTS INTRODUCTION
                     ============================================= -->

                <div class="section-heading">
                    <p class="eyebrow">01 — Projects</p>

                    <h2 id="projects-title">Featured Projects</h2>

                    <p class="section-intro">
                        A marketplace business I ran for seven years, and the
                        systems I have built since.
                    </p>
                </div>

                <!-- =============================================
                     ROCKETEERS UMBRELLA
                     ============================================= -->

                <section
                    class="rocketeers-feature"
                    aria-labelledby="rocketeers-title"
                >
                    <!-- =========================================
                         ROCKETEERS OVERVIEW
                         ========================================= -->

                    <div class="rocketeers-hero">
                        <div class="rocketeers-copy">
                            <p class="featured-label">
                                Featured project · 2017–2024
                            </p>

                            <!--
                                The title leads to the Rocketeers
                                umbrella/overview page.
                            -->

                            <a
                                class="rocketeers-title-link"
                                href="/projects/rocketeers/"
                            >
                                <h3 id="rocketeers-title">
                                    Rocketeers
                                    <span aria-hidden="true">↗</span>
                                </h3>
                            </a>

                            <p class="rocketeers-tagline">
                                A real marketplace business and the systems
                                behind it.
                            </p>

                            <p class="rocketeers-description">
                                I founded and operated Rocketeers, a digital
                                marketplace business focused on Rocket League
                                items. The project combined business planning,
                                marketplace execution, pricing, inventory,
                                customer operations, automation, analytics, and
                                commercial decision-making.
                            </p>

                            <p class="rocketeers-description">
                                Explore the business itself and the operational
                                systems I built to help manage and scale it.
                            </p>

                            <!--
                                Main Rocketeers overview button.
                                Orange makes this distinct from the
                                individual project links below.
                            -->

                            <a
                                class="button button-primary rocketeers-overview-button"
                                href="/projects/rocketeers/"
                            >
                                Explore the Rocketeers project hub
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>

                        <!-- The entire visual panel links to the Rocketeers overview. -->

                        <a
                            class="rocketeers-visual rocketeers-visual-link"
                            href="/projects/rocketeers/"
                            aria-label="Explore the Rocketeers project hub"
                        >
                            <span class="visual-label"> The Rocketeers </span>

                            <div class="visual-center">
                                <strong>23K+</strong>
                                <span>items sold</span>
                            </div>

                            <span class="visual-footer">
                                Business · Marketplace · Systems
                            </span>

                            <span
                                class="visual-link-indicator"
                                aria-hidden="true"
                            >
                                Explore project hub ↗
                            </span>
                        </a>
                    </div>

                    <!-- =========================================
                         THREE ROCKETEERS PROJECTS
                         ========================================= -->

                    <div class="rocketeers-grid">
                        <!-- =====================================
                             01 — BUSINESS & MARKETPLACE OPERATIONS
                             ===================================== -->

                        <a
                            class="rocketeers-card card-business"
