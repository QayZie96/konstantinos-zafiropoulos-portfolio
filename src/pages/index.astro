        color: var(--orange);
    }

    .card-finance .view-link {
        color: var(--green);
    }

    /* =========================================================
       OTHER PROJECTS — CENTERED HEADING
       ========================================================= */

    .other-projects {
        margin-top: clamp(4.5rem, 8vw, 7rem);
    }

    .other-projects-heading {
        display: flex;
        flex-direction: column;
        align-items: center;

        gap: 0.75rem;
        margin-bottom: 2rem;

        text-align: center;
    }

    .other-projects-heading h3 {
        margin-bottom: 0;
    }

    .other-projects-heading > p:last-child {
        max-width: 500px;
        margin-bottom: 0;

        color: var(--subtle);
        font-size: 0.84rem;
        line-height: 1.5;
    }

    .currently-building {
        margin-top: clamp(4.5rem, 8vw, 7rem);
        padding-top: clamp(3rem, 6vw, 5rem);
        border-top: 1px solid var(--border);
    }

    .currently-building-heading {
        max-width: 620px;
        margin-bottom: 2rem;
    }

    .currently-building-heading h3 {
        margin-bottom: 0.75rem;
    }

    .currently-building-heading > p:last-child {
        margin-bottom: 0;
        color: var(--subtle);
        line-height: 1.6;
    }

    .currently-building-grid {
        display: grid;
        grid-template-columns: minmax(0, 360px);
        gap: 1rem;
    }
    .other-project-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 1rem;
    }

    /* Automation work leads as two wide cards; the rest sit three across. */
    .other-project-grid > .other-project-card { grid-column: span 2; }
    .other-project-grid > [data-track="automation"] { grid-column: span 3; }
    .other-project-grid.is-filtered > .other-project-card { grid-column: span 2; }

    .other-project-card[hidden],
    .lab-strip[hidden] {
        display: none;
    }

    .other-project-card.is-entering,
    .lab-strip.is-entering {
        animation: card-enter 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes card-enter {
        from { opacity: 0; transform: translateY(14px) scale(0.98); }
        to { opacity: 1; transform: none; }
    }

    /* =========================================================
       TOOLBELT MARQUEE
       ========================================================= */

    .toolbelt {
        display: flex;
        overflow: hidden;
        margin-bottom: clamp(1rem, 3vw, 2rem);
        padding: 0.9rem 0;
        border-top: 1px solid var(--border);
        mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    }

    .toolbelt-track {
        display: flex;
        flex: 0 0 auto;
        gap: 2.2rem;
        margin: 0;
        padding: 0 1.1rem;
        list-style: none;
        animation: toolbelt-scroll 38s linear infinite;
    }

    .toolbelt:hover .toolbelt-track {
        animation-play-state: paused;
    }

    .toolbelt li {
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .toolbelt li::before {
        content: "◆";
        margin-right: 0.7rem;
        color: var(--blue);
        font-size: 0.6rem;
        vertical-align: 0.15em;
    }

    @keyframes toolbelt-scroll {
        to { transform: translateX(-100%); }
    }

    /* =========================================================
       PROJECT TRACK FILTER
       ========================================================= */

    .track-filter {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin: 0 auto 2rem;
    }

    .track-filter button {
        min-height: 40px;
        padding: 0 1rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(9, 27, 43, 0.7);
        color: var(--muted);
        font: inherit;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .track-filter button:hover {
        color: #ffffff;
        border-color: #2a5d84;
        transform: translateY(-1px);
    }

    .track-filter button[aria-pressed="true"] {
        border-color: var(--blue);
        background: var(--blue);
        color: #ffffff;
    }

    .track-filter button:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 3px;
    }

    /* =========================================================
       INTELLIGENCE CARD VISUAL
       ========================================================= */

    .intel-graph {
        width: 150px;
        overflow: visible;
    }

    .intel-graph path {
        fill: none;
        stroke: #2c6a9c;
        stroke-width: 2;
        stroke-dasharray: 6 6;
        animation: intel-flow 2.4s linear infinite;
    }

    .intel-graph circle {
        fill: #0b2338;
        stroke: var(--blue-light);
        stroke-width: 2.5;
    }

    .intel-graph rect {
        fill: rgba(255, 138, 0, 0.14);
        stroke: var(--orange);
        stroke-width: 2.5;
    }

    @keyframes intel-flow {
        to { stroke-dashoffset: -24; }
    }

    /* =========================================================
       MATHS LAB STRIP
       ========================================================= */

    .lab-strip {
        margin-top: 1.4rem;
    }

    .lab-label {
        margin: 0 0 0.8rem;
        color: var(--subtle);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-align: left;
        text-transform: uppercase;
    }

    .lab-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .lab-card {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        min-width: 0;
        padding: 1rem 1.2rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-card);
        color: inherit;
        text-align: left;
        text-decoration: none;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .lab-card:hover {
        transform: translateY(-3px);
        border-color: #2a5d84;
        box-shadow: 0 14px 32px rgba(0, 0, 0, 0.3);
    }

    .lab-card:focus-visible {
        outline: 3px solid var(--orange);
        outline-offset: 3px;
    }

    .lab-card svg {
        flex: 0 0 auto;
        width: 96px;
        height: 72px;
        overflow: visible;
    }

    .math-orbit {
        border-radius: 10px;
        background: #000000;
    }

    .math-orbit path {
        fill: none;
        stroke: #b48cff;
        stroke-width: 1.4;
        stroke-dasharray: 1400;
        stroke-dashoffset: 1400;
        filter: drop-shadow(0 0 3px rgba(180, 140, 255, 0.8));
        animation: orbit-draw 6s ease-in-out infinite alternate;
    }

    @keyframes orbit-draw {
        to { stroke-dashoffset: 0; }
    }

    .mandala-mini ellipse,
    .mandala-mini circle {
        fill: rgba(255, 252, 239, 0.04);
        stroke: #e9e2cf;
        stroke-width: 1.6;
        transition: fill 0.3s ease;
    }

    .mandala-mini {
        animation: mandala-turn 30s linear infinite;
    }

    .mandala-card:hover .mandala-mini ellipse:nth-child(odd) { fill: #f4a7cf; }
    .mandala-card:hover .mandala-mini ellipse:nth-child(even) { fill: #65baff; }
    .mandala-card:hover .mandala-mini circle { fill: #ff8a00; }

    @keyframes mandala-turn {
        to { transform: rotate(360deg); }
    }

    .lab-copy {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }

    .lab-copy strong {
        color: #ffffff;
        font-size: 0.98rem;
    }

    .lab-copy strong span { color: var(--blue); }

    .lab-copy > span {
        color: var(--muted);
        font-size: 0.84rem;
        line-height: 1.55;
    }

    .other-project-card {
        position: relative;
        display: flex;
        flex-direction: column;

        min-width: 0;
        overflow: hidden;

        color: inherit;
        border: 1px solid var(--border);
        border-radius: 12px;

        background: var(--bg-card);
        text-decoration: none;
        text-align: left;

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            background 0.25s ease,
            box-shadow 0.25s ease;
    }

    .other-project-card:hover {
        background: var(--bg-card-soft);
    }

    .project-link:hover {
        transform: translateY(-4px);
        border-color: #2a5d84;
        box-shadow:
            0 18px 40px rgba(0, 0, 0, 0.35),
            0 0 0 1px rgba(22, 141, 255, 0.18),
            0 0 32px rgba(22, 141, 255, 0.12);
    }

    .card-cover-link {
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
    }

    .card-cover-link:focus-visible {
        outline: 3px solid var(--orange);
        outline-offset: 3px;
    }

    .project-link .card-title-link,
    .project-link .view-link,
    .project-link :global(.skill-tag-list) {
        position: relative;
        z-index: 2;
    }

    /* =========================================================
       PROJECT VISUALS
       ========================================================= */

    .project-visual {
        display: flex;
        align-items: center;
        justify-content: center;

        min-height: 175px;

        border-bottom: 1px solid var(--border);

        background:
            radial-gradient(
                circle at center,
                rgba(22, 141, 255, 0.15),
                transparent 70%
            ),
            #071523;
    }

    /* RAMÉ card keeps the client's wordmark on the shared dark panel */

    .rame-mini {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
    }

    .rame-mini-word {
        color: #f4a7cf;
        font-family: "Arial Rounded MT Bold", "Arial Black", system-ui, sans-serif;
        font-size: 3.1rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.02em;
        -webkit-text-stroke: 2px #1c1416;
        paint-order: stroke fill;
        text-shadow: 3px 3px 0 #000000, 0 0 24px rgba(244, 167, 207, 0.25);
    }

    .rame-mini-pill {
        margin-top: -0.2rem;
        padding: 0.15rem 0.7rem;
        border: 2px solid #1c1416;
        border-radius: 999px;
        background: #fffcef;
        box-shadow: 2px 2px 0 #1c1416;
        color: #2e9a2a;
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.2em;
        rotate: -3deg;
    }

    .rame-mini-star {
        position: absolute;
        top: -1.6rem;
        right: -2.2rem;
        width: 42px;
        height: 42px;
        overflow: visible;
        transition: rotate 0.6s cubic-bezier(0.3, 1.5, 0.5, 1);
    }

    .rame-mini-star path {
        fill: #fde84f;
        stroke: #1c1416;
        stroke-width: 5;
        stroke-linejoin: round;
    }

    .rame-mini-dot {
        position: absolute;
        bottom: -0.9rem;
        left: -1.4rem;
        width: 20px;
        height: 20px;
        border: 2px solid #1c1416;
        border-radius: 50%;
        background: #cdb8f7;
    }

    .project-link:hover .rame-mini { transform: rotate(-3deg) scale(1.06); }
    .project-link:hover .rame-mini-star { rotate: 180deg; }

    .project-visual > :not(.rame-mini) {
        transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
    }

    .project-link:hover .project-visual > :not(.rame-mini) {
        transform: scale(1.08) rotate(-4deg);
    }

    .chess-icon {
        position: relative;
        display: grid;
        width: 76px;
        height: 76px;
        place-items: center;
        border: 2px solid rgba(101, 186, 255, 0.72);
        border-radius: 50%;
        color: var(--light-blue);
        background: rgba(22, 141, 255, 0.08);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2.65rem;
        line-height: 1;
    }

    .chess-ring {
        position: absolute;
        inset: -9px;
        border: 1.5px dashed rgba(101, 186, 255, 0.45);
        border-radius: 50%;
        animation: icon-spin 16s linear infinite;
    }

    .chess-knight {
        display: inline-block;
        animation: knight-hop 3.2s ease-in-out infinite;
    }

    @keyframes knight-hop {
        0%, 60%, 100% { transform: translate(0, 0) rotate(0deg); }
        70% { transform: translate(3px, -9px) rotate(-8deg); }
        82% { transform: translate(6px, 0) rotate(0deg); }
        90% { transform: translate(3px, 0); }
    }

    @keyframes icon-spin {
        to { transform: rotate(360deg); }
    }

    .funnel-icon {
        width: 112px;
        overflow: visible;
    }

    .funnel-shape {
        fill: rgba(22, 141, 255, 0.08);
        stroke: var(--blue-light);
        stroke-width: 2.5;
        stroke-linejoin: round;
    }

    .funnel-drop {
        fill: var(--blue-light);
        animation: funnel-drop 3s ease-in infinite;
    }

    .funnel-drop.d2 { animation-delay: 1s; }
    .funnel-drop.d3 { animation-delay: 2s; }

    .funnel-out {
        fill: var(--orange);
        animation: funnel-out 3s ease-out infinite;
    }

    @keyframes funnel-drop {
        0% { opacity: 0; transform: translate(0, 0); }
        15% { opacity: 1; }
        55% { opacity: 1; transform: translate(0, 34px); }
        70%, 100% { opacity: 0; transform: translate(0, 40px); }
    }

    .funnel-drop.d1 { animation-name: funnel-drop-left; }
    .funnel-drop.d3 { animation-name: funnel-drop-right; }

    @keyframes funnel-drop-left {
        0% { opacity: 0; transform: translate(0, 0); }
        15% { opacity: 1; }
        55% { opacity: 1; transform: translate(22px, 36px); }
        70%, 100% { opacity: 0; transform: translate(26px, 44px); }
    }

    @keyframes funnel-drop-right {
        0% { opacity: 0; transform: translate(0, 0); }
        15% { opacity: 1; }
        55% { opacity: 1; transform: translate(-22px, 36px); }
        70%, 100% { opacity: 0; transform: translate(-26px, 44px); }
    }

    @keyframes funnel-out {
        0%, 60% { opacity: 0; transform: translateY(-8px); }
        75% { opacity: 1; transform: translateY(0); }
        100% { opacity: 0; transform: translateY(6px); }
    }

    .gym-icon {
        width: 136px;
        overflow: visible;
    }

    .gym-grid {
        stroke: rgba(101, 186, 255, 0.14);
        stroke-width: 1;
    }

    .gym-line {
        fill: none;
        stroke: var(--blue-light);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 160;
        stroke-dashoffset: 160;
        animation: gym-draw 4.5s ease-in-out infinite;
    }

    .gym-dot {
        fill: var(--orange);
        transform-box: fill-box;
        transform-origin: center;
        animation: gym-dot 4.5s ease-in-out infinite;
    }

    .gym-label {
        fill: #edf4fa;
        font-size: 15px;
        font-weight: 850;
    }

    @keyframes gym-draw {
        0% { stroke-dashoffset: 160; }
        55%, 85% { stroke-dashoffset: 0; }
        100% { stroke-dashoffset: 0; opacity: 0; }
    }

    @keyframes gym-dot {
        0%, 50% { opacity: 0; transform: scale(0.3); }
        60% { opacity: 1; transform: scale(1.35); }
        70%, 88% { opacity: 1; transform: scale(1); }
        100% { opacity: 0; transform: scale(1); }
    }

    .bar-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.45rem;
        height: 82px;
    }

    .bar-chart span {
        width: 13px;
        border-radius: 3px 3px 0 0;
        background: var(--blue);
    }

    .bar-chart span:nth-child(1) {
        height: 35%;
    }

    .bar-chart span:nth-child(2) {
        height: 65%;
    }

    .bar-chart span:nth-child(3) {
        height: 52%;
    }

    .bar-chart span:nth-child(4) {
        height: 92%;
    }

    .bar-chart span:nth-child(5) {
        height: 74%;
    }

    .ai-circle {
        display: grid;
        place-items: center;

        width: 90px;
        height: 90px;

        color: var(--blue-light);
        border: 1px solid #296696;
        border-radius: 50%;

        font-size: 1.55rem;
        font-weight: 850;

        box-shadow: 0 0 42px rgba(22, 141, 255, 0.13);
    }

    .gym-visual span {
        color: #edf4fa;
        font-size: 2rem;
        font-weight: 850;
        letter-spacing: -0.05em;
    }

    /* =========================================================
       OTHER PROJECT CARD CONTENT
       ========================================================= */

    .other-project-body {
        display: flex;
        flex: 1;
        flex-direction: column;

        padding: 1.25rem;
    }

    .other-project-body > p {
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.55;
    }

    .other-project-body .tags {
        margin-top: auto;
    }

    /* =========================================================
       ABOUT ME — CENTERED
       ========================================================= */

    .about {
        padding-top: clamp(5rem, 9vw, 8rem);
        padding-bottom: clamp(5rem, 9vw, 8rem);

        text-align: center;
    }

    .about-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
        max-width: 940px;
        margin: 2.25rem auto;
        text-align: left;
    }

    .about-summary > div {
        display: grid;
        gap: 0.4rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--bg-card);
    }

    .about-summary strong {
        color: var(--heading);
        font-size: 0.84rem;
    }

    .about-summary span {
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.5;
    }
    .about h2 {
        max-width: 850px;
        margin-inline: auto;
    }

    .about > p:not(.eyebrow) {
        max-width: 780px;
        margin: 0 auto 1.3rem;

        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.75;
    }

    .about .section-lead {
        color: #e4edf5;
        font-size: clamp(1.1rem, 1.8vw, 1.3rem);
        font-weight: 500;
    }

    .about-highlights {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;

        gap: 0.7rem;
        max-width: 900px;

        margin: 2rem auto 0;
    }

    .about-highlights span {
        padding: 0.65rem 0.9rem;

        color: #c6d8e7;
        background: #0a2034;

        border: 1px solid #284861;
        border-radius: 7px;

        font-size: 0.78rem;
        font-weight: 600;
    }

    /* =========================================================
       CONTACT — CENTERED
       ========================================================= */

    .contact {
        padding-top: clamp(5rem, 9vw, 8rem);
        padding-bottom: clamp(6rem, 10vw, 9rem);

        text-align: center;
    }

    .contact h2 {
        max-width: 850px;
        margin-inline: auto;
    }

    .contact > p:not(.eyebrow) {
        max-width: 760px;
        margin: 0 auto 1.25rem;

        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .contact-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;

        gap: 1rem;
        margin-top: 1.5rem;
    }

    .contact-links .text-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 0.4rem;
        min-height: 46px;
        padding: 0.8rem 1.3rem;

        color: white;
        border: 1px solid var(--border);
        border-radius: 8px;

        background: var(--bg-card);
        font-weight: 750;
        text-decoration: none;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .contact-links .text-link:hover {
        background: var(--bg-card-soft);
        border-color: var(--blue);
        transform: translateY(-2px);
    }

    .contact-links .text-link span {
        color: var(--orange);
    }

    /* =========================================================
       FOOTER
       ========================================================= */

    footer {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;

        gap: 2rem;

        padding-top: 1.7rem;
        padding-bottom: 1.7rem;

        border-top: 1px solid var(--border);
        color: var(--subtle);
        text-align: center;
    }

    .footer-left {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .footer-left > strong {
        color: white;
        font-size: 1.35rem;
    }

    .footer-left div {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .footer-left span {
        color: #d9e4ec;
        font-size: 0.84rem;
    }

    .footer-left small,
    .footer-right {
        color: var(--subtle);
        font-size: 0.72rem;
        line-height: 1.5;
    }

    /* =========================================================
       RESPONSIVE — TABLET
       ========================================================= */

    @media (max-width: 1100px) {
        .rocketeers-grid {
            grid-template-columns: 1fr;
        }

        .rocketeers-card {
            min-height: auto;
        }

        .other-project-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .other-project-grid > .other-project-card,
        .other-project-grid > [data-track="automation"],
        .other-project-grid.is-filtered > .other-project-card {
            grid-column: auto;
        }
    }

    /* =========================================================
       RESPONSIVE — MOBILE
       ========================================================= */

    @media (max-width: 650px) {
        nav {
            gap: 1rem;
        }

        .nav-links {
            gap: 0.8rem;
        }

        .nav-links a {
            font-size: 0.8rem;
        }

        .hero {
            padding: 4rem 0 5rem;
        }

        h1 {
            font-size: clamp(2.7rem, 12vw, 4rem);
        }

        .proof-strip,
        .about-summary,
        .currently-building-grid {
            grid-template-columns: 1fr;
        }

        .hero-actions {
            width: 100%;
        }

        .hero-actions .button {
            width: 100%;
        }

        .rocketeers-feature {
            padding: 1rem;
        }

        .rocketeers-overview-button {
            width: 100%;
        }

        .rocketeers-card .metrics {
            grid-template-columns: 1fr;
        }

        .other-project-grid,
        .lab-grid {
            grid-template-columns: 1fr;
        }

