---
/* =========================================================
   PAGE METADATA
   ========================================================= */

import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SkillLinks from "../components/SkillLinks.astro";
import SkillTagList from "../components/SkillTagList.astro";

const title =
    "Konstantinos Zafiropoulos | Operations, AI Automation, Data & Web";

const description =
    "Portfolio of Konstantinos Zafiropoulos — marketplace operations, AI workflow implementation, Excel/VBA, data analysis, and web development.";
---

<html lang="en">
    <!-- =====================================================
         HEAD / SEO
         ===================================================== -->

    <head>
        <meta charset="utf-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta name="description" content={description} />

        <title>{title}</title>
    </head>

    <body>
        <main>
            <!-- =================================================
                 PRIMARY NAVIGATION
                 ================================================= -->

            <SiteHeader />

            <!-- =================================================
                 HERO
                 ================================================= -->

            <section class="hero" aria-labelledby="intro-title">
                <div class="hero-copy">
                    <p class="eyebrow">Hello, I'm Konstantinos</p>

                    <h1 id="intro-title">
                        I build practical systems with{" "}
                        <span class="hero-accent">data, automation,</span>{" "}
                        and the web.
                    </h1>

                    <p class="intro">
                        A portfolio of real projects spanning marketplace
                        operations, Excel/VBA, AI workflow implementation, data,
                        and web development.
                    </p>

                    <div class="hero-actions">
                        <a class="button button-primary" href="#projects">
                            View my projects
                            <span aria-hidden="true">→</span>
                        </a>

                        <a class="button button-secondary" href="#about">
                            About me
                        </a>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 PROJECTS
                 ================================================= -->

            <section
                id="projects"
                class="section projects"
                aria-labelledby="projects-title"
            >
                <!-- =============================================
                     PROJECTS INTRODUCTION
                     ============================================= -->

                <div class="section-heading">
                    <p class="eyebrow">01 — Projects</p>

                    <h2 id="projects-title">Featured Projects</h2>

                    <p class="section-intro">
                        Real projects, real operating experience, and practical
                        systems built around actual problems.
                    </p>
                </div>

                <!-- =============================================
                     ROCKETEERS UMBRELLA
                     ============================================= -->

                <section
                    class="rocketeers-feature"
                    aria-labelledby="rocketeers-title"
                >
                    <!-- =========================================
                         ROCKETEERS OVERVIEW
                         ========================================= -->

                    <div class="rocketeers-hero">
                        <div class="rocketeers-copy">
                            <p class="featured-label">
                                Featured project · 2017–2024
                            </p>

                            <!--
                                The title leads to the Rocketeers
                                umbrella/overview page.
                            -->

                            <a
                                class="rocketeers-title-link"
                                href="/projects/rocketeers/"
                            >
                                <h3 id="rocketeers-title">
                                    Rocketeers
                                    <span aria-hidden="true">↗</span>
                                </h3>
                            </a>

                            <p class="rocketeers-tagline">
                                A real marketplace business and the systems
                                behind it.
                            </p>

                            <p class="rocketeers-description">
                                I founded and operated Rocketeers, a digital
                                marketplace business focused on Rocket League
                                items. The project combined business planning,
                                marketplace execution, pricing, inventory,
                                customer operations, automation, analytics, and
                                commercial decision-making.
                            </p>

                            <p class="rocketeers-description">
                                Explore the business itself and the operational
                                systems I built to help manage and scale it.
                            </p>

                            <!--
                                Main Rocketeers overview button.
                                Orange makes this distinct from the
                                individual project links below.
                            -->

                            <a
                                class="button button-primary rocketeers-overview-button"
                                href="/projects/rocketeers/"
                            >
                                Explore the Rocketeers project hub
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>

                        <!-- The entire visual panel links to the Rocketeers overview. -->

                        <a
                            class="rocketeers-visual rocketeers-visual-link"
                            href="/projects/rocketeers/"
                            aria-label="Explore the Rocketeers project hub"
                        >
                            <span class="visual-label"> The Rocketeers </span>

                            <div class="visual-center">
                                <strong>23K+</strong>
                                <span>items sold</span>
                            </div>

                            <span class="visual-footer">
                                Business · Marketplace · Systems
                            </span>

                            <span
                                class="visual-link-indicator"
                                aria-hidden="true"
                            >
                                Explore project hub ↗
                            </span>
                        </a>
                    </div>

                    <!-- =========================================
                         THREE ROCKETEERS PROJECTS
                         ========================================= -->

                    <div class="rocketeers-grid">
                        <!-- =====================================
                             01 — BUSINESS & MARKETPLACE OPERATIONS
                             ===================================== -->

                        <a
                            class="rocketeers-card card-business"
                            href="/projects/rocketeers/business-operations/"
                            aria-label="View the Business and Marketplace Operations case study"
                        >
                            <div class="card-top">
                                <span class="card-number orange"> 01 </span>

                                <span
                                    class="card-symbol orange"
                                    aria-hidden="true"
                                >
                                    ◫
                                </span>
                            </div>

                            <h4>
                                Business & Marketplace Operations
                                <span
                                    class="inline-arrow orange"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </h4>

                            <p>
                                How Rocketeers was planned, launched, operated,
                                and scaled — covering marketplace strategy,
                                sourcing, listings, pricing, inventory,
                                fulfilment, customer experience, disputes, and
                                seller performance.
                            </p>

                            <div class="metrics">
                                <div>
                                    <strong>23K+</strong>
                                    <span>items sold</span>
                                </div>

                                <div>
                                    <strong>6,455</strong>
                                    <span>feedback entries</span>
                                </div>

                                <div>
                                    <strong>0</strong>
                                    <span>negative feedback</span>
                                </div>
                            </div>

                            <div class="view-link">View case study ↗</div>
                        </a>

                        <!-- =====================================
                             02 — MARKETPLACE REPRICING ENGINE
                             ===================================== -->

                        <article
                            class="rocketeers-card card-repricing"
                        >
                            <div class="card-top">
                                <span class="card-number blue"> 02 </span>

                                <span
                                    class="card-symbol blue"
                                    aria-hidden="true"
                                >
                                    ⚙
                                </span>
                            </div>

                            <h4>
                                <a class="card-title-link" href="/projects/rocketeers/repricing/">
                                    Marketplace Repricing Engine
                                    <span class="inline-arrow blue" aria-hidden="true">→</span>
                                </a>
                            </h4>

                            <p>
                                An Excel-based pricing system built to manage
                                1,000+ live listings and 10,000+ priced
                                variations using imported market data,
                                structured pricing logic, and bulk-update
                                workflows.
                            </p>

                            <SkillTagList skills={["excel", "pricing-operations", "operational-scaling"]} />

                            <a class="view-link" href="/projects/rocketeers/repricing/">View case study ↗</a>
                        </article>

                        <!-- =====================================
                             03 — FINANCIAL & OPERATIONS TRACKER
                             ===================================== -->

                        <article
                            class="rocketeers-card card-finance"
                        >
                            <div class="card-top">
                                <span class="card-number green"> 03 </span>

                                <span
                                    class="card-symbol green"
                                    aria-hidden="true"
                                >
                                    ↗
                                </span>
                            </div>

                            <h4>
                                <a class="card-title-link" href="/projects/rocketeers/financial-tracker/">
                                    Financial & Operations Tracker
                                    <span class="inline-arrow green" aria-hidden="true">→</span>
                                </a>
                            </h4>

                            <p>
                                A multi-sheet Excel tracker covering turnover,
                                orders, inventory, trading activity, fees,
                                cancellations, and approximate profitability
                                across the growing operation.
                            </p>

                            <!-- Historical financial totals are covered on the case study, not presented as lifetime figures. -->

                            <SkillTagList skills={["excel", "commercial-analysis", "operational-reporting"]} />

                            <a class="view-link" href="/projects/rocketeers/financial-tracker/">View case study ↗</a>
                        </article>
                    </div>
                </section>

                <!-- =============================================
                     OTHER PROJECTS
                     ============================================= -->

                <section
                    class="other-projects"
                    aria-labelledby="other-projects-title"
                >
                    <div class="other-projects-heading">
                        <p class="eyebrow">Other projects</p>

                        <h3 id="other-projects-title">
                            Different problems. The same mindset.
                        </h3>

                        <p>Web development, data, AI, and automation.</p>
                    </div>

                    <div class="other-project-grid">
                        <!-- =====================================
                             RAME
                             ===================================== -->

                        <article
                            class="other-project-card project-link"
                        >
                            <div class="project-visual rame-visual">
                                <div class="storefront-icon" aria-hidden="true">
                                    <span class="storefront-awning">
                                        <i></i>
                                        <i></i>
                                        <i></i>
                                    </span>
                                    <span class="storefront-base"></span>
                                </div>
                            </div>

                            <div class="other-project-body">
                                <h4>
                                    <a class="card-title-link" href="/projects/rame/">
                                        RAMÉ Creative Space
                                        <span class="inline-arrow blue" aria-hidden="true">→</span>
                                    </a>
                                </h4>

                                <p>
                                    An in-progress client store built with
                                    WordPress, WooCommerce, Elementor, and
                                    targeted CSS—covering responsive pages,
                                    custom-order inquiries, side-cart styling,
                                    and practical site maintenance.
                                </p>

                                <SkillTagList skills={["wordpress", "woocommerce", "elementor", "theme-customization"]} />

                                <a class="view-link" href="/projects/rame/">View case study ↗</a>
                            </div>
                        </article>

                        <!-- =====================================
                             DATA ANALYSIS PROJECT
                             ===================================== -->

                        <article class="other-project-card">
                            <div class="project-visual data-visual">
                                <div class="bar-chart" aria-hidden="true">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            </div>

                            <div class="other-project-body">
                                <h4>
                                    Chess Analytics: What Influences Game
                                    Outcomes?
                                </h4>

                                <p>
                                    An exploratory analysis of 20,058 online
                                    chess games, examining relationships between
                                    player ratings, opening choices, game
                                    duration, and results. Currently in
                                    development.
                                </p>

                                <p class="planned-stack-label">Planned stack</p>
                                <div class="tags" aria-label="Planned Chess Analytics stack">
                                    <span>SQL</span>
                                    <span>Python</span>
                                    <span>Power BI</span>
                                </div>

                                <div class="card-status">Coming Soon</div>
                            </div>
                        </article>

                        <!-- =====================================
                             AI JOB DISCOVERY & OUTREACH AUTOMATION
                             ===================================== -->

                        <article
                            class="other-project-card project-link"
                        >
                            <div class="project-visual ai-visual">
                                <div class="ai-circle" aria-hidden="true">
                                    AI
                                </div>
                            </div>

                            <div class="other-project-body">
                                <h4>
                                    <a class="card-title-link" href="/projects/ai-job-outreach/">
                                        AI Job Discovery & Outreach Automation
                                        <span class="inline-arrow blue" aria-hidden="true">→</span>
                                    </a>
                                </h4>

                                <p>
                                    An end-to-end Python workflow combining
                                    three job APIs with Gemini-based relevance
                                    assessment, structured prompts, reusable
                                    validation, and human-reviewed outreach
                                    drafts in Google Sheets.
                                </p>

                                <SkillTagList skills={["python", "google-gemini", "prompt-design", "ai-workflow-implementation"]} />

                                <a class="view-link" href="/projects/ai-job-outreach/">View case study ↗</a>
                            </div>
                        </article>

                        <!-- =====================================
                             GYM PROGRESS SYSTEM
                             ===================================== -->

                        <article
                            class="other-project-card project-link"
                        >
                            <div class="project-visual gym-visual">
                                <span aria-hidden="true"> KG </span>
                            </div>

                            <div class="other-project-body">
                                <h4>
                                    <a class="card-title-link" href="/projects/gym-progress/">
                                        Gym Progress System
                                        <span class="inline-arrow blue" aria-hidden="true">→</span>
                                    </a>
                                </h4>

                                <p>
                                    An Excel/VBA analytics system for tracking
                                    workouts, progression, historical data,
                                    diagnostics, and performance trends.
                                </p>

                                <SkillTagList skills={["excel", "vba", "data-visualisation"]} />

                                <a class="view-link" href="/projects/gym-progress/">View case study ↗</a>
                            </div>
                        </article>
                    </div>
                </section>
            </section>

            <!-- =================================================
                 ABOUT ME
                 ================================================= -->

            <section
                id="about"
                class="section about"
                aria-labelledby="about-title"
            >
                <p class="eyebrow">02 — About Me</p>

                <h2 id="about-title">
                    From running a business to building better systems.
                </h2>

                <p class="section-lead">
                    I'm Konstantinos, an operations-focused professional with a
                    background in e-commerce, marketplace management, data,
                    automation, and practical technology.
                </p>

                <p>
                    From 2017 to 2024, I founded and operated Rocketeers, a
                    digital marketplace business that sold more than 23,000
                    items. Running the business gave me hands-on experience
                    across sourcing, pricing, inventory, order management,
                    customer experience, and commercial decision-making.
                </p>

                <p>
                    As the operation grew, I became increasingly interested in
                    solving the problems behind the work itself. I developed
                    Excel-based systems to streamline repricing, organize
                    inventory, and track business performance. That same
                    interest has since expanded into Python, AI-assisted
                    workflows, data analysis, and web development.
                </p>

                <p>
                    I enjoy combining an understanding of real operational
                    problems with the technical tools needed to solve them.
                    Whether I'm working with spreadsheets, code, data, or
                    marketplace systems, my goal is to make processes clearer,
                    more reliable, and easier to scale.
                </p>

                <p>
                    In my AI automation project, I designed a workflow that uses
                    a language model for defined tasks, connects it to job data
                    and spreadsheet outputs, and keeps final outreach decisions
                    with a human reviewer. I focus on making AI useful in a
                    repeatable process rather than treating a generated answer
                    as a finished solution.
                </p>

                <!-- Professional focus areas -->
                <SkillLinks
                    variant="highlight"
                    skills={[
                        "marketplace-operations",
                        "excel",
                        "vba",
                        "ai-workflow-implementation",
                        "python",
                        "wordpress",
                        "operational-reporting",
                        "responsive-web-design",
                    ]}
                />
            </section>
            <!-- =================================================
                  SKILLS — CAPABILITIES SHOWN IN THE PROJECTS
                  ================================================= -->

            <section
                id="skills"
                class="section skills"
                aria-labelledby="skills-title"
            >
                <p class="eyebrow">03 — Skills</p>
                <h2 id="skills-title">Skills put into practice.</h2>
                <p class="section-lead">
                    A snapshot of what my completed projects demonstrate. I am
                    continuing to develop my Python, SQL, and analytical skills.
                </p>

                <div class="skills-grid">
                    <article class="skill-group">
                        <h3><a href="/skills/#umbrella-operations-ecommerce">Operations &amp; e-commerce</a></h3>
                        <p>
                            Marketplace management, digital inventory, pricing,
                            order fulfilment, customer issue resolution, seller
                            performance, and process design.
                        </p>
                        <a href="/projects/rocketeers/">See Rocketeers ↗</a>
                    </article>
                    <article class="skill-group">
                        <h3><a href="/skills/#umbrella-excel-vba-analytics">Excel, VBA &amp; analytics</a></h3>
                        <p>
                            Operational workbooks, formulas, reporting, data
                            organisation, chart automation, and interactive
                            workbook interfaces.
                        </p>
                        <a href="/projects/gym-progress/">See Gym Progress ↗</a>
                    </article>
                    <article class="skill-group">
                        <h3><a href="/skills/#umbrella-ai-automation">AI implementation &amp; automation</a></h3>
                        <p>
                            Applying LLMs to defined workflow steps, prompt
                            design, structured outputs, API integration,
                            validation and caching, and human review. Practical
                            implementation experience, not model training.
                        </p>
                        <a href="/projects/ai-job-outreach/"
                            >See AI automation ↗</a
                        >
                    </article>
                    <article class="skill-group">
                        <h3><a href="/skills/#umbrella-python-data-web">Python, data &amp; web</a></h3>
                        <p>
                            Python scripting, API data handling, SQLite caching,
                            Google Sheets integration, WordPress/WooCommerce
                            development, and building a responsive Astro
                            portfolio. SQL and Power BI are areas I am
                            developing through Chess Analytics.
                        </p>
                        <a href="/projects/rame/">See web project ↗</a>
                    </article>
                </div>

                <a class="skills-page-link" href="/skills/">
                    Explore all skills and project evidence
                    <span aria-hidden="true">→</span>
                </a>
            </section>

            <!-- =================================================
                 CONTACT
                 ================================================= -->

            <section
                id="contact"
                class="section contact"
                aria-labelledby="contact-title"
            >
                <p class="eyebrow">04 — Contact</p>

                <h2 id="contact-title">Let’s connect.</h2>

                <p class="section-lead">
                    Open to marketplace and business operations, junior analyst,
                    AI workflow implementation, automation, and
                    technical-operations roles.
                </p>

                <p>
                    If you’d like to discuss a role, a project, or my work, feel
                    free to reach out.
                </p>

                <!-- Contact links -->
                <div class="contact-links">
                    <a class="text-link" href="mailto:kwstaszaf@hotmail.com">
                        Email me
                        <span aria-hidden="true">↗</span>
                    </a>

                    <a
                        class="text-link"
                        href="https://www.linkedin.com/in/konstantinos-zafeiropoulos-18011996/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        LinkedIn
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </section>
        </main>

        <SiteFooter />
    </body>
</html>

<style>
    /* =========================================================
       DESIGN TOKENS
       ========================================================= */

    :root {
        --bg: #050d18;
        --bg-card: #071522;
        --bg-card-soft: #0a1928;

        --text: #e8eef5;
        --heading: #ffffff;

        --muted: #a9bbcc;
        --subtle: #71869a;

        --border: #1d354a;

        --blue: #168dff;
        --blue-light: #65baff;

        --orange: #ff8a00;
        --green: #26d5a2;

        --page-width: 1380px;

        color: var(--text);
        background: var(--bg);

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    /* =========================================================
       GLOBAL RESET / BASICS
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;
        margin: 0;

        color: var(--text);

        background:
            radial-gradient(
                circle at top right,
                rgba(22, 141, 255, 0.08),
                transparent 38rem
            ),
            var(--bg);
    }

    main,
    footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;

        padding-left: clamp(1.5rem, 5vw, 5rem);
        padding-right: clamp(1.5rem, 5vw, 5rem);
    }

    a {
        color: inherit;
    }

    a:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
    }

    section[id] {
        scroll-margin-top: 5.5rem;
    }

    ::selection {
        color: white;
        background: rgba(255, 138, 0, 0.65);
    }

    /* =========================================================
       TYPOGRAPHY
       ========================================================= */

    h1,
    h2,
    h3,
    h4,
    p {
        margin-top: 0;
    }

    h1,
    h2,
    h3 {
        color: var(--heading);
        letter-spacing: -0.04em;
    }

    h1 {
        max-width: 900px;
        margin-bottom: 1.6rem;

        font-size: clamp(3.2rem, 7vw, 6.2rem);
        line-height: 1.02;
    }

    h2 {
        margin-bottom: 0.8rem;
        font-size: clamp(2.4rem, 4.5vw, 4rem);
        line-height: 1.08;
    }

    h3 {
        font-size: clamp(2rem, 3vw, 2.8rem);
        line-height: 1.1;
    }

    h4 {
        margin-bottom: 0.8rem;
        color: var(--heading);
        font-size: 1.2rem;
        line-height: 1.3;
    }

    .eyebrow,
    .featured-label {
        margin-bottom: 1rem;

        color: var(--orange);

        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    /* =========================================================
       NAVIGATION
       ========================================================= */

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 74px;

        border-bottom: 1px solid rgba(29, 53, 74, 0.65);
    }

    .wordmark {
        color: white;
        font-size: 1.4rem;
        font-weight: 850;
        letter-spacing: -0.08em;
        text-decoration: none;
    }

    .wordmark span {
        color: var(--orange);
    }

    .nav-links {
        display: flex;
        gap: clamp(1rem, 3vw, 2.8rem);
    }

    .nav-links a {
        position: relative;
        color: var(--muted);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -0.35rem;

        width: 0;
        height: 1px;

        background: var(--blue);
        transition: width 0.2s ease;
    }

    .nav-links a:hover {
        color: white;
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    /* =========================================================
       HERO — CENTERED LAYOUT
       ========================================================= */

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
        align-items: center;

        min-height: auto;
        padding: clamp(5rem, 10vw, 8rem) 0;

        text-align: center;
    }

    .hero-copy {
        width: 100%;
        max-width: 980px;
    }

    .hero h1,
    .hero .intro {
        margin-inline: auto;
    }

    .hero-accent {
        color: var(--blue);
    }

    .intro {
        max-width: 700px;
        color: var(--muted);

        font-size: clamp(1.02rem, 1.6vw, 1.25rem);
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;

        gap: 0.8rem;
        margin-top: 2rem;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 0.55rem;
        min-height: 48px;
        padding: 0.85rem 1.3rem;

        border: 1px solid var(--blue);
        border-radius: 8px;

        font-size: 0.87rem;
        font-weight: 750;
        text-decoration: none;

        transition:
            transform 0.2s ease,
            background 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .button:hover {
        transform: translateY(-2px);
    }

    .button-primary {
        color: white;
        background: var(--blue);

        box-shadow: 0 10px 30px rgba(22, 141, 255, 0.14);
    }

