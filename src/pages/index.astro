<script>
    // Project track filter: shows one area of work at a time.
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-track-filter]");
    const projectGrid = document.querySelector<HTMLElement>(".other-project-grid");
    const trackItems = document.querySelectorAll<HTMLElement>(".other-project-grid > [data-track], .lab-strip[data-track]");
    const trackStatus = document.querySelector<HTMLElement>("[data-track-status]");

    for (const button of filterButtons) {
        button.addEventListener("click", () => {
            const track = button.dataset.trackFilter ?? "all";
            let shown = 0;

            for (const other of filterButtons) {
                other.setAttribute("aria-pressed", String(other === button));
            }

            for (const item of trackItems) {
                const visible = track === "all" || item.dataset.track === track;
                const lab = item.classList.contains("lab-strip");
                item.hidden = !visible;
                item.classList.remove("is-entering");
                if (visible) {
                    void item.offsetWidth;
                    item.classList.add("is-entering");
                    shown += lab ? item.querySelectorAll(".lab-card").length : 1;
                }
            }

            projectGrid?.classList.toggle("is-filtered", track !== "all");
            if (projectGrid) projectGrid.hidden = track === "lab";
            if (trackStatus) trackStatus.textContent = `${shown} projects shown`;
        });
    }

    // Count the hero figures up from zero; the final text is already in the HTML.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduceMotion) {
        for (const figure of document.querySelectorAll<HTMLElement>(".proof-strip strong")) {
            const finalText = figure.textContent ?? "";
            const match = finalText.match(/^([^\d]*)([\d.]+)(.*)$/);
            if (!match) continue;

            const [, prefix, numberText, suffix] = match;
            const target = Number(numberText);
            const decimals = numberText.split(".")[1]?.length ?? 0;
            const duration = 1300;
            const start = performance.now();

            figure.setAttribute("aria-label", finalText);

            const tick = (now: number) => {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                figure.textContent =
                    progress < 1 ? `${prefix}${(target * eased).toFixed(decimals)}${suffix}` : finalText;
                if (progress < 1) requestAnimationFrame(tick);
            };

            requestAnimationFrame(tick);
        }
    }
</script>

