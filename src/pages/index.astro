---
/* =========================================================
   PAGE METADATA
   ========================================================= */

const title =
    "Konstantinos Zafiropoulos | Marketplace Operations, Automation & Data";

const description =
    "Portfolio of Konstantinos Zafiropoulos — marketplace operations, automation, data, and practical systems.";
---

<html lang="en">
    <!-- =======================================================
       HEAD / SEO
       ======================================================= -->

    <head>
        <meta charset="utf-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta name="description" content={description} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>{title}</title>
    </head>

    <body>
        <main>
            <!-- ===================================================
           PRIMARY NAVIGATION
           =================================================== -->

            <nav aria-label="Primary navigation">
                <a class="wordmark" href="/" aria-label="Homepage">
                    KZ<span>.</span>
                </a>

                <div class="nav-links">
                    <a href="#projects">Projects</a>
                    <a href="#about">About</a>
                    <a href="#contact">Contact</a>
                </div>
            </nav>

            <!-- ===================================================
           HERO
           =================================================== -->

            <section class="hero" aria-labelledby="intro-title">
                <p class="eyebrow">
                    Marketplace operations · Automation · Data
                </p>

                <h1 id="intro-title">
                    Konstantinos<br />
                    Zafiropoulos
                </h1>

                <p class="intro">
                    I build practical systems that make complex operations
                    clearer, faster, and easier to run.
                </p>

                <a class="text-link" href="#projects">
                    Selected work
                    <span aria-hidden="true">↓</span>
                </a>
            </section>

            <!-- ===================================================
           SECTION 01 — SELECTED WORK
           =================================================== -->

            <section
                id="projects"
                class="section projects"
                aria-labelledby="projects-title"
            >
                <div class="section-heading">
                    <p class="eyebrow">01 — Selected work</p>

                    <h2 id="projects-title">Built through real operations.</h2>
                </div>

                <!-- =================================================
             PROJECT GRID
             ================================================= -->

                <div class="project-grid">
                    <!-- ===============================================
               PROJECT 01 — ROCKETEERS
               =============================================== -->

                    <a
                        href="/projects/rocketeers/"
                        class="project-card project-card-link"
                        aria-label="View the Rocketeers case study"
                    >
                        <div class="project-card-content">
                            <span class="project-number">01</span>

                            <h3>Rocketeers</h3>

                            <p class="project-description">
                                A digital marketplace business operated from
                                2017–2024, serving customers across more than 20
                                countries.
                            </p>
                        </div>

                        <div class="project-bottom">
                            <span class="project-meta">
                                Marketplace operations · Customer experience
                            </span>

                            <span class="project-action">
                                View case study
                                <span aria-hidden="true">↗</span>
                            </span>
                        </div>
                    </a>

                    <!-- ===============================================
     PROJECT 02 — GYM PROGRESS SYSTEM
     =============================================== -->

                    <a
                        href="/projects/gym-progress/"
                        class="project-card project-card-link"
                        aria-label="View the Gym Progress System case study"
                    >
                        <div class="project-card-content">
                            <span class="project-number">02</span>

                            <h3>Gym Progress System</h3>

                            <p class="project-description">
                                An Excel and VBA analytics system for turning
                                workout history into useful, visible
                                progression.
                            </p>
                        </div>

                        <div class="project-bottom">
                            <span class="project-meta">
                                Excel/VBA · Data quality · Automation
                            </span>

                            <span class="project-action">
                                View case study
                                <span aria-hidden="true">↗</span>
                            </span>
                        </div>
                    </a>

                    <!-- ===============================================
               PROJECT 03 — JOB APPLICATION TRACKER
               =============================================== -->

                    <article class="project-card">
                        <div class="project-card-content">
                            <span class="project-number">03</span>

                            <h3>Job Application Tracker</h3>

                            <p class="project-description">
                                A tailored tracking workflow combining
                                application status, metrics, and automation in
                                one workbook.
                            </p>
                        </div>

                        <div class="project-bottom">
                            <span class="project-meta">
                                Workflow design · Excel/VBA
                            </span>

                            <span class="project-status">
                                Case study coming
                            </span>
                        </div>
                    </article>
                </div>
            </section>

            <!-- ===================================================
           SECTION 02 — ABOUT
           =================================================== -->

            <section
                id="about"
                class="section about"
                aria-labelledby="about-title"
            >
                <p class="eyebrow">02 — About</p>

                <h2 id="about-title">
                    Operations experience, with a systems mindset.
                </h2>

                <p>
                    I work at the intersection of marketplace operations,
                    process improvement, data, and automation. My background
                    spans e-commerce, Excel/VBA, basic SQL, and technical
                    automation work.
                </p>
            </section>

            <!-- ===================================================
           SECTION 03 — CONTACT
           =================================================== -->

            <section
                id="contact"
                class="section contact"
                aria-labelledby="contact-title"
            >
                <p class="eyebrow">03 — Contact</p>

                <h2 id="contact-title">Let’s connect.</h2>

                <p>
                    Available for operations, marketplace, analyst, automation,
                    and technical-operations opportunities.
                </p>

                <!-- TODO:
             Replace this placeholder email with your real public
             contact address before the portfolio is finalized.
        -->

                <a class="text-link" href="mailto:hello@example.com">
                    Email me
                    <span aria-hidden="true">↗</span>
                </a>
            </section>
        </main>

        <!-- =====================================================
         FOOTER
         ===================================================== -->

        <footer>
            <span>
                © {new Date().getFullYear()} Konstantinos Zafiropoulos
            </span>

            <span>Built with Astro</span>
        </footer>
    </body>
</html>

<style>
    /* =========================================================
     DESIGN TOKENS

     Central colour variables.
     If we later change the site's visual identity, most colours
     can be adjusted from this section alone.
     ========================================================= */

    :root {
        --color-bg: #07111f;
        --color-bg-soft: #0a1726;

        --color-text: #e8edf3;
        --color-heading: #ffffff;

        --color-muted: #b8c7d6;
        --color-subtle: #7f95aa;
        --color-dim: #60778c;

        --color-border: #203247;

        --color-blue: #2aa7ff;
        --color-blue-light: #70c5ff;

        --color-orange: #ff8a00;

        --page-width: 1200px;

        color: var(--color-text);
        background: var(--color-bg);

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    /* =========================================================
     GLOBAL RESET / BASICS
     ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;
        margin: 0;

        color: var(--color-text);

        background:
            radial-gradient(
                circle at top right,
                rgba(42, 167, 255, 0.08),
                transparent 32rem
            ),
            radial-gradient(
                circle at 12% 60%,
                rgba(255, 138, 0, 0.025),
                transparent 28rem
            ),
            var(--color-bg);
    }

    ::selection {
        color: #ffffff;
        background: rgba(255, 138, 0, 0.65);
    }

    /* =========================================================
     PAGE CONTAINER
     ========================================================= */

    main,
    footer {
        max-width: var(--page-width);

        margin-inline: auto;

        padding-left: clamp(1.5rem, 5vw, 4.5rem);
        padding-right: clamp(1.5rem, 5vw, 4.5rem);
    }

    /* =========================================================
     LINKS / ACCESSIBILITY
     ========================================================= */

    a {
        color: inherit;
        text-underline-offset: 0.25em;
    }

    a:focus-visible {
        outline: 2px solid var(--color-orange);
        outline-offset: 5px;
    }

    /* =========================================================
     PRIMARY NAVIGATION
     ========================================================= */

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding-top: 1.5rem;
    }

    .wordmark {
        font-size: 1.3rem;
        font-weight: 800;

        text-decoration: none;

        letter-spacing: -0.08em;
    }

    .wordmark span {
        color: var(--color-orange);
    }

    .nav-links {
        display: flex;

        gap: clamp(1rem, 3vw, 2.5rem);

        font-size: 0.9rem;
    }

    .nav-links a {
        color: var(--color-muted);

        text-decoration: none;

        transition: color 0.2s ease;
    }

    .nav-links a:hover {
        color: var(--color-heading);
    }

    /* =========================================================
     TYPOGRAPHY
     ========================================================= */

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2 {
        font-family: Georgia, "Times New Roman", serif;

        font-weight: 400;

        letter-spacing: -0.055em;
    }

    h1 {
        max-width: 850px;

        margin-bottom: 1.5rem;

        color: var(--color-heading);

        font-size: clamp(3.6rem, 9vw, 7.4rem);

        line-height: 0.89;
    }

    h2 {
        color: var(--color-heading);

        font-size: clamp(2.2rem, 5vw, 4rem);

        line-height: 0.98;
    }

    h3 {
        margin-bottom: 0.9rem;

        color: var(--color-heading);

        font-size: 1.35rem;
    }

    .eyebrow {
        margin: 0 0 1.25rem;

        color: var(--color-orange);

        font-size: 0.78rem;
        font-weight: 750;

        letter-spacing: 0.08em;

        text-transform: uppercase;
    }

    /* =========================================================
     HERO
     ========================================================= */

    .hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;

        min-height: 71vh;

        padding: clamp(5rem, 12vw, 10rem) 0 4rem;
    }

    .intro {
        max-width: 535px;

        color: var(--color-muted);

        font-size: clamp(1.1rem, 2vw, 1.35rem);

        line-height: 1.55;
    }

    /* =========================================================
     GENERAL TEXT LINKS
     ========================================================= */

    .text-link {
        display: inline-block;

        margin-top: 1rem;

        color: var(--color-text);

        font-weight: 700;

        transition:
            color 0.2s ease,
            transform 0.2s ease;
    }

    .text-link:hover {
        color: var(--color-heading);
    }

    .text-link span {
        margin-left: 0.35rem;

        color: var(--color-orange);
    }

    /* =========================================================
     GENERAL PAGE SECTIONS
     ========================================================= */

    .section {
        padding: clamp(4.5rem, 10vw, 8rem) 0;

        border-top: 1px solid var(--color-border);
    }

    .section-heading {
        max-width: 620px;
    }

    /* =========================================================
     PROJECT GRID
     ========================================================= */

    .project-grid {
        display: grid;

        grid-template-columns: repeat(3, minmax(0, 1fr));

        margin-top: 3rem;

        border-top: 2px solid var(--color-blue);
    }

    /* =========================================================
     PROJECT CARD — BASE

     Every project uses this same layout regardless of whether
     it is currently clickable.
     ========================================================= */

    .project-card {
        display: flex;
        flex-direction: column;

        min-width: 0;
        min-height: 300px;

        padding: 1.5rem 1.5rem 1.5rem 0;

        color: inherit;

        border-bottom: 1px solid var(--color-border);

        text-decoration: none;
    }

    /* Vertical separators between cards */
    .project-card + .project-card {
        margin-left: 1.5rem;

        padding-left: 1.5rem;

        border-left: 1px solid var(--color-border);
    }

    /* =========================================================
     PROJECT CARD — MAIN CONTENT
     ========================================================= */

    .project-card-content {
        display: block;
    }

    .project-number {
        display: block;

        margin-bottom: 0.55rem;

        color: var(--color-orange);

        font-size: 0.82rem;
        font-weight: 700;
    }

    .project-description {
        margin-bottom: 0;

        color: var(--color-muted);

        line-height: 1.55;
    }

    /* =========================================================
     PROJECT CARD — BOTTOM AREA

     This is deliberately separated from the main content so
     metadata/status links cannot run into one another.
     ========================================================= */

    .project-bottom {
        display: grid;

        gap: 0.75rem;

        width: 100%;

        margin-top: auto;

        padding-top: 2rem;
    }

    .project-meta {
        display: block;

        color: var(--color-subtle);

        font-size: 0.82rem;

        line-height: 1.45;
    }

    .project-action {
        display: inline-flex;
        align-items: center;

        gap: 0.35rem;

        width: fit-content;

        color: var(--color-blue);

        font-size: 0.78rem;
        font-weight: 700;

        line-height: 1.4;

        transition: color 0.2s ease;
    }

    .project-status {
        display: block;

        width: fit-content;

        color: var(--color-dim);

        font-size: 0.72rem;
        font-weight: 600;

        line-height: 1.4;

        letter-spacing: 0.06em;

        text-transform: uppercase;
    }

    /* =========================================================
     CLICKABLE PROJECT CARD
     ========================================================= */

    .project-card-link {
        position: relative;

        transition:
            transform 0.2s ease,
            background 0.2s ease;
    }

    .project-card-link:hover {
        transform: translateY(-4px);

        background: linear-gradient(
            to bottom,
            rgba(42, 167, 255, 0.035),
            transparent
        );
    }

    .project-card-link:hover .project-action {
        color: var(--color-blue-light);
    }

    /* =========================================================
     ABOUT / CONTACT
     ========================================================= */

    .about > p:not(.eyebrow),
    .contact > p:not(.eyebrow) {
        max-width: 620px;

        color: var(--color-muted);

        font-size: 1.1rem;

        line-height: 1.55;
    }

    .contact {
        padding-bottom: clamp(5rem, 12vw, 9rem);
    }

    /* =========================================================
     FOOTER
     ========================================================= */

    footer {
        display: flex;
        justify-content: space-between;

        gap: 1rem;

        padding-top: 1.5rem;
        padding-bottom: 1.5rem;

        border-top: 1px solid var(--color-border);

        color: var(--color-subtle);

        font-size: 0.8rem;
    }

    /* =========================================================
     RESPONSIVE — TABLET / MOBILE
     ========================================================= */

    @media (max-width: 720px) {
        .hero {
            min-height: 68vh;
        }

        .project-grid {
            grid-template-columns: 1fr;
        }

        .project-card {
            min-height: auto;

            padding: 1.5rem 0;
        }

        /* Remove desktop separators */
        .project-card + .project-card {
            margin-left: 0;

            padding-left: 0;

            border-left: 0;
        }

        .project-bottom {
            margin-top: 0;

            padding-top: 1.5rem;
        }

        footer {
            flex-direction: column;
        }
    }

    /* =========================================================
     REDUCED MOTION ACCESSIBILITY
     ========================================================= */

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        .project-card-link,
        .nav-links a,
        .text-link,
        .project-action {
            transition: none;
        }

        .project-card-link:hover {
            transform: none;
        }
    }
</style>
