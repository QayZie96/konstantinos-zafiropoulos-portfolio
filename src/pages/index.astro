---
/* =========================================================
   PAGE METADATA
   ========================================================= */

const title = "Konstantinos Zafiropoulos | Operations, Automation, Data & Web";

const description =
    "Portfolio of Konstantinos Zafiropoulos — marketplace operations, automation, data analysis, web development, and practical systems.";
---

<html lang="en">
    <!-- =====================================================
         HEAD / SEO
         ===================================================== -->

    <head>
        <meta charset="utf-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta name="description" content={description} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>{title}</title>
    </head>

    <body>
        <main>
            <!-- =================================================
                 PRIMARY NAVIGATION
                 ================================================= -->

            <nav aria-label="Primary navigation">
                <a class="wordmark" href="/" aria-label="Homepage">
                    KZ<span>.</span>
                </a>

                <div class="nav-links">
                    <a href="#projects">Projects</a>
                    <a href="#about">About</a>
                    <a href="#contact">Contact</a>
                </div>
            </nav>

            <!-- =================================================
                 HERO
                 ================================================= -->

            <section class="hero" aria-labelledby="intro-title">
                <div class="hero-copy">
                    <p class="eyebrow">Hello, I'm Konstantinos</p>

                    <h1 id="intro-title">
                        I build practical systems with{" "}
                        <span class="hero-accent">data, automation,</span>{" "}
                        and the web.
                    </h1>

                    <p class="intro">
                        A portfolio of real projects spanning marketplace
                        operations, Excel/VBA, web development, analytics, and
                        practical AI implementation.
                    </p>

                    <div class="hero-actions">
                        <a class="button button-primary" href="#projects">
                            View my projects
                            <span aria-hidden="true">→</span>
                        </a>

                        <a class="button button-secondary" href="#about">
                            About me
                        </a>
                    </div>
                </div>

                <!-- Small positioning statement -->
                <aside class="hero-note">
                    <span class="hero-note-line"></span>

                    <p>Better systems create more opportunities.</p>
                </aside>
            </section>

            <!-- =================================================
                 PROJECTS
                 ================================================= -->

            <section
                id="projects"
                class="section projects"
                aria-labelledby="projects-title"
            >
                <!-- =============================================
                     PROJECTS INTRO
                     ============================================= -->

                <div class="section-heading">
                    <p class="eyebrow">01 — Projects</p>

                    <h2 id="projects-title">Featured Projects</h2>

                    <p class="section-intro">
                        Real projects, real operating experience, and practical
                        systems built around actual problems.
                    </p>
                </div>

                <!-- =============================================
                     ROCKETEERS UMBRELLA
                     ============================================= -->

                <section
                    class="rocketeers-feature"
                    aria-labelledby="rocketeers-title"
                >
                    <!-- =========================================
                         ROCKETEERS OVERVIEW
                         ========================================= -->

                    <div class="rocketeers-hero">
                        <div class="rocketeers-copy">
                            <p class="featured-label">Featured project</p>

                            <a
                                class="rocketeers-title-link"
                                href="/projects/rocketeers/"
                            >
                                <h3 id="rocketeers-title">
                                    Rocketeers
                                    <span aria-hidden="true">→</span>
                                </h3>
                            </a>

                            <p class="rocketeers-tagline">
                                A real marketplace business and the systems
                                behind it.
                            </p>

                            <p class="rocketeers-description">
                                I founded and operated Rocketeers, a digital
                                marketplace business focused on Rocket League
                                items. The project combined business planning,
                                marketplace execution, pricing, inventory,
                                customer operations, automation, analytics, and
                                commercial decision-making.
                            </p>

                            <p class="rocketeers-description">
                                The overview connects the business itself with
                                the operational systems I built to help manage
                                and scale it.
                            </p>

                            <a
                                class="button button-primary"
                                href="/projects/rocketeers/"
                            >
                                View Rocketeers overview
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>

                        <!--
                            Temporary visual.
                            Later we can replace this with genuine Rocketeers imagery.
                        -->
                        <div class="rocketeers-visual" aria-hidden="true">
                            <span class="visual-label"> The Rocketeers </span>

                            <div class="visual-center">
                                <strong>23K+</strong>
                                <span>items sold</span>
                            </div>

                            <span class="visual-footer">
                                Business · Marketplace · Systems
                            </span>
                        </div>
                    </div>

                    <!-- =========================================
                         THREE ROCKETEERS PROJECTS
                         ========================================= -->

                    <div class="rocketeers-grid">
                        <!-- =====================================
                             01 — BUSINESS & MARKETPLACE OPERATIONS
                             ===================================== -->

                        <a
                            class="rocketeers-card card-business"
                            href="/projects/rocketeers/business-operations/"
                            aria-label="View the Business and Marketplace Operations case study"
                        >
                            <div class="card-top">
                                <span class="card-number orange"> 01 </span>

                                <span
                                    class="card-symbol orange"
                                    aria-hidden="true"
                                >
                                    ◫
                                </span>
                            </div>

                            <h4>
                                Business & Marketplace Operations
                                <span
                                    class="inline-arrow orange"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </h4>

                            <p>
                                How Rocketeers was planned, launched, operated,
                                and scaled — covering marketplace strategy,
                                sourcing, listings, pricing, inventory,
                                fulfilment, customer experience, disputes, and
                                seller performance.
                            </p>

                            <div class="metrics">
                                <div>
                                    <strong>23K+</strong>
                                    <span>items sold</span>
                                </div>

                                <div>
                                    <strong>6,455</strong>
                                    <span>feedback entries</span>
                                </div>

                                <div>
                                    <strong>807</strong>
                                    <span>followers</span>
                                </div>
                            </div>

                            <div class="view-link">View case study ↗</div>
                        </a>

                        <!-- =====================================
                             02 — MARKETPLACE REPRICING ENGINE
                             ===================================== -->

                        <a
                            class="rocketeers-card card-repricing"
                            href="/projects/rocketeers/repricing/"
                            aria-label="View the Marketplace Repricing Engine case study"
                        >
                            <div class="card-top">
                                <span class="card-number blue"> 02 </span>

                                <span
                                    class="card-symbol blue"
                                    aria-hidden="true"
                                >
                                    ⚙
                                </span>
                            </div>

                            <h4>
                                Marketplace Repricing Engine
                                <span
                                    class="inline-arrow blue"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </h4>

                            <p>
                                An Excel-based pricing system built to manage
                                1,000+ live listings and 10,000+ priced
                                variations using imported market data,
                                structured pricing logic, and bulk-update
                                workflows.
                            </p>

                            <div class="tags">
                                <span>Excel</span>
                                <span>Pricing Logic</span>
                                <span>Process Scaling</span>
                            </div>

                            <div class="view-link">View case study ↗</div>
                        </a>

                        <!-- =====================================
                             03 — FINANCIAL & OPERATIONS TRACKER
                             ===================================== -->

                        <a
                            class="rocketeers-card card-finance"
                            href="/projects/rocketeers/financial-tracker/"
                            aria-label="View the Financial and Operations Tracker case study"
                        >
                            <div class="card-top">
                                <span class="card-number green"> 03 </span>

                                <span
                                    class="card-symbol green"
                                    aria-hidden="true"
                                >
                                    ↗
                                </span>
                            </div>

                            <h4>
                                Financial & Operations Tracker
                                <span
                                    class="inline-arrow green"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </h4>

                            <p>
                                A multi-sheet Excel tracker covering turnover,
                                orders, inventory, trading activity, fees,
                                cancellations, and approximate profitability
                                across the growing operation.
                            </p>

                            <div class="metrics finance-metrics">
                                <div>
                                    <strong>$55.6K</strong>
                                    <span>recorded turnover</span>
                                </div>

                                <div>
                                    <strong>4,154</strong>
                                    <span>orders</span>
                                </div>

                                <div>
                                    <strong>6,372</strong>
                                    <span>products sold</span>
                                </div>
                            </div>

                            <div class="view-link">View case study ↗</div>
                        </a>
                    </div>
                </section>

                <!-- =============================================
                     OTHER PROJECTS
                     ============================================= -->

                <section
                    class="other-projects"
                    aria-labelledby="other-projects-title"
                >
                    <div class="other-projects-heading">
                        <div>
                            <p class="eyebrow">Other projects</p>

                            <h3 id="other-projects-title">
                                Different problems. The same mindset.
                            </h3>
                        </div>

                        <p>Web development, data, AI, and automation.</p>
                    </div>

                    <div class="other-project-grid">
                        <!-- =====================================
                             RAME
                             ===================================== -->

                        <article class="other-project-card">
                            <div class="project-visual rame-visual">
                                <span>RAME</span>
                            </div>

                            <div class="other-project-body">
                                <h4>Rame</h4>

                                <p>
                                    A real e-commerce business website currently
                                    being developed for an active commercial
                                    project, covering frontend design, site
                                    structure, deployment, and practical web
                                    development.
                                </p>

                                <div class="tags">
                                    <span>E-commerce</span>
                                    <span>Web Development</span>
                                    <span>Frontend</span>
                                </div>

                                <div class="card-status">Coming Soon</div>
                            </div>
                        </article>

                        <!-- =====================================
                             DATA ANALYSIS PROJECT
                             ===================================== -->

                        <article class="other-project-card">
                            <div class="project-visual data-visual">
                                <div class="bar-chart" aria-hidden="true">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            </div>

                            <div class="other-project-body">
                                <h4>Data Analysis Project</h4>

                                <p>
                                    A focused analytics project using SQL,
                                    Python, and Power BI to investigate
                                    real-world data and communicate meaningful
                                    findings.
                                </p>

                                <div class="tags">
                                    <span>SQL</span>
                                    <span>Python</span>
                                    <span>Power BI</span>
                                </div>

                                <div class="card-status">Coming Soon</div>
                            </div>
                        </article>

                        <!-- =====================================
                             AI IMPLEMENTATION PROJECT
                             ===================================== -->

                        <article class="other-project-card">
                            <div class="project-visual ai-visual">
                                <div class="ai-circle" aria-hidden="true">
                                    AI
                                </div>
                            </div>

                            <div class="other-project-body">
                                <h4>AI Implementation Project</h4>

                                <p>
                                    A practical project exploring how language
                                    models can support workflows, structured
                                    analysis, decision support, and useful
                                    automation.
                                </p>

                                <div class="tags">
                                    <span>AI</span>
                                    <span>Automation</span>
                                    <span>Operations</span>
                                </div>

                                <div class="card-status">Coming Soon</div>
                            </div>
                        </article>

                        <!-- =====================================
                             GYM PROGRESS SYSTEM
                             ===================================== -->

                        <a
                            class="other-project-card project-link"
                            href="/projects/gym-progress/"
                            aria-label="View the Gym Progress System case study"
                        >
                            <div class="project-visual gym-visual">
                                <span aria-hidden="true"> KG </span>
                            </div>

                            <div class="other-project-body">
                                <h4>
                                    Gym Progress System
                                    <span
                                        class="inline-arrow blue"
                                        aria-hidden="true"
                                    >
                                        →
                                    </span>
                                </h4>

                                <p>
                                    An Excel/VBA analytics system for tracking
                                    workouts, progression, historical data,
                                    diagnostics, and performance trends.
                                </p>

                                <div class="tags">
                                    <span>Excel</span>
                                    <span>VBA</span>
                                    <span>Analytics</span>
                                </div>

                                <div class="view-link">View case study ↗</div>
                            </div>
                        </a>
                    </div>
                </section>
            </section>

            <!-- =================================================
                 ABOUT
                 ================================================= -->

            <section
                id="about"
                class="section about"
                aria-labelledby="about-title"
            >
                <p class="eyebrow">02 — About</p>

                <h2 id="about-title">
                    Operations experience, with a systems mindset.
                </h2>

                <p class="section-lead">
                    I work at the intersection of marketplace operations,
                    process improvement, data, automation, and technology.
                </p>

                <p>
                    My background spans e-commerce, Excel/VBA, SQL, web
                    development, and practical technical operations. I’m
                    especially interested in building systems that make work
                    clearer, faster, and easier to run.
                </p>
            </section>

            <!-- =================================================
                 CONTACT
                 ================================================= -->

            <section
                id="contact"
                class="section contact"
                aria-labelledby="contact-title"
            >
                <p class="eyebrow">03 — Contact</p>

                <h2 id="contact-title">Let’s connect.</h2>

                <p class="section-lead">
                    Open to operations, marketplace, analyst, implementation,
                    automation, and technical-operations opportunities.
                </p>

                <p>
                    If you’d like to discuss a role, a project, or my work, feel
                    free to reach out.
                </p>

                <!-- Contact links -->
                <div class="contact-links">
                    <a class="text-link" href="mailto:kwstaszaf@hotmail.com">
                        Email me
                        <span aria-hidden="true">↗</span>
                    </a>

                    <a
                        class="text-link"
                        href="https://www.linkedin.com/in/konstantinos-zafeiropoulos-18011996/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        LinkedIn
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </section>
        </main>

        <!-- ===================================================
             FOOTER
             =================================================== -->

        <footer>
            <div class="footer-left">
                <strong>KZ</strong>

                <div>
                    <span> Konstantinos Zafiropoulos </span>

                    <small> Operations · Automation · Data · Web </small>
                </div>
            </div>

            <div class="footer-right">
                Built with Astro · Git/GitHub · VS Code · Netlify
            </div>
        </footer>
    </body>
</html>

<style>
    /* =========================================================
       DESIGN TOKENS
       ========================================================= */

    :root {
        --bg: #050d18;
        --bg-card: #071522;
        --bg-card-soft: #0a1928;

        --text: #e8eef5;
        --heading: #ffffff;

        --muted: #a9bbcc;
        --subtle: #71869a;

        --border: #1d354a;

        --blue: #168dff;
        --blue-light: #65baff;

        --orange: #ff8a00;

        --green: #26d5a2;

        --page-width: 1380px;

        color: var(--text);
        background: var(--bg);

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    /* =========================================================
       GLOBAL RESET / BASICS
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;

        margin: 0;

        color: var(--text);

        background:
            radial-gradient(
                circle at top right,
                rgba(22, 141, 255, 0.08),
                transparent 38rem
            ),
            var(--bg);
    }

    main,
    footer {
        width: min(100%, var(--page-width));

        margin-inline: auto;

        padding-left: clamp(1.5rem, 5vw, 5rem);
        padding-right: clamp(1.5rem, 5vw, 5rem);
    }

    a {
        color: inherit;
    }

    a:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
    }

    ::selection {
        color: white;
        background: rgba(255, 138, 0, 0.65);
    }

    /* =========================================================
       TYPOGRAPHY
       ========================================================= */

    h1,
    h2,
    h3,
    h4,
    p {
        margin-top: 0;
    }

    h1,
    h2,
    h3 {
        color: var(--heading);

        letter-spacing: -0.04em;
    }

    h1 {
        max-width: 900px;

        margin-bottom: 1.6rem;

        font-size: clamp(3.2rem, 7vw, 6.2rem);

        line-height: 0.96;
    }

    h2 {
        margin-bottom: 0.8rem;

        font-size: clamp(2.4rem, 4.5vw, 4rem);

        line-height: 1;
    }

    h3 {
        font-size: clamp(2rem, 3vw, 2.8rem);

        line-height: 1.05;
    }

    h4 {
        margin-bottom: 0.8rem;

        color: var(--heading);

        font-size: 1.2rem;

        line-height: 1.25;
    }

    .eyebrow,
    .featured-label {
        margin-bottom: 1rem;

        color: var(--orange);

        font-size: 0.75rem;
        font-weight: 800;

        letter-spacing: 0.09em;

        text-transform: uppercase;
    }

    /* =========================================================
       NAVIGATION
       ========================================================= */

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 74px;

        border-bottom: 1px solid rgba(29, 53, 74, 0.65);
    }

    .wordmark {
        color: white;

        font-size: 1.4rem;
        font-weight: 850;

        letter-spacing: -0.08em;

        text-decoration: none;
    }

    .wordmark span {
        color: var(--orange);
    }

    .nav-links {
        display: flex;

        gap: clamp(1rem, 3vw, 2.8rem);
    }

    .nav-links a {
        position: relative;

        color: var(--muted);

        font-size: 0.9rem;

        text-decoration: none;

        transition: color 0.2s ease;
    }

    .nav-links a::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: -0.35rem;

        width: 0;
        height: 1px;

        background: var(--blue);

        transition: width 0.2s ease;
    }

    .nav-links a:hover {
        color: white;
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    /* =========================================================
       HERO
       ========================================================= */

    .hero {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            minmax(220px, 0.28fr);

        align-items: center;

        gap: clamp(3rem, 8vw, 6rem);

        min-height: 70vh;

        padding: clamp(5rem, 10vw, 8rem) 0;
    }

    .hero-copy {
        max-width: 900px;
    }

    .hero-accent {
        display: inline;

        color: var(--blue);
    }

    .intro {
        max-width: 700px;

        color: var(--muted);

        font-size: clamp(1.02rem, 1.6vw, 1.25rem);

        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;

        gap: 0.8rem;

        margin-top: 2rem;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 0.55rem;

        min-height: 48px;

        padding: 0.85rem 1.3rem;

        border: 1px solid var(--blue);
        border-radius: 8px;

        font-size: 0.87rem;
        font-weight: 750;

        text-decoration: none;

        transition:
            transform 0.2s ease,
            background 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .button:hover {
        transform: translateY(-2px);
    }

    .button-primary {
        color: white;

        background: var(--blue);

        box-shadow: 0 10px 30px rgba(22, 141, 255, 0.14);
    }

    .button-primary:hover {
        background: #2397ff;

        box-shadow: 0 14px 34px rgba(22, 141, 255, 0.2);
    }

    .button-secondary {
        color: #dbe7f0;

        background: rgba(7, 21, 34, 0.75);
    }

    .button-secondary:hover {
        border-color: var(--blue-light);
    }

    /* =========================================================
       HERO NOTE
       ========================================================= */

    .hero-note {
        display: flex;
        align-items: flex-start;

        gap: 1rem;

        color: #cfd9e2;

        font-style: italic;

        line-height: 1.6;
    }

    .hero-note-line {
        flex: 0 0 2px;

        width: 2px;
        height: 56px;

        background: var(--blue);
    }

    .hero-note p {
        max-width: 220px;

        margin: 0;
    }

    /* =========================================================
       GENERAL SECTIONS
       ========================================================= */

    .section {
        padding: clamp(5rem, 9vw, 8rem) 0;

        border-top: 1px solid var(--border);
    }

    .section-heading {
        max-width: 780px;
    }

    .section-intro {
        max-width: 680px;

        color: var(--muted);

        font-size: 1rem;

        line-height: 1.6;
    }

    .section-lead {
        max-width: 760px;

        margin-bottom: 1rem;

        color: #dbe5ee;

        font-size: 1.08rem;
        font-weight: 500;

        line-height: 1.65;
    }

    /* =========================================================
       ROCKETEERS UMBRELLA
       ========================================================= */

    .rocketeers-feature {
        margin-top: 3rem;

        padding: clamp(1.3rem, 2.5vw, 2rem);

        border: 1px solid #1f5685;
        border-radius: 16px;

        background:
            radial-gradient(
                circle at 85% 10%,
                rgba(22, 141, 255, 0.15),
                transparent 34rem
            ),
            linear-gradient(135deg, #071624, #050e18);

        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
    }

    /* =========================================================
       ROCKETEERS HEADER
       ========================================================= */

    .rocketeers-hero {
        display: grid;

        grid-template-columns:
            minmax(0, 1.45fr)
            minmax(260px, 0.55fr);

        gap: 1.5rem;

        align-items: stretch;

        margin-bottom: 1.4rem;
    }

    .rocketeers-copy {
        padding: clamp(0.7rem, 2vw, 1.3rem);
    }

    .rocketeers-title-link {
        text-decoration: none;
    }

    .rocketeers-title-link h3 {
        margin-bottom: 0.7rem;

        font-size: clamp(2.8rem, 5vw, 4.8rem);

        transition: color 0.2s ease;
    }

    .rocketeers-title-link:hover h3 {
        color: #dcecff;
    }

    .rocketeers-title-link span {
        color: var(--orange);
    }

    .rocketeers-tagline {
        margin-bottom: 1.1rem;

        color: #e2ebf3;

        font-size: 1.18rem;
        font-weight: 650;
    }

    .rocketeers-description {
        max-width: 760px;

        color: var(--muted);

        line-height: 1.65;
    }

    /* =========================================================
       ROCKETEERS TEMPORARY VISUAL
       ========================================================= */

    .rocketeers-visual {
        display: flex;
        flex-direction: column;
        justify-content: space-between;

        min-height: 280px;

        padding: 1.4rem;

        border: 1px solid rgba(22, 141, 255, 0.28);
        border-radius: 12px;

        background:
            linear-gradient(
                145deg,
                rgba(22, 141, 255, 0.18),
                rgba(255, 138, 0, 0.04)
            ),
            #071522;
    }

    .visual-label {
        color: var(--orange);

