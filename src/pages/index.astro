---
const title =
    "Konstantinos Zafiropoulos | Marketplace Operations, Automation & Data";
---

<html lang="en">
    <head
        ><meta charset="utf-8" /><link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.svg"
        /><meta name="viewport" content="width=device-width" /><meta
            name="description"
            content="Portfolio of Konstantinos Zafiropoulos — marketplace operations, automation, and data."
        /><title>{title}</title></head
    ><body
        ><main>
            <nav aria-label="Primary navigation">
                <a class="wordmark" href="/">KZ<span>.</span></a><div
                    class="nav-links"
                >
                    <a href="#projects">Projects</a><a href="#about">About</a><a
                        href="#contact">Contact</a>
                </div>
            </nav><section class="hero" aria-labelledby="intro-title">
                <p class="eyebrow">
                    Marketplace operations · Automation · Data
                </p><h1 id="intro-title">Konstantinos<br />Zafiropoulos</h1><p
                    class="intro"
                >
                    I build practical systems that make complex operations
                    clearer, faster, and easier to run.
                </p><a class="text-link" href="#projects"
                    >Selected work <span aria-hidden="true">↓</span></a>
            </section><section
                id="projects"
                class="section projects"
                aria-labelledby="projects-title"
            >
                <div class="section-heading">
                    <p class="eyebrow">01 — Selected work</p><h2
                        id="projects-title"
                    >
                        Built through real operations.
                    </h2>
                </div><div class="project-grid">
                    <a href="/projects/rocketeers/" class="project-card-link">
                        <article>
                        <p class="project-number">01</p><h3>Rocketeers</h3><p>
                            A digital marketplace business operated from
                            2017–2024, serving customers across more than 20
                            countries.
                        </p><p class="project-meta">
                            Marketplace operations · Customer experience
                        </p>
                        </article>
                    </a>                    
                    <article>
                        <p class="project-number">02</p><h3>
                            Gym Progress System
                        </h3><p>
                            An Excel and VBA analytics system for turning
                            workout history into useful, visible progression.
                        </p><p class="project-meta">
                            Excel/VBA · Data quality · Automation
                        </p>
                    </article><article>
                        <p class="project-number">03</p><h3>
                            Job Application Tracker
                        </h3><p>
                            A tailored tracking workflow combining application
                            status, metrics, and automation in one workbook.
                        </p><p class="project-meta">
                            Workflow design · Excel/VBA
                        </p>
                    </article>
                </div>
            </section><section
                id="about"
                class="section about"
                aria-labelledby="about-title"
            >
                <p class="eyebrow">02 — About</p><h2 id="about-title">
                    Operations experience, with a systems mindset.
                </h2><p>
                    I work at the intersection of marketplace operations,
                    process improvement, data, and automation. My background
                    spans e-commerce, Excel/VBA, basic SQL, and technical
                    automation work.
                </p>
            </section><section
                id="contact"
                class="section contact"
                aria-labelledby="contact-title"
            >
                <p class="eyebrow">03 — Contact</p><h2 id="contact-title">
                    Let’s connect.
                </h2><p>
                    Available for operations, marketplace, analyst, automation,
                    and technical-operations opportunities.
                </p><a class="text-link" href="mailto:hello@example.com"
                    >Email me <span aria-hidden="true">↗</span></a>
            </section>
        </main><footer>
            <span>© {new Date().getFullYear()} Konstantinos Zafiropoulos</span
            ><span>Built with Astro</span>
        </footer></body>
</html>
<style>
    :root {
        color: #12221f;
        background: #f4f1e9;
        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }
    * {
        box-sizing: border-box;
    }
    html {
        scroll-behavior: smooth;
    }
    body {
        margin: 0;
    }
    main,
    footer {
        max-width: 1200px;
        margin: auto;
        padding-left: clamp(1.5rem, 5vw, 4.5rem);
        padding-right: clamp(1.5rem, 5vw, 4.5rem);
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.5rem;
    }
    a {
        color: inherit;
        text-underline-offset: 0.25em;
    }
    .wordmark {
        font-size: 1.3rem;
        font-weight: 800;
        text-decoration: none;
        letter-spacing: -0.08em;
    }
    .wordmark span,
    .text-link span {
        color: #e6562e;
    }
    .nav-links {
        display: flex;
        gap: clamp(1rem, 3vw, 2.5rem);
        font-size: 0.9rem;
    }
    .nav-links a {
        text-decoration: none;
    }
    .hero {
        min-height: 71vh;
        padding: clamp(5rem, 12vw, 10rem) 0 4rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    .eyebrow {
        margin: 0 0 1.25rem;
        color: #e6562e;
        font-size: 0.78rem;
        font-weight: 750;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }
    h1,
    h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
        letter-spacing: -0.055em;
    }
    h1 {
        max-width: 850px;
        margin-bottom: 1.5rem;
        font-size: clamp(3.6rem, 9vw, 7.4rem);
        line-height: 0.89;
    }
    h2 {
        font-size: clamp(2.2rem, 5vw, 4rem);
        line-height: 0.98;
    }
    .intro {
        max-width: 535px;
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        line-height: 1.55;
    }
    .text-link {
        margin-top: 1rem;
        font-weight: 700;
    }
    .text-link span {
        margin-left: 0.35rem;
    }
    .section {
        padding: clamp(4.5rem, 10vw, 8rem) 0;
        border-top: 1px solid #bac5bc;
    }
    .section-heading {
        max-width: 620px;
    }
    .project-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 3rem;
        border-top: 2px solid #12221f;
    }
    article {
        min-height: 270px;
        padding: 1.35rem 1.5rem 1.5rem 0;
        border-bottom: 1px solid #bac5bc;
    }
    article:not(:last-child) {
        border-right: 1px solid #bac5bc;
        padding-right: 1.5rem;
        margin-right: 1.5rem;
    }
    .project-number {
        color: #e6562e;
        font-size: 0.82rem;
        font-weight: 700;
    }
    h3 {
        margin-bottom: 0.9rem;
        font-size: 1.35rem;
    }
    article > p:not(.project-number):not(.project-meta),
    .about > p:not(.eyebrow),
    .contact > p:not(.eyebrow) {
        line-height: 1.55;
    }
    .project-meta {
        margin-top: 2rem;
        color: #53645d;
        font-size: 0.82rem;
    }
    .about > p:not(.eyebrow),
    .contact > p:not(.eyebrow) {
        max-width: 620px;
        font-size: 1.1rem;
    }
    .contact {
        padding-bottom: clamp(5rem, 12vw, 9rem);
    }
    footer {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        border-top: 1px solid #bac5bc;
        color: #53645d;
        font-size: 0.8rem;
    }
    @media (max-width: 720px) {
        .hero {
            min-height: 68vh;
        }
        .project-grid {
            grid-template-columns: 1fr;
        }
        article {
            min-height: auto;
            padding: 1.5rem 0;
        }
        article:not(:last-child) {
            border-right: 0;
            padding-right: 0;
            margin-right: 0;
        }
        .project-meta {
            margin: 1.5rem 0 0;
        }
    }
    .project-card-link {
  color: inherit;
  text-decoration: none;
    }
</style>
