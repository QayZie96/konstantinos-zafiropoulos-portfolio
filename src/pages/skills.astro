---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import { projects, skillsForUmbrella, umbrellas } from "../data/skills";

const title = "Skills | Konstantinos Zafiropoulos";
const description =
    "A project-backed view of the operations, Excel, VBA, analytics, AI automation, Python, data, and web skills demonstrated in Konstantinos Zafiropoulos's portfolio.";
---

<html lang="en">
    <head>
        <SeoHead {title} {description} />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <p class="eyebrow">Skills · Project evidence</p>
                <h1>Skills put into practice.</h1>
                <p class="hero-lead">
                    Every skill below links to completed work where it is
                    demonstrated. Select a skill to read the context and open
                    the supporting case studies.
                </p>
            </header>

            <nav class="skill-navigation" aria-label="Browse skill categories">
                {
                    umbrellas.map((umbrella, index) => (
                        <a
                            href={`#umbrella-${umbrella.id}`}
                            data-umbrella-link={umbrella.id}
                        >
                            <span aria-hidden="true">0{index + 1}</span>
                            <span>{umbrella.title}</span>
                        </a>
                    ))
                }
            </nav>

            <div class="skill-groups">
                {
                    umbrellas.map((umbrella, index) => (
                        <section
                            class="skill-group"
                            id={`umbrella-${umbrella.id}`}
                            aria-labelledby={`title-${umbrella.id}`}
                        >
                            <div class="section-heading">
                                <p class="eyebrow">
                                    0{index + 1} — Skill umbrella
                                </p>
                                <h2 id={`title-${umbrella.id}`}>
                                    {umbrella.title}
                                </h2>
                                <p>{umbrella.description}</p>
                            </div>

                            <div class="skill-list">
                                {skillsForUmbrella(umbrella.id).map((skill) => (
                                    <details class="skill-card" id={skill.id}>
                                        <summary>
                                            <span class="skill-card-title">
                                                {skill.label}
                                            </span>
                                            <span class="skill-card-meta">
                                                {skill.projects.length}{" "}
                                                {skill.projects.length === 1
                                                    ? "project"
                                                    : "projects"}
                                            </span>
                                            <span
                                                class="expand-icon"
                                                aria-hidden="true"
                                            >
                                                +
                                            </span>
                                        </summary>

                                        <div class="skill-content">
                                            <p>{skill.description}</p>
                                            <h3>Demonstrated in</h3>
                                            <ul>
                                                {skill.projects.map(
                                                    (projectId) => {
                                                        const project =
                                                            projects[projectId];
                                                        return (
                                                            <li>
                                                                <a
                                                                    href={
                                                                        project.href
                                                                    }
                                                                >
                                                                    {
                                                                        project.title
                                                                    }
                                                                    <span aria-hidden="true">
                                                                        →
                                                                    </span>
                                                                </a>
                                                            </li>
                                                        );
                                                    },
                                                )}
                                            </ul>
                                        </div>
                                    </details>
                                ))}
                            </div>
                        </section>
                    ))
                }
            </div>

            <section class="project-end">
                <p class="eyebrow">Portfolio</p>
                <h2>See the work behind the skills.</h2>
                <a href="/#projects"
                    >Explore all projects <span aria-hidden="true">→</span></a
                >
            </section>
        </main>

        <SiteFooter />

        <script is:inline>
            const openLinkedSkill = () => {
                if (!window.location.hash) return;
                const target = document.getElementById(
                    decodeURIComponent(window.location.hash.slice(1)),
                );
                if (target instanceof HTMLDetailsElement) {
                    target.open = true;
                }
            };

            openLinkedSkill();
            window.addEventListener("hashchange", openLinkedSkill);

            const categoryLinks = document.querySelectorAll(
                "[data-umbrella-link]",
            );
            const setActiveCategory = (id) => {
                categoryLinks.forEach((link) => {
                    link.toggleAttribute(
                        "aria-current",
                        link.dataset.umbrellaLink === id,
                    );
                });
            };

            const categoryObserver = new IntersectionObserver(
                (entries) => {
                    const visibleCategory = entries
                        .filter((entry) => entry.isIntersecting)
                        .sort(
                            (a, b) => b.intersectionRatio - a.intersectionRatio,
                        )[0];
                    if (visibleCategory)
                        setActiveCategory(
                            visibleCategory.target.id.replace("umbrella-", ""),
                        );
                },
                { rootMargin: "-20% 0px -65% 0px", threshold: [0, 0.15, 0.4] },
            );

            document
                .querySelectorAll(".skill-group")
                .forEach((group) => categoryObserver.observe(group));

            document.addEventListener(
                "toggle",
                (event) => {
                    const opened = event.target;
                    if (!(opened instanceof HTMLDetailsElement) || !opened.open)
                        return;
                    if (!opened.classList.contains("skill-card")) return;

                    opened
                        .closest(".skill-list")
                        ?.querySelectorAll(".skill-card[open]")
                        .forEach((detail) => {
                            if (
                                detail !== opened &&
                                detail instanceof HTMLDetailsElement
                            ) {
                                detail.open = false;
                            }
                        });
                },
                true,
            );

            document.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;
                const opened = document.querySelector(".skill-card[open]");
                if (!(opened instanceof HTMLDetailsElement)) return;

                opened.open = false;
                opened.querySelector("summary")?.focus();
            });
        </script>
    </body>
</html>

<style>
    :root {
        --bg: #06111e;
        --surface: #091b2b;
        --surface-strong: #0c2236;
        --border: #203f59;
        --heading: #ffffff;
        --text: #d8e4ee;
        --muted: #99adbd;
        --blue: #168dff;
        --orange: #ff8a00;
        --page-width: 1280px;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        background: var(--bg);
    }

    body {
        margin: 0;
        background:
            radial-gradient(
                circle at 50% 0,
                rgba(22, 141, 255, 0.09),
                transparent 34rem
            ),
            var(--bg);
        color: var(--text);
        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    main,
    footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;
        padding-inline: clamp(1.3rem, 5vw, 4.5rem);
    }

    a {
        color: inherit;
        text-underline-offset: 0.25em;
    }

    a:focus-visible,
    summary:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
        border-radius: 4px;
    }

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2 {
        color: var(--heading);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
        letter-spacing: -0.05em;
    }

    h1 {
        max-width: 900px;
        margin-bottom: 1.4rem;
        font-size: clamp(3.5rem, 8vw, 7rem);
        line-height: 0.94;
    }

    h2 {
        margin-bottom: 1rem;
        font-size: clamp(2.35rem, 5vw, 4.25rem);
        line-height: 1;
    }

    .eyebrow {
        margin-bottom: 1rem;
        color: var(--orange);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    .hero {
        padding: clamp(5rem, 10vw, 8rem) 0 clamp(3.5rem, 7vw, 5rem);
        text-align: center;
    }

    .hero h1,
    .hero-lead {
        margin-inline: auto;
    }

    .hero-lead {
        max-width: 760px;
        color: var(--muted);
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        line-height: 1.7;
    }

    .skill-navigation {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.7rem;
        margin-bottom: clamp(5rem, 10vw, 8rem);
        padding: 0.7rem;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: rgba(7, 22, 36, 0.76);
    }

    .skill-navigation a {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.65rem;
        align-items: center;
        min-height: 58px;
        padding: 0.75rem 0.85rem;
        border: 1px solid transparent;
        border-radius: 9px;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 750;
        line-height: 1.25;
        text-decoration: none;
        transition:
            border-color 0.2s ease,
            background 0.2s ease,
            color 0.2s ease;
    }

    .skill-navigation a > span:first-child {
        color: var(--orange);
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.08em;
    }

    .skill-navigation a:hover,
    .skill-navigation a[aria-current] {
        border-color: rgba(22, 141, 255, 0.65);
        background: rgba(22, 141, 255, 0.1);
        color: var(--heading);
    }

    .skill-group {
        scroll-margin-top: 6rem;
        display: grid;
        grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
        gap: clamp(2rem, 6vw, 6rem);
        padding: clamp(4rem, 8vw, 7rem) 0;
        border-top: 1px solid rgba(32, 63, 89, 0.82);
    }

    .section-heading {
        position: sticky;
        top: 6rem;
        align-self: start;
    }

    .section-heading > p:last-child {
        max-width: 480px;
        color: var(--muted);
        line-height: 1.7;
    }

    .skill-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
    }

    .skill-card {
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: linear-gradient(
            145deg,
            rgba(12, 34, 54, 0.94),
            rgba(7, 22, 36, 0.94)
        );
        overflow: hidden;
        transition:
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .skill-card:hover,
    .skill-card[open],
    .skill-card:target {
        border-color: var(--blue);
    }

    .skill-card[open] {
        grid-column: 1 / -1;
    }

    summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 0.75rem;
        align-items: center;
        min-height: 86px;
        padding: 1rem 1.1rem;
        cursor: pointer;
        color: var(--heading);
        list-style: none;
        transition: background 0.2s ease;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover,
    .skill-card[open] summary,
    .skill-card:target summary {
        background: rgba(22, 141, 255, 0.1);
    }

    .skill-card-title {
        font-size: 0.98rem;
        font-weight: 750;
        line-height: 1.35;
    }

    .skill-card-meta {
        color: var(--muted);
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .expand-icon {
        display: grid;
        width: 1.65rem;
        height: 1.65rem;
        place-items: center;
        border: 1px solid rgba(22, 141, 255, 0.55);
        border-radius: 50%;
        color: var(--blue);
        font-size: 1rem;
        font-weight: 800;
    }

    details[open] .expand-icon {
        transform: rotate(45deg);
    }

    .skill-content {
        width: 100%;
        margin-top: 0.8rem;
        padding: 1.15rem;
        border: 1px solid rgba(22, 141, 255, 0.55);
        border-radius: 11px;
        background: rgba(10, 32, 51, 0.96);
    }

    .skill-content > p {
        margin: 1.1rem 0 1.3rem;
        color: var(--muted);
        line-height: 1.7;
    }

    .skill-content h3 {
        margin-bottom: 0.7rem;
        color: var(--heading);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .skill-content ul {
        display: grid;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .skill-content a {
        display: inline-flex;
        gap: 0.5rem;
        align-items: baseline;
        color: #b9d9f7;
        font-weight: 700;
        text-decoration: none;
    }

    .skill-content a:hover {
        color: #ffffff;
        text-decoration: underline;
    }

    .project-end {
        padding: clamp(5rem, 10vw, 8rem) 0;
        border-top: 1px solid rgba(32, 63, 89, 0.82);
        text-align: center;
    }

    .project-end h2 {
        margin-inline: auto;
    }

    .project-end a {
        display: inline-flex;
        gap: 0.6rem;
        padding: 0.9rem 1.2rem;
        border: 1px solid var(--blue);
        border-radius: 8px;
        color: #ffffff;
        font-weight: 750;
        text-decoration: none;
    }

    .project-end a:hover {
        background: rgba(22, 141, 255, 0.14);
    }

    footer {
        padding-top: 1.5rem;
        padding-bottom: 2rem;
        border-top: 1px solid rgba(32, 63, 89, 0.72);
        color: var(--muted);
        font-size: 0.82rem;
        text-align: center;
    }

    @media (max-width: 780px) {
        .skill-group {
            grid-template-columns: 1fr;
        }

        .skill-navigation {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .section-heading {
            position: static;
        }
    }

    @media (max-width: 520px) {
        .hero {
            padding-top: 4rem;
        }

        .skill-group,
        .skill-card {
            scroll-margin-top: 8rem;
        }

        .skill-navigation {
            grid-template-columns: 1fr;
        }

        .skill-list {
            grid-template-columns: 1fr;
        }

        .skill-list {
            gap: 0.55rem;
        }

        summary {
            min-height: 44px;
            padding-inline: 0.78rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        .skill-navigation a,
        .skill-card,
        summary {
            transition: none;
        }
    }
</style>
