---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
    projects,
    skillsForUmbrella,
    umbrellas,
} from "../data/skills";

const title = "Skills | Konstantinos Zafiropoulos";
const description =
    "A project-backed view of the operations, Excel, VBA, analytics, AI automation, Python, data, and web skills demonstrated in Konstantinos Zafiropoulos's portfolio.";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <p class="eyebrow">Skills · Project evidence</p>
                <h1>Skills put into practice.</h1>
                <p class="hero-lead">
                    Every skill below links to completed work where it is
                    demonstrated. Select a skill to read the context and open
                    the supporting case studies.
                </p>
            </header>

            <nav class="umbrella-grid" aria-label="Skill categories">
                {umbrellas.map((umbrella, index) => (
                    <a href={`#umbrella-${umbrella.id}`}>
                        <span>0{index + 1}</span>
                        <strong>{umbrella.title}</strong>
                        <p>{umbrella.description}</p>
                    </a>
                ))}
            </nav>

            <div class="skill-groups">
                {umbrellas.map((umbrella, index) => (
                    <section
                        class="skill-group"
                        id={`umbrella-${umbrella.id}`}
                        aria-labelledby={`title-${umbrella.id}`}
                    >
                        <div class="section-heading">
                            <p class="eyebrow">0{index + 1} — Skill umbrella</p>
                            <h2 id={`title-${umbrella.id}`}>{umbrella.title}</h2>
                            <p>{umbrella.description}</p>
                        </div>

                        <div class="skill-list">
                            {skillsForUmbrella(umbrella.id).map((skill) => (
                                <details class="skill-detail" id={skill.id}>
                                    <summary>
                                        <span>{skill.label}</span>
                                        <span class="expand-icon" aria-hidden="true">+</span>
                                    </summary>

                                    <div class="skill-content">
                                        <p>{skill.description}</p>
                                        <h3>Demonstrated in</h3>
                                        <ul>
                                            {skill.projects.map((projectId) => {
                                                const project = projects[projectId];
                                                return (
                                                    <li>
                                                        <a href={project.href}>
                                                            {project.title}
                                                            <span aria-hidden="true">→</span>
                                                        </a>
                                                    </li>
                                                );
                                            })}
                                        </ul>
                                    </div>
                                </details>
                            ))}
                        </div>
                    </section>
                ))}
            </div>

            <section class="project-end">
                <p class="eyebrow">Portfolio</p>
                <h2>See the work behind the skills.</h2>
                <a href="/#projects">Explore all projects <span aria-hidden="true">→</span></a>
            </section>
        </main>

        <SiteFooter />

        <script is:inline>
            const openLinkedSkill = () => {
                if (!window.location.hash) return;
                const target = document.getElementById(
                    decodeURIComponent(window.location.hash.slice(1)),
                );
                if (target instanceof HTMLDetailsElement) {
                    target.open = true;
                }
            };

            openLinkedSkill();
            window.addEventListener("hashchange", openLinkedSkill);

            document.addEventListener("toggle", (event) => {
                const opened = event.target;
                if (!(opened instanceof HTMLDetailsElement) || !opened.open) return;
                if (!opened.classList.contains("skill-detail")) return;

                opened.closest(".skill-list")
                    ?.querySelectorAll(".skill-detail[open]")
                    .forEach((detail) => {
                        if (detail !== opened && detail instanceof HTMLDetailsElement) {
                            detail.open = false;
                        }
                    });
            }, true);

            document.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;
                const opened = document.querySelector(".skill-detail[open]");
                if (!(opened instanceof HTMLDetailsElement)) return;

                opened.open = false;
                opened.querySelector("summary")?.focus();
            });
        </script>
    </body>
</html>

<style>
    :root {
        --bg: #06111e;
        --surface: #091b2b;
        --surface-strong: #0c2236;
        --border: #203f59;
        --heading: #ffffff;
        --text: #d8e4ee;
        --muted: #99adbd;
        --blue: #168dff;
        --orange: #ff8a00;
        --page-width: 1280px;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        background: var(--bg);
    }

    body {
        margin: 0;
        background:
            radial-gradient(circle at 50% 0, rgba(22, 141, 255, 0.09), transparent 34rem),
            var(--bg);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    main,
    footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;
        padding-inline: clamp(1.3rem, 5vw, 4.5rem);
    }

    a {
        color: inherit;
        text-underline-offset: 0.25em;
    }

    a:focus-visible,
    summary:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
        border-radius: 4px;
    }

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2 {
        color: var(--heading);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
        letter-spacing: -0.05em;
    }

    h1 {
        max-width: 900px;
        margin-bottom: 1.4rem;
        font-size: clamp(3.5rem, 8vw, 7rem);
        line-height: 0.94;
    }

    h2 {
        margin-bottom: 1rem;
        font-size: clamp(2.35rem, 5vw, 4.25rem);
        line-height: 1;
    }

    .eyebrow {
        margin-bottom: 1rem;
        color: var(--orange);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    .hero {
        padding: clamp(5rem, 10vw, 8rem) 0 clamp(3.5rem, 7vw, 5rem);
        text-align: center;
    }

    .hero h1,
    .hero-lead {
        margin-inline: auto;
    }

    .hero-lead {
        max-width: 760px;
        color: var(--muted);
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        line-height: 1.7;
    }

    .umbrella-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        padding-bottom: clamp(5rem, 10vw, 8rem);
    }

    .umbrella-grid a {
        min-height: 220px;
        padding: clamp(1.4rem, 3vw, 2.2rem);
        border: 1px solid var(--border);
        border-radius: 15px;
        background: linear-gradient(145deg, rgba(12, 34, 54, 0.94), rgba(7, 22, 36, 0.94));
        text-decoration: none;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .umbrella-grid a:hover {
        border-color: var(--blue);
        transform: translateY(-2px);
    }

    .umbrella-grid span {
        display: block;
        margin-bottom: 1.4rem;
        color: var(--orange);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.08em;
    }

    .umbrella-grid strong {
        display: block;
        margin-bottom: 0.85rem;
        color: var(--heading);
        font-size: clamp(1.35rem, 2.5vw, 2rem);
    }

    .umbrella-grid p {
        margin-bottom: 0;
        color: var(--muted);
        line-height: 1.65;
    }

    .skill-group {
        scroll-margin-top: 6rem;
        display: grid;
        grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
        gap: clamp(2rem, 6vw, 6rem);
        padding: clamp(4rem, 8vw, 7rem) 0;
        border-top: 1px solid rgba(32, 63, 89, 0.82);
    }

    .section-heading {
        position: sticky;
        top: 6rem;
        align-self: start;
    }

    .section-heading > p:last-child {
        max-width: 480px;
        color: var(--muted);
        line-height: 1.7;
    }

    .skill-list {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 0.7rem;
    }

    .skill-detail {
        scroll-margin-top: 6rem;
        min-width: 0;
    }

    .skill-detail[open] {
        flex: 1 0 100%;
    }

    summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        min-height: 44px;
        padding: 0.7rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(9, 27, 43, 0.82);
        cursor: pointer;
        color: var(--heading);
        font-size: 0.86rem;
        font-weight: 700;
        list-style: none;
        transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover,
    .skill-detail[open] summary,
    .skill-detail:target summary {
        border-color: var(--blue);
        background: rgba(22, 141, 255, 0.12);
        transform: translateY(-1px);
    }

    .expand-icon {
        color: var(--blue);
        font-size: 1rem;
        font-weight: 800;
    }

    details[open] .expand-icon {
        transform: rotate(45deg);
    }

    .skill-content {
        width: 100%;
        margin-top: 0.8rem;
        padding: 1.15rem;
        border: 1px solid rgba(22, 141, 255, 0.55);
        border-radius: 11px;
        background: rgba(10, 32, 51, 0.96);
    }

    .skill-content > p {
        margin: 1.1rem 0 1.3rem;
        color: var(--muted);
        line-height: 1.7;
    }

    .skill-content h3 {
        margin-bottom: 0.7rem;
        color: var(--heading);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .skill-content ul {
        display: grid;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .skill-content a {
        display: inline-flex;
        gap: 0.5rem;
        align-items: baseline;
        color: #b9d9f7;
        font-weight: 700;
        text-decoration: none;
    }

    .skill-content a:hover {
        color: #ffffff;
        text-decoration: underline;
    }

    .project-end {
        padding: clamp(5rem, 10vw, 8rem) 0;
        border-top: 1px solid rgba(32, 63, 89, 0.82);
        text-align: center;
    }

    .project-end h2 {
        margin-inline: auto;
    }

    .project-end a {
        display: inline-flex;
        gap: 0.6rem;
        padding: 0.9rem 1.2rem;
        border: 1px solid var(--blue);
        border-radius: 8px;
        color: #ffffff;
        font-weight: 750;
        text-decoration: none;
    }

    .project-end a:hover {
        background: rgba(22, 141, 255, 0.14);
    }

    footer {
        padding-top: 1.5rem;
        padding-bottom: 2rem;
        border-top: 1px solid rgba(32, 63, 89, 0.72);
        color: var(--muted);
        font-size: 0.82rem;
        text-align: center;
    }

    @media (max-width: 780px) {
        .umbrella-grid,
        .skill-group {
            grid-template-columns: 1fr;
        }

        .umbrella-grid a {
            min-height: 0;
        }

        .section-heading {
            position: static;
        }
    }

    @media (max-width: 520px) {
        .hero {
            padding-top: 4rem;
        }

        .skill-group,
        .skill-detail {
            scroll-margin-top: 8rem;
        }

        .umbrella-grid {
            grid-template-columns: 1fr;
        }

        .skill-list {
            gap: 0.55rem;
        }

        summary {
            min-height: 44px;
            padding-inline: 0.78rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        .umbrella-grid a {
            transition: none;
        }

        summary {
            transition: none;
        }
    }
</style>
