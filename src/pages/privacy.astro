---
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const title = "Privacy Notice | Konstantinos Zafiropoulos";
const description =
    "Privacy information for the Konstantinos Zafiropoulos portfolio, including optional Google Analytics measurement and consent choices.";
---

<html lang="en">
    <head>
        <SeoHead {title} {description} />
    </head>
    <body>
        <main>
            <SiteHeader />
            <article class="privacy-page">
                <p class="eyebrow">Privacy</p>
                <h1>Your analytics choice stays under your control.</h1>
                <p class="intro">
                    This portfolio uses optional Google Analytics 4 only after
                    you select “Allow analytics” in the privacy prompt.
                </p>

                <section>
                    <h2>What is measured</h2>
                    <p>
                        If you consent, Google Analytics records aggregated
                        information such as page views, approximate traffic
                        source, device category, scrolling, outbound-link clicks,
                        and file downloads. This helps identify which portfolio
                        pages and projects are useful.
                    </p>
                </section>

                <section>
                    <h2>What is not intentionally collected</h2>
                    <p>
                        The site does not intentionally send names, email
                        addresses, application-company names, form contents, or
                        other personally identifying information to Google
                        Analytics. Advertising signals and ad personalisation are
                        disabled in the site configuration.
                    </p>
                </section>

                <section>
                    <h2>Consent and storage</h2>
                    <p>
                        Analytics is disabled by default. Your choice is stored
                        in your browser so the site can remember it. If you allow
                        analytics, Google Analytics may set measurement cookies.
                        If you decline, the Google Analytics script is not loaded.
                    </p>
                </section>

                <section>
                    <h2>Change your choice</h2>
                    <p>
                        Use the <strong>Privacy choices</strong> button in the
                        lower-right corner of any page. Declining after previously
                        allowing analytics removes accessible GA cookies and
                        reloads the page with analytics disabled.
                    </p>
                </section>

                <section>
                    <h2>Service provider</h2>
                    <p>
                        Analytics data is processed by Google under its Google
                        Analytics terms and privacy controls. The site uses the
                        GA4 property identified by <code>G-S8MHHW0ZCH</code>.
                    </p>
                </section>
            </article>
        </main>
        <SiteFooter />
    </body>
</html>

<style>
    :root {
        --bg: #050d18;
        --text: #e8eef5;
        --muted: #a9bbcc;
        --border: #1d354a;
        --blue: #168dff;
        --orange: #ff8a00;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--text);
        background: var(--bg);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--text); }
    main { min-height: calc(100vh - 120px); }
    :global(.site-nav) {
        width: min(calc(100% - 2rem), 1240px);
        margin-inline: auto;
    }

    .privacy-page {
        width: min(calc(100% - 2rem), 800px);
        margin-inline: auto;
        padding: clamp(4rem, 9vw, 7rem) 0;
    }

    .eyebrow {
        margin: 0 0 1rem;
        color: var(--orange);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h1 {
        max-width: 720px;
        margin: 0;
        font-size: clamp(2.35rem, 7vw, 4.8rem);
        line-height: 0.98;
        letter-spacing: -0.055em;
    }

    .intro {
        max-width: 680px;
        margin: 1.5rem 0 3rem;
        color: #dce6ee;
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        line-height: 1.65;
    }

    section {
        padding: 1.5rem 0;
        border-top: 1px solid var(--border);
    }

    h2 {
        margin: 0 0 0.65rem;
        color: #ffffff;
        font-size: 1.2rem;
    }

    p {
        margin: 0;
        color: var(--muted);
        line-height: 1.75;
    }

    code {
        color: #65baff;
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    }
</style>
