---
/* =========================================================
   PRINT PRICE CALCULATOR: CASE STUDY
   The pricing maths below matches the live app (checked
   against its default quote: production €12.05, floor €13.72,
   suggested €19.99, profit €5.64).
   ========================================================= */
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";
import "../../styles/case-study.css";

const appUrl = "https://3dpricingcalculator.netlify.app/";

const title =
    "3D Print Price Calculator | Pricing Web App with Subscriptions | Konstantinos Zafeiropoulos";

const description =
    "A live web app that prices 3D prints from filament, electricity, machine wear, failed prints, labour and platform fees, with a Pro subscription set up in RevenueCat.";

const metrics = [
    { value: "6", label: "cost lines in every quote" },
    { value: "3", label: "prices: break-even, suggested, profit" },
    { value: "2", label: "plans: Free and Pro (monthly or annual)" },
    { value: "3", label: "subscription issues found and fixed" },
];

const fields = [
    { id: "weight", label: "Model weight (g)", value: 250, step: 1 },
    { id: "hours", label: "Print time (h)", value: 6, step: 0.5 },
    { id: "filament", label: "Filament €/kg", value: 22, step: 0.5 },
    { id: "watts", label: "Printer power (W)", value: 180, step: 10 },
    { id: "kwh", label: "Electricity €/kWh", value: 0.2, step: 0.01 },
    { id: "printer", label: "Printer price (€)", value: 1200, step: 50 },
    { id: "lifetime", label: "Printer lifetime (h)", value: 5000, step: 100 },
    { id: "maint", label: "Maintenance €/h", value: 0.05, step: 0.01 },
    { id: "fail", label: "Failure rate (%)", value: 5, step: 1 },
    { id: "labourMin", label: "Labour (min)", value: 15, step: 1 },
    { id: "labourRate", label: "Labour €/h", value: 12, step: 0.5 },
    { id: "packaging", label: "Packaging (€)", value: 1.2, step: 0.1 },
    { id: "fees", label: "Platform fees (%)", value: 10, step: 0.5 },
    { id: "fixed", label: "Fixed fee per order (€)", value: 0.3, step: 0.05 },
    { id: "margin", label: "Target margin (%)", value: 25, step: 1 },
];

const formula = [
    ["Filament", "weight × price per kg"],
    ["Electricity", "printer watts × hours × price per kWh"],
    ["Machine wear", "(printer price ÷ lifetime hours + maintenance per hour) × hours"],
    ["Failed print buffer", "the three costs above × failure rate ÷ (1 − failure rate), so failures are paid for by the prints that succeed"],
    ["Labour and packaging", "minutes of hands-on time at an hourly rate, plus packaging"],
    ["Break-even price", "(production cost + fixed order fee) ÷ (1 − platform fee %)"],
    ["Suggested price", "(production cost + fixed fee) ÷ (1 − platform fee % − target margin %), rounded up to .99"],
];

const plans = [
    ["Single quote with full cost breakdown", "✓", "✓"],
    ["Break-even, suggested price and profit per sale", "✓", "✓"],
    ["Saved printer and material profiles", "", "✓"],
    ["Purge waste in the cost", "", "✓"],
    ["STL upload with 3D preview and weight estimate", "", "✓"],
    ["Batch quotes and CSV export", "", "✓"],
];

const lessons = [
    {
        title: "The purchase went through, but nothing unlocked",
        text: "My entitlement was named \"Pro\" while the app checked \"pro\", and no products were attached to it. Apps check entitlements, not products: when a purchase shows in the customer timeline but access isn't granted, check the entitlement mapping first.",
    },
    {
        title: "Only the monthly plan showed",
        text: "The annual product existed in the catalogue but wasn't a package in the current offering. The catalogue alone isn't enough; the offering decides what the app sees.",
    },
    {
        title: "A failed paywall froze the page",
        text: "When the dashboard paywall couldn't load, the SDK left an invisible full-screen layer that blocked every click. The fix cleans up after the error, shows the reason on screen and falls back to the app's own plan picker.",
    },
];
---

<html lang="en">
    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <a class="back-link" href="/#projects">← Back to projects</a>

                <p class="eyebrow">Live web app · Pricing · Subscriptions (RevenueCat)</p>

                <h1>3D Print Price Calculator</h1>

                <p class="hero-subtitle">
                    A web app that turns the hidden costs of a 3D print into a
                    break-even price, a suggested price and the profit per sale,
                    with a Pro subscription for heavier users.
                </p>

                <SkillLinks
                    variant="hero"
                    skills={["pricing-operations", "commercial-analysis", "html-css", "netlify"]}
                />

                <div class="button-row">
                    <a class="button button-primary" href={appUrl} target="_blank" rel="noopener noreferrer">
                        Open the live app <span aria-hidden="true">↗</span>
                    </a>
                    <a class="button" href="#try-it">Try the pricing maths here</a>
                </div>
            </header>

            <section class="metrics" aria-label="3D Print Price Calculator in numbers">
                {metrics.map((metric) => (
                    <article class="metric-card">
                        <strong>{metric.value}</strong>
                        <span>{metric.label}</span>
                    </article>
                ))}
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">01 — Why</p>
                </div>
                <div class="section-content">
                    <h2>Most small sellers price on filament and guesswork.</h2>
                    <p class="lead">
                        The filament is the obvious cost. Electricity, machine wear,
                        failed prints, labour, packaging and marketplace fees are not,
                        and together they are often more than half the real cost.
                    </p>
                    <p>
                        Pricing was the core of my marketplace business for seven
                        years, so I built the tool I would have wanted: put in the
                        print, see what it really costs, and get a price that covers
                        fees and still leaves a margin. I also used it to learn how
                        app subscriptions work end to end, from products to paywall.
                    </p>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">02 — The app</p>
                </div>
                <div class="section-content">
                    <h2>One screen: inputs on the left, the quote on the right.</h2>
                    <figure class="shot">
                        <img
                            src="/images/projects/print-price-calculator/app.webp"
                            width="1280"
                            height="1226"
                            loading="lazy"
                            alt="3D Print Price Calculator with print, machine and selling inputs on the left, and a quote on the right showing a break-even price of €13.72, a suggested price of €19.99 and €5.64 profit per sale, above locked Pro panels for model upload and batch quotes."
                        />
                        <figcaption>
                            The free tier: a full quote and cost breakdown. Pro panels
                            (model upload, batch quotes) unlock with the subscription.
                            Payments run in RevenueCat test mode, so no real money moves.
                        </figcaption>
                    </figure>
                </div>
            </section>

            <section class="case-section" id="try-it">
                <div class="section-label">
                    <p class="eyebrow">03 — Try it</p>
                </div>
                <div class="section-content">
                    <h2>The same pricing maths, live on this page.</h2>
                    <p>Change any number; the quote updates as you type. The defaults are the app's own example.</p>

                    <div class="calc" data-calc>
                        <form class="calc-inputs" aria-label="Print inputs" onsubmit="return false">
                            {fields.map((f) => (
                                <label>
                                    <span>{f.label}</span>
                                    <input type="number" inputmode="decimal" min="0" step={f.step} value={f.value} data-field={f.id} />
                                </label>
                            ))}
                            <label class="check">
                                <input type="checkbox" checked data-field="round" />
                                <span>Round suggested price up to .99</span>
                            </label>
                        </form>

                        <div class="calc-quote" aria-live="polite">
                            <div class="quote-tiles">
                                <div><span>Break-even</span><strong data-out="floor">€13.72</strong></div>
                                <div class="is-main"><span>Suggested price</span><strong data-out="price">€19.99</strong></div>
                                <div><span>Profit per sale</span><strong data-out="profit">€5.64</strong></div>
                            </div>
                            <table>
                                <tbody>
                                    <tr><td>Filament</td><td data-out="filamentCost">€5.50</td></tr>
                                    <tr><td>Electricity</td><td data-out="power">€0.22</td></tr>
                                    <tr><td>Machine wear and maintenance</td><td data-out="wear">€1.74</td></tr>
                                    <tr><td>Failed print buffer</td><td data-out="failCost">€0.39</td></tr>
                                    <tr><td>Labour</td><td data-out="labour">€3.00</td></tr>
                                    <tr><td>Packaging</td><td data-out="pack">€1.20</td></tr>
                                    <tr class="total"><td>Production cost</td><td data-out="cost">€12.05</td></tr>
                                </tbody>
                            </table>
                            <p class="calc-warning" data-out="warning" hidden></p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">04 — The maths</p>
                </div>
                <div class="section-content">
                    <h2>How a price is built.</h2>
                    <p>The same thinking as my marketplace repricing engine: start from real costs, add the platform's cut, then the margin.</p>
                    <div class="table-wrap">
                        <table>
                            <tbody>
                                {formula.map(([name, rule]) => (
                                    <tr>
                                        <td><strong>{name}</strong></td>
                                        <td>{rule}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    <p class="note">
                        Fees are a percentage of the selling price, so they are divided
                        out rather than added on. Adding 10% on top of cost would leave
                        the seller short on every sale.
                    </p>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">05 — Free and Pro</p>
                </div>
                <div class="section-content">
                    <h2>A free tool that's useful on its own, and a reason to upgrade.</h2>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr><th>Feature</th><th>Free</th><th>Pro</th></tr>
                            </thead>
                            <tbody>
                                {plans.map(([feature, free, pro]) => (
                                    <tr>
                                        <td>{feature}</td>
                                        <td class="num">{free}</td>
                                        <td class="num">{pro}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">06 — Subscriptions</p>
                </div>
                <div class="section-content">
                    <h2>Set up in RevenueCat, tested end to end.</h2>
                    <p>
                        I configured the subscription side myself in RevenueCat's
                        test store, then bought plans and checked access in the
                        app until every path worked.
                    </p>
                    <ol class="flow" aria-label="How a purchase unlocks Pro">
                        <li><strong>Products</strong><span>Pro monthly and Pro annual</span></li>
                        <li><strong>Entitlement</strong><span>"pro", with both products attached</span></li>
                        <li><strong>Offering</strong><span>Both plans as packages in the default offering</span></li>
                        <li><strong>Paywall</strong><span>Shown from the dashboard, with the app's own plan picker as fallback</span></li>
                        <li><strong>App</strong><span>Checks the "pro" entitlement and unlocks the Pro panels</span></li>
                    </ol>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">07 — What broke</p>
                </div>
                <div class="section-content">
                    <h2>Three problems, and what each one taught me.</h2>
                    <div class="decision-list">
                        {lessons.map((l, i) => (
                            <article>
                                <span class="card-number">0{i + 1}</span>
                                <h3>{l.title}</h3>
                                <p>{l.text}</p>
                            </article>
                        ))}
                    </div>
                    <p class="note">
                        The pattern: most "subscriptions aren't working" moments are
                        configuration, not code. Walking through products, entitlement
                        and offering in that order finds them fastest.
                    </p>
                </div>
            </section>

            <section class="project-end">
                <p class="eyebrow">More work</p>
                <h2>Explore the rest of the portfolio.</h2>
                <a class="text-link" href="/#projects">
                    Back to selected work <span aria-hidden="true">→</span>
                </a>
            </section>
        </main>

        <SiteFooter />

        <script>
            const euro = (n: number) => "€" + (Number.isFinite(n) ? n : 0).toFixed(2);

            document.querySelectorAll<HTMLElement>("[data-calc]").forEach((root) => {
                const read = (id: string) => {
                    const el = root.querySelector<HTMLInputElement>(`[data-field="${id}"]`);
                    const v = parseFloat(el?.value ?? "");
                    return Number.isFinite(v) && v >= 0 ? v : 0;
                };
                const out = (id: string) => root.querySelector<HTMLElement>(`[data-out="${id}"]`)!;

                const update = () => {
                    const hours = read("hours");
                    const filamentCost = (read("weight") / 1000) * read("filament");
                    const power = (read("watts") / 1000) * hours * read("kwh");
                    const lifetime = read("lifetime");
                    const wear = ((lifetime > 0 ? read("printer") / lifetime : 0) + read("maint")) * hours;
                    const failRate = Math.min(read("fail"), 90) / 100;
                    const failCost = (filamentCost + power + wear) * (failRate / (1 - failRate));
                    const labour = (read("labourMin") / 60) * read("labourRate");
                    const pack = read("packaging");
                    const cost = filamentCost + power + wear + failCost + labour + pack;

                    const fee = read("fees") / 100;
                    const margin = read("margin") / 100;
                    const fixed = read("fixed");
                    const warning = out("warning");

                    const floor = fee < 1 ? (cost + fixed) / (1 - fee) : NaN;
                    let price = fee + margin < 1 ? (cost + fixed) / (1 - fee - margin) : NaN;
                    const round = root.querySelector<HTMLInputElement>('[data-field="round"]')?.checked;
                    if (round && Number.isFinite(price)) price = Math.floor(price) + 0.99 >= price ? Math.floor(price) + 0.99 : Math.ceil(price) + 0.99;
                    const profit = price * (1 - fee) - fixed - cost;

                    if (!Number.isFinite(price)) {
                        warning.hidden = false;
                        warning.textContent = "Platform fees and target margin add up to 100% or more, so no price can cover them.";
                    } else {
                        warning.hidden = true;
                    }

                    out("filamentCost").textContent = euro(filamentCost);
                    out("power").textContent = euro(power);
                    out("wear").textContent = euro(wear);
                    out("failCost").textContent = euro(failCost);
                    out("labour").textContent = euro(labour);
                    out("pack").textContent = euro(pack);
                    out("cost").textContent = euro(cost);
                    out("floor").textContent = Number.isFinite(floor) ? euro(floor) : "—";
                    out("price").textContent = Number.isFinite(price) ? euro(price) : "—";
                    out("profit").textContent = Number.isFinite(profit) ? euro(profit) : "—";
                };

                root.addEventListener("input", update);
                root.addEventListener("change", update);
                update();
            });
        </script>
    </body>
</html>

<style>
    .calc {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 1rem;
        margin-top: 1.4rem;
    }

    .calc-inputs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
        padding: 1.2rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: rgba(10, 26, 43, 0.5);
    }

    .calc-inputs label { display: grid; gap: 0.3rem; color: var(--color-muted); font-size: 0.8rem; font-weight: 650; }

    .calc-inputs input[type="number"] {
        width: 100%;
        min-height: 40px;
        padding: 0.45rem 0.6rem;
        border: 1px solid #2a4560;
        border-radius: 8px;
        color: #ffffff;
        background: #071423;
        font: inherit;
        font-size: 0.95rem;
    }

    .calc-inputs input:focus-visible { outline: 2px solid var(--color-orange); outline-offset: 1px; }

    .calc-inputs .check {
        display: flex;
        grid-column: 1 / -1;
        align-items: center;
        gap: 0.5rem;
    }

    .calc-inputs .check input { width: 18px; height: 18px; accent-color: var(--color-orange); }

    .calc-quote {
        align-self: start;
        padding: 1.2rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: rgba(10, 26, 43, 0.7);
    }

    .quote-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; margin-bottom: 1rem; }

    .quote-tiles div {
        padding: 0.7rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: #071423;
    }

    .quote-tiles .is-main { border-color: var(--color-orange); background: rgba(255, 138, 0, 0.1); }

    .quote-tiles span { display: block; color: var(--color-muted); font-size: 0.72rem; }
    .quote-tiles strong { color: #ffffff; font-size: clamp(1.05rem, 2.2vw, 1.35rem); }
    .quote-tiles .is-main strong { color: var(--color-orange); }

    .calc-quote table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .calc-quote td { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-muted); }
    .calc-quote td:last-child { color: #ffffff; text-align: right; font-variant-numeric: tabular-nums; }
    .calc-quote tr.total td { border-bottom: 0; color: #ffffff; font-weight: 800; }

    .calc-warning { margin: 0.8rem 0 0; color: #ff8f93; font-size: 0.88rem; }

    .flow {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.6rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
        counter-reset: flow;
    }

    .flow li {
        position: relative;
        padding: 1rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: rgba(10, 26, 43, 0.5);
        counter-increment: flow;
    }

    .flow li::before {
        content: counter(flow, decimal-leading-zero);
        display: block;
        margin-bottom: 0.3rem;
        color: var(--color-orange);
        font-size: 0.74rem;
        font-weight: 800;
    }

    .flow strong { display: block; color: #ffffff; font-size: 0.95rem; }
    .flow span { color: var(--color-muted); font-size: 0.82rem; line-height: 1.5; }

    @media (max-width: 900px) {
        .calc { grid-template-columns: 1fr; }
        .flow { grid-template-columns: 1fr; }
    }

    @media (max-width: 420px) {
        .calc-inputs { grid-template-columns: 1fr; }
        .quote-tiles { grid-template-columns: 1fr; }
    }
</style>
