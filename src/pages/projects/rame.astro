---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";

const title =
    "RAMÉ Creative Space | WordPress & WooCommerce Client Project | Konstantinos Zafeiropoulos";

const description =
    "An in-progress client e-commerce project developed with WordPress, WooCommerce, Elementor, Blocksy, plugins, and targeted CSS.";

const projectFacts = [
    { label: "Role", value: "WordPress & E-commerce Website Developer", tone: "pink" },
    { label: "Project", value: "Client e-commerce website", tone: "butter" },
    { label: "Stack", value: "WordPress · WooCommerce · Elementor", tone: "mint" },
    { label: "Status", value: "In progress", tone: "lilac" },
];

const highlights = [
    {
        number: "01",
        title: "Brand-led homepage",
        text: "Built a responsive homepage around the client's imagery, typography, palette, product messaging, calls to action, and value propositions.",
    },
    {
        number: "02",
        title: "Custom-order inquiries",
        text: "Created a dedicated page and structured form for personalized products, covering practical details such as dimensions, colours, quantity, timing, and budget.",
    },
    {
        number: "03",
        title: "Branded side cart",
        text: "Configured a WooCommerce side-cart plugin and used targeted CSS to align its hierarchy, product cards, quantity controls, and checkout actions with the RAMÉ identity.",
    },
    {
        number: "04",
        title: "Safer development workflow",
        text: "Maintained a separate WordPress Studio copy for experimentation, plugin review, compatibility checks, backups, and troubleshooting away from the hosted installation.",
    },
];

const shots = [
    {
        src: "/images/projects/rame/homepage-hero.webp",
        width: 1440,
        height: 730,
        label: "ramé · homepage",
        sticker: "the hero I rebuilt",
        className: "shot-hero",
        alt: "RAMÉ homepage hero with a green squiggle, pink RAMÉ wordmark, yellow star and the headline Some spaces were never meant to be boring.",
        caption: "Homepage hero rebuilt with an image widget and separate content layers, so it stays sharp and uncropped on desktop and mobile.",
    },
    {
        src: "/images/projects/rame/mobile-home.webp",
        width: 780,
        height: 1560,
        label: "phone",
        sticker: "mobile ✦",
        className: "shot-mobile",
        alt: "RAMÉ homepage on a phone-width screen, with the hero artwork, headline and two stacked call-to-action buttons.",
        caption: "The same homepage at phone width.",
    },
    {
        src: "/images/projects/rame/custom-orders.webp",
        width: 1440,
        height: 730,
        label: "ramé · custom orders",
        sticker: "got an idea?",
        className: "shot-custom",
        alt: "RAMÉ Custom Orders page with a playful green Customise your order heading and a speech-bubble prompt.",
        caption: "Custom Orders landing section that sets the tone before the inquiry form.",
    },
    {
        src: "/images/projects/rame/side-cart.webp",
        width: 405,
        height: 900,
        label: "side cart",
        sticker: "on-brand cart",
        className: "shot-cart",
        alt: "RAMÉ side cart drawer with a pink Your Cart header, empty-cart illustration, trust badges and a Keep Shopping button.",
        caption: "WooCommerce side cart restyled in RAMÉ colours, with trust badges.",
    },
    {
        src: "/images/projects/rame/custom-orders-form.webp",
        width: 1440,
        height: 780,
        label: "ramé · inquiry form",
        sticker: "structured brief",
        className: "shot-form",
        alt: "RAMÉ custom-order inquiry form with fields for name, contact details, vision, dimensions, colours, quantity and deadline.",
        caption: "Structured inquiry form for dimensions, colours, quantity, timing, references and budget.",
    },
];
---

<html lang="en">
    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <div class="breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span aria-hidden="true">→</span>
                    <strong>RAMÉ Creative Space</strong>
                </div>

                <div class="rame-board">
                    <svg class="shape squiggle" viewBox="0 0 260 150" aria-hidden="true">
                        <path d="M18 120 C 40 10, 80 10, 100 80 S 160 150, 180 70 S 230 0, 245 40" class="squiggle-outline" />
                        <path d="M18 120 C 40 10, 80 10, 100 80 S 160 150, 180 70 S 230 0, 245 40" class="squiggle-fill" />
                    </svg>
                    <span class="shape blob blob-pink" aria-hidden="true"></span>
                    <span class="shape blob blob-pink-small" aria-hidden="true"></span>
                    <span class="shape blob blob-lilac" aria-hidden="true"></span>

                    <button class="star" type="button" aria-label="Spin the star">
                        <svg viewBox="0 0 100 100" aria-hidden="true">
                            <path d="M50 4 L60 40 L96 50 L60 60 L50 96 L40 60 L4 50 L40 40 Z" />
                        </svg>
                    </button>

                    <p class="board-eyebrow">Client project · WordPress · E-commerce</p>

                    <h1>
                        <span class="rame-word">RAMÉ</span>
                        <span class="rame-pill">Creative Space</span>
                    </h1>

                    <p class="hero-subtitle">
                        Building a playful, responsive WooCommerce store for a
                        creative 3D-printing brand.
                    </p>

                    <p class="hand-note" aria-hidden="true">oh hi! ✦ tap the star</p>
                </div>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "wordpress",
                        "woocommerce",
                        "elementor",
                        "theme-customization",
                        "responsive-web-design",
                    ]}
                />
            </header>

            <section class="facts" aria-label="RAMÉ project information">
                {projectFacts.map((fact) => (
                    <article class={`sticker tone-${fact.tone}`}>
                        <span>{fact.label}</span>
                        <strong>{fact.value}</strong>
                    </article>
                ))}
            </section>

            <section class="case-section overview" aria-labelledby="rame-overview">
                <div class="section-heading">
                    <p class="eyebrow">01 — Overview</p>
                    <h2 id="rame-overview">A real client storefront with a distinctive visual direction.</h2>
                </div>

                <div class="overview-grid">
                    <article class="copy-card">
                        <p class="lead">
                            RAMÉ Creative Space is a creative brand offering
                            3D-printed décor, lighting, gifts, digital designs,
                            and custom-made products.
                        </p>
                        <p>
                            I have been developing and adapting its WordPress
                            and WooCommerce website to the client's visual style
                            and functional requirements. My work combines
                            Elementor page development, e-commerce
                            configuration, plugin integration, targeted CSS,
                            and practical website maintenance.
                        </p>
                        <p>
                            The brand, products, and core visual identity belong
                            to the client. My role is translating that direction
                            into a coherent, usable online shop, not claiming to
                            have built WooCommerce or the brand itself from
                            scratch.
                        </p>
                    </article>

                    <article class="brand-preview" aria-label="RAMÉ visual direction represented with colour and typography">
                        <span class="preview-label">Visual direction</span>
                        <strong>RAMÉ</strong>
                        <p>Objects with a little too much personality.</p>
                        <div class="swatches" aria-hidden="true">
                            <span class="cream"></span>
                            <span class="green"></span>
                            <span class="pink"></span>
                            <span class="lilac"></span>
                            <span class="yellow"></span>
                            <span class="plum"></span>
                        </div>
                    </article>
                </div>
            </section>

            <section class="case-section peek-section" aria-labelledby="rame-peek">
                <div class="section-heading centered-heading">
                    <p class="eyebrow">02 — A peek at the store</p>
                    <h2 id="rame-peek">Some spaces were never meant to be boring.</h2>
                    <p>
                        Screenshots from the development build. Select any
                        screen to open it full size.
                    </p>
                </div>

                <div class="peek-board">
                    {shots.map((shot) => (
                        <figure class={`shot ${shot.className}`}>
                            <span class="shot-sticker" aria-hidden="true">{shot.sticker}</span>
                            <div class="shot-frame">
                                <div class="shot-bar" aria-hidden="true">
                                    <i></i><i></i><i></i>
                                    <span>{shot.label}</span>
                                </div>
                                <a href={shot.src} target="_blank" rel="noopener">
                                    <img
                                        src={shot.src}
                                        alt={shot.alt}
                                        width={shot.width}
                                        height={shot.height}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </a>
                            </div>
                            <figcaption>{shot.caption}</figcaption>
                        </figure>
                    ))}

                    <aside class="peek-note" data-reveal>
                        <p class="note-title">What you're looking at</p>
                        <ul>
                            <li>Elementor layouts built on the client's artwork</li>
                            <li>Scoped CSS so plugins match the brand</li>
                            <li>Responsive checks at phone and desktop widths</li>
                        </ul>
                        <p class="note-small">The brand, artwork and products belong to the client.</p>
                    </aside>
                </div>
            </section>

            <section class="case-section" aria-labelledby="rame-work">
                <div class="section-heading centered-heading">
                    <p class="eyebrow">03 — Selected work</p>
                    <h2 id="rame-work">Four practical parts of the client experience.</h2>
                    <p>
                        The case study focuses on implemented or materially
                        developed work, without presenting future ideas as
                        finished features.
                    </p>
                </div>

                <div class="highlight-grid">
                    {highlights.map((highlight) => (
                        <article>
                            <span class="badge">{highlight.number}</span>
                            <h3>{highlight.title}</h3>
                            <p>{highlight.text}</p>
                        </article>
                    ))}
                </div>
            </section>

            <section class="case-section" aria-labelledby="rame-challenge">
                <div class="section-heading centered-heading">
                    <p class="eyebrow">04 — Challenge & approach</p>
                    <h2 id="rame-challenge">Keeping the personality without obscuring the shopping journey.</h2>
                </div>

                <div class="challenge-grid">
                    <article>
                        <h3>Expressive, but familiar</h3>
                        <p>
                            The client's playful stickers, soft palette, and
                            product imagery needed to coexist with recognizable
                            navigation and calls to action. I used configurable
                            WordPress tools plus scoped styling to balance both.
                        </p>
                    </article>
                    <article>
                        <h3>Responsive hero presentation</h3>
                        <p>
                            A stretched background approach reduced image
                            clarity and created cropping problems. The hero was
                            rebuilt with an image widget and separate content
                            elements for more controlled desktop and mobile
                            behaviour.
                        </p>
                    </article>
                    <article>
                        <h3>Cohesive cart interaction</h3>
                        <p>
                            Instead of presenting a stock drawer detached from
                            the rest of the site, I configured the side-cart
                            plugin and styled its visible components to feel
                            native to RAMÉ.
                        </p>
                    </article>
                </div>
            </section>

            <section class="case-section status-section" aria-labelledby="rame-status">
                <div class="section-heading centered-heading">
                    <p class="eyebrow">05 — Current status</p>
                    <h2 id="rame-status">A working foundation, still being refined.</h2>
                    <p>
                        The project has produced a customized storefront,
                        branded cart interface, and structured route for custom
                        inquiries. Development and final testing are ongoing.
                    </p>
                </div>

                <div class="scope-grid">
                    <article class="delivered">
                        <h3>Materially developed</h3>
                        <ul>
                            <li>WordPress, WooCommerce, Elementor, and Blocksy customization</li>
                            <li>Responsive branded homepage and shopping presentation</li>
                            <li>Custom Orders page and inquiry-form layout</li>
                            <li>Side-cart integration and targeted CSS styling</li>
                            <li>Local WordPress Studio copy and maintenance workflow</li>
                        </ul>
                    </article>

                    <article>
                        <h3>Still to come</h3>
                        <ul>
                            <li>Workshop booking, subscriptions, and capacity management</li>
                            <li>Full checkout or main Cart page redesign</li>
                            <li>Production-validated payments and end-to-end form delivery</li>
                            <li>Measured performance, conversion, traffic, or revenue improvements</li>
                            <li>Final client domain and launch configuration</li>
                        </ul>
                    </article>
                </div>
            </section>

            <section class="case-section skills-section" aria-labelledby="rame-skills">
                <div class="section-heading centered-heading">
                    <p class="eyebrow">06 — Skills demonstrated</p>
                    <h2 id="rame-skills">Client-focused WordPress and e-commerce implementation.</h2>
                    <p>Select any skill to see its evidence across the portfolio.</p>
                </div>

                <SkillLinks
                    skills={[
                        "wordpress",
                        "woocommerce",
                        "elementor",
                        "theme-customization",
                        "html-css",
                        "responsive-web-design",
                        "ecommerce-site-configuration",
                        "plugin-integration",
                        "inquiry-workflows",
                        "wordpress-maintenance",
                        "local-wordpress-development",
                        "client-requirements",
                        "iterative-development",
                    ]}
                />
            </section>

            <section class="project-end">
                <p class="eyebrow">Portfolio</p>
                <h2>Explore another completed case study.</h2>
                <div class="project-links">
                    <a href="/projects/ai-job-outreach/">AI automation <span aria-hidden="true">→</span></a>
                    <a href="/projects/gym-progress/">Gym Progress <span aria-hidden="true">→</span></a>
                    <a href="/#projects">All projects <span aria-hidden="true">→</span></a>
                </div>
            </section>
        </main>

        <SiteFooter />
    </body>
</html>

<script>
    const star = document.querySelector<HTMLButtonElement>(".rame-board .star");

    star?.addEventListener("click", () => {
        star.classList.remove("is-spinning");
        // Restart the animation on every tap.
        void star.offsetWidth;
        star.classList.add("is-spinning");
    });
</script>

<style>
    :root {
        --bg: #06111e;
        --surface: #091b2b;
        --border: #203f59;
        --heading: #ffffff;
        --text: #d8e4ee;
        --muted: #9eb1c0;
        --subtle: #7890a3;
        --blue: #168dff;
        --blue-light: #65baff;
        --orange: #ff8a00;
        --page-width: 1240px;

        /* RAMÉ palette, sampled from the client site */
        --r-cream: #fbf9d6;
        --r-paper: #fffcef;
        --r-ink: #1c1416;
        --r-plum: #5c2733;
        --r-pink: #f4a7cf;
        --r-blush: #f3cdd4;
        --r-green: #52c84b;
        --r-mint: #d6ebcb;
        --r-lilac: #cdb8f7;
        --r-butter: #f6e6a8;
        --r-yellow: #fde84f;
        --r-display: "Arial Rounded MT Bold", "Arial Black", "Segoe UI Black", system-ui, sans-serif;
        --r-hand: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
    }

    * { box-sizing: border-box; }

    html {
        scroll-behavior: smooth;
        background: var(--bg);
    }

    body {
        min-height: 100vh;
        margin: 0;
        color: var(--text);
        background:
            radial-gradient(circle at 88% 5%, rgba(244, 167, 207, 0.1), transparent 28rem),
            radial-gradient(circle at 10% 40%, rgba(82, 200, 75, 0.05), transparent 30rem),
            radial-gradient(circle at 85% 75%, rgba(205, 184, 247, 0.06), transparent 30rem),
            var(--bg);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    main,
    footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;
        padding-inline: clamp(1.4rem, 5vw, 4.5rem);
    }

    a { color: inherit; text-underline-offset: 0.25em; }
    a:focus-visible,
    button:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; }

    h1, h2, h3, p { margin-top: 0; }

    h2 {
        margin-bottom: 1rem;
        color: var(--heading);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.3rem, 5vw, 4rem);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: -0.05em;
    }

    h3 { color: var(--heading); font-size: 1.25rem; }

    .eyebrow {
        margin-bottom: 1rem;
        color: var(--orange);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    /* =========================================================
       HERO — RAMÉ STICKER BOARD
       ========================================================= */

    .hero {
        padding: clamp(3rem, 6vw, 4.5rem) 0 clamp(3.5rem, 7vw, 5rem);
        text-align: center;
    }

    .breadcrumbs {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 2rem;
        color: var(--subtle);
        font-size: 0.8rem;
    }

    .breadcrumbs a { text-decoration: none; }
    .breadcrumbs a:hover { color: white; }
    .breadcrumbs strong { color: var(--r-blush); }

    .rame-board {
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        padding: clamp(3rem, 8vw, 5.5rem) clamp(1.2rem, 4vw, 3rem) clamp(4rem, 8vw, 5.5rem);
        border: 3px solid var(--r-ink);
        border-radius: 28px;
        background-color: var(--r-paper);
        background-image:
            linear-gradient(rgba(28, 20, 22, 0.07) 1px, transparent 1px),
            linear-gradient(90deg, rgba(28, 20, 22, 0.07) 1px, transparent 1px);
        background-size: 34px 34px;
        box-shadow: 8px 8px 0 var(--r-pink);
        color: var(--r-ink);
    }

    .shape {
        position: absolute;
        pointer-events: none;
    }

    .squiggle {
        top: 4%;
        left: -3%;
        width: clamp(170px, 30vw, 330px);
        rotate: -8deg;
        animation: float 7s ease-in-out infinite;
    }

    .squiggle path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .squiggle-outline { stroke: var(--r-ink); stroke-width: 30; }
    .squiggle-fill { stroke: var(--r-green); stroke-width: 22; }

    .blob {
        border: 3px solid var(--r-ink);
        border-radius: 50%;
        box-shadow: inset -8px -10px 0 rgba(28, 20, 22, 0.08);
    }

    .blob-pink {
        right: 16%;
        bottom: -38px;
        width: clamp(90px, 13vw, 140px);
        aspect-ratio: 1;
        background: var(--r-pink);
        animation: float 6s ease-in-out infinite reverse;
    }

    .blob-pink-small {
        top: 12%;
        left: 30%;
        width: 34px;
        aspect-ratio: 1;
        background: var(--r-blush);
        animation: float 5s ease-in-out 0.8s infinite;
    }

    .blob-lilac {
        bottom: 14%;
        left: 7%;
        width: clamp(50px, 7vw, 72px);
        aspect-ratio: 1;
        background: var(--r-lilac);
        animation: float 6.5s ease-in-out 0.4s infinite;
    }

    .star {
        position: absolute;
        z-index: 2;
        top: 8%;
        right: 5%;
        width: clamp(78px, 12vw, 132px);
        aspect-ratio: 1;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
        rotate: 12deg;
        animation: bob 4s ease-in-out infinite;
    }

    .star svg { width: 100%; height: 100%; overflow: visible; }

    .star path {
        fill: var(--r-yellow);
        stroke: var(--r-ink);
        stroke-width: 4;
        stroke-linejoin: round;
        filter: drop-shadow(4px 5px 0 var(--r-ink));
    }

    .star:hover { scale: 1.08; }
    .star.is-spinning svg { animation: spin 0.9s cubic-bezier(0.3, 1.4, 0.5, 1); }

    .board-eyebrow {
        position: relative;
        display: inline-block;
        margin-bottom: 1.4rem;
        padding: 0.4rem 0.85rem;
        border: 2px solid var(--r-ink);
        border-radius: 999px;
        background: var(--r-mint);
        color: var(--r-plum);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .rame-board h1 {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0 0 1.4rem;
    }

    .rame-word {
        color: var(--r-pink);
        font-family: var(--r-display);
        font-size: clamp(4.2rem, 15vw, 9.5rem);
        font-weight: 900;
        line-height: 0.9;
        letter-spacing: 0.02em;
        -webkit-text-stroke: 3px var(--r-ink);
        paint-order: stroke fill;
        text-shadow: 6px 6px 0 var(--r-ink);
    }

    .rame-pill {
        margin-top: -0.4rem;
        padding: 0.45rem 1.4rem;
        border: 3px solid var(--r-ink);
        border-radius: 999px;
        background: var(--r-paper);
        box-shadow: 4px 4px 0 var(--r-ink);
        color: #2e9a2a;
        font-family: var(--r-display);
        font-size: clamp(1rem, 3vw, 1.6rem);
        font-weight: 900;
        letter-spacing: 0.24em;
        rotate: -3deg;
    }

    .hero-subtitle {
        position: relative;
        max-width: 620px;
        margin: 0 auto;
        color: #3d3033;
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        font-weight: 500;
        line-height: 1.6;
    }

    .hand-note {
        position: absolute;
        bottom: 1.1rem;
        left: 1.2rem;
        margin: 0;
        padding: 0.2rem 0.8rem;
        border: 2px solid var(--r-ink);
        border-radius: 999px;
        background: var(--r-paper);
        color: var(--r-ink);
        font-family: var(--r-hand);
        font-size: 0.85rem;
        rotate: -4deg;
    }

    .hero :global(.skill-links) { justify-content: center; }

    @keyframes float {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -12px; }
    }

    @keyframes bob {
        0%, 100% { translate: 0 0; rotate: 12deg; }
        50% { translate: 0 -8px; rotate: 4deg; }
    }

    @keyframes spin {
        to { rotate: 360deg; }
    }

    /* =========================================================
       FACT STICKERS
       ========================================================= */

    .facts {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.1rem;
        padding-bottom: clamp(4rem, 8vw, 6rem);
    }

    .sticker {
        padding: 1.2rem;
        border: 2.5px solid var(--r-ink);
        border-radius: 16px;
        box-shadow: 5px 5px 0 rgba(255, 255, 255, 0.14);
        color: var(--r-ink);
        text-align: center;
        transition: rotate 0.25s ease, transform 0.25s ease;
    }

    .sticker:nth-child(odd) { rotate: -1.6deg; }
    .sticker:nth-child(even) { rotate: 1.3deg; }
    .sticker:hover { rotate: 0deg; transform: translateY(-4px); }

    .sticker span {
        display: block;
        margin-bottom: 0.55rem;
        color: var(--r-plum);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .sticker strong { font-size: 0.92rem; line-height: 1.45; }

    .tone-pink { background: var(--r-blush); }
    .tone-butter { background: var(--r-butter); }
    .tone-mint { background: var(--r-mint); }
    .tone-lilac { background: var(--r-lilac); }

    /* =========================================================
       SHARED SECTIONS
       ========================================================= */

    .case-section {
        padding: clamp(4.5rem, 9vw, 7rem) 0;
        border-top: 1px solid rgba(32, 63, 89, 0.8);
    }

    .section-heading { max-width: 830px; }
    .centered-heading { margin-inline: auto; text-align: center; }
    .section-heading > p:last-child { color: var(--muted); line-height: 1.7; }

    .highlight-grid article,
    .challenge-grid article,
