---
/* =========================================================
   PAGE METADATA
   ========================================================= */
import ProjectGallery from "../../components/ProjectGallery.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SkillLinks from "../../components/SkillLinks.astro";
const title =
  "Gym Progress System | Excel & VBA Case Study | Konstantinos Zafiropoulos";

const description =
  "Case study of an Excel and VBA workout analytics system built for progress tracking, dynamic charts, historical-data handling, and data-quality diagnostics.";

const metrics = [
  {
    value: "6",
    label: "Workout sheets",
  },
  {
    value: "2",
    label: "Chart views per exercise",
  },
  {
    value: "1",
    label: "Overall progress dashboard",
  },
  {
    value: "VBA",
    label: "Automation layer",
  },
];
---

<html lang="en">
  <!-- =======================================================
       HEAD / SEO
       ======================================================= -->

  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <main>
      <!-- ===================================================
           PRIMARY NAVIGATION
           =================================================== -->

      <SiteHeader />

      <!-- ===================================================
           HERO
           =================================================== -->

      <header class="hero">
        <a class="back-link" href="/#projects">← Back to projects</a>

        <p class="eyebrow">Excel · VBA · Analytics · Automation</p>

        <h1>Gym Progress System</h1>

        <p class="hero-subtitle">
          A custom Excel and VBA system for turning workout history into clear,
          useful progression data through dynamic charts, historical mappings,
          and automated analysis.
        </p>

        <SkillLinks
          variant="hero"
          skills={[
            "excel",
            "vba",
            "data-quality",
            "data-visualisation",
            "excel-automation",
          ]}
        />
      </header>

      <!-- ===================================================
           KEY METRICS
           =================================================== -->

      <section class="metrics" aria-label="Gym Progress project highlights">
        {
          metrics.map((metric) => (
            <article class="metric-card">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </article>
          ))
        }
      </section>

      <!-- ===================================================
           SECTION 01 — OVERVIEW
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">01 — Overview</p>
        </div>

        <div class="section-content">
          <h2>Turning workout logs into an actual analytics system.</h2>

          <p class="lead">
            The project started as a way to record training history, but it
            gradually evolved into a structured Excel/VBA application for
            analysing strength progression over time.
          </p>

          <p>
            Instead of treating the workbook as a collection of static cells, I
            designed it as a system with reusable logic, dynamic charting,
            historical-data handling, automated calculations, and diagnostic
            checks.
          </p>

          <p>
            The goal was to make performance trends visible quickly while
            keeping weekly data entry simple enough to use consistently.
          </p>
        </div>
      </section>

      <!-- =====================================================
     PROJECT VISUALS — GYM PROGRESS SYSTEM
     ===================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">Project visuals</p>
        </div>

        <div class="section-content">
          <ProjectGallery
            title="Training analytics dashboards"
            description="Edited presentation visuals based on the Excel training dashboard, showing historical strength trends, weekly volume and exercise-level analysis."
            images={[
              {
                src: "/images/projects/gym-progress/dashboard-1.webp",
                width: 1548,
                height: 701,
                alt: "Gym Progress dashboard with weekly training metrics, historical strength trends and recorded training volume.",
                caption:
                  "Dashboard overview illustrating the system's weekly summary, historical strength trends and current training-volume reporting.",
              },
              {
                src: "/images/projects/gym-progress/dashboard-2.webp",
                width: 1551,
                height: 835,
                alt: "Gym Progress dashboard showing workout volume distribution and highest recorded exercise volumes.",
                caption:
                  "Additional dashboard view illustrating workout-level volume distribution and the exercises contributing the highest recorded volume.",
              },
            ]}
          />
        </div>
      </section>

      <!-- ===================================================
           SECTION 02 — THE PROBLEM
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">02 — The problem</p>
        </div>

        <div class="section-content">
          <h2>
            Workout data is easy to collect and surprisingly hard to read.
          </h2>

          <p class="lead">
            Raw workout logs can show what happened, but they do not
            automatically reveal whether performance is actually improving.
          </p>

          <div class="challenge-grid">
            <article>
              <span class="card-number">01</span>

              <h3>Progression visibility</h3>

              <p>
                Weight and repetition data needed to be translated into clear
                trends instead of manually comparing rows and weeks.
              </p>
            </article>

            <article>
              <span class="card-number">02</span>

              <h3>Historical consistency</h3>

              <p>
                Exercise names, machines, and historical formats changed over
                time, creating mapping and comparability problems.
              </p>
            </article>

            <article>
              <span class="card-number">03</span>

              <h3>Data quality</h3>

              <p>
                Missing pairs, malformed week headers, numeric text, and broken
                formulas could quietly distort analysis.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ===================================================
           SECTION 03 — WORKBOOK ARCHITECTURE
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">03 — Architecture</p>
        </div>

        <div class="section-content">
          <h2>A structured workbook rather than a collection of worksheets.</h2>

          <p class="lead">
            The system is organised around six workout sheets, a historical data
            layer, reusable chart logic, and VBA procedures that connect the
            pieces together.
          </p>

          <div class="operations-grid">
            <div class="operation">
              <span>Workout structure</span>

              <strong>Six workout sheets</strong>

              <p>
                Push, Pull, Legs, Upper, Lower, and Abs provide a consistent
                structure for weekly data entry.
              </p>
            </div>

            <div class="operation">
              <span>Historical layer</span>

              <strong>Legacy data integration</strong>

              <p>
                Older workout records remain available while current analysis
                can distinguish historical data from new progression data.
              </p>
            </div>

            <div class="operation">
              <span>Interface</span>

              <strong>Exercise buttons</strong>

              <p>
                Buttons attached to exercises open dynamic progress views
                without requiring the user to manipulate chart ranges.
              </p>
            </div>

            <div class="operation">
              <span>Analytics</span>

              <strong>Overall dashboard</strong>

              <p>
                A dedicated overview summarises progression across exercises
                instead of requiring each movement to be inspected separately.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================================================
           SECTION 04 — DYNAMIC EXERCISE CHARTS
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">04 — Dynamic charts</p>
        </div>

        <div class="section-content">
          <h2>One exercise button, multiple analytical views.</h2>

          <p class="lead">
            Each exercise can generate progress visualisations using the
            underlying workout history.
          </p>

          <div class="feature-stack">
            <article>
              <span class="feature-label">View 01</span>

              <div>
                <h3>Best-set progression</h3>

                <p>
                  Tracks the strongest set over time using weight and
                  repetitions, making long-term performance trends visible.
                </p>
              </div>
            </article>

            <article>
              <span class="feature-label">View 02</span>

              <div>
                <h3>Volume and repetition context</h3>

                <p>
                  Adds additional context so improvements are not judged from
                  weight alone.
                </p>
              </div>
            </article>

            <article>
              <span class="feature-label">Display</span>

              <div>
                <h3>Readable data labels</h3>

                <p>
                  Labels combine weight and repetition information so key points
                  can be interpreted without constantly reading axes.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ===================================================
           SECTION 05 — OVERALL PROGRESS SYSTEM
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">05 — Overall progress</p>
        </div>

        <div class="section-content">
          <h2>From individual lifts to a system-level view of training.</h2>

          <p class="lead">
            A separate overall-progress system aggregates exercise performance
            into a higher-level view of improvement.
          </p>

          <div class="evidence-grid">
            <article>
              <strong>Improved</strong>
              <span>Exercises showing positive progression</span>
            </article>

            <article>
              <strong>Declined</strong>
              <span>Exercises where performance moved backwards</span>
            </article>

            <article>
              <strong>Unchanged</strong>
              <span>Exercises without meaningful movement</span>
            </article>

            <article>
              <strong>Movers</strong>
              <span>Strongest positive and negative changes</span>
            </article>
          </div>
        </div>
      </section>

      <!-- ===================================================
           SECTION 06 — DATA QUALITY & DIAGNOSTICS
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">06 — Data quality</p>
        </div>

        <div class="section-content">
          <h2>
            Analytics are only useful when the underlying data can be trusted.
          </h2>

          <p class="lead">
            As the workbook became more complex, identifying data-quality issues
            became an important part of maintaining reliable analysis.
          </p>

          <div class="diagnostic-list">
            <div>
              <span>01</span>
              <p>Incomplete weight / repetition pairs</p>
            </div>

            <div>
              <span>02</span>
              <p>Numeric values stored as text</p>
            </div>

            <div>
              <span>03</span>
              <p>Malformed week headers</p>
            </div>

            <div>
              <span>04</span>
              <p>Missing or inconsistent set structures</p>
            </div>

            <div>
              <span>05</span>
              <p>Broken formulas and structural inconsistencies</p>
            </div>

            <div>
              <span>06</span>
              <p>Ambiguous historical exercise mappings</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================================================
           SECTION 07 — HISTORICAL DATA HANDLING
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">07 — Historical data</p>
        </div>

        <div class="section-content">
          <h2>Preserving history without letting it distort current trends.</h2>

          <p class="lead">
            One of the harder design problems was deciding how older exercise
            data should connect to the current workbook structure.
          </p>

          <p>
            Legitimate historical equivalents can be linked through alias
            mappings, while genuinely different exercises or machines remain
            separate.
          </p>

          <p>
            Historical values can remain visible where useful, while current
            trendlines and progression calculations can focus on the newer
            training period.
          </p>
        </div>
      </section>

      <!-- ===================================================
           SECTION 08 — VBA AUTOMATION
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">08 — Automation</p>
        </div>

        <div class="section-content">
          <h2>VBA turns the workbook into an interactive tool.</h2>

          <p class="lead">
            VBA handles repetitive logic behind chart creation, navigation,
            analysis, and interface behaviour.
          </p>

          <SkillLinks
            skills={[
              "data-visualisation",
              "interface-design",
              "data-modelling",
              "operational-reporting",
              "dashboards",
              "vba",
            ]}
          />
        </div>
      </section>

      <!-- ===================================================
           SECTION 09 — SKILLS DEMONSTRATED
           =================================================== -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">09 — Skills demonstrated</p>
        </div>

        <div class="section-content">
          <h2>Technical implementation shaped by a real usability problem.</h2>

          <SkillLinks
            skills={[
              "excel",
              "vba",
              "data-modelling",
              "data-visualisation",
              "excel-automation",
              "debugging",
              "data-quality",
              "interface-design",
              "system-architecture",
              "iterative-development",
            ]}
          />
        </div>
      </section>

      <!-- ===================================================
           RETURN TO PROJECTS
           =================================================== -->

      <section class="project-end">
        <p class="eyebrow">More work</p>

        <h2>Explore the rest of the portfolio.</h2>

        <a class="text-link" href="/#projects">
          Back to selected work
          <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  /* =========================================================
     DESIGN TOKENS
     ========================================================= */

  :root {
    --color-bg: #050b14;
    --color-bg-soft: #081220;

    --color-text: #e8edf3;
    --color-heading: #ffffff;

    --color-muted: #a9bbcc;
    --color-subtle: #7f95aa;

    --color-border: #203247;

    --color-blue: #2aa7ff;
    --color-orange: #ff8a00;

    --page-width: 1200px;

    color: var(--color-text);
    background: var(--color-bg);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  /* =========================================================
     GLOBAL
     ========================================================= */

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;

    color: var(--color-text);

    background:
      radial-gradient(
        circle at top right,
        rgba(42, 167, 255, 0.12),
        transparent 34rem
      ),
      radial-gradient(
        circle at 15% 35%,
        rgba(255, 138, 0, 0.045),
        transparent 30rem
      ),
      var(--color-bg);
  }

  main,
  footer {
    max-width: var(--page-width);

    margin-inline: auto;

    padding-left: clamp(1.5rem, 5vw, 4.5rem);
    padding-right: clamp(1.5rem, 5vw, 4.5rem);
  }

  a {
    color: inherit;
    text-underline-offset: 0.25em;
  }

  a:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: 5px;
  }

  /* =========================================================
     NAVIGATION
     ========================================================= */

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding-top: 1.5rem;
  }

  .wordmark {
    font-size: 1.3rem;
    font-weight: 800;

    text-decoration: none;

    letter-spacing: -0.08em;
  }

  .wordmark span {
    color: var(--color-orange);
  }

  .nav-links {
    display: flex;

    gap: clamp(1rem, 3vw, 2.5rem);

    font-size: 0.9rem;
  }

  .nav-links a {
    color: #b8c7d6;

    text-decoration: none;

    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #ffffff;
  }

  /* =========================================================
     TYPOGRAPHY
     ========================================================= */

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;

    font-weight: 400;

    letter-spacing: -0.055em;
  }

  h1 {
    max-width: 950px;

    margin-bottom: 1.5rem;

    color: #ffffff;

    font-size: clamp(3.8rem, 9vw, 7.6rem);

    line-height: 0.9;
  }

  h2 {
    max-width: 780px;

    color: #ffffff;

    font-size: clamp(2.2rem, 5vw, 4rem);

    line-height: 1;
  }

  h3 {
    color: #ffffff;
  }

  .eyebrow {
    margin: 0 0 1.25rem;

    color: var(--color-orange);

    font-size: 0.78rem;
    font-weight: 750;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  /* =========================================================
     HERO
     ========================================================= */

  .hero {
    padding: clamp(5rem, 10vw, 8rem) 0 clamp(3.5rem, 7vw, 5.5rem);
  }

  .back-link {
    display: inline-block;

    margin-bottom: 3rem;

    color: var(--color-subtle);

    font-size: 0.85rem;

    text-decoration: none;
  }

  .hero-subtitle {
    max-width: 740px;

    color: #b8c7d6;

    font-size: clamp(1.1rem, 2vw, 1.35rem);

    line-height: 1.6;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 0.65rem;

    margin-top: 2rem;
  }

  .hero-tags span {
    padding: 0.55rem 0.8rem;

    border: 1px solid var(--color-border);
    border-radius: 999px;

    color: #a9bbcc;

    background: rgba(8, 18, 32, 0.8);

    font-size: 0.78rem;
  }

  /* =========================================================
     METRICS
     ========================================================= */

  .metrics {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 1rem;

    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .metric-card {
    min-height: 145px;

    padding: 1.4rem;

    border: 1px solid var(--color-border);
    border-radius: 14px;

    background:
      linear-gradient(
        135deg,
        rgba(42, 167, 255, 0.08),
        rgba(255, 138, 0, 0.025)
      ),
      rgba(8, 18, 32, 0.82);
  }

  .metric-card strong {
    display: block;

    margin-bottom: 0.5rem;

    color: var(--color-blue);

    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  .metric-card span {
    color: #9fb1c2;

    font-size: 0.9rem;
  }

  /* =========================================================
     CASE STUDY SECTIONS
     ========================================================= */

  .case-section {
    display: grid;

    grid-template-columns:
      minmax(150px, 0.32fr)
      minmax(0, 1fr);

    gap: clamp(2rem, 7vw, 6rem);

    padding: clamp(4.5rem, 9vw, 7.5rem) 0;

    border-top: 1px solid var(--color-border);
  }

  .section-content {
    max-width: 820px;
  }

  .section-content > p {
    color: var(--color-muted);

    line-height: 1.7;
  }

  .lead {
    color: #d7e0e8 !important;

    font-size: 1.15rem;
  }

  /* =========================================================
     CHALLENGE CARDS
     ========================================================= */

  .challenge-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 1rem;

    margin-top: 2.5rem;
  }

  .challenge-grid article {
    padding: 1.4rem;

    border: 1px solid #28394b;
    border-radius: 14px;

    background: rgba(9, 18, 31, 0.9);
  }

  .card-number {
    display: inline-block;

    margin-bottom: 1.3rem;

    color: var(--color-orange);

    font-size: 0.8rem;
    font-weight: 700;
  }

  .challenge-grid p {
    color: #94a8ba;

    line-height: 1.55;
  }

  /* =========================================================
     ARCHITECTURE GRID
     ========================================================= */

  .operations-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 1rem;

    margin-top: 2.5rem;
  }

  .operation {
    padding: 1.5rem;

    border-left: 2px solid var(--color-blue);

    background: rgba(8, 17, 30, 0.72);
  }

  .operation > span {
    display: block;

    margin-bottom: 0.6rem;

    color: var(--color-orange);

    font-size: 0.72rem;
    font-weight: 750;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  .operation strong {
    display: block;

    margin-bottom: 0.7rem;

    color: #ffffff;
  }

  .operation p {
    margin-bottom: 0;

    color: #91a4b7;

    line-height: 1.55;
  }

  /* =========================================================
     FEATURE STACK
     ========================================================= */

  .feature-stack {
    display: grid;

    gap: 1rem;

    margin-top: 2.5rem;
  }

  .feature-stack article {
    display: grid;

    grid-template-columns: 110px 1fr;

    gap: 1.5rem;

    padding: 1.4rem;

    border: 1px solid var(--color-border);
    border-radius: 12px;

    background: rgba(8, 17, 30, 0.72);
  }

  .feature-label {
    color: var(--color-blue);

    font-size: 0.75rem;
    font-weight: 700;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .feature-stack h3 {
    margin-bottom: 0.5rem;
  }

  .feature-stack p {
    margin-bottom: 0;

    color: #94a8ba;

    line-height: 1.55;
  }

  /* =========================================================
     PROGRESS / EVIDENCE GRID
     ========================================================= */

  .evidence-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 1rem;

    margin-top: 2.5rem;
  }

  .evidence-grid article {
    padding: 1.4rem;

    border: 1px solid var(--color-border);
    border-radius: 12px;

    background: rgba(8, 17, 30, 0.72);
  }

  .evidence-grid strong {
    display: block;

    margin-bottom: 0.45rem;

    color: var(--color-orange);

    font-size: 1.15rem;
  }

  .evidence-grid span {
    color: #91a4b7;

    font-size: 0.85rem;

    line-height: 1.45;
  }

  /* =========================================================
     DIAGNOSTIC LIST
     ========================================================= */

  .diagnostic-list {
    display: grid;

    gap: 0.75rem;

    margin-top: 2.5rem;
  }

  .diagnostic-list div {
    display: grid;

    grid-template-columns: 42px 1fr;

    align-items: center;

    gap: 1rem;

    padding: 1rem 0;

    border-bottom: 1px solid var(--color-border);
  }

  .diagnostic-list span {
    color: var(--color-blue);

    font-size: 0.75rem;
    font-weight: 700;
  }

  .diagnostic-list p {
    margin: 0;

    color: #b8c7d6;
  }

  /* =========================================================
     SKILLS
     ========================================================= */

  .skills-list {
    display: flex;
    flex-wrap: wrap;

    gap: 0.7rem;

    margin-top: 2.5rem;
  }

  .skills-list span {
    padding: 0.7rem 0.9rem;

    border: 1px solid #285078;
    border-radius: 8px;

    color: #c5d5e4;

    background: rgba(8, 25, 42, 0.78);

    font-size: 0.82rem;
  }

  /* =========================================================
     PROJECT END
     ========================================================= */

  .project-end {
    padding: clamp(5rem, 10vw, 8rem) 0;

    border-top: 1px solid var(--color-border);
  }

  .text-link {
    display: inline-block;

    margin-top: 1rem;

    color: var(--color-text);

    font-weight: 700;
  }

  .text-link span {
    margin-left: 0.35rem;

    color: var(--color-orange);
  }

  /* =========================================================
     FOOTER
     ========================================================= */

  footer {
    display: flex;
    justify-content: space-between;

    gap: 1rem;

    padding-top: 1.5rem;
    padding-bottom: 1.5rem;

    border-top: 1px solid var(--color-border);

    color: var(--color-subtle);

    font-size: 0.8rem;
  }

  /* =========================================================
     RESPONSIVE — TABLET
     ========================================================= */

  @media (max-width: 900px) {
    .metrics {
      grid-template-columns: repeat(2, 1fr);
    }

