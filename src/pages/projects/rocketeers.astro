---
/* =========================================================
   PAGE METADATA
   ========================================================= */

const title =
  "Rocketeers | Marketplace Business & Operations | Konstantinos Zafiropoulos";

const description =
  "Overview of Rocketeers — a digital marketplace business and the operational systems built around it.";

const metrics = [
  {
    value: "23K+",
    label: "Items sold",
  },
  {
    value: "6,455",
    label: "Seller feedback entries",
  },
  {
    value: "0",
    label: "Negative feedback",
  },
  {
    value: "807",
    label: "Store followers",
  },
];
---

<html lang="en">
  <!-- =====================================================
         HEAD / SEO
         ===================================================== -->

  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
  </head>

  <body>
    <main>
      <!-- =================================================
                 PRIMARY NAVIGATION
                 ================================================= -->

      <nav aria-label="Primary navigation">
        <a class="wordmark" href="/" aria-label="Homepage">
          KZ<span>.</span>
        </a>

        <div class="nav-links">
          <a href="/#projects">Projects</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </div>
      </nav>

      <!-- =================================================
                 HERO
                 ================================================= -->

      <header class="hero">
        <div class="hero-breadcrumbs">
          <a href="/#projects">Projects</a>
          <span>→</span>
          <strong>Rocketeers</strong>
        </div>

        <p class="eyebrow">
          Featured Project · Marketplace Business · Operations
        </p>

        <h1>Rocketeers</h1>

        <p class="hero-subtitle">
          A real digital marketplace business I founded and operated from 2017
          to 2024 — combining marketplace operations, pricing, inventory,
          customer experience, commercial decision-making, Excel systems, and
          process improvement.
        </p>

        <div class="hero-tags">
          <span>Marketplace Operations</span>
          <span>E-commerce</span>
          <span>Business Ownership</span>
          <span>Excel</span>
          <span>Pricing</span>
          <span>Analytics</span>
        </div>
      </header>

      <!-- =================================================
                 KEY METRICS
                 ================================================= -->

      <section class="metrics" aria-label="Rocketeers key metrics">
        {
          metrics.map((metric) => (
            <article class="metric-card">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </article>
          ))
        }
      </section>

      <!-- =================================================
                 SECTION 01 — OVERVIEW
                 ================================================= -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">01 — Overview</p>
        </div>

        <div class="section-content">
          <h2>A marketplace business that became a systems problem.</h2>

          <p class="lead">
            Rocketeers started as a small digital marketplace operation and grew
            into a multi-year business serving thousands of customers.
          </p>

          <p>
            I handled the operation end to end: sourcing inventory, creating and
            maintaining listings, pricing products, fulfilling customer orders,
            handling disputes and support, monitoring seller performance, and
            tracking commercial results.
          </p>

          <p>
            As the catalogue and transaction volume grew, manual processes
            became increasingly difficult to maintain. That led me to build
            dedicated systems for repricing, financial tracking, and operational
            control.
          </p>
        </div>
      </section>

      <!-- =================================================
                 SECTION 02 — THREE PROJECTS
                 ================================================= -->

      <section class="case-section projects-section">
        <div class="section-label">
          <p class="eyebrow">02 — Explore Rocketeers</p>
        </div>

        <div class="section-content">
          <h2>Three connected case studies.</h2>

          <p class="lead">
            Rocketeers is best understood through three different lenses: how
            the business was operated, how pricing was scaled, and how
            commercial performance was tracked.
          </p>

          <div class="project-grid">
            <!-- =====================================
                             BUSINESS & MARKETPLACE OPERATIONS
                             ===================================== -->

            <a
              class="project-card business-card"
              href="/projects/rocketeers/business-operations/"
            >
              <div class="project-card-top">
                <span class="project-number orange"> 01 </span>

                <span class="project-icon orange" aria-hidden="true"> ◫ </span>
              </div>

              <h3>Business & Marketplace Operations</h3>

              <p>
                How the business was planned, launched, operated, and scaled —
                including sourcing, listings, pricing, inventory, fulfilment,
                customer support, disputes, and seller performance.
              </p>

              <div class="project-metrics">
                <div>
                  <strong>23K+</strong>
                  <span>items sold</span>
                </div>

                <div>
                  <strong>6,455</strong>
                  <span>feedback entries</span>
                </div>

                <div>
                  <strong>0</strong>
                  <span>negative feedback</span>
                </div>
              </div>

              <span class="project-link orange"> View case study → </span>
            </a>

            <!-- =====================================
                             MARKETPLACE REPRICING ENGINE
                             ===================================== -->

            <a
              class="project-card repricing-card"
              href="/projects/rocketeers/repricing/"
            >
              <div class="project-card-top">
                <span class="project-number blue"> 02 </span>

                <span class="project-icon blue" aria-hidden="true"> ⚙ </span>
              </div>

              <h3>Marketplace Repricing Engine</h3>

              <p>
                An Excel-based pricing and bulk-repricing workflow built to
                manage 1,000+ listings and more than 10,000 priced product
                variations.
              </p>

              <div class="project-metrics">
                <div>
                  <strong>1,000+</strong>
                  <span>live listings</span>
                </div>

                <div>
                  <strong>10K+</strong>
                  <span>priced variations</span>
                </div>

                <div>
                  <strong>~1 hr</strong>
                  <span>mature repricing run</span>
                </div>
              </div>

              <span class="project-link blue"> View case study → </span>
            </a>

            <!-- =====================================
                             FINANCIAL & OPERATIONS TRACKER
                             ===================================== -->

            <a
              class="project-card finance-card"
              href="/projects/rocketeers/financial-tracker/"
            >
              <div class="project-card-top">
                <span class="project-number green"> 03 </span>

                <span class="project-icon green" aria-hidden="true"> ↗ </span>
              </div>

              <h3>Financial & Operations Tracker</h3>

              <p>
                A multi-sheet Excel system used to understand turnover, orders,
                inventory, fees, trading, cancellations, and approximate
                profitability.
              </p>

              <div class="project-metrics">
                <div>
                  <strong>$55.6K</strong>
                  <span>recorded turnover</span>
                </div>

                <div>
                  <strong>4,154</strong>
                  <span>orders</span>
                </div>

                <div>
                  <strong>6,372</strong>
                  <span>products sold</span>
                </div>
              </div>

              <span class="project-link green"> View case study → </span>
            </a>
          </div>
        </div>
      </section>

      <!-- =================================================
                 SECTION 03 — THE OPERATING MODEL
                 ================================================= -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">03 — Operating model</p>
        </div>

        <div class="section-content">
          <h2>
            The business connected sourcing, inventory, marketplaces, and
            customers.
          </h2>

          <p class="lead">
            The core operation was a commercial loop rather than a simple
            storefront.
          </p>

          <div class="operating-flow">
            <div class="flow-step">
              <span>01</span>
              <strong>Source inventory</strong>
            </div>

            <div class="flow-arrow" aria-hidden="true">→</div>

            <div class="flow-step">
              <span>02</span>
              <strong>Price products</strong>
            </div>

            <div class="flow-arrow" aria-hidden="true">→</div>

            <div class="flow-step">
              <span>03</span>
              <strong>Maintain listings</strong>
            </div>

            <div class="flow-arrow" aria-hidden="true">→</div>

            <div class="flow-step">
              <span>04</span>
              <strong>Fulfil orders</strong>
            </div>

            <div class="flow-arrow" aria-hidden="true">→</div>

            <div class="flow-step">
              <span>05</span>
              <strong>Support customers</strong>
            </div>

            <div class="flow-arrow" aria-hidden="true">→</div>

            <div class="flow-step">
              <span>06</span>
              <strong>Measure performance</strong>
            </div>
          </div>

          <p>
            The business and the systems were tightly connected. Pricing logic
            mattered because the catalogue was large. Financial tracking
            mattered because inventory, sales, trading, and cash were
            interdependent. Customer operations mattered because seller
            performance affected the health of the marketplace account.
          </p>
        </div>
      </section>

      <!-- =================================================
                 SECTION 04 — CUSTOMER EXPERIENCE
                 ================================================= -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">04 — Customer experience</p>
        </div>

        <div class="section-content">
          <h2>Operational quality showed up in customer feedback.</h2>

          <p class="lead">
            Across the account history, Rocketeers accumulated 6,455 seller
            feedback entries with zero negative feedback and one neutral entry.
          </p>

          <div class="feedback-grid">
            <article>
              <strong>6,455</strong>
              <span>seller feedback entries</span>
            </article>

            <article>
              <strong>3,361</strong>
              <span>unique positive feedback</span>
            </article>

            <article>
              <strong>0</strong>
              <span>negative feedback</span>
            </article>

            <article>
              <strong>1</strong>
              <span>neutral feedback</span>
            </article>
          </div>

          <p>
            Maintaining that record required careful fulfilment, clear
            communication, and hands-on use of eBay Seller Hub and Resolution
            Center for returns, disputes, cases, and seller-performance
            management.
          </p>
        </div>
      </section>

      <!-- =================================================
                 SECTION 05 — SCALE CREATED SYSTEMS
                 ================================================= -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">05 — Scaling the operation</p>
        </div>

        <div class="section-content">
          <h2>Growth changed the kind of problems I had to solve.</h2>

          <p class="lead">
            At small scale, repetitive marketplace tasks can be handled
            manually. At larger scale, the process itself becomes the
            bottleneck.
          </p>

          <div class="scale-grid">
            <article>
              <span>Catalogue</span>
              <strong>1,000+ listings</strong>
              <p>
                Large enough that individual manual repricing stopped being
                practical.
              </p>
            </article>

            <article>
              <span>Variations</span>
              <strong>10,000+ prices</strong>
              <p>
                Product-colour combinations created much more complexity than
                the listing count alone.
              </p>
            </article>

            <article>
              <span>Commercial tracking</span>
              <strong>25 months</strong>
              <p>
                Surviving finance records covering sales, orders, inventory, and
                performance.
              </p>
            </article>

            <article>
              <span>Customer operations</span>
              <strong>Thousands served</strong>
              <p>
                More transactions meant more exceptions, questions, disputes,
                and operational risk.
              </p>
            </article>
          </div>

          <div class="callout">
            <strong> The recurring pattern </strong>

            <p>
              When a process became difficult to manage manually, I looked for a
              way to structure it, standardize it, or build a system around it.
            </p>
          </div>
        </div>
      </section>

      <!-- =================================================
                 SECTION 06 — EVIDENCE
                 ================================================= -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">06 — Evidence</p>
        </div>

        <div class="section-content">
          <h2>
            The portfolio will continue adding genuine evidence from the
            operation.
          </h2>

          <p class="lead">
            The project pages are based on surviving business records,
            marketplace data, and operational workbooks. Public evidence will be
            sanitized before being shown.
          </p>

          <div class="evidence-grid">
            <div class="evidence-placeholder">
              <span>01</span>

              <strong> Marketplace storefront </strong>

              <p>Sanitized evidence of the Rocketeers marketplace presence.</p>
            </div>

            <div class="evidence-placeholder">
              <span>02</span>

              <strong> Seller performance </strong>

              <p>
                Feedback and account-performance evidence from the operation.
              </p>
            </div>

            <div class="evidence-placeholder">
              <span>03</span>

              <strong> Pricing system </strong>

              <p>Real workbook evidence from the repricing workflow.</p>
            </div>

            <div class="evidence-placeholder">
              <span>04</span>

              <strong> Financial tracking </strong>

              <p>Sanitized operating and financial records from the tracker.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================
                 SECTION 07 — SKILLS
                 ================================================= -->

      <section class="case-section">
        <div class="section-label">
          <p class="eyebrow">07 — Skills demonstrated</p>
        </div>

        <div class="section-content">
          <h2>
            Rocketeers combined commercial ownership with practical systems
            work.
          </h2>

          <div class="skills-list">
            <span>Marketplace Operations</span>
            <span>E-commerce</span>
            <span>Business Ownership</span>
            <span>Customer Operations</span>
            <span>Excel</span>
            <span>Pricing</span>
            <span>Inventory Management</span>
            <span>Process Improvement</span>
            <span>Commercial Analysis</span>
            <span>Seller Performance</span>
            <span>Operational Scaling</span>
            <span>Decision-Making</span>
          </div>
        </div>
      </section>

      <!-- =================================================
                 RETURN TO PORTFOLIO
                 ================================================= -->

      <section class="project-end">
        <p class="eyebrow">Portfolio</p>

        <h2>
          Explore the individual Rocketeers case studies or return to the full
          portfolio.
        </h2>

        <div class="project-end-links">
          <a
            class="text-link business-link"
            href="/projects/rocketeers/business-operations/"
          >
            Business & Marketplace Operations
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="text-link repricing-link"
            href="/projects/rocketeers/repricing/"
          >
            Repricing Engine
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="text-link finance-link"
            href="/projects/rocketeers/financial-tracker/"
          >
            Financial Tracker
            <span aria-hidden="true">→</span>
          </a>

          <a class="text-link portfolio-link" href="/#projects">
            All projects
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <!-- ===================================================
             FOOTER
             =================================================== -->

    <footer>
      <span>
        © {new Date().getFullYear()} Konstantinos Zafiropoulos
      </span>

      <span> Built with Astro · Git/GitHub · VS Code · Netlify </span>
    </footer>
  </body>
</html>

<style>
  /* =========================================================
       DESIGN TOKENS
       ========================================================= */

  :root {
    --bg: #050d18;
    --bg-card: rgba(7, 21, 34, 0.88);

    --heading: #ffffff;
    --text: #e8eef5;
    --muted: #a9bbcc;
    --subtle: #71869a;

    --border: #1d354a;

    --blue: #168dff;
    --blue-light: #65baff;

    --orange: #ff8a00;

    --green: #26d5a2;

    --page-width: 1240px;

    color: var(--text);
    background: var(--bg);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  /* =========================================================
       GLOBAL
       ========================================================= */

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;

    margin: 0;

    color: var(--text);

    background:
      radial-gradient(
        circle at 88% 8%,
        rgba(22, 141, 255, 0.09),
        transparent 34rem
      ),
      radial-gradient(
        circle at 10% 30%,
        rgba(255, 138, 0, 0.045),
        transparent 30rem
      ),
      var(--bg);
  }

  main,
  footer {
    max-width: var(--page-width);

    margin-inline: auto;

    padding-left: clamp(1.5rem, 5vw, 4.5rem);
    padding-right: clamp(1.5rem, 5vw, 4.5rem);
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 4px;
  }

  /* =========================================================
       NAVIGATION
       ========================================================= */

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 74px;

    border-bottom: 1px solid var(--border);
  }

  .wordmark {
    color: white;

    font-size: 1.35rem;
    font-weight: 850;

    letter-spacing: -0.08em;

    text-decoration: none;
  }

  .wordmark span {
    color: var(--orange);
  }

  .nav-links {
    display: flex;

    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .nav-links a {
    color: var(--muted);

    font-size: 0.9rem;

    text-decoration: none;
  }

  .nav-links a:hover {
    color: white;
  }

  /* =========================================================
       TYPOGRAPHY
       ========================================================= */

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--heading);

    letter-spacing: -0.05em;
  }

  h1 {
    margin-bottom: 1.5rem;

    font-size: clamp(4.2rem, 10vw, 8rem);

    line-height: 0.88;
  }

  h2 {
    max-width: 840px;

    font-size: clamp(2.2rem, 5vw, 4rem);

    line-height: 1;
  }

  h3 {
    font-size: clamp(1.45rem, 2.3vw, 2rem);

    line-height: 1.05;
  }

  .eyebrow {
    margin-bottom: 1.15rem;

    color: var(--orange);

    font-size: 0.76rem;
    font-weight: 800;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }

  .lead {
    color: #dce6ee !important;

    font-size: 1.12rem;
  }

  /* =========================================================
       HERO
       ========================================================= */

  .hero {
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .hero-breadcrumbs {
    display: flex;
    flex-wrap: wrap;

    gap: 0.6rem;

    margin-bottom: 3.5rem;

    color: var(--subtle);

    font-size: 0.78rem;
  }

  .hero-breadcrumbs a {
    text-decoration: none;
  }

  .hero-breadcrumbs a:hover {
    color: white;
  }

  .hero-breadcrumbs strong {
    color: var(--blue-light);
  }

  .hero-subtitle {
    max-width: 820px;

    color: var(--muted);

    font-size: clamp(1.08rem, 2vw, 1.35rem);

    line-height: 1.65;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 0.6rem;

    margin-top: 2rem;
  }

  .hero-tags span,
  .skills-list span {
    padding: 0.55rem 0.75rem;

    color: #c5d5e3;

    border: 1px solid #28445c;
    border-radius: 7px;

    background: #091b2b;

    font-size: 0.74rem;
  }

  /* =========================================================
       KEY METRICS
       ========================================================= */

  .metrics {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 1rem;

    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .metric-card {
    min-height: 145px;

    padding: 1.4rem;

    border: 1px solid var(--border);
    border-radius: 13px;

    background:
      linear-gradient(
        135deg,
        rgba(22, 141, 255, 0.06),
        rgba(255, 138, 0, 0.025)
      ),
      var(--bg-card);
  }

  .metric-card strong {
    display: block;

    margin-bottom: 0.5rem;

    color: var(--orange);

    font-size: clamp(1.8rem, 4vw, 2.7rem);
  }

  .metric-card span {
    color: #9eb1c2;

    font-size: 0.87rem;
  }

  /* =========================================================
       CASE STUDY SECTIONS
       ========================================================= */

  .case-section {
    display: grid;

    grid-template-columns:
      minmax(150px, 0.3fr)
      minmax(0, 1fr);

    gap: clamp(2rem, 7vw, 6rem);

    padding: clamp(4.5rem, 9vw, 7.5rem) 0;

    border-top: 1px solid var(--border);
  }

  .section-content {
    max-width: 900px;
  }

  .section-content > p {
    color: var(--muted);

    line-height: 1.75;
  }

  /* =========================================================
       ROCKEETERS PROJECT GRID
       ========================================================= */

  .projects-section .section-content {
    max-width: none;
  }

  .project-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 1rem;

    margin-top: 2.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;

    min-height: 430px;

    padding: 1.5rem;

    color: inherit;

    border: 1px solid var(--border);
    border-radius: 13px;

    background: var(--bg-card);

    text-decoration: none;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);

    background: #091a2a;

    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
  }

  .business-card {
    border-color: rgba(255, 138, 0, 0.5);
  }

  .business-card:hover {
    border-color: var(--orange);
  }

  .repricing-card {
    border-color: rgba(22, 141, 255, 0.5);
  }

  .repricing-card:hover {
    border-color: var(--blue);
  }

  .finance-card {
    border-color: rgba(38, 213, 162, 0.48);
  }

  .finance-card:hover {
    border-color: var(--green);
  }

  .project-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 1.4rem;
  }

  .project-number {
    font-size: 0.8rem;
    font-weight: 850;
  }

  .project-icon {
    font-size: 1.4rem;
  }

  .orange {
    color: var(--orange);
  }

  .blue {
    color: var(--blue);
  }

  .green {
    color: var(--green);
  }

  .project-card > p {
    color: var(--muted);

    line-height: 1.55;
  }

  .project-metrics {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 0.6rem;

    margin-top: auto;
    padding-top: 1.25rem;

    border-top: 1px solid var(--border);
  }

  .project-metrics strong {
    display: block;

    color: white;

    font-size: 1rem;
  }

  .project-metrics span {
    display: block;

    margin-top: 0.2rem;

    color: var(--subtle);

    font-size: 0.68rem;

    line-height: 1.3;
  }

  .project-link {
    display: inline-block;

    margin-top: 1.1rem;

    font-size: 0.76rem;
    font-weight: 750;
  }

  /* =========================================================
       OPERATING FLOW
       ========================================================= */

  .operating-flow {
    display: grid;

    grid-template-columns:
