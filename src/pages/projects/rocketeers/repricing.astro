---
/* =========================================================
   PAGE METADATA
   ========================================================= */
import ProjectGallery from "../../../components/ProjectGallery.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SeoHead from "../../../components/SeoHead.astro";
import HorizontalBarChart from "../../../components/HorizontalBarChart.astro";
import SkillLinks from "../../../components/SkillLinks.astro";
import { rocketeersSummary } from "../../../data/rocketeers";
const title =
    "Marketplace Repricing Engine | Rocketeers | Konstantinos Zafiropoulos";

const description =
    "Case study of the Excel-based marketplace pricing and bulk-repricing system built for Rocketeers.";

const metrics = [
    {
        value: "1,000+",
        label: "Live eBay listings",
    },
    {
        value: "10,000+",
        label: "Priced variations",
    },
    {
        value: "16,000+",
        label: "Prices refreshed per run",
    },
    {
        value: "~1 hour",
        label: "Mature repricing workflow",
    },
];
---

<html lang="en">
    <!-- =======================================================
       HEAD / SEO
       ======================================================= -->

    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <!-- ===================================================
           PRIMARY NAVIGATION
           =================================================== -->

            <SiteHeader />

            <!-- ===================================================
           HERO
           =================================================== -->

            <header class="hero">
                <div class="hero-breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span>→</span>
                    <a href="/projects/rocketeers/">Rocketeers</a>
                    <span>→</span>
                    <strong>Repricing Engine</strong>
                </div>

                <p class="eyebrow">Rocketeers · Excel · Pricing Operations</p>

                <h1>Marketplace Repricing Engine</h1>

                <p class="hero-subtitle">
                    An Excel-based pricing system built to turn rapidly changing
                    market data into structured marketplace prices across
                    thousands of product variations.
                </p>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "excel",
                        "web-queries",
                        "pricing-operations",
                        "ebay-fileexchange",
                        "operational-scaling",
                        "data-quality",
                    ]}
                />
            </header>

            <!-- ===================================================
           KEY METRICS
           =================================================== -->

            <section
                class="metrics"
                aria-label="Marketplace repricing system metrics"
            >
                {
                    metrics.map((metric) => (
                        <article class="metric-card">
                            <strong>{metric.value}</strong>
                            <span>{metric.label}</span>
                        </article>
                    ))
                }
            </section>

            <!-- ===================================================
           SECTION 01 — THE PROBLEM
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">01 — The problem</p>
                </div>

                <div class="section-content">
                    <h2>
                        Manual repricing stopped being practical as the
                        catalogue grew.
                    </h2>

                    <p class="lead">
                        Rocketeers eventually operated more than 1,000 live eBay
                        listings containing more than 10,000 individually priced
                        product variations.
                    </p>

                    <p>
                        Many listings contained roughly 12–14 colour variations,
                        while some products contained substantially more. Market
                        prices for Rocket League items could move quickly, so
                        keeping thousands of individual marketplace prices
                        current became an operational bottleneck.
                    </p>

                    <p>
                        Updating every variation manually would have taken days.
                        I built separate Excel pricing workbooks for PC,
                        PlayStation, Xbox, and Switch so repricing could be
                        handled as a repeatable process.
                    </p>
                </div>
            </section>

            <!-- =====================================================
     PROJECT VISUALS — REPRICING ENGINE
     ===================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">Project visuals</p>
                </div>

                <div class="section-content">
                    <ProjectGallery
                        title="The marketplace repricing workbook"
                        description="A presentation visual based on the surviving Excel pricing system."
                        images={[
                            {
                                src: "/images/projects/rocketeers/repricing.webp",
                                width: 1563,
                                height: 692,
                                alt: "Excel repricing matrix with product variations and color-coded marketplace prices.",
                                caption:
                                    "Edited view of the repricing matrix illustrating how product variations and prices were organized into repeatable bulk-update workflows.",
                            },
                        ]}
                    />
                </div>
            </section>

            <HorizontalBarChart
                title="Repricing workflow scale"
                description="The system translated a large marketplace catalogue into repeatable bulk-price operations."
                items={[
                    { label: "Live eBay listings", value: 1000, display: "1,000+" },
                    { label: "Priced product variations", value: 10000, display: "10,000+" },
                    { label: "Prices refreshed per mature run", value: 16000, display: "16,000+" },
                ]}
                sourceNote="Operational scale documented from the production repricing workflow; values are presented as conservative minimums."
            />

            <!-- ===================================================
           DOCUMENTED COMMERCIAL SCALE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">Commercial evidence</p>
                </div>

                <div class="section-content">
                    <h2>The pricing system supported a multi-platform catalogue.</h2>

                    <p class="lead">
                        The later eBay export provides transaction-level evidence
                        of the commercial environment in which the repricing
                        workflow operated.
                    </p>

                    <div class="scale-grid">
                        <article>
                            <strong>$219.8K</strong>
                            <span>documented eBay USD gross sales</span>
                        </article>

                        <article>
                            <strong>{rocketeersSummary.uniqueItemIds.toLocaleString("en-US")}</strong>
                            <span>unique sold eBay item IDs</span>
                        </article>

                        <article>
                            <strong>42.2%</strong>
                            <span>of documented USD sales from PC</span>
                        </article>

                        <article>
                            <strong>4</strong>
                            <span>primary product platforms</span>
                        </article>
                    </div>

                    <p>
                        PC generated the largest documented USD share, followed
                        by PlayStation and Xbox. Separate workbooks helped keep
                        pricing logic and product ordering aligned with each
                        platform's catalogue.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 02 — THE WORKFLOW
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">02 — Workflow</p>
                </div>

                <div class="section-content">
                    <h2>Market data in. Structured marketplace prices out.</h2>

                    <p class="lead">
                        The system connected external market information, Excel
                        pricing logic, commercial judgement, and eBay
                        bulk-revision workflows.
                    </p>

                    <!-- Workflow diagram -->
                    <div class="workflow">
                        <div class="workflow-step">
                            <span>01</span>
                            <strong>Market data</strong>
                            <p>
                                Import marketplace reference prices from
                                external sources.
                            </p>
                        </div>

                        <div class="workflow-arrow" aria-hidden="true">→</div>

                        <div class="workflow-step">
                            <span>02</span>
                            <strong>Normalize</strong>
                            <p>
                                Convert imported price ranges into usable
                                numeric credit values.
                            </p>
                        </div>

                        <div class="workflow-arrow" aria-hidden="true">→</div>

                        <div class="workflow-step">
                            <span>03</span>
                            <strong>Price</strong>
                            <p>
                                Apply pricing tables, margin logic, and
                                commercial judgement.
                            </p>
                        </div>

                        <div class="workflow-arrow" aria-hidden="true">→</div>

                        <div class="workflow-step">
                            <span>04</span>
                            <strong>Order outputs</strong>
                            <p>
                                Produce prices in the same variation order used
                                on eBay.
                            </p>
                        </div>

                        <div class="workflow-arrow" aria-hidden="true">→</div>

                        <div class="workflow-step">
                            <span>05</span>
                            <strong>Bulk revise</strong>
                            <p>
                                Transfer ordered price blocks into eBay
                                FileExchange.
                            </p>
                        </div>

                        <div class="workflow-arrow" aria-hidden="true">→</div>

                        <div class="workflow-step">
                            <span>06</span>
                            <strong>Review</strong>
                            <p>
                                Check response files for successful revisions,
                                warnings, and failures.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 03 — MARKET DATA
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">03 — Market data</p>
                </div>

                <div class="section-content">
                    <h2>
                        External market prices were pulled directly into Excel.
                    </h2>

                    <p class="lead">
                        The surviving PC workbook contains real Excel web-query
                        connections used to bring external market pricing into
                        the workbook.
                    </p>

                    <div class="evidence-grid">
                        <article>
                            <strong>42</strong>
                            <span
                                >web-data connections in the surviving workbook</span
                            >
                        </article>

                        <article>
                            <strong>39</strong>
                            <span
                                >connections pointing to RL Insider PC data</span
                            >
                        </article>

                        <article>
                            <strong>3</strong>
                            <span
                                >connections pointing to an alternative price
                                source</span
                            >
                        </article>
                    </div>

                    <p>
                        Imported datasets covered categories such as painted
                        wheels, cars, boosts, toppers, decals, goal explosions,
                        and trails.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 04 — NORMALIZATION & PRICING LOGIC
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">04 — Pricing logic</p>
                </div>

                <div class="section-content">
                    <h2>
                        Raw market ranges had to become usable commercial
                        prices.
                    </h2>

                    <p class="lead">
                        Imported prices were not directly usable. The workbook
                        first normalized them into numerical credit values
                        before applying the commercial pricing model.
                    </p>

                    <div class="logic-grid">
                        <article>
                            <span class="logic-label">Raw value</span>
                            <strong>2.3 k</strong>
                            <p>Imported marketplace text</p>
                        </article>

                        <div class="logic-arrow" aria-hidden="true">→</div>

                        <article>
                            <span class="logic-label">Normalized</span>
                            <strong>2300</strong>
                            <p>Numeric credit value</p>
                        </article>

                        <div class="logic-arrow" aria-hidden="true">→</div>

                        <article>
                            <span class="logic-label">Pricing model</span>
                            <strong>Target price</strong>
                            <p>Marketplace selling price</p>
                        </article>
                    </div>

                    <p>
                        The pricing process generally used the upper part of the
                        observed market range and then cross-referenced
                        commercial price and margin tables to calculate a target
                        selling price.
                    </p>

                    <p>
                        The system was deliberately not completely mechanical.
                        Scarce, rare, or difficult-to-source items could still
                        receive manual adjustments when marketplace conditions
                        justified a different price.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 05 — VARIATION ORDERING
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">05 — Process control</p>
                </div>

                <div class="section-content">
                    <h2>
                        Standardized variation ordering reduced manual matching.
                    </h2>

                    <p class="lead">
                        One of the most important process decisions was keeping
                        product variations in the same standard order in both
                        Excel and the eBay listings.
                    </p>

                    <div class="variation-example">
                        <span>Black</span>
                        <span>Burnt Sienna</span>
                        <span>Cobalt</span>
                        <span>Crimson</span>
                        <span>Default</span>
                        <span>Forest Green</span>
                        <span>Grey</span>
                        <span>Lime</span>
                        <span>Orange</span>
                        <span>Pink</span>
                        <span>Purple</span>
                        <span>Saffron</span>
                        <span>Sky Blue</span>
                        <span>Titanium White</span>
                    </div>

                    <p>
                        Because the internal output matched the listing
                        variation order, an entire price block could be copied
                        into FileExchange instead of matching every colour
                        individually.
                    </p>

                    <div class="callout">
                        <strong>Why this mattered</strong>

                        <p>
                            The biggest time saving did not come from one
                            sophisticated formula. It came from designing the
                            process so thousands of repeated decisions could be
                            handled consistently.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 06 — SCALE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">06 — Scale</p>
                </div>

                <div class="section-content">
                    <h2>
                        The system turned a multi-day manual task into a
                        repeatable operating workflow.
                    </h2>

                    <p class="lead">
                        At maturity, the workflow could refresh more than 16,000
                        marketplace variation prices in roughly one hour.
                    </p>

                    <div class="scale-grid">
                        <article>
                            <strong>1,283</strong>
                            <span
                                >parent listings in one preserved FileExchange
                                dataset</span
                            >
                        </article>

                        <article>
                            <strong>14,719</strong>
                            <span>variation rows</span>
                        </article>

                        <article>
                            <strong>16,002</strong>
                            <span
                                >total rows in the preserved bulk-update dataset</span
                            >
                        </article>

                        <article>
                            <strong>38</strong>
                            <span
                                >maximum observed variations on a single listing</span
                            >
                        </article>
                    </div>

                    <div class="important-note">
                        <strong>Important:</strong>

                        <p>
                            This was a highly structured bulk-repricing
                            workflow, not real-time or fully automated
                            repricing. Product matching and transfer into
                            FileExchange still involved manual operational
                            steps.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 07 — EBAY FILEEXCHANGE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">07 — Bulk updates</p>
                </div>

                <div class="section-content">
                    <h2>
                        Excel outputs ultimately fed into eBay FileExchange.
                    </h2>

                    <p class="lead">
                        Once product prices were calculated and arranged in the
                        correct order, the corresponding block was transferred
                        into eBay's FileExchange bulk-edit format.
                    </p>

                    <div class="response-grid">
                        <article class="response-success">
                            <strong>246</strong>
                            <span>Success</span>
                        </article>

                        <article class="response-warning">
                            <strong>261</strong>
                            <span>Warning</span>
                        </article>

                        <article class="response-failure">
                            <strong>7</strong>
                            <span>Failure</span>
                        </article>
                    </div>

                    <p>
                        Response files were reviewed after uploads to confirm
                        processing and identify warnings or failed revisions.
                        This made validation part of the workflow rather than
                        assuming every bulk update had succeeded.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 08 — WORKBOOK ARCHITECTURE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">08 — Workbook architecture</p>
                </div>

                <div class="section-content">
                    <h2>
                        Different sheets handled different stages of the pricing
                        process.
                    </h2>

                    <div class="architecture-grid">
                        <article>
                            <span>Market inputs</span>
                            <strong>Wheels · Boosts · Cars</strong>
                            <p>
                                Imported market pricing data for major product
                                categories.
                            </p>
                        </article>

                        <article>
                            <span>Normalization</span>
                            <strong>Insider-Prices</strong>
                            <p>
                                Converted imported text price ranges into usable
                                numeric values.
                            </p>
                        </article>

                        <article>
                            <span>Commercial model</span>
                            <strong>Key Prices</strong>
                            <p>
                                Pricing and margin tables used to derive
                                marketplace price levels.
                            </p>
                        </article>

                        <article>
                            <span>Outputs</span>
                            <strong>Sheet1 · Sheet2 · Sheet3</strong>
                            <p>
                                Category-based price outputs arranged for
                                practical marketplace use.
                            </p>
                        </article>
                    </div>

                    <p>
                        One of the largest output sheets contains roughly 40,590
                        formula cells and more than 1,400 populated headers,
                        illustrating the scale the workbook eventually reached.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 09 — DATA QUALITY
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">09 — Data quality</p>
                </div>

                <div class="section-content">
                    <h2>
                        A large operational workbook also creates maintenance
                        problems.
                    </h2>

                    <p class="lead">
                        The surviving production workbook contains both
                        legitimate missing values and some genuine historical
                        errors.
                    </p>

                    <div class="diagnostic-list">
                        <div>
                            <span>01</span>
                            <p>
                                Large numbers of <code>#N/A</code> results where particular
                                item / colour combinations did not exist or external
                                prices were unavailable.
                            </p>
                        </div>

                        <div>
                            <span>02</span>
                            <p>
                                88 formulas containing literal <code>#REF!</code
                                > references in historical sections.
                            </p>
                        </div>

                        <div>
                            <span>03</span>
                            <p>
                                Four broken defined names requiring review in
                                any cleaned presentation copy.
                            </p>
                        </div>

                        <div>
                            <span>04</span>
                            <p>
                                External links and private local file paths that
                                must be sanitized before public presentation.
                            </p>
                        </div>
                    </div>

                    <div class="important-note">
                        <strong>Portfolio approach</strong>

                        <p>
                            The original production logic should be preserved
                            rather than hiding every historical imperfection.
                            Cleaning the public copy means separating genuine
                            operational behaviour from obsolete or private
                            material — not rewriting the project into something
                            it never was.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 10 — SKILLS DEMONSTRATED
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">10 — Skills demonstrated</p>
                </div>

                <div class="section-content">
                    <h2>
                        The value was in scaling an operational problem, not in
                        one Excel formula.
                    </h2>

                    <SkillLinks
                        skills={[
                            "excel",
                            "pricing-operations",
                            "marketplace-operations",
                            "web-queries",
                            "data-transformation",
                            "decision-making",
                            "process-improvement",
                            "variation-management",
                            "bulk-marketplace-updates",
                            "data-quality",
                            "error-reduction",
                            "operational-scaling",
                            "commercial-analysis",
                        ]}
                    />
                </div>
            </section>

            <!-- ===================================================
           PROJECT NAVIGATION
           =================================================== -->

            <section class="project-end">
                <p class="eyebrow">Rocketeers systems</p>

                <h2>
                    One system helped price the catalogue. Another tracked the
                    business.
                </h2>

                <div class="project-end-links">
                    <a class="text-link" href="/projects/rocketeers/">
                        Rocketeers overview
                        <span aria-hidden="true">→</span>
                    </a>

                    <a
                        class="text-link"
                        href="/projects/rocketeers/business-operations/"
                    >
                        Business & Marketplace Operations
                        <span aria-hidden="true">→</span>
                    </a>

                    <a
                        class="text-link"
                        href="/projects/rocketeers/financial-tracker/"
                    >
                        Financial & Operations Tracker
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </section>
        </main>

        <!-- =====================================================
         FOOTER
         ===================================================== -->

        <SiteFooter />
    </body>
</html>

<style>
    /* =========================================================
     DESIGN TOKENS
     ========================================================= */

    :root {
        --bg: #050d18;
        --bg-soft: #071522;
        --bg-card: rgba(7, 21, 34, 0.86);

        --heading: #ffffff;
        --text: #e8eef5;
        --muted: #a9bbcc;
        --subtle: #71869a;

        --border: #1d354a;

        --blue: #168dff;
        --blue-light: #65baff;

        --orange: #ff8a00;

        --green: #26d5a2;

        --red: #ff5b5b;
        --yellow: #ffb347;

        --page-width: 1240px;

        color: var(--text);
        background: var(--bg);

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    /* =========================================================
     GLOBAL
     ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;

        margin: 0;

        color: var(--text);

        background:
            radial-gradient(
                circle at top right,
                rgba(22, 141, 255, 0.1),
                transparent 35rem
            ),
            radial-gradient(
                circle at 15% 35%,
                rgba(255, 138, 0, 0.035),
                transparent 30rem
            ),
            var(--bg);
    }

    main,
    footer {
        max-width: var(--page-width);

        margin-inline: auto;

        padding-left: clamp(1.5rem, 5vw, 4.5rem);
        padding-right: clamp(1.5rem, 5vw, 4.5rem);
    }

    a {
        color: inherit;
    }

    a:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
    }

    code {
        color: var(--blue-light);
    }

    /* =========================================================
     NAVIGATION
     ========================================================= */

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 74px;

        border-bottom: 1px solid var(--border);
    }

    .wordmark {
        color: white;

        font-size: 1.35rem;
        font-weight: 850;

        letter-spacing: -0.08em;

        text-decoration: none;
    }

    .wordmark span {
        color: var(--orange);
    }

    .nav-links {
        display: flex;

        gap: clamp(1rem, 3vw, 2.5rem);
    }

    .nav-links a {
        color: var(--muted);

        font-size: 0.9rem;

        text-decoration: none;
    }

    .nav-links a:hover {
        color: white;
    }

    /* =========================================================
     TYPOGRAPHY
     ========================================================= */

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2 {
        color: var(--heading);

        letter-spacing: -0.05em;
    }

    h1 {
        max-width: 1000px;

        margin-bottom: 1.5rem;

        font-size: clamp(3.8rem, 8vw, 7.2rem);

        line-height: 0.9;
    }

    h2 {
        max-width: 800px;

        font-size: clamp(2.2rem, 5vw, 4rem);

        line-height: 1;
    }

    h3 {
        color: white;
    }

    .eyebrow {
        margin-bottom: 1.15rem;

        color: var(--orange);

        font-size: 0.76rem;
        font-weight: 800;

        letter-spacing: 0.09em;

        text-transform: uppercase;
    }

    .lead {
        color: #dce6ee !important;

        font-size: 1.12rem;
    }

    /* =========================================================
     HERO
     ========================================================= */

    .hero {
        padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
    }

    .hero-breadcrumbs {
        display: flex;
        flex-wrap: wrap;

        gap: 0.6rem;

        margin-bottom: 3.5rem;

        color: var(--subtle);

        font-size: 0.78rem;
    }

    .hero-breadcrumbs a {
        text-decoration: none;
    }

    .hero-breadcrumbs a:hover {
        color: white;
    }

    .hero-breadcrumbs strong {
        color: var(--blue-light);
    }

    .hero-subtitle {
        max-width: 780px;

        color: var(--muted);

        font-size: clamp(1.08rem, 2vw, 1.35rem);

        line-height: 1.65;
    }

    .hero-tags {
        display: flex;
        flex-wrap: wrap;

