---
/* =========================================================
   PAGE METADATA
   ========================================================= */
import ProjectGallery from "../../../components/ProjectGallery.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SeoHead from "../../../components/SeoHead.astro";
import HorizontalBarChart from "../../../components/HorizontalBarChart.astro";
import SkillLinks from "../../../components/SkillLinks.astro";
import ProcessFlow from "../../../components/ProcessFlow.astro";
import { rocketeersSummary } from "../../../data/rocketeers";
const title =
    "Marketplace Repricing Engine | Rocketeers | Konstantinos Zafeiropoulos";

const description =
    "Case study of the Excel-based marketplace pricing and bulk-repricing system built for Rocketeers.";

const metrics = [
    {
        value: "1,000+",
        label: "Live eBay listings",
    },
    {
        value: "10,000+",
        label: "Priced variations",
    },
    {
        value: "16,000+",
        label: "Prices refreshed per run",
    },
    {
        value: "~1 hour",
        label: "Mature repricing workflow",
    },
];
---

<html lang="en">
    <!-- =======================================================
       HEAD / SEO
       ======================================================= -->

    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <!-- ===================================================
           PRIMARY NAVIGATION
           =================================================== -->

            <SiteHeader />

            <!-- ===================================================
           HERO
           =================================================== -->

            <header class="hero">
                <div class="hero-breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span>→</span>
                    <a href="/projects/rocketeers/">Rocketeers</a>
                    <span>→</span>
                    <strong>Repricing Engine</strong>
                </div>

                <p class="eyebrow">Rocketeers · Excel · Pricing Operations</p>

                <h1>Marketplace Repricing Engine</h1>

                <p class="hero-subtitle">
                    An Excel-based pricing system built to turn rapidly changing
                    market data into structured marketplace prices across
                    thousands of product variations.
                </p>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "excel",
                        "web-queries",
                        "pricing-operations",
                        "ebay-fileexchange",
                        "operational-scaling",
                        "data-quality",
                    ]}
                />
            </header>

            <!-- ===================================================
           KEY METRICS
           =================================================== -->

            <section
                class="metrics"
                aria-label="Marketplace repricing system metrics"
            >
                {
                    metrics.map((metric) => (
                        <article class="metric-card">
                            <strong>{metric.value}</strong>
                            <span>{metric.label}</span>
                        </article>
                    ))
                }
            </section>

            <!-- ===================================================
           SECTION 01 — THE PROBLEM
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">01 — The problem</p>
                </div>

                <div class="section-content">
                    <h2>
                        Manual repricing stopped being practical as the
                        catalogue grew.
                    </h2>

                    <p class="lead">
                        Rocketeers eventually operated more than 1,000 live eBay
                        listings containing more than 10,000 individually priced
                        product variations.
                    </p>

                    <p>
                        Many listings contained roughly 12–14 colour variations,
                        while some products contained substantially more. Market
                        prices for Rocket League items could move quickly, so
                        keeping thousands of individual marketplace prices
                        current became an operational bottleneck.
                    </p>

                    <p>
                        Updating every variation manually would have taken days.
                        I built separate Excel pricing workbooks for PC,
                        PlayStation, Xbox, and Switch so repricing could be
                        handled as a repeatable process.
                    </p>
                </div>
            </section>

            <!-- =====================================================
     PROJECT VISUALS — REPRICING ENGINE
     ===================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">Project visuals</p>
                </div>

                <div class="section-content">
                    <ProjectGallery
                        title="The marketplace repricing workbook"
                        description="A presentation visual based on the original Excel pricing system."
                        images={[
                            {
                                src: "/images/projects/rocketeers/repricing.webp",
                                width: 1563,
                                height: 692,
                                alt: "Excel repricing matrix with product variations and color-coded marketplace prices.",
                                caption:
                                    "Edited view of the repricing matrix illustrating how product variations and prices were organized into repeatable bulk-update workflows.",
                            },
                        ]}
                    />
                </div>
            </section>

            <HorizontalBarChart
                title="Repricing workflow scale"
                description="The system translated a large marketplace catalogue into repeatable bulk-price operations."
                items={[
                    { label: "Live eBay listings", value: 1000, display: "1,000+" },
                    { label: "Priced product variations", value: 10000, display: "10,000+" },
                    { label: "Prices refreshed per mature run", value: 16000, display: "16,000+" },
                ]}
                sourceNote="Minimum figures from the production repricing workflow."
            />

            <!-- ===================================================
           DOCUMENTED COMMERCIAL SCALE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">Commercial evidence</p>
                </div>

                <div class="section-content">
                    <h2>The pricing system supported a multi-platform catalogue.</h2>

                    <p class="lead">
                        The eBay export shows the size of the catalogue the engine
                        kept priced.
                    </p>

                    <div class="scale-grid">
                        <article>
                            <strong>$219.8K</strong>
                            <span>eBay USD gross sales, 2017–22</span>
                        </article>

                        <article>
                            <strong>{rocketeersSummary.uniqueItemIds.toLocaleString("en-US")}</strong>
                            <span>unique sold eBay item IDs</span>
                        </article>

                        <article>
                            <strong>42.2%</strong>
                            <span>of USD sales from PC</span>
                        </article>

                        <article>
                            <strong>4</strong>
                            <span>primary product platforms</span>
                        </article>
                    </div>

                    <p>
                        PC generated the largest USD share, followed
                        by PlayStation and Xbox. Separate workbooks helped keep
                        pricing logic and product ordering aligned with each
                        platform's catalogue.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 02 — THE WORKFLOW
           =================================================== -->

            <section class="case-section wide-section" id="workflow">
                <div class="section-label">
                    <p class="eyebrow">02 — Workflow</p>
                </div>

                <div class="section-content">
                    <h2>Market data in. Structured marketplace prices out.</h2>

                    <p class="lead">
                        Six stages connected external market data, Excel
                        pricing logic, commercial judgement and eBay bulk
                        revisions.
                    </p>

                    <ProcessFlow
                        id="repricing-flow"
                        label="Repricing workflow"
                        detailHint="Select a stage to walk through a worked example"
                        steps={[
                            { title: "Market data", text: "Pull reference prices into Excel." },
                            { title: "Normalize", text: "Turn text price ranges into numbers." },
                            { title: "Price", text: "Apply price tables, margin and judgement." },
                            { title: "Order outputs", text: "Match the eBay variation order." },
                            { title: "Bulk revise", text: "Load price blocks into FileExchange." },
                            { title: "Review", text: "Check every response file." },
                        ]}
                    >
                        <div class="pf-ex" slot="detail-1">
                            <span class="pf-ex-label">Worked example · illustrative values</span>
                            <p>
                                Excel web queries refreshed category tables
                                straight from the price sites. The PC workbook holds 42 connections: 39 to RL Insider
                                and 3 to a second source.
                            </p>
<pre class="pf-ex-code">Item      Colour           Market price (as imported)
Octane    Titanium White   <em>2.3k - 2.8k</em>
Octane    Black            <em>1.1k - 1.4k</em>
Octane    Crimson          <em>600 - 800</em></pre>
                        </div>

                        <div class="pf-ex" slot="detail-2">
                            <span class="pf-ex-label">Worked example · illustrative values</span>
                            <p>
                                Imported prices arrive as text ranges. The
                                Insider-Prices sheet splits each range and
                                converts shorthand such as “2.3k” into a credit
                                value the pricing model can use.
                            </p>
                            <div class="pf-ex-chain">
                                <div class="pf-ex-box"><small>Imported text</small><b>2.3k – 2.8k</b></div>
                                <span class="pf-ex-op" aria-hidden="true">→</span>
                                <div class="pf-ex-box"><small>Low / high</small><b>2,300 / 2,800</b></div>
                                <span class="pf-ex-op" aria-hidden="true">→</span>
                                <div class="pf-ex-box is-result"><small>Value used (upper range)</small><b>2,800 credits</b></div>
                            </div>
                        </div>

                        <div class="pf-ex" slot="detail-3">
                            <span class="pf-ex-label">Worked example · illustrative values</span>
                            <p>
                                The credit value is cross-referenced with the Key
                                Prices tables to find a cost basis, then a margin
                                tier sets the target. Scarce or hard-to-source
                                items could still be adjusted by hand.
                            </p>
                            <div class="pf-ex-chain">
                                <div class="pf-ex-box"><small>Market value</small><b>2,800 cr</b></div>
                                <span class="pf-ex-op" aria-hidden="true">×</span>
                                <div class="pf-ex-box"><small>Cost per credit</small><b>$0.0045</b></div>
                                <span class="pf-ex-op" aria-hidden="true">+</span>
                                <div class="pf-ex-box"><small>Margin tier</small><b>30%</b></div>
                                <span class="pf-ex-op" aria-hidden="true">=</span>
                                <div class="pf-ex-box"><small>Target</small><b>$16.38</b></div>
                                <span class="pf-ex-op" aria-hidden="true">→</span>
                                <div class="pf-ex-box is-result"><small>Price point</small><b>$16.49</b></div>
                            </div>
                        </div>

                        <div class="pf-ex" slot="detail-4">
                            <span class="pf-ex-label">Worked example · illustrative prices</span>
                            <p>
                                Every output column follows the same colour
                                order as the eBay listing, so a whole block of
                                prices moves across in one paste.
                            </p>
                            <ol class="pf-ex-swatches">
                                <li><span>Black</span><b>$9.49</b></li>
                                <li><span>Burnt Sienna</span><b>$4.99</b></li>
                                <li><span>Cobalt</span><b>$5.49</b></li>
                                <li><span>Crimson</span><b>$5.99</b></li>
                                <li><span>Default</span><b>$2.99</b></li>
                                <li><span>Forest Green</span><b>$4.99</b></li>
                                <li><span>Grey</span><b>$4.49</b></li>
                                <li><span>Lime</span><b>$4.99</b></li>
                                <li><span>Orange</span><b>$4.99</b></li>
                                <li><span>Pink</span><b>$5.49</b></li>
                                <li><span>Purple</span><b>$5.49</b></li>
                                <li><span>Saffron</span><b>$4.99</b></li>
                                <li><span>Sky Blue</span><b>$5.99</b></li>
                                <li><span>Titanium White</span><b>$16.49</b></li>
                            </ol>
                        </div>

                        <div class="pf-ex" slot="detail-5">
                            <span class="pf-ex-label">Worked example · FileExchange format</span>
                            <p>
                                One parent row per listing, then one row per
                                variation. The preserved dataset holds 1,283
                                parent rows and 14,719 variation rows — 16,002
                                in total.
                            </p>
<pre class="pf-ex-code">*Action(SiteID=US|Country=US|Currency=USD),ItemID,Relationship,RelationshipDetails,StartPrice
Revise,<em>&lt;item ID&gt;</em>,,,
,,Variation,Color=Black,<em>9.49</em>
,,Variation,Color=Burnt Sienna,<em>4.99</em>
,,Variation,Color=Titanium White,<em>16.49</em></pre>
                        </div>

                        <div class="pf-ex" slot="detail-6">
                            <span class="pf-ex-label">From a preserved response file</span>
                            <p>
                                eBay returns a status for every uploaded row. One
                                preserved response file reads:
                            </p>
                            <div class="pf-ex-status">
                                <div class="pf-ex-stack" role="img" aria-label="246 success, 261 warning and 7 failure rows out of 514">
                                    <span style="width: 47.86%; background: #26d5a2"></span>
                                    <span style="width: 50.78%; background: #ffb347"></span>
                                    <span style="width: 1.36%; background: #ff5b5b"></span>
                                </div>
                                <ul class="pf-ex-legend">
                                    <li><i style="background: #26d5a2"></i><b>246</b> success</li>
                                    <li><i style="background: #ffb347"></i><b>261</b> warning</li>
                                    <li><i style="background: #ff5b5b"></i><b>7</b> failure</li>
                                </ul>
                            </div>
                            <p>
                                Warnings and failures were reviewed before the
                                next run, so validation was built into every
                                upload.
                            </p>
                        </div>
                    </ProcessFlow>
                </div>
            </section>

            <!-- ===================================================
           SECTION 03 — MARKET DATA
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">03 — Market data</p>
                </div>

                <div class="section-content">
                    <h2>
                        External market prices were pulled directly into Excel.
                    </h2>

                    <p class="lead">
                        The PC workbook pulls external market pricing in through
                        Excel web-query connections.
                    </p>

                    <div class="evidence-grid">
                        <article>
                            <strong>42</strong>
                            <span
                                >web-data connections in the PC workbook</span
                            >
                        </article>

                        <article>
                            <strong>39</strong>
                            <span
                                >connections pointing to RL Insider PC data</span
                            >
                        </article>

                        <article>
                            <strong>3</strong>
                            <span
                                >connections pointing to an alternative price
                                source</span
                            >
                        </article>
                    </div>

                    <p>
                        Imported datasets covered categories such as painted
                        wheels, cars, boosts, toppers, decals, goal explosions,
                        and trails.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 04 — NORMALIZATION & PRICING LOGIC
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">04 — Pricing logic</p>
                </div>

                <div class="section-content">
                    <h2>
                        Raw market ranges had to become usable commercial
                        prices.
                    </h2>

                    <p class="lead">
                        Imported prices were not directly usable. The workbook
                        first normalized them into numerical credit values
                        before applying the commercial pricing model.
                    </p>

                    <div class="logic-grid">
                        <article>
                            <span class="logic-label">Raw value</span>
                            <strong>2.3 k</strong>
                            <p>Imported marketplace text</p>
                        </article>

                        <div class="logic-arrow" aria-hidden="true">→</div>

                        <article>
                            <span class="logic-label">Normalized</span>
                            <strong>2300</strong>
                            <p>Numeric credit value</p>
                        </article>

                        <div class="logic-arrow" aria-hidden="true">→</div>

                        <article>
                            <span class="logic-label">Pricing model</span>
                            <strong>Target price</strong>
                            <p>Marketplace selling price</p>
                        </article>
                    </div>

                    <p>
                        The pricing process generally used the upper part of the
                        observed market range and then cross-referenced
                        commercial price and margin tables to calculate a target
                        selling price.
                    </p>

                    <p>
                        The system was deliberately not completely mechanical.
                        Scarce, rare, or difficult-to-source items could still
                        receive manual adjustments when marketplace conditions
                        justified a different price.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 05 — VARIATION ORDERING
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">05 — Process control</p>
                </div>

                <div class="section-content">
                    <h2>
                        Standardized variation ordering reduced manual matching.
                    </h2>

                    <p class="lead">
                        One of the most important process decisions was keeping
                        product variations in the same standard order in both
                        Excel and the eBay listings.
                    </p>

                    <div class="variation-example">
                        <span>Black</span>
                        <span>Burnt Sienna</span>
                        <span>Cobalt</span>
                        <span>Crimson</span>
                        <span>Default</span>
                        <span>Forest Green</span>
                        <span>Grey</span>
                        <span>Lime</span>
                        <span>Orange</span>
                        <span>Pink</span>
                        <span>Purple</span>
                        <span>Saffron</span>
                        <span>Sky Blue</span>
                        <span>Titanium White</span>
                    </div>

                    <p>
                        Because the internal output matched the listing
                        variation order, an entire price block could be copied
                        into FileExchange instead of matching every colour
                        individually.
                    </p>

                    <div class="callout">
                        <strong>Why this mattered</strong>

                        <p>
                            The biggest time saving did not come from one
                            sophisticated formula. It came from designing the
                            process so thousands of repeated decisions could be
                            handled consistently.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 06 — SCALE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">06 — Scale</p>
                </div>

                <div class="section-content">
                    <h2>
                        The system turned a multi-day manual task into a
                        repeatable operating workflow.
                    </h2>

                    <p class="lead">
                        At maturity, the workflow could refresh more than 16,000
                        marketplace variation prices in roughly one hour.
                    </p>

                    <div class="scale-grid">
                        <article>
                            <strong>1,283</strong>
                            <span
                                >parent listings in one preserved FileExchange
                                dataset</span
                            >
                        </article>

                        <article>
                            <strong>14,719</strong>
                            <span>variation rows</span>
                        </article>

                        <article>
                            <strong>16,002</strong>
                            <span
                                >total rows in the preserved bulk-update dataset</span
                            >
                        </article>

                        <article>
                            <strong>38</strong>
                            <span
                                >maximum observed variations on a single listing</span
                            >
                        </article>
                    </div>

                    <div class="callout">
                        <strong>Batch by design</strong>

                        <p>
                            Prices were refreshed in structured batches rather
                            than in real time. Product matching and the
                            FileExchange upload stayed hands-on, which kept a
                            human check on every run.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 07 — EBAY FILEEXCHANGE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">07 — Bulk updates</p>
                </div>

                <div class="section-content">
                    <h2>
                        Excel outputs ultimately fed into eBay FileExchange.
                    </h2>

                    <p class="lead">
                        Once product prices were calculated and arranged in the
                        correct order, the corresponding block was transferred
                        into eBay's FileExchange bulk-edit format.
                    </p>

                    <div class="response-grid">
                        <article class="response-success">
                            <strong>246</strong>
                            <span>Success</span>
                        </article>

                        <article class="response-warning">
                            <strong>261</strong>
                            <span>Warning</span>
                        </article>

                        <article class="response-failure">
                            <strong>7</strong>
                            <span>Failure</span>
                        </article>
                    </div>

                    <p>
                        Response files were reviewed after uploads to confirm
                        processing and identify warnings or failed revisions.
                        This made validation part of the workflow rather than
                        assuming every bulk update had succeeded.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 08 — WORKBOOK ARCHITECTURE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">08 — Workbook architecture</p>
                </div>

                <div class="section-content">
                    <h2>
                        Different sheets handled different stages of the pricing
                        process.
                    </h2>

                    <div class="architecture-grid">
                        <article>
                            <span>Market inputs</span>
                            <strong>Wheels · Boosts · Cars</strong>
                            <p>
                                Imported market pricing data for major product
                                categories.
                            </p>
                        </article>

                        <article>
                            <span>Normalization</span>
                            <strong>Insider-Prices</strong>
                            <p>
                                Converted imported text price ranges into usable
                                numeric values.
                            </p>
                        </article>

                        <article>
                            <span>Commercial model</span>
                            <strong>Key Prices</strong>
                            <p>
                                Pricing and margin tables used to derive
                                marketplace price levels.
                            </p>
                        </article>

                        <article>
                            <span>Outputs</span>
                            <strong>Sheet1 · Sheet2 · Sheet3</strong>
                            <p>
                                Category-based price outputs arranged for
                                practical marketplace use.
                            </p>
                        </article>
                    </div>

                    <p>
                        One of the largest output sheets contains roughly 40,590
                        formula cells and more than 1,400 populated headers,
                        illustrating the scale the workbook eventually reached.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 09 — DATA QUALITY
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">09 — Data quality</p>
                </div>

                <div class="section-content">
                    <h2>
                        A large operational workbook also creates maintenance
                        problems.
                    </h2>

                    <p class="lead">
                        A workbook that grows with the business picks up the
                        same maintenance debt as any production system.
                    </p>

                    <div class="diagnostic-list">
                        <div>
                            <span>01</span>
                            <p>
                                <code>#N/A</code> results wherever an item / colour
                                combination did not exist or no market price
                                was available.
                            </p>
                        </div>

                        <div>
                            <span>02</span>
                            <p>
                                88 formulas with literal <code>#REF!</code> references
                                in retired sections.
                            </p>
                        </div>

                        <div>
                            <span>03</span>
                            <p>
                                Four broken defined names left behind by earlier
                                restructuring.
                            </p>
                        </div>

                        <div>
                            <span>04</span>
                            <p>
                                External links and local file paths tied to the
                                original working environment.
                            </p>
                        </div>
                    </div>

                    <div class="callout">
                        <strong>What I would do differently</strong>

                        <p>
                            Retire old sections instead of leaving them in
                            place, document every defined name, and keep source
                            connections in one register. The pricing logic held
                            up; the housekeeping is what a rebuild would fix.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 10 — SKILLS DEMONSTRATED
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">10 — Skills demonstrated</p>
                </div>

                <div class="section-content">
                    <h2>
                        The value was in scaling an operational problem, not in
                        one Excel formula.
                    </h2>

                    <SkillLinks
                        skills={[
                            "excel",
                            "pricing-operations",
                            "marketplace-operations",
                            "web-queries",
                            "data-transformation",
                            "decision-making",
                            "process-improvement",
                            "variation-management",
                            "bulk-marketplace-updates",
                            "data-quality",
                            "error-reduction",
                            "operational-scaling",
                            "commercial-analysis",
                        ]}
                    />
                </div>
            </section>

            <!-- ===================================================
           PROJECT NAVIGATION
           =================================================== -->

            <section class="project-end">
                <p class="eyebrow">Rocketeers systems</p>

                <h2>
                    One system helped price the catalogue. Another tracked the
                    business.
                </h2>

                <div class="project-end-links">
                    <a class="text-link" href="/projects/rocketeers/">
                        Rocketeers overview
                        <span aria-hidden="true">→</span>
                    </a>

                    <a
                        class="text-link"
                        href="/projects/rocketeers/business-operations/"
                    >
                        Business & Marketplace Operations
                        <span aria-hidden="true">→</span>
                    </a>

                    <a
                        class="text-link"
                        href="/projects/rocketeers/financial-tracker/"
                    >
                        Financial & Operations Tracker
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </section>
        </main>

        <!-- =====================================================
         FOOTER
         ===================================================== -->

        <SiteFooter />
    </body>
</html>

<style>
    /* =========================================================
     DESIGN TOKENS
     ========================================================= */

    :root {
