---
/* =========================================================
   PAGE METADATA
   ========================================================= */

const title =
    "Financial & Operations Tracker | Rocketeers | Konstantinos Zafiropoulos";

const description =
    "Case study of the Excel-based financial and operations tracker used to monitor Rocketeers marketplace performance.";

const metrics = [
    {
        value: "$55.6K",
        label: "Recorded eBay turnover",
    },
    {
        value: "4,154",
        label: "Customer orders",
    },
    {
        value: "6,372",
        label: "Products sold",
    },
    {
        value: "25",
        label: "Populated months",
    },
];
---

<html lang="en">
    <!-- =======================================================
       HEAD / SEO
       ======================================================= -->

    <head>
        <meta charset="utf-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta name="description" content={description} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>{title}</title>
    </head>

    <body>
        <main>
            <!-- ===================================================
           PRIMARY NAVIGATION
           =================================================== -->

            <nav aria-label="Primary navigation">
                <a class="wordmark" href="/" aria-label="Homepage">
                    KZ<span>.</span>
                </a>

                <div class="nav-links">
                    <a href="/#projects">Projects</a>
                    <a href="/#about">About</a>
                    <a href="/#contact">Contact</a>
                </div>
            </nav>

            <!-- ===================================================
           HERO
           =================================================== -->

            <header class="hero">
                <div class="hero-breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span>→</span>
                    <a href="/projects/rocketeers/">Rocketeers</a>
                    <span>→</span>
                    <strong>Financial Tracker</strong>
                </div>

                <p class="eyebrow">
                    Rocketeers · Excel · Commercial Operations
                </p>

                <h1>Financial & Operations Tracker</h1>

                <p class="hero-subtitle">
                    A multi-sheet Excel system used to understand how the
                    marketplace operation was performing across sales,
                    inventory, platform activity, fees, trading, cancellations,
                    and approximate profitability.
                </p>

                <div class="hero-tags">
                    <span>Excel</span>
                    <span>Commercial Operations</span>
                    <span>Marketplace Analytics</span>
                    <span>Sales Tracking</span>
                    <span>Inventory Tracking</span>
                    <span>Operational Reporting</span>
                </div>
            </header>

            <!-- ===================================================
           KEY METRICS
           =================================================== -->

            <section
                class="metrics"
                aria-label="Financial and operations tracker metrics"
            >
                {
                    metrics.map((metric) => (
                        <article class="metric-card">
                            <strong>{metric.value}</strong>
                            <span>{metric.label}</span>
                        </article>
                    ))
                }
            </section>

            <!-- ===================================================
           SECTION 01 — OVERVIEW
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">01 — Overview</p>
                </div>

                <div class="section-content">
                    <h2>
                        Tracking the business behind the marketplace storefront.
                    </h2>

                    <p class="lead">
                        As Rocketeers grew, I needed more than order history and
                        account balances. I needed a way to understand how the
                        operation was performing commercially.
                    </p>

                    <p>
                        I maintained a multi-sheet Excel tracker covering
                        monthly sales, customer orders, products sold,
                        cancellations, inventory values, marketplace fees,
                        trading activity, cash positions, and approximate
                        operating profit.
                    </p>

                    <p>
                        The workbook evolved with the business and became a
                        practical tool for monitoring both day-to-day
                        performance and longer-term trends.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 02 — SCOPE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">02 — Scope</p>
                </div>

                <div class="section-content">
                    <h2>
                        The surviving workbook documents 25 months of real
                        marketplace activity.
                    </h2>

                    <p class="lead">
                        The available finance records cover approximately
                        December 2017 through December 2019.
                    </p>

                    <div class="scope-grid">
                        <article>
                            <strong>~30</strong>
                            <span>worksheets in the surviving workbook</span>
                        </article>

                        <article>
                            <strong>25</strong>
                            <span>populated monthly records</span>
                        </article>

                        <article>
                            <strong>PC</strong>
                            <span>tracked as a separate operating channel</span>
                        </article>

                        <article>
                            <strong>PS4</strong>
                            <span>tracked as a separate operating channel</span>
                        </article>

                        <article>
                            <strong>Xbox</strong>
                            <span>tracked as a separate operating channel</span>
                        </article>
                    </div>

                    <div class="important-note">
                        <strong>Important scope note</strong>

                        <p>
                            These figures represent surviving eBay-focused
                            finance records, not the full lifetime performance
                            of Rocketeers and not all platforms used during the
                            business's history.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 03 — WHAT THE TRACKER MONITORED
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">03 — What it tracked</p>
                </div>

                <div class="section-content">
                    <h2>
                        One workbook connected commercial performance with
                        operational activity.
                    </h2>

                    <div class="tracking-grid">
                        <article>
                            <span>Sales</span>
                            <strong>Turnover & customer orders</strong>
                            <p>
                                Monthly sales value and the number of completed
                                customer transactions.
                            </p>
                        </article>

                        <article>
                            <span>Volume</span>
                            <strong>Products sold</strong>
                            <p>
                                Individual products sold, separated from
                                customer order count.
                            </p>
                        </article>

                        <article>
                            <span>Inventory</span>
                            <strong>Stock & inventory values</strong>
                            <p>
                                In-game inventory and changes in inventory value
                                over time.
                            </p>
                        </article>

                        <article>
                            <span>Trading</span>
                            <strong>Credits / keys spent</strong>
                            <p>
                                Sourcing and trading activity used to replenish
                                or improve inventory composition.
                            </p>
                        </article>

                        <article>
                            <span>Costs</span>
                            <strong>Fees & acquisition costs</strong>
                            <p>
                                Marketplace fees and other operating costs
                                feeding into approximate profitability.
                            </p>
                        </article>

                        <article>
                            <span>Risk / quality</span>
                            <strong>Cancellations</strong>
                            <p>
                                Cancelled transactions and other activity
                                affecting realized performance.
                            </p>
                        </article>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 04 — OPERATING MODEL
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">04 — Operating model</p>
                </div>

                <div class="section-content">
                    <h2>The tracker followed the full commercial loop.</h2>

                    <p class="lead">
                        Rocketeers operated through a cycle where cash was
                        converted into in-game purchasing power, then inventory,
                        then marketplace sales, and finally back into cash.
                    </p>

                    <div class="flow">
                        <div class="flow-step">
                            <span>01</span>
                            <strong>Cash</strong>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>02</span>
                            <strong>Keys / Credits</strong>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>03</span>
                            <strong>Inventory</strong>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>04</span>
                            <strong>Marketplace Listings</strong>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>05</span>
                            <strong>Customer Sales</strong>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>06</span>
                            <strong>Cash</strong>
                        </div>
                    </div>

                    <p>
                        In-game trading also affected inventory composition,
                        inventory value, sourcing cost, and liquidity. The
                        workbook helped separate these different layers rather
                        than treating the entire operation as one simple sales
                        figure.
                    </p>
                </div>
            </section>

            <!-- ===================================================
           SECTION 05 — RECORDED PERFORMANCE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">05 — Recorded performance</p>
                </div>

                <div class="section-content">
                    <h2>
                        The surviving records document a substantial period of
                        marketplace activity.
                    </h2>

                    <div class="performance-grid">
                        <article>
                            <strong>$55,621</strong>
                            <span>recorded eBay turnover</span>
                        </article>

                        <article>
                            <strong>4,154</strong>
                            <span>customer orders</span>
                        </article>

                        <article>
                            <strong>6,372</strong>
                            <span>individual products sold</span>
                        </article>

                        <article>
                            <strong>$27,101</strong>
                            <span>approximate operating profit</span>
                        </article>

                        <article>
                            <strong>199</strong>
                            <span>cancellations</span>
                        </article>

                        <article>
                            <strong>1.53</strong>
                            <span>average products per order</span>
                        </article>
                    </div>

                    <div class="important-note">
                        <strong>Profit methodology</strong>

                        <p>
                            Approximate operating profit should be interpreted
                            cautiously because the workbook and calculation
                            methodology evolved over time. Turnover, order
                            count, and product volume are cleaner historical
                            metrics.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 06 — 2018 VS 2019
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">06 — Growth</p>
                </div>

                <div class="section-content">
                    <h2>2019 shows clear growth compared with 2018.</h2>

                    <div class="year-grid">
                        <article class="year-card">
                            <span>2018</span>

                            <div>
                                <strong>$20.7K</strong>
                                <small>turnover</small>
                            </div>

                            <div>
                                <strong>1,728</strong>
                                <small>orders</small>
                            </div>

                            <div>
                                <strong>2,604</strong>
                                <small>products sold</small>
                            </div>

                            <div>
                                <strong>$8.7K</strong>
                                <small>approx. profit</small>
                            </div>
                        </article>

                        <div class="growth-arrow" aria-hidden="true">→</div>

                        <article class="year-card year-card-highlight">
                            <span>2019</span>

                            <div>
                                <strong>$33.6K</strong>
                                <small>turnover</small>
                            </div>

                            <div>
                                <strong>2,362</strong>
                                <small>orders</small>
                            </div>

                            <div>
                                <strong>3,691</strong>
                                <small>products sold</small>
                            </div>

                            <div>
                                <strong>$18.0K</strong>
                                <small>approx. profit</small>
                            </div>
                        </article>
                    </div>

                    <div class="growth-metrics">
                        <div>
                            <strong>+62%</strong>
                            <span>turnover</span>
                        </div>

                        <div>
                            <strong>+37%</strong>
                            <span>orders</span>
                        </div>

                        <div>
                            <strong>+42%</strong>
                            <span>products sold</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 07 — PLATFORM MIX
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">07 — Platform mix</p>
                </div>

                <div class="section-content">
                    <h2>
                        PC, PlayStation, and Xbox were tracked as separate
                        commercial channels.
                    </h2>

                    <p class="lead">
                        In 2019, PlayStation represented the largest share of
                        recorded turnover, followed by PC and Xbox.
                    </p>

                    <div class="platform-grid">
                        <article>
                            <span>PC</span>
                            <strong>$11.6K</strong>
                            <small>turnover</small>

                            <p>781 orders · 1,267 products</p>

                            <div class="platform-bar">
                                <span style="width: 35%"></span>
                            </div>

                            <small>~35% of 2019 turnover</small>
                        </article>

                        <article>
                            <span>PS4</span>
                            <strong>$13.3K</strong>
                            <small>turnover</small>

                            <p>992 orders · 1,669 products</p>

                            <div class="platform-bar">
                                <span style="width: 40%"></span>
                            </div>

                            <small>~40% of 2019 turnover</small>
                        </article>

                        <article>
                            <span>Xbox</span>
                            <strong>$8.7K</strong>
                            <small>turnover</small>

                            <p>589 orders · 755 products</p>

                            <div class="platform-bar">
                                <span style="width: 26%"></span>
                            </div>

                            <small>~26% of 2019 turnover</small>
                        </article>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 08 — PEAK MONTHS
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">08 — Peak months</p>
                </div>

                <div class="section-content">
                    <h2>
                        Peak months show the operational volume behind the
                        numbers.
                    </h2>

                    <div class="peak-grid">
                        <article>
                            <span>July 2019</span>

                            <strong>$4,656</strong>
                            <small>turnover</small>

                            <div class="peak-stats">
                                <p>
                                    <b>292</b>
                                    orders
                                </p>

                                <p>
                                    <b>490</b>
                                    products
                                </p>

                                <p>
                                    <b>$2,330</b>
                                    approx. profit
                                </p>
                            </div>

                            <p class="peak-note">
                                Highest recorded turnover, product volume, and
                                approximate profit.
                            </p>
                        </article>

                        <article>
                            <span>December 2019</span>

                            <strong>$4,326</strong>
                            <small>turnover</small>

                            <div class="peak-stats">
                                <p>
                                    <b>294</b>
                                    orders
                                </p>

                                <p>
                                    <b>424</b>
                                    products
                                </p>

                                <p>
                                    <b>$2,172</b>
                                    approx. profit
                                </p>
                            </div>

                            <p class="peak-note">
                                Highest recorded monthly customer order count.
                            </p>
                        </article>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 09 — DEFINING THE METRICS
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">09 — Metric definitions</p>
                </div>

                <div class="section-content">
                    <h2>
                        Understanding the numbers required understanding what
                        each number meant.
                    </h2>

                    <div class="definition-list">
                        <div>
                            <span>01</span>

                            <div>
                                <strong>Total Sales</strong>
                                <p>
                                    Customer orders / transactions. One order
                                    could contain more than one product.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>02</span>

                            <div>
                                <strong>Total Product Sales</strong>
                                <p>
                                    Individual items sold, which is why this
                                    number is higher than the number of customer
                                    orders.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>03</span>

                            <div>
                                <strong>Trading</strong>
                                <p>
                                    In-game activity used to source, replenish,
                                    or improve inventory.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>04</span>

                            <div>
                                <strong>Total Profits apprx</strong>
                                <p>
                                    Approximate operating profit after
                                    acquisition cost, marketplace fees, and
                                    related operating costs.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>05</span>

                            <div>
                                <strong>Total Outcome no inv</strong>
                                <p>
                                    Monetary position excluding estimated
                                    in-game inventory value.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 10 — KEYS TO CREDITS TRANSITION
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">10 — Economic change</p>
                </div>

                <div class="section-content">
                    <h2>
                        The tracking model had to adapt when Rocket League
                        changed its economy.
                    </h2>

                    <p class="lead">
                        In late 2019, Rocket League moved from a keys-based
                        economy to a credits-based system.
                    </p>

                    <p>
                        The workbook reflects this transition, which changed how
                        inventory, sourcing, and in-game value were represented
                        operationally.
                    </p>

                    <div class="callout">
                        <strong>Why this matters</strong>

                        <p>
                            Real operating systems have to survive changes in
                            the environment around them. The tracker evolved
                            alongside changes in the game's economy rather than
                            remaining a static template.
                        </p>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 11 — VISUAL EVIDENCE
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">11 — Evidence</p>
                </div>

                <div class="section-content">
                    <h2>
                        The final public version will use real workbook
                        evidence.
                    </h2>

                    <p class="lead">
                        The original finance workbook should remain private,
                        while a sanitized presentation layer can show the
                        operating model and verified historical metrics.
                    </p>

                    <div class="screenshot-grid">
                        <div class="screenshot-placeholder">
                            <span>01</span>
                            <strong>Monthly performance</strong>

                            <p>
                                Authentic source-sheet view showing sales and
                                operating performance.
                            </p>
                        </div>

                        <div class="screenshot-placeholder">
                            <span>02</span>
                            <strong>Platform breakdown</strong>

                            <p>
                                PC, PS4, and Xbox tracking from the surviving
                                workbook.
                            </p>
                        </div>

                        <div class="screenshot-placeholder">
                            <span>03</span>
                            <strong>Inventory & trading</strong>

                            <p>
                                Source view showing the relationship between
                                trading, inventory, and monetary position.
                            </p>
                        </div>

                        <div class="screenshot-placeholder">
                            <span>04</span>
                            <strong>Performance summary</strong>

                            <p>
                                A sanitized portfolio chart or dashboard built
                                from the surviving historical records.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           SECTION 12 — SKILLS DEMONSTRATED
           =================================================== -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">12 — Skills demonstrated</p>
                </div>

                <div class="section-content">
                    <h2>
                        The tracker turned marketplace activity into operating
                        information.
                    </h2>

                    <div class="skills-list">
                        <span>Excel</span>
                        <span>Commercial Operations</span>
                        <span>Marketplace Analytics</span>
                        <span>Sales Tracking</span>
                        <span>Inventory Tracking</span>
                        <span>Revenue Monitoring</span>
                        <span>Channel Analysis</span>
                        <span>Basic Financial Analysis</span>
                        <span>Operational Reporting</span>
                        <span>Business Ownership</span>
                    </div>
                </div>
            </section>

            <!-- ===================================================
           PROJECT NAVIGATION
           =================================================== -->

            <section class="project-end">
                <p class="eyebrow">Rocketeers systems</p>

                <h2>
                    Commercial tracking supported the business. Repricing helped
                    scale it.
                </h2>

                <div class="project-end-links">
                    <a class="text-link" href="/projects/rocketeers/">
                        Rocketeers overview
                        <span aria-hidden="true">→</span>
                    </a>

                    <a
                        class="text-link secondary-project-link"
                        href="/projects/rocketeers/repricing/"
                    >
                        Marketplace Repricing Engine
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </section>
        </main>

        <!-- =====================================================
         FOOTER
         ===================================================== -->

        <footer>
            <span>
                © {new Date().getFullYear()} Konstantinos Zafiropoulos
            </span>

            <span> Built with Astro · Git/GitHub · VS Code · Netlify </span>
        </footer>
    </body>
</html>

<style>
    /* =========================================================
     DESIGN TOKENS
     ========================================================= */

    :root {
        --bg: #050d18;
        --bg-soft: #071522;
        --bg-card: rgba(7, 21, 34, 0.86);

        --heading: #ffffff;
        --text: #e8eef5;
        --muted: #a9bbcc;
        --subtle: #71869a;

        --border: #1d354a;

        --blue: #168dff;
        --blue-light: #65baff;

        --orange: #ff8a00;

        --green: #26d5a2;

        --page-width: 1240px;

        color: var(--text);
        background: var(--bg);

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    /* =========================================================
     GLOBAL
     ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;

        margin: 0;

        color: var(--text);

        background:
            radial-gradient(
                circle at top right,
                rgba(38, 213, 162, 0.08),
                transparent 35rem
            ),
            radial-gradient(
                circle at 15% 35%,
                rgba(22, 141, 255, 0.045),
                transparent 30rem
            ),
            var(--bg);
    }

    main,
    footer {
        max-width: var(--page-width);

        margin-inline: auto;

        padding-left: clamp(1.5rem, 5vw, 4.5rem);
        padding-right: clamp(1.5rem, 5vw, 4.5rem);
    }

    a {
        color: inherit;
    }

    a:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
    }

    /* =========================================================
     NAVIGATION
     ========================================================= */

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 74px;

        border-bottom: 1px solid var(--border);
    }

    .wordmark {
        color: white;

        font-size: 1.35rem;
        font-weight: 850;

        letter-spacing: -0.08em;

        text-decoration: none;
    }

    .wordmark span {
        color: var(--orange);
    }

    .nav-links {
        display: flex;

        gap: clamp(1rem, 3vw, 2.5rem);
    }

    .nav-links a {
        color: var(--muted);

        font-size: 0.9rem;

        text-decoration: none;
    }

    .nav-links a:hover {
        color: white;
    }

    /* =========================================================
     TYPOGRAPHY
     ========================================================= */

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2 {
        color: var(--heading);

        letter-spacing: -0.05em;
    }

    h1 {
        max-width: 1000px;

        margin-bottom: 1.5rem;

        font-size: clamp(3.8rem, 8vw, 7rem);

        line-height: 0.9;
    }

    h2 {
        max-width: 820px;

        font-size: clamp(2.2rem, 5vw, 4rem);

        line-height: 1;
    }

    h3 {
        color: white;
    }

    .eyebrow {
        margin-bottom: 1.15rem;

        color: var(--orange);

