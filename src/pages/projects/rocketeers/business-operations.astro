---
/* =========================================================
   PAGE METADATA
   ========================================================= */

import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SeoHead from "../../../components/SeoHead.astro";
import HorizontalBarChart from "../../../components/HorizontalBarChart.astro";
import SkillLinks from "../../../components/SkillLinks.astro";
import {
    rocketeersFeedbackMetrics,
    rocketeersSummary,
} from "../../../data/rocketeers";

const title =
    "Business & Marketplace Operations | Rocketeers | Konstantinos Zafiropoulos";

const description =
    "Case study of the planning, launch, operation, and scaling of Rocketeers, a real digital marketplace business.";

const metrics = [
    {
        value: "23K+",
        label: "Items sold across the business",
    },
    {
        value: "6,944",
        label: "Documented unique buyer IDs",
    },
    {
        value: "42,982",
        label: "Documented message records",
    },
    {
        value: "0",
        label: "Negative feedback on the final live profile",
    },
];
---

<html lang="en">
    <!-- =====================================================
         HEAD / SEO
         ===================================================== -->

    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <!-- =================================================
                 PRIMARY NAVIGATION
                 ================================================= -->

            <SiteHeader />

            <!-- =================================================
                 HERO
                 ================================================= -->

            <header class="hero">
                <div class="hero-breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span>→</span>
                    <a href="/projects/rocketeers/">Rocketeers</a>
                    <span>→</span>
                    <strong>Business & Marketplace Operations</strong>
                </div>

                <p class="eyebrow">
                    Rocketeers · Business · Marketplace Operations
                </p>

                <h1>Business & Marketplace Operations</h1>

                <p class="hero-subtitle">
                    How Rocketeers went from an opportunity in a digital
                    marketplace to a real multi-year business — covering
                    planning, sourcing, listings, pricing, inventory, customer
                    operations, seller performance, and day-to-day execution.
                </p>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "marketplace-operations",
                        "ecommerce-operations",
                        "business-ownership",
                        "customer-operations",
                        "pricing-operations",
                        "inventory-management",
                    ]}
                />
            </header>

            <!-- =================================================
                 KEY METRICS
                 ================================================= -->

            <section class="metrics" aria-label="Rocketeers business metrics">
                {
                    metrics.map((metric) => (
                        <article class="metric-card">
                            <strong>{metric.value}</strong>
                            <span>{metric.label}</span>
                        </article>
                    ))
                }
            </section>

            <!-- =================================================
                 SECTION 01 — THE OPPORTUNITY
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">01 — The opportunity</p>
                </div>

                <div class="section-content">
                    <h2>A niche digital marketplace with real demand.</h2>

                    <p class="lead">
                        Rocketeers started as an opportunity to serve demand for
                        Rocket League digital items through established online
                        marketplaces.
                    </p>

                    <p>
                        The business began on eBay and later expanded into
                        additional marketplace activity. The core idea was
                        simple: source digital inventory efficiently, present it
                        clearly, price it competitively, fulfil orders reliably,
                        and build trust through strong customer service.
                    </p>

                    <p>
                        What started small gradually became a real operating
                        business requiring structured processes for listings,
                        inventory, pricing, order handling, disputes, customer
                        communication, and performance monitoring.
                    </p>
                </div>
            </section>

            <!-- =================================================
                 SECTION 02 — BUSINESS MODEL
                 ================================================= -->

            <section class="case-section wide-section">
                <div class="section-label">
                    <p class="eyebrow">02 — Business model</p>
                </div>

                <div class="section-content">
                    <h2>
                        The business connected sourcing, pricing, inventory, and
                        marketplace demand.
                    </h2>

                    <p class="lead">
                        Rocketeers operated around a straightforward commercial
                        loop: acquire in-game inventory, list it on
                        marketplaces, fulfil customer orders, and reinvest into
                        further stock.
                    </p>

                    <div class="business-flow">
                        <div class="flow-step">
                            <span>01</span>
                            <strong>Source</strong>
                            <p>
                                Acquire digital inventory through purchasing and
                                in-game trading.
                            </p>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>02</span>
                            <strong>Price</strong>
                            <p>
                                Use market conditions, scarcity, and target
                                margins to set selling prices.
                            </p>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>03</span>
                            <strong>List</strong>
                            <p>
                                Create and maintain marketplace listings across
                                thousands of product variations.
                            </p>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>04</span>
                            <strong>Fulfil</strong>
                            <p>
                                Complete customer orders and transfer digital
                                products reliably.
                            </p>
                        </div>

                        <div class="flow-arrow" aria-hidden="true">→</div>

                        <div class="flow-step">
                            <span>05</span>
                            <strong>Support</strong>
                            <p>
                                Handle customer questions, disputes, returns,
                                and marketplace cases.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 SECTION 03 — OPERATING RESPONSIBILITY
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">03 — What I owned</p>
                </div>

                <div class="section-content">
                    <h2>I owned the operation end to end.</h2>

                    <p class="lead">
                        Rocketeers was not a narrow role. I was responsible for
                        the full commercial and operational cycle.
                    </p>

                    <div class="ownership-grid">
                        <article>
                            <span>Marketplace</span>
                            <strong>Listings & catalogue</strong>
                            <p>
                                Creating, maintaining, and organizing product
                                listings and variations.
                            </p>
                        </article>

                        <article>
                            <span>Commercial</span>
                            <strong>Pricing</strong>
                            <p>
                                Monitoring market prices and adjusting selling
                                prices based on demand, supply, and scarcity.
                            </p>
                        </article>

                        <article>
                            <span>Inventory</span>
                            <strong>Sourcing & stock</strong>
                            <p>
                                Acquiring products and managing available
                                digital inventory across platforms.
                            </p>
                        </article>

                        <article>
                            <span>Operations</span>
                            <strong>Orders & fulfilment</strong>
                            <p>
                                Managing customer transactions and ensuring
                                products were delivered correctly.
                            </p>
                        </article>

                        <article>
                            <span>Customer</span>
                            <strong>Support & disputes</strong>
                            <p>
                                Handling customer issues, returns, cases, and
                                marketplace resolution processes.
                            </p>
                        </article>

                        <article>
                            <span>Performance</span>
                            <strong>Seller health</strong>
                            <p>
                                Monitoring feedback, seller metrics, account
                                standing, and operational quality.
                            </p>
                        </article>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 SECTION 04 — MARKETPLACE EXECUTION
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">04 — Marketplace execution</p>
                </div>

                <div class="section-content">
                    <h2>Marketplace operations became a daily discipline.</h2>

                    <p class="lead">
                        Running the business consistently required more than
                        simply posting items for sale.
                    </p>

                    <div class="execution-list">
                        <div>
                            <span>01</span>

                            <div>
                                <strong>Catalogue maintenance</strong>
                                <p>
                                    Keep listings, product variations, prices,
                                    and availability aligned with actual stock.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>02</span>

                            <div>
                                <strong>Competitive pricing</strong>
                                <p>
                                    Monitor changing market conditions and
                                    adjust pricing while protecting commercial
                                    margins.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>03</span>

                            <div>
                                <strong>Order management</strong>
                                <p>
                                    Track customer transactions from purchase
                                    through fulfilment and resolution.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>04</span>

                            <div>
                                <strong>Exception handling</strong>
                                <p>
                                    Resolve cancellations, customer mistakes,
                                    fulfilment issues, disputes, and unusual
                                    marketplace cases.
                                </p>
                            </div>
                        </div>

                        <div>
                            <span>05</span>

                            <div>
                                <strong>Seller performance</strong>
                                <p>
                                    Protect account health by monitoring
                                    feedback and marketplace performance
                                    indicators.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 SECTION 05 — CUSTOMER EXPERIENCE
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">05 — Customer experience</p>
                </div>

                <div class="section-content">
                    <h2>
                        Customer trust became one of the strongest measures of
                        operational quality.
                    </h2>

                    <p class="lead">
                        The final live eBay profile showed 6,454 positive
                        feedback entries, one neutral entry, and zero negative
                        feedback. Historical negative records in the export
                        were subsequently revised.
                    </p>

                    <div class="feedback-grid">
                        {
                            rocketeersFeedbackMetrics.map((metric) => (
                                <article>
                                    <strong>{metric.value}</strong>
                                    <span>{metric.label}</span>
                                </article>
                            ))
                        }
                    </div>

                    <p>
                        Maintaining that record required careful communication,
                        fast problem resolution, accurate fulfilment, and
                        consistent use of eBay Seller Hub and Resolution Center
                        for returns, disputes, cases, and seller-performance
                        management.
                    </p>

                    <div class="callout">
                        <strong> Operational principle </strong>

                        <p>
                            Customer experience was treated as part of the
                            operating system, not as something separate from
                            marketplace performance.
                        </p>
                    </div>
                </div>
            </section>

            <HorizontalBarChart
                title="Documented annual eBay volume"
                description="Full-year item volume rose substantially as the operation, catalogue, and supporting processes scaled."
                items={[
                    { label: "2018", value: 2600, display: "2,600 items" },
                    { label: "2019", value: 3262, display: "3,262 items" },
                    { label: "2020", value: 7687, display: "7,687 items" },
                    { label: "2021", value: 6175, display: "6,175 items" },
                ]}
                sourceNote="Full calendar years from the reviewed eBay transaction export. Partial 2017 and 2022 periods are excluded from this comparison."
            />

            <!-- =================================================
                 SECTION 06 — DOCUMENTED OPERATING EVIDENCE
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">06 — Operating evidence</p>
                </div>

                <div class="section-content">
                    <h2>The export shows the workload behind the storefront.</h2>

                    <p class="lead">
                        Transaction, customer-service, return, and dispute
                        records provide a documented view of the operation
                        through May 2022.
                    </p>

                    <div class="scale-grid">
                        <article>
                            <strong>{rocketeersSummary.activeSalesDays.toLocaleString("en-US")}</strong>
                            <span> active sales days </span>
                        </article>

                        <article>
                            <strong>{rocketeersSummary.messageRecords.toLocaleString("en-US")}</strong>
                            <span> inbox and sent-message records </span>
                        </article>

                        <article>
                            <strong>0.45%</strong>
                            <span> seller-side return-case rate </span>
                        </article>

                        <article>
                            <strong>0.24%</strong>
                            <span> dispute-claim rate </span>
                        </article>
                    </div>

                    <p>
                        The communication export begins in September 2020, so
                        the message count represents only part of the business's
                        operating history. Return and dispute rates use exported
                        sale rows as the available denominator.
                    </p>
                </div>
            </section>

            <!-- =================================================
                 SECTION 07 — SCALE
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">07 — Scale</p>
                </div>

                <div class="section-content">
                    <h2>
                        Growth forced the operation to become more systematic.
                    </h2>

                    <p class="lead">
                        As order volume, catalogue size, and inventory grew,
                        manual processes became increasingly difficult to
                        maintain.
                    </p>

                    <div class="scale-grid">
                        <article>
                            <strong>23K+</strong>
                            <span> items sold across the business </span>
                        </article>

                        <article>
                            <strong>6,944</strong>
                            <span> documented unique buyer IDs </span>
                        </article>

                        <article>
                            <strong>20+</strong>
                            <span> countries reached </span>
                        </article>

                        <article>
                            <strong>7 years</strong>
                            <span> operating the business </span>
                        </article>
                    </div>

                    <p>
                        The growing workload eventually led me to build
                        dedicated systems for pricing, repricing, finance, and
                        operational tracking rather than continue managing
                        everything manually.
                    </p>
                </div>
            </section>

            <!-- =================================================
                 SECTION 08 — SYSTEMS THAT EMERGED
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">08 — Systems built</p>
                </div>

                <div class="section-content">
                    <h2>
                        Operational complexity created the need for better
                        systems.
                    </h2>

                    <p class="lead">
                        Two major Excel systems emerged directly from the
                        problems created by running the business at scale.
                    </p>

                    <div class="systems-grid">
                        <a href="/projects/rocketeers/repricing/">
                            <span>System 01</span>

                            <strong> Marketplace Repricing Engine </strong>

                            <p>
                                A pricing and bulk-repricing workflow designed
                                to manage more than 1,000 listings and 10,000+
                                priced variations.
                            </p>

                            <small> View case study → </small>
                        </a>

                        <a href="/projects/rocketeers/financial-tracker/">
                            <span>System 02</span>

                            <strong> Financial & Operations Tracker </strong>

                            <p>
                                A multi-sheet Excel system for monitoring
                                turnover, orders, inventory, platform activity,
                                cancellations, and approximate profitability.
                            </p>

                            <small> View case study → </small>
                        </a>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 SECTION 09 — DECISION-MAKING
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">09 — Decision-making</p>
                </div>

                <div class="section-content">
                    <h2>
                        Not every operational decision could be reduced to a
                        formula.
                    </h2>

                    <p class="lead">
                        Data and systems supported decisions, but commercial
                        judgement still mattered.
                    </p>

                    <p>
                        Scarce products, unusual demand, marketplace changes,
                        sourcing difficulty, customer behaviour, and inventory
                        availability could all affect how the operation was
                        managed.
                    </p>

                    <p>
                        The goal was not to automate judgement away. It was to
                        remove repetitive work so attention could be focused on
                        decisions that actually required human judgement.
                    </p>
                </div>
            </section>

            <!-- =================================================
                 SECTION 10 — RESULTS
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">10 — Results</p>
                </div>

                <div class="section-content">
                    <h2>
                        The business became both a marketplace operation and a
                        systems problem.
                    </h2>

                    <p class="lead">
                        Over seven years, Rocketeers developed from a small
                        digital-marketplace activity into a structured operation
                        with thousands of customers and tens of thousands of
                        products sold.
                    </p>

                    <div class="results-grid">
                        <div>
                            <strong> 23K+ </strong>

                            <span> items sold </span>
                        </div>

                        <div>
                            <strong> $219.8K </strong>

                            <span> documented eBay USD gross sales </span>
                        </div>

                        <div>
                            <strong> 0 </strong>

                            <span> negative feedback on final live profile </span>
                        </div>

                        <div>
                            <strong> 1 </strong>

                            <span> neutral feedback entry </span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 SECTION 11 — SKILLS DEMONSTRATED
                 ================================================= -->

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">11 — Skills demonstrated</p>
                </div>

                <div class="section-content">
                    <h2>
                        Running Rocketeers required both commercial ownership
                        and operational execution.
                    </h2>

                    <SkillLinks
                        skills={[
                            "marketplace-operations",
                            "ecommerce-operations",
                            "business-ownership",
                            "customer-operations",
                            "pricing-operations",
                            "inventory-management",
                            "order-management",
                            "seller-performance",
                            "dispute-resolution",
                            "process-improvement",
                            "decision-making",
                            "operational-scaling",
                            "commercial-analysis",
                            "operational-reporting",
                        ]}
                    />
                </div>
            </section>

            <!-- =================================================
                 PROJECT NAVIGATION
                 ================================================= -->

            <section class="project-end">
                <p class="eyebrow">Rocketeers</p>

                <h2>
                    The business created the problems. The systems helped solve
                    them.
                </h2>

                <div class="project-end-links">
                    <a class="text-link" href="/projects/rocketeers/">
                        Rocketeers overview
                        <span aria-hidden="true">→</span>
                    </a>

                    <a
                        class="text-link secondary-link"
                        href="/projects/rocketeers/repricing/"
                    >
                        Repricing Engine
                        <span aria-hidden="true">→</span>
                    </a>

                    <a
                        class="text-link finance-link"
                        href="/projects/rocketeers/financial-tracker/"
                    >
                        Financial Tracker
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </section>
        </main>

        <!-- ===================================================
             FOOTER
             =================================================== -->

        <SiteFooter />
    </body>
</html>

<style>
    /* =========================================================
       DESIGN TOKENS
       ========================================================= */

    :root {
        --bg: #050d18;
        --bg-card: rgba(7, 21, 34, 0.86);

        --heading: #ffffff;
        --text: #e8eef5;

        --muted: #a9bbcc;
        --subtle: #71869a;

        --border: #1d354a;

        --blue: #168dff;
        --blue-light: #65baff;

        --orange: #ff8a00;

        --green: #26d5a2;

        --page-width: 1240px;

        color: var(--text);
        background: var(--bg);

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;

        margin: 0;

        color: var(--text);

        background:
            radial-gradient(
                circle at top right,
                rgba(255, 138, 0, 0.08),
                transparent 35rem
            ),
            radial-gradient(
                circle at 15% 35%,
                rgba(22, 141, 255, 0.04),
                transparent 30rem
            ),
            var(--bg);
    }

    main,
    footer {
        max-width: var(--page-width);

        margin-inline: auto;

        padding-left: clamp(1.5rem, 5vw, 4.5rem);
        padding-right: clamp(1.5rem, 5vw, 4.5rem);
    }

    a {
        color: inherit;
    }

    a:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 4px;
    }

    /* =========================================================
       NAVIGATION
       ========================================================= */

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 74px;

        border-bottom: 1px solid var(--border);
    }

    .wordmark {
        color: white;

        font-size: 1.35rem;
        font-weight: 850;

        letter-spacing: -0.08em;

        text-decoration: none;
    }

    .wordmark span {
        color: var(--orange);
    }

    .nav-links {
        display: flex;

        gap: clamp(1rem, 3vw, 2.5rem);
    }

    .nav-links a {
        color: var(--muted);

        font-size: 0.9rem;

        text-decoration: none;
    }

    .nav-links a:hover {
        color: white;
    }

    /* =========================================================
       TYPOGRAPHY
       ========================================================= */

    h1,
    h2,
    p {
        margin-top: 0;
    }

    h1,
    h2 {
        color: var(--heading);

        letter-spacing: -0.05em;
    }

    h1 {
        max-width: 1040px;

        margin-bottom: 1.5rem;

        font-size: clamp(3.7rem, 8vw, 7rem);

        line-height: 0.9;
    }

    h2 {
        max-width: 820px;

        font-size: clamp(2.2rem, 5vw, 4rem);

        line-height: 1;
    }

    .eyebrow {
        margin-bottom: 1.15rem;

        color: var(--orange);

        font-size: 0.76rem;
        font-weight: 800;

        letter-spacing: 0.09em;

        text-transform: uppercase;
    }

    .lead {
        color: #dce6ee !important;

        font-size: 1.12rem;
    }

    /* =========================================================
       HERO
       ========================================================= */

    .hero {
        padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
    }

    .hero-breadcrumbs {
        display: flex;
        flex-wrap: wrap;

        gap: 0.6rem;

        margin-bottom: 3.5rem;

        color: var(--subtle);

        font-size: 0.78rem;
    }

    .hero-breadcrumbs a {
        text-decoration: none;
    }

    .hero-breadcrumbs a:hover {
        color: white;
    }

    .hero-breadcrumbs strong {
        color: var(--orange);
    }

    .hero-subtitle {
        max-width: 820px;

        color: var(--muted);

        font-size: clamp(1.08rem, 2vw, 1.35rem);

        line-height: 1.65;
    }

    .hero-tags {
        display: flex;
        flex-wrap: wrap;

        gap: 0.6rem;

        margin-top: 2rem;
    }

    .hero-tags span,
    .skills-list span {
        padding: 0.55rem 0.75rem;

        color: #c5d5e3;

        border: 1px solid #4c3a22;
        border-radius: 7px;

        background: #21160c;

        font-size: 0.74rem;
    }

    /* =========================================================
       KEY METRICS
       ========================================================= */

    .metrics {
        display: grid;

        grid-template-columns: repeat(4, minmax(0, 1fr));

        gap: 1rem;

        padding-bottom: clamp(4rem, 8vw, 6rem);
    }

    .metric-card {
        min-height: 145px;

        padding: 1.4rem;

        border: 1px solid var(--border);
        border-radius: 13px;

        background:
            linear-gradient(
                135deg,
                rgba(255, 138, 0, 0.07),
                rgba(22, 141, 255, 0.02)
            ),
            var(--bg-card);
    }

    .metric-card strong {
        display: block;

        margin-bottom: 0.5rem;

        color: var(--orange);

        font-size: clamp(1.8rem, 4vw, 2.7rem);
    }

    .metric-card span {
        color: #9eb1c2;

        font-size: 0.87rem;
    }

    /* =========================================================
       CASE STUDY SECTIONS
       ========================================================= */

    .case-section {
        display: grid;

        grid-template-columns:
            minmax(150px, 0.3fr)
            minmax(0, 1fr);

        gap: clamp(2rem, 7vw, 6rem);

        padding: clamp(4.5rem, 9vw, 7.5rem) 0;

        border-top: 1px solid var(--border);
    }

    .section-content {
        max-width: 850px;
    }

    .section-content > p {
