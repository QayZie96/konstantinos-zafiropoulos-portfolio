---
/* =========================================================
   JOB SCOUT: CASE STUDY
   ========================================================= */
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";

const title =
    "Job Scout | Daily Job-Search Pipeline (Python, Gemini, Google Sheets) | Konstantinos Zafeiropoulos";

const description =
    "A live, scheduled pipeline that reads job boards and company hiring systems every weekday, removes deal-breakers, scores fit with rules and Gemini, and writes a ranked list to Google Sheets for two people.";

const metrics = [
    { value: "2", label: "people using it every weekday" },
    { value: "10+", label: "job boards read each run" },
    { value: "9", label: "hiring systems (ATS) supported" },
    { value: "770+", label: "companies tracked" },
];

const steps = [
    {
        number: "01",
        title: "Collect",
        text: "Reads public job boards (Workable, Himalayas, Remotive, Remote OK, We Work Remotely, Indeed Greece and more) and the public hiring feeds of hundreds of companies on Greenhouse, Lever, Ashby, Workable, SmartRecruiters, Personio, Recruitee, Teamtailor and Workday.",
    },
    {
        number: "02",
        title: "Remove deal-breakers",
        text: "Drops jobs that can't work: wrong location, another field, a degree with no alternative, a required language I don't speak, commission-only sales. Every removed job is listed with its reason, so nothing disappears silently.",
    },
    {
        number: "03",
        title: "Score",
        text: "Rules give points for role family, location, tools, seniority and freshness. Gemini then reads the promising jobs against my profile and writes a fit score and a one-line reason. Low scorers get a cheap title-only check instead of a full read.",
    },
    {
        number: "04",
        title: "Hand over to a person",
        text: "New jobs land at the top of a Google Sheet, with a Best tab for the last three days' strongest matches. It never applies to anything: I read, decide and apply by hand.",
    },
];

const decisions = [
    {
        title: "Built for failure",
        text: "One broken feed or AI call never stops the run. Failures are collected into a run summary, and the job finishes with whatever did work.",
    },
    {
        title: "A backup start",
        text: "Checking the run history showed GitHub's scheduler had never actually fired. I added a second trigger from the sheet's Apps Script that starts the morning runs only if they haven't run that day.",
    },
    {
        title: "Settings non-coders can change",
        text: "Keywords, points, score thresholds and AI limits live in a Settings tab, so the search can be tuned without touching code.",
    },
    {
        title: "A second user without a second codebase",
        text: "A profile folder (CV facts, prompts, companies, settings) runs the same code for someone looking for HR roles, writing to their own sheet on their own schedule.",
    },
    {
        title: "Housekeeping",
        text: "Jobs that vanish from a company's feed are marked Closed; untouched jobs move to an archive after 30 days; anything already applied to is skipped.",
    },
    {
        title: "Honest about the AI",
        text: "The first AI scores were too generous, so the rules do the filtering and the AI only ranks. Its reason is shown next to every score so I can disagree with it.",
    },
];
---

<html lang="en">
    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <a class="back-link" href="/#projects">← Back to projects</a>

                <p class="eyebrow">Live · Python · Gemini · Google Sheets · GitHub Actions</p>

                <h1>Job Scout</h1>

                <p class="hero-subtitle">
                    A daily pipeline that reads hundreds of hiring feeds, removes
                    the jobs that can't work, ranks the rest and hands a short list
                    to a person every weekday morning.
                </p>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "python",
                        "google-gemini",
                        "google-sheets-api",
                        "google-apps-script",
                        "rest-api-integration",
                        "deduplication",
                        "human-oversight",
                    ]}
                />
            </header>

            <section class="metrics" aria-label="Job Scout in numbers">
                {metrics.map((metric) => (
                    <article class="metric-card">
                        <strong>{metric.value}</strong>
                        <span>{metric.label}</span>
                    </article>
                ))}
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">01 — Why</p>
                </div>
                <div class="section-content">
                    <h2>Job boards are noisy, and the good roles are often not on them.</h2>
                    <p class="lead">
                        Many companies post only on their own careers page, and the
                        big boards bury them under roles I can't take. Checking it
                        all by hand took hours a day.
                    </p>
                    <p>
                        I wanted a tool that does the reading and filtering every
                        morning and leaves the judgement to me. It runs on a
                        schedule, costs nothing to host, and since November 2026 it
                        has been used daily by two people.
                    </p>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">02 — How it works</p>
                </div>
                <div class="section-content">
                    <h2>Collect, remove, score, hand over.</h2>
                    <div class="step-grid">
                        {steps.map((step) => (
                            <article class="step-card">
                                <span class="card-number">{step.number}</span>
                                <h3>{step.title}</h3>
                                <p>{step.text}</p>
                            </article>
                        ))}
                    </div>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">03 — Decisions</p>
                </div>
                <div class="section-content">
                    <h2>What makes it something people can rely on.</h2>
                    <div class="decision-list">
                        {decisions.map((item) => (
                            <article>
                                <h3>{item.title}</h3>
                                <p>{item.text}</p>
                            </article>
                        ))}
                    </div>
                </div>
            </section>

            <section class="case-section">
                <div class="section-label">
                    <p class="eyebrow">04 — How I built it</p>
                </div>
                <div class="section-content">
                    <h2>AI coding tools, my scoping and testing.</h2>
                    <p>
                        I built Job Scout with Claude Code. My part was deciding what
                        it should do and not do, writing the rules, checking every
                        change against real job data, and fixing what broke in daily
                        use. The code has automated tests, and each change goes
                        through a pull request before it runs.
                    </p>
                    <p>
                        It grew out of two earlier attempts, a Python and Gemini
                        prototype and a Google Apps Script job funnel.{" "}
                        <a href="/projects/ai-job-outreach/">See the earlier versions →</a>
                    </p>
                </div>
            </section>

            <section class="project-end">
                <p class="eyebrow">More work</p>
                <h2>Explore the rest of the portfolio.</h2>
                <a class="text-link" href="/#projects">
                    Back to selected work <span aria-hidden="true">→</span>
                </a>
            </section>
        </main>

        <SiteFooter />
    </body>
</html>

<style>
    :root {
        --color-bg: #050b14;
        --color-text: #e8edf3;
        --color-heading: #ffffff;
        --color-muted: #a9bbcc;
        --color-border: #203247;
        --color-blue: #2aa7ff;
        --color-orange: #ff8a00;
        --page-width: 1200px;

        color: var(--color-text);
        background: var(--color-bg);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }

    body {
        min-height: 100vh;
        margin: 0;
        color: var(--color-text);
        background:
            radial-gradient(circle at top right, rgba(42, 167, 255, 0.12), transparent 34rem),
            radial-gradient(circle at 15% 35%, rgba(255, 138, 0, 0.045), transparent 30rem),
            var(--color-bg);
    }

    main {
        max-width: var(--page-width);
        margin-inline: auto;
        padding-inline: clamp(1rem, 5vw, 4.5rem);
    }

    a { color: inherit; text-underline-offset: 0.25em; }

    a:focus-visible {
        outline: 2px solid var(--color-orange);
        outline-offset: 5px;
    }

    h1, h2, h3 { color: var(--color-heading); }

    .eyebrow {
        margin: 0 0 0.8rem;
        color: var(--color-orange);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .hero { padding: clamp(2.5rem, 7vw, 5rem) 0 2.5rem; }

    .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        color: var(--color-muted);
        font-size: 0.9rem;
        text-decoration: none;
    }

    .back-link:hover { color: #ffffff; }

    h1 {
        margin: 0 0 1rem;
        font-size: clamp(2.6rem, 7vw, 4.6rem);
        line-height: 1;
        letter-spacing: -0.05em;
    }

    .hero-subtitle {
        max-width: 720px;
        margin: 0 0 1.6rem;
        color: var(--color-muted);
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        line-height: 1.6;
    }

    .metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 3rem;
    }

    .metric-card {
        padding: 1.3rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: rgba(10, 26, 43, 0.6);
    }

    .metric-card strong {
        display: block;
        color: var(--color-blue);
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        letter-spacing: -0.04em;
    }

    .metric-card span {
        color: var(--color-muted);
        font-size: 0.88rem;
    }

    .case-section {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 2rem;
        padding: 3rem 0;
        border-top: 1px solid var(--color-border);
    }

    .section-content h2 {
        margin: 0 0 1rem;
        font-size: clamp(1.6rem, 3.4vw, 2.3rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
    }

    .section-content p {
        max-width: 760px;
        color: var(--color-muted);
        line-height: 1.7;
    }

    .section-content .lead {
        color: var(--color-text);
        font-size: 1.12rem;
    }

    .section-content p a { color: var(--color-blue); }

    .step-grid,
    .decision-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .step-card,
    .decision-list article {
        padding: 1.3rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: rgba(10, 26, 43, 0.5);
    }

    .card-number {
        color: var(--color-orange);
        font-size: 0.78rem;
        font-weight: 800;
    }

    .step-card h3,
    .decision-list h3 {
        margin: 0.4rem 0 0.5rem;
        font-size: 1.08rem;
    }

    .step-card p,
    .decision-list p {
        margin: 0;
        font-size: 0.94rem;
    }

    .project-end {
        padding: 3rem 0 4rem;
        border-top: 1px solid var(--color-border);
        text-align: center;
    }

    .project-end h2 { margin: 0 0 1rem; }

    .text-link {
        color: var(--color-blue);
        font-weight: 700;
        text-decoration: none;
    }

    @media (max-width: 900px) {
        .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .case-section { grid-template-columns: 1fr; gap: 0.5rem; }
    }

    @media (max-width: 650px) {
        .step-grid,
        .decision-list { grid-template-columns: 1fr; }
    }
</style>
