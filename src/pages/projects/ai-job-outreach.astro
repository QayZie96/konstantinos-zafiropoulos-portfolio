---
/* =========================================================
   AI JOB DISCOVERY & OUTREACH AUTOMATION
   Portfolio case study: v1 Python + Gemini prototype, and
   its evolution into the v2 multi-ATS Apps Script job funnel.

   Every number on this page comes from the project READMEs,
   code, milestone specs, readiness reports or handoff notes.
   Sample postings in the interactive labs are fictional and
   are labelled as such.
   ========================================================= */

import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";

const title =
    "AI Job Discovery & Outreach Automation | Python, Gemini & Apps Script | Konstantinos Zafeiropoulos";

const description =
    "How a three-API Python and Gemini prototype evolved into a nine-adapter Google Apps Script job funnel with source verification, deduplication, conservative screening, review batches and scheduled collection.";

const githubUrl = "https://github.com/QayZie96/ai-job-outreach-automation";
const dashboardUrl =
    "https://docs.google.com/spreadsheets/d/1HuyvIww3t2x2ta-_hHnoeIT8t0M2MFtA6XQFL-ikbA0/edit?usp=sharing";

const metrics = [
    { value: "3 → 9", label: "Job sources: three aggregator APIs in v1, nine ATS adapters in v2" },
    { value: "500/500", label: "Native tests passing after the v2 reconciliation" },
    { value: "15", label: "Sources in the first scheduled set, split into five batches" },
    { value: "69/69", label: "v1 cache hits in the final diagnostic" },
];

/* ---------- Evolution timeline ---------- */
const milestones = [
    {
        id: "v1",
        tag: "v1",
        date: "Assessment",
        name: "Python prototype",
        summary:
            "Three public job APIs, Gemini validation in batches of 20, generated outreach drafts, a SQLite validation cache and a Google Sheets dashboard, run daily by Windows Task Scheduler.",
        points: ["Arbeitnow, Remotive and Adzuna", "Gemini checks remote, language and role fit", "SQLite cache keyed on a content fingerprint"],
    },
    {
        id: "spec",
        tag: "Spec",
        date: "12 Oct 2026",
        name: "Multi-ATS design",
        summary:
            "Rewrote the goal: find genuinely suitable, active postings on employers' own ATS job boards with less repeated manual browsing. Nine public-feed provider families, isolated staging, a protected master spreadsheet and conservative rules.",
        points: ["One adapter per ATS behind one interface", "Only verified public feeds may run", "Zero new jobs is an acceptable, truthful output"],
    },
    {
        id: "m1",
        tag: "M1",
        date: "12 Oct 2026",
        name: "Functional core",
        summary:
            "Greenhouse, Ashby and Lever adapters, a four-tab staging workbook (Sources, Postings, Dedup Snapshot, Run Log) and a manual runner. A hotfix added Greenhouse EU boards and Lever's literal \"onsite\" after testing against real public responses.",
        points: ["Full suite 211/211 → 217/217 after the hotfix", "Real response bodies: 5/5, 37/37 and 2/2 postings accepted", "All candidate sources start disabled"],
    },
    {
        id: "m21",
        tag: "M2.1",
        date: "13 Oct 2026",
        name: "Conservative screening",
        summary:
            "Deterministic pre-screening routes each posting to AI Review, Already handled, Hard ineligible, Low priority or Source uncertain. A hard exclusion needs an explicit textual signal in a complete description.",
        points: ["Reason codes tied to Search Criteria IDs", "Unknowns go to review, never to the bin", "Never marks anything application-ready"],
    },
    {
        id: "m22",
        tag: "M2.2",
        date: "13 Oct 2026",
        name: "Review batches",
        summary:
            "Builds bounded, copy-paste review packets for a manual AI review session: 20 jobs by default (1–30 allowed) within a 45,000-character budget. Results are cached against the posting fingerprint and the criteria version.",
        points: ["Job text is wrapped as untrusted JSON", "Unchanged, reviewed postings are not re-queued", "Criteria change → re-screen, even old exclusions"],
    },
    {
        id: "m22b",
        tag: "M2.2b",
        date: "13 Oct 2026",
        name: "Source onboarding",
        summary:
            "A dependency-free Node CLI with discover, prepare and verify commands. It follows official careers pages to ATS boards, verifies public endpoints with bounded requests, and emits disabled Sources rows plus an explicit approval plan.",
        points: ["Tenant IDs parsed from real URLs, never guessed", "HTTP 200 alone is not proof of identity", "Re-running is deterministic and idempotent"],
    },
    {
        id: "m23",
        tag: "M2.3",
        date: "13–14 Oct 2026",
        name: "Six more adapters",
        summary:
            "SmartRecruiters, Workable, Personio, Recruitee, Teamtailor and Pinpoint, including XML and RSS feeds through a hardened shared parser, integrated into the same collector, normaliser, lifecycle and screening code.",
        points: ["459/459 native tests at the integration commit", "Shared XML parser rejects DTD/entity attacks", "Every adapter has its own readiness report"],
    },
    {
        id: "m24",
        tag: "R1",
        date: "14 Oct 2026",
        name: "Reconciliation",
        summary:
            "Merged the nine-provider collector (461/461) with the onboarding branch (285/285), preserving both histories, plus seven new onboarding-to-collector contract tests.",
        points: ["Combined native suite: 500/500", "Offline checkpoint, not a deployment", "Deployment and activation stay separately gated"],
    },
    {
        id: "m2d",
        tag: "M2D",
        date: "15 Oct 2026",
        name: "Unattended collection",
        summary:
            "A scheduled mode: one time-driven trigger every six hours processes one batch of a fingerprint-approved 15-source configuration under a script lock, after a read-only refresh of the dedup snapshot from the master spreadsheet.",
        points: ["Five batches, a full cycle in about 30 hours", "Snapshot older than 48 hours blocks every request", "Cursor commits only after a terminal summary"],
    },
];

/* ---------- Pipeline walkthrough ---------- */
const stages = [
    {
        file: "SourceValidation.gs",
        name: "Source gate",
        text: "Only a Sources row marked PUBLIC_FEED_VERIFIED, enabled for manual fetch or listed in the approved schedule, can make a request. The feed host must be on the provider allowlist and the source key must equal co_id:provider:tenant.",
        sample: `{
  "source_key": "CO-9001:lever:example-market",
  "provider": "Lever",
  "feed_format": "JSON",
  "api_validation_status": "PUBLIC_FEED_VERIFIED",
  "candidate_public_feed_url":
    "https://api.lever.co/v0/postings/example-market"
}`,
    },
    {
        file: "Fetch.gs · Lever.gs",
        name: "Bounded fetch",
        text: "HTTPS only, no redirects, no credential-like query keys. Each source has a budget of 6 requests, 4 pages, 1.5 MB and 1 retry inside a 150-second collection deadline. A failed later page makes the inventory PARTIAL, never empty.",
        sample: `{
  "coverage_status": "ACTIVE_COMPLETE_SCOPE",
  "pagination_manifest": {
    "method": "lever_public_postings_skip_limit_json",
    "requested_offsets": [0],
    "pages_fetched": 1,
    "observed_count": 12,
    "duplicate_count": 0,
    "ending_evidence": "SHORT_PAGE"
  }
}`,
    },
    {
        file: "Normalize.gs",
        name: "Normalise & fingerprint",
        text: "Provider fields are mapped into one Postings schema. Identity is source key + provider posting ID, never title or requisition. A 128-bit FNV fingerprint covers meaningful content only, so fetch times cannot create false changes.",
        sample: "fingerprint",
    },
    {
        file: "Lifecycle.gs",
        name: "Change detection",
        text: "The first complete fetch is a baseline. Later complete, same-scope fetches classify each posting as new, unchanged or changed. A missing posting becomes possibly_removed only when the feed was complete; partial feeds retain prior jobs.",
        sample: `{
  "reason": "COMPLETE_MATCHING_SCOPE",
  "new": [],
  "unchanged": [],
  "changed": [],
  "baseline_discovered": ["CO-9001:lever:example-market:3f2c9a1e-…"],
  "possibly_removed": [],
  "removal_authorized": false
}`,
    },
    {
        file: "Dedup.gs",
        name: "History match",
        text: "The posting is compared with a minimal Dedup Snapshot of past applications and researched vacancies: posting ID, then requisition, then canonical URL. Title similarity alone only raises an alias warning.",
        sample: `{
  "status": "none",
  "match_type": "",
  "snapshot_available": true,
  "requires_live_master_recheck": true
}`,
    },
    {
        file: "Screen.gs",
        name: "Conservative screening",
        text: "Deterministic rules route the posting. Without an explicit hard exclusion it goes to AI Review, with open questions such as whether the employer can actually hire someone based in Greece.",
        sample: `{
  "route": "AI Review",
  "reason_codes": [
    "GEOGRAPHY_NEEDS_VERIFICATION",
    "POTENTIALLY_RELEVANT_OR_UNCERTAIN"
  ],
  "application_ready": false,
  "requires_manual_high_review": true
}`,
    },
    {
        file: "Review.gs",
        name: "Review batch",
        text: "Postings that need review are prioritised (never reviewed → changed → criteria changed) and packed into a manual review prompt. The packet tells the reviewer to treat job text as untrusted and never to treat a result as permission to apply.",
        sample: `MANUAL HIGH REVIEW PACKET — NOT AN APPLICATION DECISION
Criteria version reference: v2.3
UNTRUSTED employer/job data follows. …

JOB 1 (UNTRUSTED JSON DATA):
{"posting_key":"CO-9001:lever:example-market:3f2c…",
 "cache_state":"NEEDS_MANUAL_REVIEW", …}`,
    },
    {
        file: "Review.gs · Run.gs",
        name: "Decision cached",
        text: "The reviewer's JSON result updates only the review-cache triple. On the next run the unchanged posting reports CACHED_UNCHANGED and is not queued again; if the employer edits the advert, the fingerprint changes and it returns to review.",
        sample: `{
  "ai_review_state": "Credible Stretch",
  "ai_reviewed_fingerprint": "fnv128:…",
  "ai_reviewed_criteria_version": "v2.3"
}`,
    },
];

/* ---------- ATS adapter explorer (from src/*.gs) ---------- */
const adapters = [
    {
        id: "greenhouse",
        name: "Greenhouse",
        format: "JSON",
        endpoint: "GET https://boards-api.greenhouse.io/v1/boards/{board}/jobs?content=true",
        paging: "Single document. jobs.length must equal meta.total.",
        mapping: [
            ["id", "provider_posting_id"],
            ["title", "title"],
            ["absolute_url", "official_job_url"],
            ["content (HTML)", "description_text"],
            ["location.name · offices[].location / name", "locations_normalized"],
            ["internal_job_id ?? requisition_id", "internal_requisition_id"],
            ["departments · metadata", "source_evidence_note"],
        ],
        rule: "Complete only when the count reconciles, IDs are unique and every job URL sits on the configured board.",
        guard: "The EU board host job-boards.eu.greenhouse.io is accepted only when it is the configured official board for that tenant.",
        tests: "Original M1 adapter",
    },
    {
        id: "ashby",
        name: "Ashby",
        format: "JSON",
        endpoint: "GET https://api.ashbyhq.com/posting-api/job-board/{org}?includeCompensation=true",
        paging: "Single document. No total count is exposed, so none is claimed.",
        mapping: [
            ["id", "provider_posting_id"],
            ["title", "title"],
            ["jobUrl", "official_job_url"],
            ["applyUrl", "official_application_url"],
            ["descriptionPlain || descriptionHtml", "description_text"],
            ["location · address · secondaryLocations", "locations_normalized"],
            ["workplaceType · isRemote", "work_arrangement_evidence"],
            ["publishedAt", "published_at_if_supplied"],
        ],
        rule: "Compensation, department, team and employment type are kept as evidence, not as fit signals.",
        guard: "Feed path must be exactly /posting-api/job-board/{org} with no extra query beyond includeCompensation.",
        tests: "Original M1 adapter",
    },
    {
        id: "lever",
        name: "Lever",
        format: "JSON",
        endpoint: "GET https://api.lever.co/v0/postings/{slug}?mode=json&skip={n}&limit=50",
        paging: "Pages of 50 until a short or empty page; EU boards use api.eu.lever.co. Repeated pages stop the run.",
        mapping: [
            ["id", "provider_posting_id"],
            ["text", "title"],
            ["hostedUrl", "official_job_url"],
            ["descriptionPlain || description + lists[]", "description_text"],
            ["categories.location · allLocations · country", "locations_normalized"],
            ["workplaceType", "work_arrangement_evidence"],
            ["commitment · salaryRange · team", "source_evidence_note"],
        ],
        rule: "Requirement lists are kept, but lists alone never mark a description complete.",
        guard: "Accepts the provider-observed literal \"onsite\" (M1 hotfix); any other unknown workplace value holds the source PARTIAL.",
        tests: "Original M1 adapter",
    },
    {
        id: "smartrecruiters",
        name: "SmartRecruiters",
        format: "JSON",
        endpoint: "GET https://api.smartrecruiters.com/v1/companies/{company}/postings?destination=PUBLIC&limit=100&offset={n}",
        paging: "Offset pages of 100 reconciled against totalFound, then one detail GET per posting.",
        mapping: [
            ["id (public posting)", "provider_posting_id"],
            ["name", "title"],
            ["postingUrl", "official_job_url"],
            ["applyUrl", "official_application_url"],
            ["jobAd.sections", "description_text"],
            ["location.remote", "work_arrangement_evidence"],
            ["releasedDate", "published_at_if_supplied"],
        ],
        rule: "Complete only when jobAd.sections.jobDescription has visible text and every detail matches the verified company identifier.",
        guard: "With the 4-page budget, pilot boards need at most three public postings; budgets are not raised to make a feed pass.",
        tests: "26/26 targeted tests",
    },
    {
        id: "workable",
        name: "Workable",
        format: "JSON",
        endpoint: "GET https://apply.workable.com/api/v1/widget/accounts/{subdomain}?details=true",
        paging: "One published-jobs array; no cursor or total is documented.",
        mapping: [
            ["shortcode (not id)", "provider_posting_id"],
            ["title", "title"],
            ["url || shortlink || application_url", "official_job_url"],
            ["application_url", "official_application_url"],
            ["description || full_description", "description_text"],
            ["workplace_type · telecommuting", "work_arrangement_evidence"],
            ["state → geographic_state", "source_evidence_note"],
        ],
        rule: "Workable's public state field is a region such as Attica, never a draft/published status.",
        guard: "Confidential, unpublished or draft flags, a foreign subdomain, or a URL on another account blocks the source.",
        tests: "23/23 targeted tests",
    },
    {
        id: "personio",
        name: "Personio",
        format: "XML",
        endpoint: "GET https://{tenant}.jobs.personio.de/xml (or .com)",
        paging: "Single <workzag-jobs> document of <position> records, one language per source.",
        mapping: [
            ["position/id", "provider_posting_id"],
            ["position/name", "title"],
            ["https://{host}/job/{id} (derived)", "official_job_url"],
            ["jobDescriptions/jobDescription", "description_text"],
            ["office · additionalOffices", "locations_normalized"],
            ["employmentType · seniority · schedule", "source_evidence_note"],
        ],
        rule: "createdAt stays a creation time and is not relabelled as a publication date; no application URL is invented.",
        guard: "Wrong root, unknown children or error pages are never treated as zero jobs.",
        tests: "22/22 targeted tests",
    },
    {
        id: "recruitee",
        name: "Recruitee",
        format: "XML",
        endpoint: "GET https://{tenant}.recruitee.com/api/feeds/offers.xml",
        paging: "Single published-board XML collection; board scope only, never employer-wide.",
        mapping: [
            ["reference (reversibly escaped)", "provider_posting_id"],
            ["title", "title"],
            ["url / careers_url", "official_job_url"],
            ["apply_url", "official_application_url"],
            ["description_requirements", "description_text"],
            ["locations/location", "locations_normalized"],
            ["remote · hybrid · on_site", "work_arrangement_evidence"],
        ],
        rule: "Job and apply URLs must share the same /o/{slug} route on the same host.",
        guard: "The documented <credentials> subtree and the mailbox email are never extracted or stored.",
        tests: "23/23 targeted tests",
    },
    {
        id: "teamtailor",
        name: "Teamtailor",
        format: "RSS",
        endpoint: "GET https://{careers-host}/jobs.rss?offset={n}&per_page=100",
        paging: "Offset advances by the items actually observed; complete only after an explicitly empty terminal page.",
        mapping: [
            ["guid", "provider_posting_id"],
            ["title", "title"],
            ["link", "official_job_url"],
            ["description", "description_text"],
            ["tt:locations", "locations_normalized"],
            ["remoteStatus", "work_arrangement_evidence"],
            ["pubDate", "published_at_if_supplied"],
        ],
        rule: "remoteStatus \"none\" does not prove an on-site role; Greece eligibility stays UNKNOWN.",
        guard: "Changed channel metadata between pages, or a job URL on another host, holds the source PARTIAL or BLOCKED.",
        tests: "26/26 targeted tests",
    },
    {
        id: "pinpoint",
        name: "Pinpoint",
        format: "JSON",
        endpoint: "GET https://{board}.pinpointhq.com/postings.json",
        paging: "One public postings collection; an unexpected next/has_more cursor invalidates completeness.",
        mapping: [
            ["data[].id", "provider_posting_id"],
            ["job.requisition_id", "internal_requisition_id"],
            ["title", "title"],
            ["url", "official_job_url"],
            ["application_form_url", "official_application_url"],
            ["description + responsibilities + skills + benefits", "description_text"],
            ["workplace_type", "work_arrangement_evidence"],
        ],
        rule: "Supplemental sections cannot make a missing principal description complete.",
        guard: "Never the deprecated jobs.json or the key-protected /api/v1 endpoints.",
        tests: "22/22 targeted tests",
    },
];

/* ---------- Verification evidence ---------- */
const evidence = [
    { label: "v1 · final cache diagnostic", pass: 69, total: 69, note: "Previously evaluated candidates matched" },
    { label: "M1 · full suite after hotfix", pass: 217, total: 217, note: "Up from 211/211 before the hotfix tests" },
    { label: "M1 · real public responses parsed", pass: 44, total: 44, note: "Postings from three real feeds (5 + 37 + 2): parser compatibility, not live connectivity" },
    { label: "M2.3 · integrated native suite", pass: 459, total: 459, note: "0 failures, 0 skips at the integration commit" },
    { label: "R1 · combined native suite", pass: 500, total: 500, note: "Nine-provider collector + onboarding, reconciled" },
];

const adapterTests = [
    { name: "SmartRecruiters", n: 26 },
    { name: "Teamtailor", n: 26 },
    { name: "Workable", n: 23 },
    { name: "Recruitee", n: 23 },
    { name: "Pinpoint", n: 22 },
    { name: "Personio", n: 22 },
    { name: "Shared XML parser", n: 9 },
];

/* M2D schedule, anonymised: provider of each source per batch. */
const schedule = [
    ["Ashby", "Teamtailor", "Personio", "Pinpoint"],
    ["Greenhouse", "Lever", "Lever", "Ashby"],
    ["Greenhouse", "Lever", "Ashby"],
    ["Greenhouse"],
    ["Ashby", "Greenhouse", "Ashby"],
];
