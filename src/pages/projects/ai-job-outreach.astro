    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = <T extends Element = HTMLElement>(root: ParentNode, sel: string) => root.querySelector(sel) as T | null;
    const $$ = <T extends Element = HTMLElement>(root: ParentNode, sel: string) => Array.from(root.querySelectorAll(sel)) as T[];
    const setText = (root: ParentNode, key: string, value: string) => {
        const el = $(root, `[data-out="${key}"]`);
        if (el) el.textContent = value;
    };

    /* Accessible tabs (timeline + ATS explorer) */
    $$(document, "[data-tabs]").forEach((group) => {
        const tabs = $$<HTMLButtonElement>(group, '[role="tab"]');
        const select = (tab: HTMLButtonElement, focus = false) => {
            tabs.forEach((t) => {
                const on = t === tab;
                t.setAttribute("aria-selected", String(on));
                t.tabIndex = on ? 0 : -1;
                const panel = document.getElementById(t.getAttribute("aria-controls") || "");
                if (panel) panel.hidden = !on;
            });
            if (focus) tab.focus();
        };
        tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => select(tab));
            tab.addEventListener("keydown", (e) => {
                const k = (e as KeyboardEvent).key;
                let n = -1;
                if (k === "ArrowRight" || k === "ArrowDown") n = (i + 1) % tabs.length;
                if (k === "ArrowLeft" || k === "ArrowUp") n = (i - 1 + tabs.length) % tabs.length;
                if (k === "Home") n = 0;
                if (k === "End") n = tabs.length - 1;
                if (n >= 0) {
                    e.preventDefault();
                    select(tabs[n], true);
                }
            });
        });
    });

    /* Count-up numbers and bars when they scroll into view */
    const countGroups = $$(document, "[data-count-group]");
    const runCount = (group: HTMLElement) => {
        group.classList.add("is-in");
        $$(group, "[data-count]").forEach((el) => {
            const target = Number(el.getAttribute("data-count"));
            if (reduceMotion) { el.textContent = String(target); return; }
            const start = performance.now();
            const tick = (now: number) => {
                const p = Math.min(1, (now - start) / 1100);
                el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
                if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        });
    };
    if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
            entries.forEach((en) => {
                if (en.isIntersecting) { runCount(en.target as HTMLElement); io.unobserve(en.target); }
            });
        }, { threshold: 0.35 });
        countGroups.forEach((g) => io.observe(g));
    } else countGroups.forEach(runCount);

    /* =========================================================
       Ports of Normalize.gs fingerprint
       ========================================================= */

    const normText = (v: unknown) => (typeof v === "string" ? v.replace(/\s+/g, " ").trim() : "");
    const stableEvidence = (value: unknown): string => {
        if (Array.isArray(value)) return "[" + value.map(stableEvidence).join(",") + "]";
        if (value && typeof value === "object") {
            const o = value as Record<string, unknown>;
            return "{" + Object.keys(o).sort().map((k) => JSON.stringify(k) + ":" + stableEvidence(o[k])).join(",") + "}";
        }
        return JSON.stringify(value === undefined ? null : value);
    };
    type Posting = Record<string, unknown>;
    const fingerprint = (p: Posting) => {
        let evidence: unknown = p.source_evidence_note;
        if (typeof evidence === "string") { try { evidence = JSON.parse(evidence); } catch { /* keep raw */ } }
        const canonical = JSON.stringify([
            p.posting_key, p.co_id, normText(p.title), p.locations_normalized, p.work_arrangement_evidence,
            p.greece_remote_evidence, normText(p.description_text), p.description_complete === true,
            p.official_job_url, p.official_application_url_if_known, stableEvidence(evidence),
        ]);
        return "fnv128:" + [2166136261, 3758891744, 134775813, 402653189].map((seed) => {
            let h = seed >>> 0;
            for (let i = 0; i < canonical.length; i++) { h ^= canonical.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
            return ("00000000" + h.toString(16)).slice(-8);
        }).join("");
    };
    const samplePosting = (title: string, desc: string): Posting => ({
        posting_key: "CO-9001:lever:example-market:3f2c9a1e-5b7d-4c11-9e2a-0b6f1d2c8e44",
        co_id: "CO-9001",
        title,
        locations_normalized: JSON.stringify(["Remote - Europe"]),
        work_arrangement_evidence: JSON.stringify({ workplaceType: "remote", location_text: "Remote - Europe" }),
        greece_remote_evidence: "UNKNOWN",
        description_text: desc,
        description_complete: true,
        official_job_url: "https://jobs.lever.co/example-market/3f2c9a1e-5b7d-4c11-9e2a-0b6f1d2c8e44",
        official_application_url_if_known: "",
        source_evidence_note: JSON.stringify({ provider: "Lever", department: "Operations", team: "Marketplace", commitment: "Full-time", salaryRange: null }),
    });

    /* =========================================================
       Pipeline stepper
       ========================================================= */

    const stepper = $(document, "[data-stepper]");
    if (stepper) {
        const dots = $$<HTMLButtonElement>(stepper, ".step-dot");
        const panels = $$(stepper, ".step-panel");
        const bar = $(stepper, ".step-progress i");
        const play = $<HTMLButtonElement>(stepper, "[data-play]");
        let current = 0;
        let timer: number | undefined;
        const fpPre = $(stepper, "[data-sample-fingerprint]");
        if (fpPre) {
            const p = samplePosting("Marketplace Operations Specialist", "Own seller onboarding, listing quality and dispute operations for our European marketplace. Remote within Europe.");
            fpPre.textContent = fpPre.textContent!.replace("…computing in your browser…", fingerprint(p));
        }
        const show = (i: number) => {
            current = (i + panels.length) % panels.length;
            panels.forEach((p, j) => (p.hidden = j !== current));
            dots.forEach((d, j) => {
                d.classList.toggle("is-done", j < current);
                if (j === current) d.setAttribute("aria-current", "step");
                else d.removeAttribute("aria-current");
            });
            if (bar) bar.style.transform = `scaleX(${(current + 1) / panels.length})`;
        };
        const stop = () => {
            window.clearInterval(timer);
            timer = undefined;
            play?.setAttribute("aria-pressed", "false");
            if (play) play.textContent = "▶ Auto-play";
        };
        dots.forEach((d) => d.addEventListener("click", () => { stop(); show(Number(d.dataset.step)); }));
        $(stepper, "[data-next]")?.addEventListener("click", () => { stop(); show(current + 1); });
        $(stepper, "[data-prev]")?.addEventListener("click", () => { stop(); show(current - 1); });
        play?.addEventListener("click", () => {
            if (timer) { stop(); return; }
            play.setAttribute("aria-pressed", "true");
            play.textContent = "❚❚ Pause";
            timer = window.setInterval(() => show(current + 1), 3200);
        });
        show(0);
    }

    /* =========================================================
       Dedup lab — port of Dedup.gs (single snapshot row)
       ========================================================= */

    const canonicalUrl = (input: string) => {
        if (typeof input !== "string" || !input || /[\s\x00-\x1f]/.test(input)) return "";
        const parts = /^https:\/\/([^\/?#]+)([^?#]*)(?:\?([^#]*))?(?:#.*)?$/i.exec(input);
        if (!parts) return "";
        const host = parts[1].toLowerCase().replace(/:443$/, "");
        if (!/^[a-z0-9][a-z0-9.-]*\.[a-z]{2,}$/.test(host) || host.indexOf("..") >= 0) return "";
        let path = parts[2] || "/";
        if (path.length > 1) path = path.replace(/\/+$/, "");
        const query = (parts[3] || "").split("&").filter(Boolean).filter((item) => {
            let key = item.split("=")[0].toLowerCase();
            try { key = decodeURIComponent(key); } catch { return true; }
            return !/^utm_|^(?:fbclid|gclid|msclkid|gh_src|lever-source|source|ref|trk)$/.test(key);
        }).sort();
        return "https://" + host + path + (query.length ? "?" + query.join("&") : "");
    };
    const dedupText = (s: string) => (typeof s === "string" ? s.normalize("NFKC").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim().replace(/\s+/g, " ") : "");
    const titleAlias = (first: string, second: string) => {
        const a = dedupText(first), b = dedupText(second);
        if (!a || !b) return false;
        if (a === b) return true;
        const aa = Array.from(new Set(a.split(" ").filter(Boolean)));
        const bb = Array.from(new Set(b.split(" ").filter(Boolean)));
        const overlap = aa.filter((w) => bb.indexOf(w) >= 0).length;
        return overlap >= 2 && overlap / Math.max(aa.length, bb.length) >= 0.66;
    };
    const hostOf = (url: string) => { const m = /^https:\/\/([^/]+)/.exec(canonicalUrl(url)); return m ? m[1] : ""; };

    type Hist = { tab: string; co: string; pid: string; req: string; url: string; title: string };
    type Inc = { co: string; pid: string; req: string; url: string; title: string };
    const matchHistory = (p: Inc, h: Hist) => {
        const sameEmployer = !!h.co && !!p.co && h.co === p.co;
        const rowUrl = canonicalUrl(h.url), inUrl = canonicalUrl(p.url);
        const sameUrl = !!rowUrl && !!inUrl && rowUrl === inUrl;
        let kind = "";
        if (sameEmployer && h.pid && p.pid && h.pid === p.pid) {
            const a = hostOf(h.url), b = hostOf(p.url);
            kind = a && b && a !== b ? "cross_board_identity_warning" : "provider_posting_id";
        } else if (sameEmployer && h.req && p.req && h.req === p.req) kind = "internal_requisition_id";
        else if (sameUrl && sameEmployer) kind = "canonical_job_url";
        else if (sameUrl && !sameEmployer) kind = "employer_conflict_url";
        else if (sameEmployer && titleAlias(h.title, p.title)) kind = "title_location_warning";
        const exact = ["provider_posting_id", "internal_requisition_id", "canonical_job_url"];
        if (exact.includes(kind)) return { status: h.tab === "Vacancies" ? "already_researched" : "previously_applied", kind };
        if (kind) return { status: "possible_alias", kind };
        return { status: "none", kind: "" };
    };
    const v1Norm = (v: string) => (v ? v.toLowerCase().replace(/[^a-z0-9]+/g, " ").replace(/\s+/g, " ").trim() : "");
    const v1Url = (v: string) => (v ? v.trim().split("#", 1)[0].replace(/\/+$/, "") : "");

    const explain: Record<string, string> = {
        provider_posting_id: "Exact provider posting ID for the same employer on the same board. Routed to Already handled.",
        internal_requisition_id: "Same employer and requisition ID. Treated as an exact match.",
        canonical_job_url: "Different raw links, but the canonical URLs match once tracking parameters (utm_*, gh_src, ref…) and trailing slashes are removed.",
        employer_conflict_url: "Same canonical URL recorded under a different employer. Kept and flagged for a person to resolve.",
        cross_board_identity_warning: "Same posting ID but on a different host. The snapshot has no ATS namespace, so a human confirms.",
        title_location_warning: "Titles look alike but nothing proves it is the same posting. Kept, with an alias warning for review.",
        "": "No identity evidence links the two. The posting continues to screening.",
    };

    const presets: Record<string, { inc: Inc; hist: Hist }> = {
        url: {
            inc: { co: "CO-9001", pid: "", req: "", url: "https://boards.greenhouse.io/examplemarket/jobs/4012345/?utm_source=newsletter&gh_src=a1b2", title: "Catalogue Operations Associate" },
            hist: { tab: "Applications", co: "CO-9001", pid: "", req: "", url: "https://boards.greenhouse.io/examplemarket/jobs/4012345", title: "Catalogue Ops Associate (EU)" },
        },
        id: {
            inc: { co: "CO-9001", pid: "4012345", req: "", url: "https://boards.greenhouse.io/examplemarket/jobs/4012345", title: "Marketplace Analyst" },
            hist: { tab: "Applied Vacancy Archive", co: "CO-9001", pid: "4012345", req: "", url: "https://boards.greenhouse.io/examplemarket/jobs/4012345", title: "Marketplace Analyst" },
        },
        title: {
            inc: { co: "CO-9001", pid: "4019999", req: "", url: "https://boards.greenhouse.io/examplemarket/jobs/4019999", title: "Seller Support Specialist" },
            hist: { tab: "Applications", co: "CO-9001", pid: "3870001", req: "", url: "https://boards.greenhouse.io/examplemarket/jobs/3870001", title: "Seller Support Specialist" },
        },
        req: {
            inc: { co: "CO-9001", pid: "4012777", req: "REQ-2291", url: "https://boards.greenhouse.io/examplemarket/jobs/4012777", title: "Pricing Operations Analyst" },
            hist: { tab: "Vacancies", co: "CO-9001", pid: "", req: "REQ-2291", url: "", title: "Pricing Analyst" },
        },
        board: {
            inc: { co: "CO-9001", pid: "88123", req: "", url: "https://example-market.pinpointhq.com/postings/88123", title: "Implementation Coordinator" },
            hist: { tab: "Applications", co: "CO-9001", pid: "88123", req: "", url: "https://apply.workable.com/example-market/j/88123", title: "Implementation Coordinator" },
        },
        conflict: {
            inc: { co: "CO-9001", pid: "", req: "", url: "https://jobs.lever.co/sharedboard/aa11bb22?lever-source=careers", title: "Operations Associate" },
            hist: { tab: "Applications", co: "CO-9002", pid: "", req: "", url: "https://jobs.lever.co/sharedboard/aa11bb22", title: "Operations Associate" },
        },
    };

    const lab = $(document, "[data-dedup-lab]");
    if (lab) {
        const field = (n: string) => $<HTMLInputElement | HTMLSelectElement>(lab, `[name="${n}"]`)!;
        const keys: [keyof Inc, string][] = [["co", "in_co"], ["pid", "in_pid"], ["req", "in_req"], ["url", "in_url"], ["title", "in_title"]];
        const hkeys: [keyof Hist, string][] = [["tab", "h_tab"], ["co", "h_co"], ["pid", "h_pid"], ["req", "h_req"], ["url", "h_url"], ["title", "h_title"]];
        const render = () => {
            const inc = Object.fromEntries(keys.map(([k, n]) => [k, field(n).value.trim()])) as Inc;
            const hist = Object.fromEntries(hkeys.map(([k, n]) => [k, field(n).value.trim()])) as Hist;
            const r = matchHistory(inc, hist);
            setText(lab, "v2status", r.status);
            setText(lab, "v2type", r.kind || "no match");
            setText(lab, "v2why", explain[r.kind]);
            const out = $(lab, ".verdict.v2")!;
            out.dataset.tone = r.status === "none" ? "go" : r.status === "possible_alias" ? "warn" : "stop";
            // v1: same normalised URL, or same normalised company + title.
            const urlDup = !!v1Url(inc.url) && v1Url(inc.url) === v1Url(hist.url);
            const keyDup = !!v1Norm(inc.title) && v1Norm(inc.co) === v1Norm(hist.co) && v1Norm(inc.title) === v1Norm(hist.title);
            const v1 = $(lab, ".verdict.v1")!;
            if (urlDup || keyDup) {
                setText(lab, "v1status", "dropped as duplicate");
                setText(lab, "v1why", urlDup ? "Identical URL after removing the fragment and trailing slash." : "Same company and same normalised title, so the job is silently skipped.");
                v1.dataset.tone = "stop";
            } else {
                setText(lab, "v1status", "kept");
                setText(lab, "v1why", "No identical URL and no identical company/title pair; tracking parameters still make links look different.");
                v1.dataset.tone = "go";
            }
            setText(lab, "canonIn", "incoming → " + (canonicalUrl(inc.url) || "(no valid https URL)"));
            setText(lab, "canonH", "snapshot → " + (canonicalUrl(hist.url) || "(no valid https URL)"));
        };
        const load = (name: string) => {
            const p = presets[name];
            keys.forEach(([k, n]) => (field(n).value = p.inc[k]));
            hkeys.forEach(([k, n]) => (field(n).value = p.hist[k]));
            render();
        };
        $$<HTMLButtonElement>(lab, "[data-preset]").forEach((b) => b.addEventListener("click", () => {
            $$(lab, "[data-preset]").forEach((x) => x.classList.toggle("is-active", x === b));
            load(b.dataset.preset!);
        }));
        lab.addEventListener("input", render);
        load("url");
    }

    /* Fingerprint panel */
    const fpLab = $(document, "[data-fp-lab]");
    if (fpLab) {
        const t = $<HTMLInputElement>(fpLab, '[name="fp_title"]')!;
        const d = $<HTMLTextAreaElement>(fpLab, '[name="fp_desc"]')!;
        const base = { title: t.value, desc: d.value };
        let firstFp = "";
        let seen = new Date("2026-10-15T06:00:00Z");
        const render = (refetched = false) => {
            const fp = fingerprint(samplePosting(t.value, d.value));
            if (!firstFp) firstFp = fingerprint(samplePosting(base.title, base.desc));
            setText(fpLab, "seen", seen.toISOString().replace(".000", ""));
            const hash = $(fpLab, '[data-out="fp"]')!;
            if (hash.textContent !== fp) {
                hash.textContent = fp;
                hash.classList.remove("flash");
                void (hash as HTMLElement).offsetWidth;
                hash.classList.add("flash");
            }
            setText(fpLab, "fpstate", fp === firstFp ? (refetched ? "unchanged" : "baseline_discovered") : "changed → back to review");
        };
        t.addEventListener("input", () => render());
        d.addEventListener("input", () => render());
        $(fpLab, "[data-refetch]")?.addEventListener("click", () => {
            seen = new Date(seen.getTime() + 6 * 3600 * 1000);
            render(true);
        });
        render();
    }

    /* =========================================================
       Screening sandbox — subset port of Screen.gs
       ========================================================= */

    const LANGS = "(?:Spanish|French|German|Italian|Dutch|Portuguese|Polish|Arabic|Mandarin|Chinese|Japanese|Korean|Russian|Turkish|Swedish|Norwegian|Danish|Finnish|Czech|Romanian|Hungarian)";
    const langRule = (d: string) => {
        const patterns = [
            new RegExp("\\b(?:fluent|native(?:-level)?|professional(?:\\s+working)?|business-level|c1|c2)\\s+(?:fluency\\s+|proficiency\\s+)?(?:in\\s+)?(" + LANGS + ")\\s+(?:is\\s+|are\\s+)?(?:required|mandatory|essential)\\b", "i"),
            new RegExp("\\b(?:must|need to)\\s+(?:speak|write|communicate in)\\s+(" + LANGS + ")\\b", "i"),
            new RegExp("\\b(" + LANGS + ")\\s+fluency\\s+(?:is\\s+)?(?:required|mandatory|essential)\\b", "i"),
            new RegExp("\\b(?:required|mandatory)\\s*:\\s*(?:fluent|native|c1|c2)\\s+(" + LANGS + ")\\b", "i"),
        ];
        for (const re of patterns) {
            const m = re.exec(d);
            if (!m) continue;
            const near = d.slice(Math.max(0, m.index - 40), Math.min(d.length, m.index + m[0].length + 70));
            if (/\b(?:not\s+required|optional|preferred\s+(?:but\s+)?not\s+required|a\s+plus)\b/i.test(near)) continue;
            return m[0];
        }
        return "";
    };
    const degreeRule = (d: string) => {
        const patterns = [
            /\b(?:a\s+)?(?:completed\s+)?(?:bachelor'?s|bsc|master'?s|msc|university|college)\s+degree\s+(?:is\s+)?(?:strictly\s+)?(?:required|mandatory|essential)\b/i,
            /\b(?:must|required to)\s+(?:have|hold|possess)\s+(?:a\s+)?(?:completed\s+)?(?:bachelor'?s|bsc|master'?s|msc|university|college)\s+degree\b/i,
        ];
        for (const re of patterns) {
            const m = re.exec(d);
            if (!m) continue;
            const near = d.slice(Math.max(0, m.index - 80), Math.min(d.length, m.index + m[0].length + 180));
            const rejects = /\b(?:no|without)\s+(?:equivalent|comparable|relevant)?\s*(?:practical|professional|work)?\s*experience\b|\bequivalent\s+experience\s+(?:will\s+)?not\s+be\s+accepted\b/i.test(near);
            const accepts = /\b(?:or|and\/or)\s+(?:an?\s+)?(?:equivalent|comparable|relevant)\s+(?:practical\s+|professional\s+|work\s+)?experience\b|\bexperience\s+(?:accepted\s+)?in\s+lieu\s+of\s+(?:a\s+)?degree\b/i.test(near);
            const ambiguous = /\bor\s+(?:an?\s+)?equivalent\s+qualification\b/i.test(near);
            if ((accepts || ambiguous) && !rejects) continue;
            return m[0];
        }
        return "";
    };
    const hardRules: { code: string; ids: string[]; match: (t: string, d: string) => string }[] = [
        { code: "MANDATORY_THIRD_LANGUAGE", ids: ["SC-013", "SC-014"], match: (_t, d) => langRule(d) },
        { code: "UNCOMPENSATED_ROLE", ids: ["SC-022"], match: (_t, d) => {
            const m = /(?:\b(?:position|role|internship|work)\s+(?:is\s+)?(?:entirely\s+|strictly\s+)?unpaid\b|\bunpaid\s+(?:position|role|internship)\b|\bno\s+(?:salary|wages|compensation)\s+(?:will\s+be\s+)?(?:paid|provided|offered)\b)/i.exec(d);
            return m ? m[0] : "";
        } },
        { code: "MANDATORY_DEGREE_NO_EQUIVALENT", ids: ["SC-015"], match: (_t, d) => degreeRule(d) },
        { code: "EXCLUDED_TRANSLATION_ONLY", ids: ["SC-038", "SC-075"], match: (t, d) => {
            const m = /(?:\b(?:exclusively|solely|only)\s+(?:performs?|involves?)\s+(?:[\w-]+\s+){0,3}translation\b|\b(?:translation\s+only|pure\s+translation\s+work)\b)/i.exec(t + "\n" + d);
            return m ? m[0] : "";
        } },
        { code: "EXPLICIT_GEOGRAPHY_EXCLUSION", ids: ["SC-006", "SC-011", "SC-054"], match: (_t, d) => {
            const m = /(?:\bmust\s+(?:currently\s+)?reside\s+in\s+the\s+United\s+States\b[^.\n]{0,100}\b(?:cannot|can\s+not|unable\s+to)\s+hire\s+outside\s+(?:the\s+)?US\b|\bUS[- ]residents?\s+only\s*[,;.]?\s*no\s+international\s+applicants\b)/i.exec(d);
            return m ? m[0] : "";
        } },
    ];

    const screenPresets: Record<string, [string, string, boolean]> = {
        remote: ["Marketplace Operations Specialist", "Own seller onboarding, listing quality and dispute operations across our European marketplace. You will work with pricing and catalogue teams. This role is remote within Europe. Strong Excel skills are a plus.", true],
        german: ["Seller Success Associate", "Support our merchants through onboarding and account health reviews. Fluent German is required for daily calls with DACH sellers. Remote within the EU.", true],
        degreeok: ["Catalogue Data Analyst", "Maintain product data quality for 40,000 listings. A bachelor's degree is required, or equivalent practical experience in e-commerce operations. Hybrid or remote.", true],
        degree: ["Pricing Analyst", "Analyse margins and competitor pricing. A completed master's degree is mandatory; equivalent experience will not be accepted. Office based in Madrid.", true],
        unpaid: ["Operations Intern", "Help the operations team with weekly reporting. This internship is unpaid and runs for three months, fully remote.", true],
        teaser: ["Implementation Coordinator", "Join our implementation team! Apply to learn more.", false],
    };

    const sLab = $(document, "[data-screen-lab]");
    if (sLab) {
        const ti = $<HTMLInputElement>(sLab, '[name="s_title"]')!;
        const de = $<HTMLTextAreaElement>(sLab, '[name="s_desc"]')!;
        const co = $<HTMLInputElement>(sLab, '[name="s_complete"]')!;
        const render = () => {
            const title = normText(ti.value), desc = normText(de.value);
            const complete = co.checked && !!desc;
            const reasons: string[] = [];
            const evidence: string[] = [];
            const add = (c: string) => { if (!reasons.includes(c)) reasons.push(c); };
            if (!complete) add("DESCRIPTION_INCOMPLETE");
            if (/\b(?:remote|europe|eu|hybrid|work\s*from\s*home)\b/i.test(desc)) add("GEOGRAPHY_NEEDS_VERIFICATION");
            if (/\b(?:phone[- ]heavy|phone\s+support|inbound\s+calls|call\s+center|telephone\s+support)\b/i.test(title + " " + desc)) add("PHONE_HEAVY_INCOME_UNVERIFIED");
            if (/\b(?:senior\s+director|vice\s+president|head\s+of|chief\s+\w+\s+officer)\b/i.test(title)) add("SENIORITY_NEEDS_VERIFICATION");
            let route = "AI Review";
            if (!complete || !title) {
                route = "Source uncertain";
            } else {
                const hard = hardRules.map((r) => ({ r, ex: r.match(title, desc) })).filter((x) => x.ex);
                if (hard.length) {
                    route = "Hard ineligible";
                    hard.forEach(({ r, ex }) => { add(r.code); evidence.push(`${r.code} (${r.ids.join(", ")}): “${ex.slice(0, 240)}”`); });
                } else add("POTENTIALLY_RELEVANT_OR_UNCERTAIN");
            }
            const routeEl = $(sLab, '[data-out="route"]')!;
            routeEl.textContent = route;
            routeEl.dataset.route = route.replace(/\s+/g, "-").toLowerCase();
            const list = $(sLab, '[data-out="codes"]')!;
            list.replaceChildren(...reasons.map((r) => { const li = document.createElement("li"); li.textContent = r; return li; }));
            const ev = $(sLab, '[data-out="evidence"]')!;
            ev.replaceChildren(...evidence.map((e) => { const p = document.createElement("p"); p.textContent = e; return p; }));
        };
        const load = (k: string) => {
            const [t, d, c] = screenPresets[k];
            ti.value = t; de.value = d; co.checked = c;
            render();
        };
        $$<HTMLButtonElement>(sLab, "[data-sp]").forEach((b) => b.addEventListener("click", () => {
            $$(sLab, "[data-sp]").forEach((x) => x.classList.toggle("is-active", x === b));
            load(b.dataset.sp!);
        }));
        sLab.addEventListener("input", render);
        sLab.addEventListener("change", render);
        load("remote");
    }

    /* =========================================================
       Lifecycle simulator — compareInventory semantics
       ========================================================= */

    const lLab = $(document, "[data-life-lab]");
    if (lLab) {
        const complete = $<HTMLInputElement>(lLab, '[name="complete"]')!;
        const scope = $<HTMLInputElement>(lLab, '[name="scope"]')!;
        const render = () => {
            const states: Record<string, string> = {};
            let reason = "";
            if (!complete.checked) {
                reason = "INCOMPLETE_OR_UNRECONCILED_FEED: nothing is classified. The prior inventory and the last complete run ID are kept, and C stays open.";
                ["A", "B", "C"].forEach((k) => (states[k] = "retained_prior"));
                states.D = "not persisted";
                scope.disabled = true;
            } else if (!scope.checked) {
                scope.disabled = false;
                reason = "BASELINE_OR_SCOPE_CHANGED: incoming postings become a new baseline; removal is not authorised, so C is retained.";
                ["A", "B", "D"].forEach((k) => (states[k] = "baseline_discovered"));
                states.C = "retained_prior";
            } else {
                scope.disabled = false;
                reason = "COMPLETE_MATCHING_SCOPE: removal authorised. C becomes possibly_removed, not closed; confirmed_closed needs separate official evidence.";
                Object.assign(states, { A: "unchanged", B: "changed", C: "possibly_removed", D: "new" });
            }
            $$(lLab, ".life-card").forEach((card) => {
                const s = states[card.dataset.k!];
                $(card, "[data-s]")!.textContent = s;
                card.dataset.state = s.replace(/\s+/g, "_");
            });
            setText(lLab, "lifeReason", reason);
        };
        lLab.addEventListener("change", render);
        render();
    }

    /* =========================================================
       M2D scheduler simulation
       ========================================================= */

    const m2d = $(document, "[data-m2d]");
    if (m2d) {
        const schedule = [
            ["Ashby", "Teamtailor", "Personio", "Pinpoint"],
            ["Greenhouse", "Lever", "Lever", "Ashby"],
            ["Greenhouse", "Lever", "Ashby"],
            ["Greenhouse"],
            ["Ashby", "Greenhouse", "Ashby"],
        ];
        const hand = $(m2d, ".wheel-hand") as unknown as SVGGElement;
        const nodes = $$(m2d, ".wheel-node");
        const log = $(m2d, '[data-out="log"]')!;
        let cursor = 0, hours = 0, snapAt: number | null = null, turns = 0;
        const line = (text: string, tone = "") => {
            const li = document.createElement("li");
            li.textContent = text;
            if (tone) li.dataset.tone = tone;
            log.prepend(li);
            while (log.children.length > 9) log.lastElementChild?.remove();
        };
        const paint = () => {
            hand.style.transform = `rotate(${(turns * 5 + cursor) * 72}deg)`;
            nodes.forEach((n, i) => n.classList.toggle("is-next", i === cursor));
            setText(m2d, "clock", `T+${hours}h`);
            setText(m2d, "age", snapAt === null ? "no snapshot" : `${hours - snapAt}h`);
            const chips = $(m2d, '[data-out="batchChips"]')!;
            chips.replaceChildren(...schedule[cursor].map((p) => { const s = document.createElement("span"); s.textContent = p; return s; }));
        };
        const fire = () => {
            line(`T+${hours}h · trigger: lock acquired (tryLock 1000 ms)`);
            const age = snapAt === null ? Infinity : hours - snapAt;
            if (cursor === 0 || age > 24) {
                snapAt = hours;
                line("Dedup Snapshot refreshed: Applications, Vacancies, Applied Vacancy Archive read-only", "info");
            }
            const n = schedule[cursor].length;
            line(`Batch ${cursor}: ${n} source${n > 1 ? "s" : ""} fetched (${schedule[cursor].join(", ")}) → Run Log receipts`, "ok");
            const next = (cursor + 1) % 5;
            line(`Cursor committed ${cursor} → ${next}; lock released`);
            if (next === 0) turns++;
            cursor = next;
            hours += 6;
            paint();
        };
        $(m2d, "[data-fire]")?.addEventListener("click", fire);
        $(m2d, "[data-stale]")?.addEventListener("click", () => {
            if (cursor === 0) { line("At cursor 0 the snapshot is refreshed first; fire one batch, then try again.", "info"); return; }
            snapAt = hours - 49;
            paint();
            line(`T+${hours}h · trigger: snapshot is 49h old. Refresh fails in this simulation`, "warn");
            line("Error: scheduled collection requires a complete fresh Dedup Snapshot. No source requested; cursor unchanged", "bad");
            snapAt = hours - 49;
        });
        $(m2d, "[data-reset]")?.addEventListener("click", () => {
            cursor = 0; hours = 0; snapAt = null; turns = 0;
            log.replaceChildren();
            line("Configuration fingerprint matches; automation enabled; cursor 0", "info");
            paint();
        });
        line("Configuration fingerprint matches; automation enabled; cursor 0", "info");
        paint();
    }
</script>

<style>
    :root {
        --bg: #06111e;
        --surface: #091b2b;
        --surface-2: #0b2236;
        --border: #1f3d57;
        --text: #d8e4ee;
        --muted: #9fb2c2;
        --subtle: #7890a3;
        --blue: #168dff;
        --blue-light: #65baff;
        --orange: #ff8a00;
        --green: #26d5a2;
        --amber: #ffc24d;
        --red: #ff6b6b;
        --violet: #a98bff;
        --mono: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
        --page-width: 1240px;
    }

    * { box-sizing: border-box; }
    [hidden] { display: none !important; }

    html { scroll-behavior: smooth; background: var(--bg); }

    body {
        min-height: 100vh;
        margin: 0;
        color: var(--text);
        background:
            radial-gradient(circle at 88% 4%, rgba(22, 141, 255, 0.13), transparent 30rem),
            radial-gradient(circle at 8% 32%, rgba(255, 138, 0, 0.05), transparent 28rem),
            radial-gradient(circle at 90% 70%, rgba(38, 213, 162, 0.05), transparent 30rem),
            var(--bg);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    main,
    footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;
        padding-inline: clamp(1rem, 5vw, 4.5rem);
    }

    a { color: inherit; text-underline-offset: 0.25em; }
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }

    h1, h2, h3, p { margin-top: 0; }
    h1, h3 { color: #fff; }

    h1 {
        max-width: 1000px;
        margin: 0 auto 1.4rem;
        font-size: clamp(2.5rem, 6.6vw, 5.6rem);
        line-height: 1;
        letter-spacing: -0.05em;
        overflow-wrap: anywhere;
    }

    h2 {
        margin-bottom: 1rem;
        color: #fff;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2rem, 4.6vw, 3.6rem);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.045em;
    }

    h3 { font-size: 1.15rem; letter-spacing: -0.01em; }

    code, pre { font-family: var(--mono); }
    p code, li code { color: var(--blue-light); font-size: 0.88em; }

    .eyebrow {
        margin-bottom: 1rem;
        color: var(--orange);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    .accent {
        background: linear-gradient(90deg, var(--blue), var(--blue-light) 60%, var(--green));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .kicker {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--orange);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .kicker.green { color: var(--green); }

    .muted-note { color: var(--subtle); font-size: 0.82rem; line-height: 1.6; }

    .card {
        padding: clamp(1.1rem, 2.5vw, 1.5rem);
        border: 1px solid var(--border);
        border-radius: 16px;
        background: linear-gradient(160deg, rgba(14, 40, 62, 0.65), rgba(9, 27, 43, 0.85));
        transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }
    .card:hover {
        border-color: rgba(101, 186, 255, 0.55);
        transform: translateY(-3px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    }
    .card p { margin-bottom: 0; color: var(--muted); line-height: 1.65; font-size: 0.92rem; }
    .card h3 { margin-bottom: 0.5rem; }

    /* =========================================================
       HERO
       ========================================================= */

    .hero {
        padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2.5rem, 5vw, 4rem);
        text-align: center;
    }

    .breadcrumbs {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 2rem;
        color: var(--subtle);
        font-size: 0.8rem;
    }
    .breadcrumbs a { text-decoration: none; }
    .breadcrumbs a:hover { color: #fff; }
    .breadcrumbs strong { color: var(--blue-light); }

    .hero-lead {
        max-width: 820px;
        margin: 0 auto;
        color: #dce6ee;
        font-size: clamp(1.02rem, 1.8vw, 1.2rem);
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0.8rem 1.2rem;
        border: 1px solid var(--blue);
        border-radius: 9px;
        color: #fff;
        font-size: 0.86rem;
        font-weight: 750;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .button:hover { transform: translateY(-2px); }
    .button-primary { background: var(--blue); }
    .button-primary:hover { background: #2a9bff; }
    .button-secondary { background: rgba(7, 21, 34, 0.8); }
    .button-secondary:hover { border-color: var(--blue-light); }

    /* Animated funnel graphic */
    .funnel-graphic {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 150px) minmax(0, 1fr) auto minmax(0, 150px);
        align-items: center;
        gap: 0.6rem;
        max-width: 820px;
        margin: 2.4rem auto 0;
        padding: 1.2rem;
        border: 1px solid var(--border);
        border-radius: 20px;
        background:
            linear-gradient(rgba(101, 186, 255, 0.05) 1px, transparent 1px) 0 0 / 22px 22px,
            linear-gradient(90deg, rgba(101, 186, 255, 0.05) 1px, transparent 1px) 0 0 / 22px 22px,
            rgba(7, 21, 34, 0.75);
    }
    .funnel-sources { display: grid; gap: 0.32rem; }
    .src {
        display: block;
        padding: 0.28rem 0.55rem;
        border: 1px solid var(--border);
        border-left: 3px solid var(--blue);
        border-radius: 6px;
        background: var(--surface);
        color: #c9d8e5;
        font-family: var(--mono);
        font-size: 0.68rem;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        animation: src-pulse 4.5s ease-in-out calc(var(--i) * 0.4s) infinite;
    }
    .fmt-xml { --fmt: var(--violet); }
    .fmt-rss { --fmt: var(--orange); }
    .fmt-json { --fmt: var(--blue); }
    .src { border-left-color: var(--fmt); }

    .funnel-lanes { display: grid; gap: 0.32rem; }
    .lane {
        position: relative;
        display: block;
        height: 1.42rem;
        overflow: hidden;
    }
    .lane::before {
        content: "";
        position: absolute;
        inset: 50% 0 auto;
        border-top: 1px dashed rgba(101, 186, 255, 0.28);
    }
    .lane i {
        position: absolute;
        top: calc(50% - 3px);
        left: 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--blue-light);
        box-shadow: 0 0 10px var(--blue-light);
        animation: lane-run 2.8s linear calc(var(--i) * -0.31s) infinite;
    }
    .funnel-core {
        display: grid;
        gap: 0.4rem;
        padding: 0.7rem;
        border: 1px solid rgba(101, 186, 255, 0.45);
        border-radius: 14px;
        background: rgba(22, 141, 255, 0.08);
    }
    .funnel-core span {
        padding: 0.4rem 0.7rem;
        border-radius: 8px;
        background: var(--surface-2);
        color: #fff;
        font-size: 0.74rem;
        font-weight: 700;
    }
    .funnel-out {
        display: grid;
        place-items: center;
        gap: 0.2rem;
        padding: 0.9rem 0.6rem;
        border: 1px solid rgba(38, 213, 162, 0.55);
        border-radius: 14px;
        background: rgba(38, 213, 162, 0.07);
        color: var(--green);
        font-weight: 800;
        font-size: 0.82rem;
        animation: out-glow 2.8s ease-in-out infinite;
    }
    .funnel-out small { color: var(--muted); font-weight: 500; font-size: 0.7rem; }

    @keyframes lane-run {
        from { left: -6px; opacity: 0; }
        15% { opacity: 1; }
        85% { opacity: 1; }
        to { left: 100%; opacity: 0; }
    }
    @keyframes src-pulse {
        0%, 100% { background: var(--surface); }
        10% { background: #12314b; }
    }
    @keyframes out-glow {
        0%, 100% { box-shadow: 0 0 0 rgba(38, 213, 162, 0); }
        50% { box-shadow: 0 0 26px rgba(38, 213, 162, 0.22); }
    }

    /* =========================================================
       METRICS
       ========================================================= */

    .metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        padding-bottom: clamp(3.5rem, 7vw, 5rem);
        text-align: center;
    }
    .metric-card {
        padding: 1.3rem 1rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(9, 27, 43, 0.85);
        transition: transform 0.25s ease, border-color 0.25s ease;
    }
    .metric-card:hover { transform: translateY(-3px); border-color: var(--blue); }
    .metric-card strong {
        display: block;
        margin-bottom: 0.45rem;
        color: var(--blue-light);
        font-size: clamp(1.6rem, 3.2vw, 2.4rem);
        letter-spacing: -0.03em;
    }
    .metric-card span { color: var(--muted); font-size: 0.82rem; line-height: 1.45; }

    /* =========================================================
       SECTIONS
       ========================================================= */

    .case-section {
        padding: clamp(4rem, 8vw, 6.5rem) 0;
        border-top: 1px solid rgba(31, 61, 87, 0.8);
    }
    .section-heading { max-width: 820px; margin-bottom: 2.2rem; }
    .section-heading > p:last-child { color: var(--muted); line-height: 1.75; }
    .section-heading.centered { margin-inline: auto; text-align: center; }

    .footnote {
        max-width: 860px;
        margin-top: 1.4rem;
        color: var(--subtle);
        font-size: 0.84rem;
        line-height: 1.65;
    }

    /* v1 */
    .v1-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .cache-story {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: clamp(1.2rem, 3vw, 2.4rem);
        align-items: center;
        margin-top: 2rem;
        padding: clamp(1.2rem, 3vw, 2rem);
        border: 1px solid var(--border);
        border-radius: 18px;
        background: rgba(7, 21, 34, 0.7);
    }
    .cache-copy p { color: var(--muted); line-height: 1.7; }
    .cache-copy p:last-child { margin-bottom: 0; }
    .meter-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: baseline;
        gap: 0.2rem 0.4rem;
        margin-bottom: 1.2rem;
    }
    .meter-row > span { grid-column: 1 / -1; color: var(--muted); font-size: 0.8rem; }
    .meter {
        height: 12px;
        border-radius: 99px;
        background: #0d2a42;
        overflow: hidden;
        align-self: center;
    }
    .meter i {
        display: block;
        width: var(--w);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--orange), var(--amber));
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .is-good .meter i { background: linear-gradient(90deg, var(--blue), var(--green)); }
    .is-in .meter i { transform: scaleX(1); }
    .meter-row strong { color: #fff; font-size: 1.6rem; font-variant-numeric: tabular-nums; }
    .meter-row em { color: var(--subtle); font-style: normal; }
    .is-good strong { color: var(--green); }

    .verified-example {
        margin-top: 1.2rem;
        padding: 1.1rem 1.3rem;
        border-left: 3px solid var(--green);
        border-radius: 12px;
        background: rgba(38, 213, 162, 0.06);
    }
    .verified-example p { margin: 0; color: var(--muted); line-height: 1.65; }

    /* why */
    .why-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }
    .why-card p { margin-bottom: 0.8rem; }
    .why-card p:last-child { margin-bottom: 0; color: #e7f0f7; }
    .why-from, .why-to {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .why-from { color: var(--subtle); text-decoration: line-through; }
    .why-to { color: var(--green); }

    .registry {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 1rem 2rem;
        align-items: center;
        margin-top: 2rem;
        padding: clamp(1.2rem, 3vw, 2rem);
        border: 1px solid var(--border);
        border-radius: 18px;
        background: rgba(7, 21, 34, 0.7);
    }
    .registry-copy p { margin: 0; color: var(--muted); line-height: 1.7; }
    .registry-dots {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9px, 1fr));
        gap: 4px;
    }
    .registry-dots i, .registry-legend i {
        display: block;
        aspect-ratio: 1;
        border-radius: 50%;
        background: #1d3a54;
    }
    .registry-dots i.known, .registry-legend i.known { background: var(--orange); box-shadow: 0 0 8px rgba(255, 138, 0, 0.5); }
    .registry-dots i.known { animation: dot-pop 2.6s ease-in-out var(--d) infinite; }
    .registry-legend {
        grid-column: 2;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        color: var(--muted);
        font-size: 0.78rem;
    }
    .registry-legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
    .registry-legend i { width: 10px; }
    @keyframes dot-pop {
        0%, 80%, 100% { transform: scale(1); }
        88% { transform: scale(1.5); }
    }

    /* timeline */
    .timeline {
        border: 1px solid var(--border);
        border-radius: 20px;
        background: rgba(7, 21, 34, 0.75);
        overflow: hidden;
    }
    .timeline-track {
        position: relative;
        display: grid;
        grid-template-columns: repeat(9, minmax(0, 1fr));
        padding: 1.4rem 1rem 1rem;
        border-bottom: 1px solid var(--border);
    }
    .timeline-track::before {
        content: "";
        position: absolute;
        top: calc(1.4rem + 9px);
        left: 6%;
        right: 6%;
        height: 2px;
        background: linear-gradient(90deg, var(--orange), var(--blue) 30%, var(--green));
        opacity: 0.6;
    }
    .tl-node {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 0.3rem;
        padding: 0 0.15rem 0.3rem;
        border: 0;
        background: none;
        color: var(--muted);
        font: inherit;
        cursor: pointer;
    }
    .tl-dot {
        width: 18px;
        height: 18px;
        border: 2px solid var(--blue);
        border-radius: 50%;
        background: var(--bg);
        transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1), background 0.25s ease;
    }
    .tl-node strong { color: #fff; font-size: 0.85rem; }
    .tl-node small { font-size: 0.68rem; line-height: 1.25; }
    .tl-node:hover .tl-dot { transform: scale(1.25); }
    .tl-node[aria-selected="true"] .tl-dot { background: var(--orange); border-color: var(--orange); transform: scale(1.3); box-shadow: 0 0 0 6px rgba(255, 138, 0, 0.15); }
    .tl-node[aria-selected="true"] small { color: #fff; }
    .tl-panel { padding: clamp(1.2rem, 3vw, 2rem); animation: panel-in 0.35s ease both; }
    .tl-panel p { max-width: 760px; color: var(--muted); line-height: 1.7; }
    .tl-date { color: var(--orange) !important; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }
    .tl-panel ul { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
    .tl-panel li {
        padding: 0.45rem 0.7rem;
        border: 1px solid #28506f;
        border-radius: 999px;
        background: var(--surface);
        color: #d1e0ec;
        font-size: 0.78rem;
    }
    @keyframes panel-in {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: none; }
    }

    /* stepper */
    .stepper {
        padding: clamp(1rem, 2.5vw, 1.6rem);
        border: 1px solid var(--border);
        border-radius: 20px;
        background: rgba(7, 21, 34, 0.75);
    }
    .sample-label {
        display: inline-block;
        margin-bottom: 1rem;
        padding: 0.35rem 0.7rem;
        border: 1px dashed rgba(255, 194, 77, 0.6);
        border-radius: 8px;
        color: var(--amber);
        font-size: 0.74rem;
    }
    .step-rail {
        display: grid;
        grid-template-columns: repeat(8, minmax(0, 1fr));
        gap: 0.4rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .step-dot {
        display: grid;
        width: 100%;
        gap: 0.2rem;
        padding: 0.55rem 0.4rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }
    .step-dot span { color: var(--blue-light); font-family: var(--mono); font-size: 0.72rem; font-weight: 700; }
    .step-dot small { font-size: 0.7rem; line-height: 1.25; }
    .step-dot:hover { transform: translateY(-2px); border-color: var(--blue); }
    .step-dot.is-done { border-color: rgba(38, 213, 162, 0.4); }
    .step-dot.is-done span { color: var(--green); }
    .step-dot[aria-current="step"] { border-color: var(--orange); background: #142a3d; color: #fff; }
    .step-dot[aria-current="step"] span { color: var(--orange); }
    .step-progress { height: 3px; margin: 0.9rem 0 1.2rem; border-radius: 3px; background: #0f2b43; overflow: hidden; }
    .step-progress i {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--blue), var(--green));
        transform: scaleX(0.125);
        transform-origin: left;
        transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .step-panel {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 1.4rem;
        min-height: 260px;
        animation: panel-in 0.35s ease both;
    }
    .step-copy p { color: var(--muted); line-height: 1.7; }
    .file-chip {
        display: inline-block;
        margin-bottom: 0.7rem;
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        background: rgba(22, 141, 255, 0.14);
        color: var(--blue-light);
        font-family: var(--mono);
        font-size: 0.74rem;
    }
    .step-controls { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.6rem; margin-top: 1rem; }

    .code {
        min-width: 0;
        max-width: 100%;
        margin: 0;
        padding: 1rem 1.1rem;
        overflow-x: auto;
        border: 1px solid #1c3a55;
        border-radius: 12px;
        background: #040c16;
        color: #bfe0ff;
        font-size: 0.76rem;
        line-height: 1.6;
        white-space: pre;
    }

    .ctl {
        min-height: 40px;
        padding: 0.55rem 0.95rem;
        border: 1px solid #2b5375;
        border-radius: 9px;
        background: var(--surface);
        color: #e6eef5;
        font: inherit;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .ctl:hover { transform: translateY(-1px); border-color: var(--blue-light); }
    .ctl-primary { border-color: var(--blue); background: var(--blue); color: #fff; }
    .ctl-primary:hover { background: #2a9bff; }
    .ctl[aria-pressed="true"] { border-color: var(--orange); color: var(--orange); }

    /* ATS explorer */
    .ats {
        display: grid;
        grid-template-columns: 210px minmax(0, 1fr);
        border: 1px solid var(--border);
        border-radius: 20px;
        background: rgba(7, 21, 34, 0.75);
        overflow: hidden;
    }
    .ats-tabs {
        display: grid;
        align-content: start;
        gap: 0.3rem;
        padding: 0.8rem;
        border-right: 1px solid var(--border);
        background: rgba(4, 12, 22, 0.5);
    }
    .ats-tab {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        border: 1px solid transparent;
        border-left: 3px solid var(--fmt);
        border-radius: 8px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.86rem;
        font-weight: 650;
        text-align: left;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }
    .ats-tab small { font-family: var(--mono); font-size: 0.64rem; color: var(--fmt); }
    .ats-tab:hover { background: var(--surface); color: #fff; transform: translateX(3px); }
    .ats-tab[aria-selected="true"] { border-color: #2b5375; border-left-color: var(--fmt); background: var(--surface-2); color: #fff; }
    .ats-panel { min-width: 0; padding: clamp(1.1rem, 3vw, 1.8rem); animation: panel-in 0.35s ease both; }
    .ats-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
    .ats-head h3 { margin: 0 0.4rem 0 0; font-size: 1.5rem; }
    .fmt-badge, .test-badge {
        padding: 0.25rem 0.55rem;
        border-radius: 6px;
        font-family: var(--mono);
        font-size: 0.7rem;
        font-weight: 700;
    }
    .fmt-badge { border: 1px solid var(--fmt); color: var(--fmt); }
    .test-badge { background: rgba(38, 213, 162, 0.12); color: var(--green); }
    .endpoint { white-space: pre-wrap; overflow-wrap: anywhere; color: #ffd8a8; }
    .ats-paging { margin: 0.9rem 0 1.2rem; color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
    .ats-paging strong { color: #fff; }
    .mapping { display: grid; gap: 0.35rem; }
    .map-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr);
        align-items: center;
        gap: 0.4rem;
        animation: row-in 0.4s ease both;
        animation-delay: calc(var(--j, 0) * 45ms);
    }
    .map-head span { color: var(--subtle); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }
    .map-row code {
        min-width: 0;
        padding: 0.42rem 0.6rem;
        border: 1px solid #1c3a55;
        border-radius: 7px;
        background: #071628;
        color: #d6e6f3;
        font-size: 0.74rem;
        overflow-wrap: anywhere;
    }
    .map-row code.to { border-color: rgba(38, 213, 162, 0.35); color: #b7f5df; }
    .map-arrow {
        position: relative;
        height: 2px;
        background: linear-gradient(90deg, rgba(101, 186, 255, 0.2), var(--blue-light));
        overflow: hidden;
    }
    .map-arrow::after {
        content: "";
        position: absolute;
        top: -2px;
        left: 0;
        width: 10px;
        height: 6px;
        border-radius: 3px;
        background: #fff;
        animation: arrow-run 1.8s ease-in-out calc(var(--j, 0) * 0.15s) infinite;
    }
    @keyframes arrow-run {
        from { transform: translateX(-12px); }
        to { transform: translateX(48px); }
    }
    @keyframes row-in {
        from { opacity: 0; transform: translateX(-8px); }
        to { opacity: 1; transform: none; }
    }
    .ats-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; margin-top: 1.2rem; }
    .ats-notes p {
        margin: 0;
        padding: 0.9rem 1rem;
        border-radius: 10px;
        background: rgba(9, 27, 43, 0.9);
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.6;
    }

    /* labs */
    .lab {
        padding: clamp(1rem, 2.5vw, 1.6rem);
        border: 1px solid var(--border);
        border-radius: 20px;
        background: rgba(7, 21, 34, 0.75);
    }
    .lab + .lab { margin-top: 1.2rem; }
    .presets { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.1rem; }
    .chip {
        padding: 0.45rem 0.75rem;
        border: 1px solid #2b5375;
        border-radius: 999px;
        background: var(--surface);
        color: #cfdeea;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 650;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .chip:hover { transform: translateY(-1px); border-color: var(--blue-light); }
    .chip.is-active { border-color: var(--orange); background: rgba(255, 138, 0, 0.12); color: #fff; }

    .lab-cols, .screen-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .lab-box { min-width: 0; margin: 0; padding: 0.9rem 1rem 1rem; border: 1px solid #1c3a55; border-radius: 14px; }
    .lab-box legend { padding: 0 0.4rem; color: var(--blue-light); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
    .lab label { display: grid; gap: 0.3rem; margin-bottom: 0.6rem; color: var(--muted); font-size: 0.76rem; font-weight: 650; }
    .lab label.check { display: flex; align-items: center; gap: 0.5rem; }
    .lab input:not([type="checkbox"]), .lab select, .lab textarea {
        width: 100%;
        min-width: 0;
        padding: 0.5rem 0.6rem;
        border: 1px solid #23476a;
        border-radius: 8px;
        background: #040c16;
        color: #e8f1f8;
        font-family: var(--mono);
        font-size: 0.78rem;
    }
    .lab textarea { resize: vertical; line-height: 1.5; }

    .lab-out {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
        margin-top: 1rem;
    }
    .verdict {
        padding: 1rem 1.1rem;
        border: 1px solid #1c3a55;
        border-left: 4px solid var(--tone, var(--blue));
        border-radius: 12px;
        background: #071628;
        transition: border-color 0.3s ease;
    }
    .verdict[data-tone="go"] { --tone: var(--green); }
    .verdict[data-tone="warn"] { --tone: var(--amber); }
    .verdict[data-tone="stop"] { --tone: var(--red); }
    .verdict strong { display: block; color: var(--tone, #fff); font-family: var(--mono); font-size: 1.05rem; }
    .verdict code { display: inline-block; margin-top: 0.3rem; color: var(--blue-light); font-size: 0.74rem; }
    .verdict p { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.84rem; line-height: 1.55; }
    .canon { grid-column: 1 / -1; display: grid; gap: 0.3rem; }
    .canon code { color: #bfe0ff; font-size: 0.74rem; overflow-wrap: anywhere; }

    .fp-lab { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.2rem; align-items: center; }
    .fp-copy p { color: var(--muted); line-height: 1.65; font-size: 0.9rem; }
    .fp-out { display: grid; gap: 0.7rem; }
    .fp-out div { display: grid; gap: 0.25rem; padding: 0.8rem 1rem; border: 1px solid #1c3a55; border-radius: 10px; background: #071628; }
    .fp-out span { color: var(--subtle); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
    .fp-out code { color: #d6e6f3; font-size: 0.8rem; overflow-wrap: anywhere; }
    .fp-out strong { color: var(--green); font-family: var(--mono); font-size: 0.9rem; }
    .fp-hash.flash { animation: flash 0.7s ease; }
    @keyframes flash {
        from { color: var(--orange); transform: scale(1.02); }
        to { color: #d6e6f3; transform: none; }
    }

    /* screening */
    .screen-out {
        padding: 1rem 1.1rem;
        border: 1px solid #1c3a55;
        border-radius: 14px;
        background: #071628;
    }
    .route {
        display: inline-block;
        margin-bottom: 0.8rem;
        padding: 0.35rem 0.8rem;
        border-radius: 8px;
        background: rgba(22, 141, 255, 0.15);
        color: var(--blue-light);
        font-size: 1.15rem;
        transition: background 0.3s ease, color 0.3s ease;
    }
    .route[data-route="hard-ineligible"] { background: rgba(255, 107, 107, 0.15); color: var(--red); }
    .route[data-route="source-uncertain"] { background: rgba(255, 194, 77, 0.15); color: var(--amber); }
    .route[data-route="ai-review"] { background: rgba(38, 213, 162, 0.13); color: var(--green); }
    .codes { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0 0 0.6rem; padding: 0; list-style: none; }
    .codes :global(li) {
        padding: 0.3rem 0.5rem;
        border: 1px solid #23476a;
        border-radius: 6px;
        color: #d6e6f3;
        font-family: var(--mono);
        font-size: 0.68rem;
        animation: row-in 0.3s ease both;
    }
    .evidence :global(p) { margin: 0 0 0.4rem; color: #ffb3b3; font-size: 0.8rem; line-height: 1.5; overflow-wrap: anywhere; }

    /* lifecycle */
    .toggles { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin-bottom: 1.2rem; }
    .switch { display: inline-flex !important; align-items: center; gap: 0.6rem !important; cursor: pointer; color: #e1ebf3 !important; font-size: 0.86rem !important; }
    .switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
    .switch span {
        position: relative;
        flex: none;
        width: 42px;
        height: 24px;
        border-radius: 99px;
        background: #23405a;
        transition: background 0.25s ease;
    }
    .switch span::after {
        content: "";
        position: absolute;
        top: 3px;
        left: 3px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #fff;
        transition: transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1);
    }
    .switch input:checked + span { background: var(--blue); }
    .switch input:checked + span::after { transform: translateX(18px); }
    .switch input:focus-visible + span { outline: 2px solid var(--orange); outline-offset: 3px; }
    .switch input:disabled + span { opacity: 0.4; }
    .life-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; }
    .life-card {
        display: grid;
        place-items: center;
        gap: 0.4rem;
        padding: 1.1rem 0.5rem;
        border: 1px solid #1c3a55;
        border-radius: 14px;
        background: #071628;
        text-align: center;
        transition: border-color 0.3s ease, transform 0.3s ease;
    }
    .life-card b { color: #fff; font-size: 1.6rem; font-family: Georgia, serif; font-weight: 400; }
    .life-card span { font-family: var(--mono); font-size: 0.72rem; overflow-wrap: anywhere; color: var(--muted); }
    .life-card[data-state="new"], .life-card[data-state="baseline_discovered"] { border-color: var(--blue); }
    .life-card[data-state="new"] span, .life-card[data-state="baseline_discovered"] span { color: var(--blue-light); }
    .life-card[data-state="changed"] { border-color: var(--amber); }
    .life-card[data-state="changed"] span { color: var(--amber); }
    .life-card[data-state="unchanged"] span { color: var(--green); }
    .life-card[data-state="possibly_removed"] { border-color: var(--red); transform: rotate(-2deg); }
    .life-card[data-state="possibly_removed"] span { color: var(--red); }
    .life-card[data-state="retained_prior"] span { color: #cfdeea; }
    .life-card[data-state="not_persisted"] { opacity: 0.5; border-style: dashed; }
    .life-reason { margin: 1rem 0 0; color: var(--muted); font-size: 0.88rem; line-height: 1.6; }

    /* m2d */
    .m2d { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 1.4rem; align-items: start; }
    .wheel-wrap { display: grid; gap: 1rem; justify-items: center; }
    .wheel { width: min(100%, 280px); height: auto; overflow: visible; }
    .wheel-ring { fill: none; stroke: #1f4060; stroke-width: 2; stroke-dasharray: 4 6; }
    .wheel-node circle { fill: #0b2236; stroke: #2b5375; stroke-width: 2; transition: fill 0.3s ease, stroke 0.3s ease; }
    .wheel-node text { fill: #fff; font-size: 12px; font-weight: 700; font-family: Inter, system-ui, sans-serif; }
    .wheel-node text.sub { fill: var(--muted); font-size: 8.5px; font-weight: 500; }
    .wheel-node.is-next circle { fill: rgba(255, 138, 0, 0.18); stroke: var(--orange); }
    .wheel-hand { transform-origin: 110px 110px; transition: transform 0.6s cubic-bezier(0.3, 1.3, 0.5, 1); }
    .wheel-hand line { stroke: var(--orange); stroke-width: 3; stroke-linecap: round; }
    .wheel-hub { fill: var(--orange); }
    .clock {
        display: grid;
        grid-template-columns: auto auto;
        gap: 0.2rem 1rem;
        align-items: baseline;
        color: var(--subtle);
        font-size: 0.74rem;
    }
    .clock strong { color: #fff; font-family: var(--mono); font-size: 0.95rem; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .chips :global(span) {
        padding: 0.35rem 0.65rem;
        border: 1px solid #2b5375;
        border-radius: 999px;
        background: var(--surface);
        color: #fff;
        font-size: 0.78rem;
        animation: row-in 0.3s ease both;
    }
    .m2d-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
    .log {
        display: grid;
        gap: 0.35rem;
        min-height: 220px;
        margin: 0;
        padding: 0.8rem;
        border: 1px solid #1c3a55;
        border-radius: 12px;
        background: #040c16;
        list-style: none;
        font-family: var(--mono);
        font-size: 0.72rem;
        line-height: 1.5;
    }
    .log :global(li) { color: #b9cbd9; overflow-wrap: anywhere; animation: row-in 0.3s ease both; }
    .log :global(li)::before { content: "› "; color: var(--subtle); }
    .log :global(li[data-tone="ok"]) { color: var(--green); }
    .log :global(li[data-tone="info"]) { color: var(--blue-light); }
    .log :global(li[data-tone="warn"]) { color: var(--amber); }
    .log :global(li[data-tone="bad"]) { color: var(--red); }

    /* evidence */
    .proof-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 1.2rem; }
    .proof-bars {
        display: grid;
        gap: 1.1rem;
        padding: clamp(1rem, 2.5vw, 1.5rem);
        border: 1px solid var(--border);
        border-radius: 18px;
        background: rgba(7, 21, 34, 0.75);
    }
    .proof-label { display: flex; justify-content: space-between; gap: 1rem; color: #e1ebf3; font-size: 0.86rem; }
    .proof-label strong { color: var(--green); font-family: var(--mono); white-space: nowrap; }
    .proof-label b { font-weight: inherit; font-variant-numeric: tabular-nums; }
    .bar { height: 8px; margin: 0.45rem 0 0.3rem; border-radius: 99px; background: #0f2b43; overflow: hidden; }
    .bar i {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--blue), var(--green));
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .is-in .bar i { transform: scaleX(1); }
    .proof-row small { color: var(--subtle); font-size: 0.76rem; line-height: 1.45; }
    .adapter-tests ul { display: grid; gap: 0.55rem; margin: 0.8rem 0 0; padding: 0; list-style: none; }
    .adapter-tests li {
        display: grid;
        grid-template-columns: 8.5rem minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.6rem;
        color: var(--muted);
        font-size: 0.8rem;
    }
    .adapter-tests li i { display: block; width: var(--w); height: 6px; border-radius: 99px; background: linear-gradient(90deg, var(--violet), var(--blue-light)); }
    .adapter-tests strong { color: #fff; font-family: var(--mono); font-size: 0.76rem; }

    .bounds { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.2rem; }
    .bounds ul { margin: 0.6rem 0 0; padding-left: 1.1rem; color: var(--muted); line-height: 1.65; font-size: 0.9rem; }
    .bounds li + li { margin-top: 0.35rem; }
    .bounds-yes { border-color: rgba(38, 213, 162, 0.4); }
    .bounds-no { border-color: rgba(255, 138, 0, 0.35); }

    .skills-section :global(.skill-links) { justify-content: center; max-width: 1000px; margin-inline: auto; }

    .project-end {
        padding: clamp(4rem, 8vw, 6.5rem) 0;
        border-top: 1px solid rgba(31, 61, 87, 0.8);
        text-align: center;
    }
    .project-end-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem 2rem;
        margin-top: 2rem;
    }
    .project-end-links a { color: #fff; font-size: 0.92rem; font-weight: 700; }
    .project-end-links a:hover { color: var(--blue-light); }

    /* =========================================================
       RESPONSIVE
