                        <label class="slider"><span>Curvature <output data-for="curvature">0.75</output></span><input type="range" data-key="curvature" min="0" max="1" step="0.05" value="0.75" /></label>
                        <label class="slider"><span>Spacing (mm) <output data-for="spacing_mm">2.5</output></span><input type="range" data-key="spacing_mm" min="1.5" max="4" step="0.1" value="2.5" /></label>
                        <div class="seed-row">
                            <label for="mg-seed">Seed</label>
                            <input id="mg-seed" class="seed-input" type="number" min="0" max="4294967295" step="1" value="20261010" inputmode="numeric" />
