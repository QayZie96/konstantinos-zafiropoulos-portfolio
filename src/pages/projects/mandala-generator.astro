                        <label class="custom-design" hidden><input type="radio" name="design" value="custom" /><span>Your generated one</span></label>
                    </div>

                    <div class="studio-grid">
                        <div class="sheet-wrap">
                            <div class="sheet">
                                <canvas
                                    class="colour-canvas"
