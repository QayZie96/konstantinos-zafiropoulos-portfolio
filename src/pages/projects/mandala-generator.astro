---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";

const title =
    "Mandala & Coloring Puzzle Generator | Python Generative Geometry | Konstantinos Zafeiropoulos";

const description =
    "A deterministic Python generator for printable mathematical colouring pages: radial mandalas with embedded JSON recipes, safe exports and 55 tests. Colour the real SVG pages and run the generator in your browser.";

/* Hero artwork: the version-1 recipe of presets/first-mandala.json,
   computed at build time with the same polar-petal formulas. */
function heroMandala() {
    const symmetry = 12;
    const layers = 4;
    const complexity = 2;
    const curvature = 0.75;
    const spacing = 2.5;
    let state = 20261010;
    const uniform = (low: number, high: number) => {
        state = Number((1664525n * BigInt(state) + 1013904223n) % 4294967296n);
        return low + ((high - low) * state) / 4294967296;
    };
    const radius = 210 / 2 - 15 - 0.45;
    const band = (radius - 10) / layers;
    const step = (2 * Math.PI) / symmetry;
    const petal = (inner: number, outer: number, half: number, angle: number, curve: number) => {
        const pts: string[] = [];
        const add = (side: number, sample: number) => {
            const t = sample / 48;
            const r = inner + (outer - inner) * t;
            const theta = angle + side * half * Math.sin(Math.PI * t) ** (1.35 - 0.75 * curve);
            pts.push(`${(r * Math.cos(theta)).toFixed(2)} ${(r * Math.sin(theta)).toFixed(2)}`);
        };
        for (let s = 0; s < 49; s += 2) add(1, s);
        for (let s = 47; s > 0; s -= 2) add(-1, s);
        return `M ${pts.join(" L ")} Z`;
    };
    const paths: { d: string; layer: number }[] = [];
    const circles = [3.5, 9, radius];
    for (let layer = 0; layer < layers; layer++) {
        const start = 10 + layer * band + spacing / 2;
        const end = 10 + (layer + 1) * band - spacing / 2;
        const middle = (start + end) / 2;
        let half = Math.min(step * 0.41, step / 2 - spacing / (2 * middle));
        half *= uniform(0.9, 1.0);
        const curve = Math.max(0, Math.min(1, curvature + uniform(-0.12, 0.12)));
        const phase = ((layer % 2) * step) / 2 - Math.PI / 2;
        for (let rep = 0; rep < symmetry; rep++) {
            const angle = phase + rep * step;
            paths.push({ d: petal(start, end, half, angle, curve), layer });
            for (let detail = 1; detail < complexity; detail++) {
                const inner = start + 2.4 * detail;
                const outer = end - 2.4 * detail;
                const width = half * (1 - 0.32 * detail);
                if (outer - inner >= 6 && 2 * middle * Math.sin(width) >= 4) {
                    paths.push({ d: petal(inner, outer, width, angle, curve), layer });
                }
            }
        }
        if (layer < layers - 1) circles.push(10 + (layer + 1) * band);
    }
    return { paths, circles };
}

const hero = heroMandala();

const projectFacts = [
    { label: "Type", value: "Personal generative-design project", tone: "saffron" },
    { label: "Stack", value: "Python 3.11 · standard library only", tone: "sage" },
    { label: "Output", value: "A4 / Letter SVG + JSON recipe", tone: "rose" },
    { label: "Status", value: "Milestone 6 · awaiting human review", tone: "sky" },
];

const versions = [
    {
        version: "1.0.0",
        name: "Sampled polar petals",
        text: "Petal sides follow a powered sine profile in polar coordinates, sampled at 96 points per outline. A local 32-bit LCG varies width and curvature per band.",
    },
    {
        version: "2.0.0",
        name: "Floral redesign",
        text: "Native SVG cubic Bézier curves: a central flower, staggered lotus contours, pointed arches and a scalloped border. Shared boundaries are drawn once.",
    },
    {
        version: "3.0.0",
        name: "Easy · Medium · Advanced",
        text: "Designed difficulty profiles built from sector constructions: equal-circle lenses, star polygons, connected facets and fan tracery.",
    },
];

const testFiles = [
    { file: "test_difficulty.py", count: 13 },
    { file: "test_ornamental.py", count: 10 },
    { file: "test_mandala.py", count: 7 },
    { file: "test_floral.py", count: 7 },
    { file: "test_contact.py", count: 7 },
    { file: "test_artifact_preservation.py", count: 4 },
    { file: "test_export_robustness.py", count: 3 },
    { file: "test_preview_svg.py", count: 3 },
    { file: "test_project_setup.py", count: 1 },
];

const codeExcerpt = `def petal(inner, outer, half_angle, angle, curvature):
    # At both ends sin(pi*t) is zero: the two sides meet at closed tips.
    points = []
    for side, samples in ((1, range(49)), (-1, range(47, 0, -1))):
        for sample in samples:
            t = sample / 48
            radius = inner + (outer - inner) * t
            profile = math.sin(math.pi * t) ** (1.35 - 0.75 * curvature)
            theta = angle + side * half_angle * profile
            points.append((radius * math.cos(theta), radius * math.sin(theta)))
    return tuple(points)`;
---

<html lang="en">
    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <div class="breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span aria-hidden="true">→</span>
                    <strong>Mandala & Coloring Puzzle Generator</strong>
                </div>

                <div class="paper-board">
                    <div class="hero-copy">
                        <p class="board-eyebrow">Personal project · Python · Printable geometry</p>
                        <h1>
                            <span class="h1-small">Mathematical</span>
                            <span class="h1-big">Mandala &amp; Coloring</span>
                            <span class="h1-script">puzzle generator</span>
                        </h1>
                        <p class="hero-subtitle">
                            A dependency-free Python tool that builds original,
                            reproducible colouring pages from polar geometry.
                            Every page carries the exact recipe that made it.
                        </p>
                        <div class="hero-actions">
                            <a class="ink-btn" href="#colour">Colour a real page <span aria-hidden="true">↓</span></a>
                            <a class="paper-btn" href="#generator">Try the generator</a>
                        </div>
                    </div>

                    <figure class="hero-art" aria-label="A twelve-fold mandala drawn from the first-mandala recipe">
                        <svg viewBox="-92 -92 184 184" role="img" aria-labelledby="hero-art-title">
                            <title id="hero-art-title">Twelve-fold radial mandala from presets/first-mandala.json</title>
                            <g class="hero-spin">
                                {hero.circles.map((r, i) => (
                                    <circle cx="0" cy="0" r={r.toFixed(2)} pathLength="1" style={`--i: ${i}`} />
                                ))}
                                {hero.paths.map((p, i) => (
                                    <path d={p.d} pathLength="1" class={`layer-${p.layer}`} style={`--i: ${(i % 24) / 6 + p.layer}`} />
                                ))}
                            </g>
                        </svg>
                        <figcaption>seed 20261010 · symmetry 12 · layers 4</figcaption>
                    </figure>
                </div>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "python",
                        "generative-art",
                        "computational-geometry",
                        "svg",
                        "system-architecture",
                        "output-validation",
                        "iterative-development",
                        "documentation",
                    ]}
                />
            </header>

            <section class="facts" aria-label="Project information">
                {projectFacts.map((fact) => (
                    <article class={`fact tone-${fact.tone}`}>
                        <span>{fact.label}</span>
                        <strong>{fact.value}</strong>
                    </article>
                ))}
            </section>

            <section class="case-section" id="colour" aria-labelledby="mg-colour">
                <div class="section-heading">
                    <p class="eyebrow">01 — Colour it in</p>
                    <h2 id="mg-colour">These are the real SVG pages.</h2>
                    <p>
                        Each design below is a file from the repository,
                        loaded unchanged. Pick a colour and click or tap any
                        region. The page detects every enclosed region in the
                        line art, so you can test whether the outlines really
                        close.
                    </p>
                </div>

                <div class="colour-studio">
                    <div class="design-picker" role="radiogroup" aria-label="Choose a design">
                        <label><input type="radio" name="design" value="easy" checked /><span>Easy</span></label>
                        <label><input type="radio" name="design" value="medium" /><span>Medium</span></label>
                        <label><input type="radio" name="design" value="advanced" /><span>Advanced</span></label>
                        <label><input type="radio" name="design" value="floral" /><span>Floral v2</span></label>
                        <label><input type="radio" name="design" value="first" /><span>First mandala v1</span></label>
