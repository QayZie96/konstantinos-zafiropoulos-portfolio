                            </div>
                            <div class="tool-row">
                                <button type="button" class="ink-btn small save-btn">Download PNG</button>
                                <a class="paper-btn small master-link" href="/images/projects/mandala-generator/mandala-easy.svg" target="_blank" rel="noopener">Open SVG master</a>
                            </div>

                            <div class="provenance">
                                <p class="design-kind">Generator v3.0.0 · Easy</p>
                                <p class="hash-check" aria-live="polite"></p>
