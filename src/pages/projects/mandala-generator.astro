</html>

<script>
    /* =========================================================
       VERSION-1 GENERATOR (port of geometry.py, config.py, svg.py)
       ========================================================= */

    type Recipe = {
        complexity: number;
        curvature: number;
        generator_id: string;
        generator_version: string;
        layers: number;
        margin_mm: number;
        page_size: "A4" | "Letter";
        seed: number;
        spacing_mm: number;
        stroke_mm: number;
        symmetry: number;
    };

    const PAGE_SIZES = { A4: [210, 297], Letter: [215.9, 279.4] } as const;
    const DEFAULT_RECIPE: Recipe = {
        complexity: 2,
        curvature: 0.75,
        generator_id: "radial-mandala",
        generator_version: "1.0.0",
        layers: 4,
        margin_mm: 15.0,
        page_size: "A4",
        seed: 20261010,
        spacing_mm: 2.5,
        stroke_mm: 0.45,
        symmetry: 12,
    };

    function validateRecipe(c: Recipe): string | null {
        if (!Number.isInteger(c.seed) || c.seed < 0 || c.seed > 4294967295) return "seed must be an integer from 0 to 4294967295";
        const [w, h] = PAGE_SIZES[c.page_size];
        const radius = Math.min(w, h) / 2 - c.margin_mm - c.stroke_mm;
        const band = (radius - 10) / c.layers;
        const middle = 10 + band / 2;
        const half = Math.min((Math.PI / c.symmetry) * 0.82, Math.PI / c.symmetry - c.spacing_mm / (2 * middle));
        if (2 * middle * Math.sin(half) * 0.9 < 5) return "This symmetry/layers/spacing combination leaves petals below 5 mm wide";
        if (band - c.spacing_mm < 10) return "Layers and spacing must leave at least 10 mm of radial coloring space";
        return null;
    }

    function petal(inner: number, outer: number, half: number, angle: number, curvature: number) {
        const pts: [number, number][] = [];
        const exponent = 1.35 - 0.75 * curvature;
        const add = (side: number, sample: number) => {
            const t = sample / 48;
            const r = inner + (outer - inner) * t;
            const theta = angle + side * half * Math.sin(Math.PI * t) ** exponent;
            pts.push([r * Math.cos(theta), r * Math.sin(theta)]);
        };
        for (let s = 0; s < 49; s++) add(1, s);
        for (let s = 47; s > 0; s--) add(-1, s);
        return pts;
    }

    function generate(c: Recipe) {
        let state = c.seed;
        // Local 32-bit LCG, as in SeededRandom.
        const uniform = (low: number, high: number) => {
            state = Number((1664525n * BigInt(state) + 1013904223n) % 4294967296n);
            return low + ((high - low) * state) / 4294967296;
        };
        const [w, h] = PAGE_SIZES[c.page_size];
        const radius = Math.min(w, h) / 2 - c.margin_mm - c.stroke_mm;
        const band = (radius - 10) / c.layers;
        const petals: [number, number][][] = [];
        const circles = [3.5, 9.0, radius];
        const step = (2 * Math.PI) / c.symmetry;
        for (let layer = 0; layer < c.layers; layer++) {
            const start = 10 + layer * band + c.spacing_mm / 2;
            const end = 10 + (layer + 1) * band - c.spacing_mm / 2;
            const middle = (start + end) / 2;
            let half = Math.min(step * 0.41, step / 2 - c.spacing_mm / (2 * middle));
            half *= uniform(0.9, 1.0);
            const curve = Math.max(0, Math.min(1, c.curvature + uniform(-0.12, 0.12)));
            const phase = ((layer % 2) * step) / 2 - Math.PI / 2;
            for (let rep = 0; rep < c.symmetry; rep++) {
                const angle = phase + rep * step;
                petals.push(petal(start, end, half, angle, curve));
                for (let detail = 1; detail < c.complexity; detail++) {
                    const inner = start + 2.4 * detail;
                    const outer = end - 2.4 * detail;
                    const width = half * (1 - 0.32 * detail);
                    if (outer - inner >= 6 && 2 * middle * Math.sin(width) >= 4) petals.push(petal(inner, outer, width, angle, curve));
                }
            }
            if (layer < c.layers - 1) circles.push(10 + (layer + 1) * band);
        }
        return { petals, circles, width: w, height: h };
    }

    // Python's f"{v:.5f}" keeps the sign of negative values that round to zero.
    const f5 = (v: number) => {
        const s = v.toFixed(5);
        return (Object.is(v, -0) || v < 0) && s[0] !== "-" ? `-${s}` : s;
    };

    function recipeJson(c: Recipe) {
        const floats = ["curvature", "margin_mm", "spacing_mm", "stroke_mm"];
        const keys = Object.keys(DEFAULT_RECIPE).sort() as (keyof Recipe)[];
        const body = keys
            .map((k) => {
                const v = c[k];
                if (typeof v === "string") return `  "${k}": ${JSON.stringify(v)}`;
                return `  "${k}": ${floats.includes(k) && Number.isInteger(v) ? v.toFixed(1) : String(v)}`;
            })
            .join(",\n");
        return `{\n${body}\n}\n`;
    }

    function renderSvg(c: Recipe) {
        const geo = generate(c);
        const { width: w, height: h } = geo;
        const lines = [
            '<?xml version="1.0" encoding="utf-8"?>',
            `<svg xmlns="http://www.w3.org/2000/svg" width="${w}mm" height="${h}mm" viewBox="0 0 ${w} ${h}" version="1.1">`,
            "  <title>Rocketeers radial mandala</title>",
            `  <metadata>${recipeJson(c)}</metadata>`,
            `  <rect width="${w}" height="${h}" fill="white" />`,
            `  <g transform="translate(${w / 2} ${h / 2})" fill="none" stroke="black" stroke-width="${c.stroke_mm}" stroke-linejoin="round" stroke-linecap="round">`,
        ];
        for (const r of geo.circles) lines.push(`    <circle cx="0" cy="0" r="${f5(r)}" />`);
        for (const p of geo.petals) lines.push(`    <path d="M ${p.map(([x, y]) => `${f5(x)} ${f5(y)}`).join(" L ")} Z" />`);
        lines.push("  </g>", "</svg>");
        return lines.join("\n") + "\n";
    }

    async function sha256(text: string | ArrayBuffer) {
        if (!crypto?.subtle) return null;
        const bytes = typeof text === "string" ? new TextEncoder().encode(text) : text;
        const digest = await crypto.subtle.digest("SHA-256", bytes);
        return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
    }

    /* =========================================================
       COLOURING STUDIO
       ========================================================= */

    type Design = { id: string; file?: string; text?: string; symmetry: number; sha?: string; kind: string };

    const BASE = "/images/projects/mandala-generator/";
    // Baselines pinned in tests/test_artifact_preservation.py.
    const DESIGNS: Design[] = [
        { id: "easy", file: "mandala-easy.svg", symmetry: 8, kind: "Generator v3.0.0 · Easy profile", sha: "27f0ec81397501a4501caeedeeb6875c3d2e087b262fa396e458e163746baa30" },
        { id: "medium", file: "mandala-medium.svg", symmetry: 8, kind: "Generator v3.0.0 · Medium profile", sha: "240ec659906e3e822504c151abb2d4641e0f3c6f7de56f64f058187f7f6d2ebe" },
        { id: "advanced", file: "mandala-advanced.svg", symmetry: 8, kind: "Generator v3.0.0 · Advanced profile", sha: "823af8cb163601b1cd1e6c6433f48d5e16ee18ed2412d2af7080ecc836665e16" },
        { id: "floral", file: "floral-mandala.svg", symmetry: 10, kind: "Generator v2.0.0 · floral redesign", sha: "16c775135f664d401fcd1d40b3c99793ce500828686d368e59fef1aac18b4f00" },
        { id: "first", file: "first-mandala.svg", symmetry: 12, kind: "Generator v1.0.0 · first mandala", sha: "24a4ad325d374cf0aebcfd111197cd07d47333d248c43ba3729d3051d0c77b5a" },
        { id: "rosette", file: "rosette-garden-03.svg", symmetry: 4, kind: "Fixed artwork · Milestone 6C (not generator output)", sha: "71ae8214cd3235cdcfd55d362bc78bf898a7085d8bf1c8a68628053c23a1c969" },
    ];

    const PALETTE = [
        ["Terracotta", "#e2725b"],
        ["Saffron", "#f2b134"],
        ["Butter", "#f7e08a"],
        ["Sage", "#8fb996"],
        ["Teal", "#2a9d8f"],
        ["Sky", "#7cc4e8"],
        ["Indigo", "#3d5a98"],
        ["Lavender", "#b9a3e3"],
        ["Rose", "#e07a9b"],
        ["Blush", "#f6c1c7"],
        ["Cocoa", "#8a5a44"],
        ["Eraser", "#ffffff"],
    ];

    const studio = document.querySelector<HTMLElement>(".colour-studio");
    const small = window.matchMedia("(max-width: 700px), (pointer: coarse)").matches;
    const N = small ? 1000 : 1400;
    let loadCustom: ((text: string, symmetry: number) => void) | null = null;

    if (studio) {
        const canvas = studio.querySelector<HTMLCanvasElement>(".colour-canvas")!;
        const ctx = canvas.getContext("2d", { willReadFrequently: true })!;
        const sheet = studio.querySelector<HTMLElement>(".sheet")!;
        const cursor = studio.querySelector<HTMLElement>(".kb-cursor")!;
        const status = studio.querySelector<HTMLElement>(".colour-status")!;
        const undoBtn = studio.querySelector<HTMLButtonElement>(".undo-btn")!;
        const symToggle = studio.querySelector<HTMLInputElement>(".sym-toggle")!;
        const symOrder = studio.querySelector<HTMLElement>(".sym-order")!;
        const kindEl = studio.querySelector<HTMLElement>(".design-kind")!;
        const hashEl = studio.querySelector<HTMLElement>(".hash-check")!;
        const recipeEl = studio.querySelector<HTMLElement>(".recipe-code")!;
        const masterLink = studio.querySelector<HTMLAnchorElement>(".master-link")!;
        const swatchGrid = studio.querySelector<HTMLElement>(".swatch-grid")!;
        const colourInput = studio.querySelector<HTMLInputElement>(".colour-input")!;

        canvas.width = N;
        canvas.height = N;

        let current = { name: "Terracotta", rgb: [226, 114, 91] as number[] };
        const hexToRgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));

        // Swatches are radio buttons so they work with arrow keys.
        PALETTE.forEach(([name, hex], i) => {
            const label = document.createElement("label");
            label.className = "swatch";
            label.title = name;
            label.style.setProperty("--c", hex);
            label.innerHTML = `<input type="radio" name="swatch" value="${hex}" ${i === 0 ? "checked" : ""} aria-label="${name}"><span></span>`;
            swatchGrid.append(label);
            label.querySelector("input")!.addEventListener("change", () => {
                current = { name, rgb: hexToRgb(hex) };
            });
        });
        colourInput.addEventListener("input", () => {
            swatchGrid.querySelectorAll<HTMLInputElement>("input").forEach((el) => (el.checked = false));
            current = { name: `custom ${colourInput.value}`, rgb: hexToRgb(colourInput.value) };
        });

        let lineLayer: HTMLCanvasElement | null = null;
        let labels = new Int32Array(0);
        let offsets = new Int32Array(0);
        let members = new Int32Array(0);
        let regionCount = 0;
        let colours = new Int32Array(0); // packed RGB, -1 = unfilled
        let fill: ImageData | null = null;
        let history: { label: number; prev: number }[][] = [];
        let symmetry = 8;
        let loadToken = 0;
        let kx = N / 2;
        let ky = N * 0.3;

        const compose = () => {
            if (!fill || !lineLayer) return;
            ctx.globalCompositeOperation = "source-over";
            ctx.putImageData(fill, 0, 0);
            ctx.globalCompositeOperation = "multiply";
            ctx.drawImage(lineLayer, 0, 0);
            ctx.globalCompositeOperation = "source-over";
        };

        const paint = (label: number, packed: number) => {
            if (!fill) return;
            const d = fill.data;
            const r = packed < 0 ? 255 : (packed >> 16) & 255;
            const g = packed < 0 ? 255 : (packed >> 8) & 255;
            const b = packed < 0 ? 255 : packed & 255;
            for (let k = offsets[label]; k < offsets[label + 1]; k++) {
                const o = members[k] * 4;
                d[o] = r;
                d[o + 1] = g;
                d[o + 2] = b;
            }
        };

        // Rasterise the SVG, then label every 4-connected region bounded by ink.
        async function prepare(svgText: string, token: number) {
            const doc = new DOMParser().parseFromString(svgText, "image/svg+xml");
            const svg = doc.documentElement;
            const [, , vw, vh] = (svg.getAttribute("viewBox") || "0 0 210 297").split(/[\s,]+/).map(Number);
            const R = Math.min(vw, vh) / 2 - 10;
            svg.setAttribute("viewBox", `${vw / 2 - R} ${vh / 2 - R} ${2 * R} ${2 * R}`);
            svg.setAttribute("width", String(N));
            svg.setAttribute("height", String(N));
            const blob = new Blob([new XMLSerializer().serializeToString(svg)], { type: "image/svg+xml" });
            const url = URL.createObjectURL(blob);
            const img = new Image();
            img.src = url;
            await img.decode();
            URL.revokeObjectURL(url);
            if (token !== loadToken) return false;

            const layer = document.createElement("canvas");
            layer.width = N;
            layer.height = N;
            const lctx = layer.getContext("2d", { willReadFrequently: true })!;
            lctx.fillStyle = "#fff";
            lctx.fillRect(0, 0, N, N);
            lctx.drawImage(img, 0, 0, N, N);
            const px = lctx.getImageData(0, 0, N, N).data;
            const total = N * N;
            const barrier = new Uint8Array(total);
            for (let i = 0; i < total; i++) {
                const o = i * 4;
                barrier[i] = px[o] * 0.299 + px[o + 1] * 0.587 + px[o + 2] * 0.114 < 170 ? 1 : 0;
            }
            await new Promise((r) => setTimeout(r, 0));

            const lab = new Int32Array(total).fill(-1);
            const stack = new Int32Array(total);
            let count = 0;
            for (let seed = 0; seed < total; seed++) {
                if (barrier[seed] || lab[seed] !== -1) continue;
                let top = 0;
                stack[top++] = seed;
                lab[seed] = count;
                while (top) {
                    const p = stack[--top];
                    const x = p % N;
                    if (x > 0 && !barrier[p - 1] && lab[p - 1] === -1) { lab[p - 1] = count; stack[top++] = p - 1; }
                    if (x < N - 1 && !barrier[p + 1] && lab[p + 1] === -1) { lab[p + 1] = count; stack[top++] = p + 1; }
                    if (p >= N && !barrier[p - N] && lab[p - N] === -1) { lab[p - N] = count; stack[top++] = p - N; }
                    if (p < total - N && !barrier[p + N] && lab[p + N] === -1) { lab[p + N] = count; stack[top++] = p + N; }
                }
                count++;
            }
            await new Promise((r) => setTimeout(r, 0));
            if (token !== loadToken) return false;

            // Hand each ink pixel to its nearest region so fills run under the lines.
            let head = 0;
            let tail = 0;
            for (let i = 0; i < total; i++) if (lab[i] !== -1) stack[tail++] = i;
            while (head < tail) {
                const p = stack[head++];
                const l = lab[p];
                const x = p % N;
                if (x > 0 && lab[p - 1] === -1) { lab[p - 1] = l; stack[tail++] = p - 1; }
                if (x < N - 1 && lab[p + 1] === -1) { lab[p + 1] = l; stack[tail++] = p + 1; }
                if (p >= N && lab[p - N] === -1) { lab[p - N] = l; stack[tail++] = p - N; }
                if (p < total - N && lab[p + N] === -1) { lab[p + N] = l; stack[tail++] = p + N; }
            }

            const off = new Int32Array(count + 1);
            for (let i = 0; i < total; i++) if (lab[i] >= 0) off[lab[i] + 1]++;
            for (let i = 0; i < count; i++) off[i + 1] += off[i];
            const cursorPos = off.slice(0, count);
            const mem = new Int32Array(total);
            for (let i = 0; i < total; i++) if (lab[i] >= 0) mem[cursorPos[lab[i]]++] = i;

            lineLayer = layer;
            labels = lab;
            offsets = off;
            members = mem;
            regionCount = count;
            colours = new Int32Array(count).fill(-1);
            fill = new ImageData(N, N);
            fill.data.fill(255);
            history = [];
            undoBtn.disabled = true;
            compose();
            return true;
        }

        const applyFills = (targets: number[], packed: number) => {
            const action: { label: number; prev: number }[] = [];
            for (const label of targets) {
                if (colours[label] === packed) continue;
                action.push({ label, prev: colours[label] });
                colours[label] = packed;
                paint(label, packed);
            }
            if (action.length) {
                history.push(action);
                undoBtn.disabled = false;
                compose();
            }
            return action.length;
        };

        const fillAt = (x: number, y: number) => {
            if (!fill) return;
            const ix = Math.max(0, Math.min(N - 1, Math.round(x)));
            const iy = Math.max(0, Math.min(N - 1, Math.round(y)));
            const targets = new Set<number>();
            const order = symToggle.checked ? symmetry : 1;
            for (let j = 0; j < order; j++) {
                const a = (2 * Math.PI * j) / order;
                const dx = ix - N / 2;
                const dy = iy - N / 2;
                const rx = Math.round(N / 2 + dx * Math.cos(a) - dy * Math.sin(a));
                const ry = Math.round(N / 2 + dx * Math.sin(a) + dy * Math.cos(a));
                if (rx < 0 || ry < 0 || rx >= N || ry >= N) continue;
                const label = labels[ry * N + rx];
                if (label >= 0) targets.add(label);
            }
            const [r, g, b] = current.rgb;
            const packed = (r << 16) | (g << 8) | b;
            const changed = applyFills([...targets], packed);
            const pixels = [...targets].reduce((sum, l) => sum + offsets[l + 1] - offsets[l], 0);
            status.textContent = changed
                ? `Filled ${changed} region${changed > 1 ? "s" : ""} (${pixels.toLocaleString("en-GB")} px) with ${current.name}.`
                : "That region already has this colour.";
        };

        canvas.addEventListener("click", (event) => {
            const rect = canvas.getBoundingClientRect();
            fillAt(((event.clientX - rect.left) / rect.width) * N, ((event.clientY - rect.top) / rect.height) * N);
        });

        const placeCursor = () => {
            cursor.style.left = `${(kx / N) * 100}%`;
            cursor.style.top = `${(ky / N) * 100}%`;
        };
        canvas.addEventListener("keydown", (event) => {
            const stepPx = N / (event.shiftKey ? 120 : 40);
            const moves: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
            if (moves[event.key]) {
                event.preventDefault();
                kx = Math.max(0, Math.min(N - 1, kx + moves[event.key][0] * stepPx));
                ky = Math.max(0, Math.min(N - 1, ky + moves[event.key][1] * stepPx));
                placeCursor();
            } else if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                fillAt(kx, ky);
            }
        });
        placeCursor();

        undoBtn.addEventListener("click", () => {
            const action = history.pop();
            if (!action) return;
            for (const { label, prev } of action) {
                colours[label] = prev;
                paint(label, prev);
            }
            compose();
            undoBtn.disabled = history.length === 0;
            status.textContent = `Undid ${action.length} fill${action.length > 1 ? "s" : ""}.`;
        });

        studio.querySelector(".reset-btn")?.addEventListener("click", () => {
            const filled = [];
            for (let l = 0; l < regionCount; l++) if (colours[l] !== -1) filled.push(l);
            if (!filled.length) return;
            const action = filled.map((label) => ({ label, prev: colours[label] }));
            for (const label of filled) {
                colours[label] = -1;
                paint(label, -1);
            }
            history.push(action);
            undoBtn.disabled = false;
            compose();
            status.textContent = "Page cleared. Undo brings the colours back.";
        });

        // Colour every region by its distance from the centre: symmetric by construction.
        studio.querySelector(".auto-btn")?.addEventListener("click", () => {
            if (!fill) return;
            const outer = labels[0];
            const ring = PALETTE.slice(0, 10).map(([, hex]) => hexToRgb(hex));
            const offsetPick = Math.floor(Math.random() * ring.length);
            const groups = new Map<number, number[]>();
            for (let l = 0; l < regionCount; l++) {
                const size = offsets[l + 1] - offsets[l];
                if (l === outer || size < 12) continue;
                let sx = 0;
                let sy = 0;
                for (let k = offsets[l]; k < offsets[l + 1]; k += 7) {
                    sx += members[k] % N;
                    sy += Math.floor(members[k] / N);
                }
                const n = Math.ceil(size / 7);
                const dist = Math.hypot(sx / n - N / 2, sy / n - N / 2) / (N / 2);
                const band = Math.round(dist * 26);
                if (!groups.has(band)) groups.set(band, []);
                groups.get(band)!.push(l);
            }
            const action: { label: number; prev: number }[] = [];
            [...groups.keys()].sort((a, b) => a - b).forEach((band, i) => {
                const [r, g, b] = ring[(i + offsetPick) % ring.length];
                const packed = (r << 16) | (g << 8) | b;
                for (const label of groups.get(band)!) {
                    action.push({ label, prev: colours[label] });
                    colours[label] = packed;
                    paint(label, packed);
                }
            });
            history.push(action);
            undoBtn.disabled = false;
            compose();
            status.textContent = `Auto-coloured ${action.length.toLocaleString("en-GB")} regions in rings. Undo to revert.`;
        });

        studio.querySelector(".save-btn")?.addEventListener("click", () => {
            canvas.toBlob((blob) => {
                if (!blob) return;
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                link.href = url;
                link.download = "my-coloured-mandala.png";
                document.body.append(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(url), 4000);
            }, "image/png");
        });

        async function load(design: Design) {
            const token = ++loadToken;
            sheet.classList.add("is-loading");
            status.textContent = "Loading the page…";
            symmetry = design.symmetry;
            symOrder.textContent = `(×${design.symmetry})`;
            kindEl.textContent = design.kind;
            hashEl.textContent = "";
            try {
                let text = design.text ?? "";
                if (design.file) {
                    masterLink.hidden = false;
                    masterLink.href = BASE + design.file;
                    const buffer = await (await fetch(BASE + design.file)).arrayBuffer();
                    text = new TextDecoder().decode(buffer);
                    const hash = await sha256(buffer);
                    if (token !== loadToken) return;
                    if (hash && design.sha) {
                        hashEl.innerHTML =
                            hash === design.sha
                                ? `<span class="ok">✓</span> SHA-256 <code>${hash.slice(0, 12)}…</code> matches the hash pinned in <code>tests/test_artifact_preservation.py</code>.`
                                : `<span class="bad">✗</span> SHA-256 <code>${hash.slice(0, 12)}…</code> differs from the pinned baseline.`;
                    }
                } else {
                    masterLink.hidden = true;
                    hashEl.textContent = "Generated in this browser by the version-1 port.";
                }
                const meta = new DOMParser().parseFromString(text, "image/svg+xml");
                recipeEl.textContent =
                    meta.querySelector("metadata")?.textContent?.trim() ||
                    `No recipe: fixed artwork.\n\n${meta.querySelector("desc")?.textContent?.trim() ?? ""}`;
                const ok = await prepare(text, token);
                if (!ok) return;
                sheet.classList.remove("is-loading");
                status.textContent = `Ready: ${regionCount.toLocaleString("en-GB")} enclosed regions detected. Pick a colour and click a region.`;
            } catch (error) {
                sheet.classList.remove("is-loading");
                status.textContent = `Could not load this design: ${(error as Error).message}`;
            }
        }

        let customDesign: Design | null = null;
        const radios = studio.querySelectorAll<HTMLInputElement>("input[name=design]");
        radios.forEach((radio) => {
            radio.addEventListener("change", () => {
                if (!radio.checked) return;
                const design = radio.value === "custom" ? customDesign : DESIGNS.find((d) => d.id === radio.value);
                if (design) load(design);
            });
        });

        loadCustom = (text: string, order: number) => {
            customDesign = { id: "custom", text, symmetry: order, kind: "Generated just now · v1.0.0 port" };
            const custom = studio.querySelector<HTMLElement>(".custom-design")!;
            custom.hidden = false;
            const radio = custom.querySelector<HTMLInputElement>("input")!;
            radio.checked = true;
            load(customDesign);
            document.querySelector("#colour")?.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        };

        const io = new IntersectionObserver(
            (entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                    io.disconnect();
                    load(DESIGNS[0]);
                }
            },
            { rootMargin: "500px" },
        );
        io.observe(studio);
    }

    /* =========================================================
       GENERATOR UI
       ========================================================= */

    const gen = document.querySelector<HTMLElement>(".gen-grid");
    if (gen) {
        const recipe: Recipe = { ...DEFAULT_RECIPE };
        let lastValid = "";
        const paper = gen.querySelector<HTMLElement>(".gen-paper")!;
        const errorEl = gen.querySelector<HTMLElement>(".gen-error")!;
        const jsonEl = gen.querySelector<HTMLElement>(".gen-json")!;
        const verifyEl = gen.querySelector<HTMLElement>(".verify-result")!;
        const seedInput = gen.querySelector<HTMLInputElement>(".seed-input")!;
        const pageSelect = gen.querySelector<HTMLSelectElement>(".page-select")!;
        const caption = gen.querySelector<HTMLElement>(".gen-caption")!;
        const sliders = gen.querySelectorAll<HTMLInputElement>("input[type=range][data-key]");

        const sync = () => {
            sliders.forEach((s) => {
                const key = s.dataset.key as keyof Recipe;
                s.value = String(recipe[key]);
                gen.querySelector(`output[data-for="${key}"]`)!.textContent = String(recipe[key]);
            });
            seedInput.value = String(recipe.seed);
            pageSelect.value = recipe.page_size;
        };

        let frame = 0;
        const update = () => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
                const error = validateRecipe(recipe);
                jsonEl.textContent = recipeJson(recipe);
                if (error) {
                    errorEl.textContent = `ValueError: ${error}`;
                    errorEl.hidden = false;
                    paper.classList.add("is-invalid");
                    return;
                }
                errorEl.hidden = true;
                paper.classList.remove("is-invalid");
                lastValid = renderSvg(recipe);
                paper.innerHTML = lastValid.replace(/^<\?xml[^>]*>\s*/, "");
                const svg = paper.querySelector("svg");
                if (svg) {
                    svg.removeAttribute("width");
                    svg.removeAttribute("height");
                    svg.setAttribute("role", "img");
                    svg.setAttribute("aria-label", `Generated ${recipe.symmetry}-fold mandala with ${recipe.layers} layers on ${recipe.page_size} paper`);
                }
                const geo = generate(recipe);
                caption.textContent = `${recipe.page_size} page · ${geo.petals.length} closed petals · ${geo.circles.length} circles · ${(lastValid.length / 1024).toFixed(0)} KB SVG`;
            });
        };

        sliders.forEach((slider) => {
            slider.addEventListener("input", () => {
                const key = slider.dataset.key as keyof Recipe;
                (recipe as Record<string, unknown>)[key] = Number(slider.value);
                gen.querySelector(`output[data-for="${key}"]`)!.textContent = slider.value;
                verifyEl.textContent = "";
                update();
            });
        });

        seedInput.addEventListener("input", () => {
            recipe.seed = seedInput.value.trim() === "" ? NaN : Number(seedInput.value);
            verifyEl.textContent = "";
            update();
        });

        pageSelect.addEventListener("change", () => {
            recipe.page_size = pageSelect.value as Recipe["page_size"];
            update();
        });

        gen.querySelector(".random-seed")?.addEventListener("click", () => {
            const buffer = new Uint32Array(1);
            crypto.getRandomValues(buffer);
            recipe.seed = buffer[0];
            seedInput.value = String(buffer[0]);
            verifyEl.textContent = "";
            update();
        });

        gen.querySelector(".gen-reset")?.addEventListener("click", () => {
            Object.assign(recipe, DEFAULT_RECIPE);
            sync();
            verifyEl.textContent = "";
            update();
        });

        gen.querySelector(".gen-download")?.addEventListener("click", () => {
            if (validateRecipe(recipe)) return;
            const blob = new Blob([renderSvg(recipe)], { type: "image/svg+xml" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url;
            link.download = `mandala-s${recipe.symmetry}-l${recipe.layers}-seed${recipe.seed}.svg`;
            document.body.append(link);
            link.click();
            link.remove();
            setTimeout(() => URL.revokeObjectURL(url), 4000);
        });

        gen.querySelector(".gen-colour")?.addEventListener("click", () => {
            if (validateRecipe(recipe) || !loadCustom) return;
            loadCustom(renderSvg(recipe), recipe.symmetry);
        });

        gen.querySelector(".gen-verify")?.addEventListener("click", async () => {
            Object.assign(recipe, DEFAULT_RECIPE);
            sync();
            update();
            verifyEl.textContent = "Fetching the repository file…";
            try {
                const reference = (await (await fetch("/images/projects/mandala-generator/first-mandala.svg")).text()).replace(/\r\n/g, "\n");
                const generated = renderSvg(recipe);
                const [refHash, genHash] = await Promise.all([sha256(reference), sha256(generated)]);
                const same = reference === generated;
                verifyEl.innerHTML = same
                    ? `<span class="ok">✓ Identical.</span> ${generated.length.toLocaleString("en-GB")} bytes${genHash ? `, SHA-256 <code>${genHash.slice(0, 16)}…</code>` : ""}, the same as <code>outputs/first-mandala.svg</code>${refHash === genHash ? "" : " (hash differs!)"}.`
                    : `<span class="bad">✗ Different</span> from the repository file (${generated.length} vs ${reference.length} bytes).`;
            } catch (error) {
                verifyEl.textContent = `Verification failed: ${(error as Error).message}`;
            }
        });

        sync();
        update();
    }
</script>

