    const root = document.querySelector<HTMLElement>(".playground");
    if (root) {
        const canvas = root.querySelector<HTMLCanvasElement>(".wall-canvas")!;
        const ctx = canvas.getContext("2d")!;
        const stage = root.querySelector<HTMLElement>(".stage")!;
        const progress = root.querySelector<HTMLProgressElement>(".render-progress")!;
        const status = root.querySelector<HTMLElement>(".render-status")!;
        const seedRow = root.querySelector<HTMLElement>(".seed-row")!;
        const seedInput = root.querySelector<HTMLInputElement>(".seed-input")!;
        const seedError = root.querySelector<HTMLElement>(".seed-error")!;
        const presetName = root.querySelector<HTMLElement>(".preset-name")!;
        const paletteRow = root.querySelector<HTMLElement>(".palette-row")!;
        const paletteSelect = root.querySelector<HTMLSelectElement>(".palette-select")!;
        const resSelect = root.querySelector<HTMLSelectElement>(".res-select")!;
        const juliaSelect = root.querySelector<HTMLSelectElement>(".julia-select")!;
        const jsonCode = root.querySelector<HTMLElement>(".preset-json")!;
        const compareToggle = root.querySelector<HTMLInputElement>(".compare-toggle")!;
        const compareSlider = root.querySelector<HTMLInputElement>(".compare-slider")!;
        const compareSliderLabel = root.querySelector<HTMLElement>(".compare-slider-label")!;
        const compareImg = root.querySelector<HTMLImageElement>(".compare-img")!;
        const compareLine = root.querySelector<HTMLElement>(".compare-line")!;
        const compareTags = root.querySelectorAll<HTMLElement>(".compare-tag");
        const compareNote = root.querySelector<HTMLElement>(".compare-note")!;
        const mobileRadio = root.querySelector<HTMLInputElement>("input[name=target][value=mobile]")!;
        const sliders = root.querySelectorAll<HTMLInputElement>("input[type=range][data-key]");
        let lastRender = { points: 0, ms: 0 };

        JULIA.forEach((cfg, i) => juliaSelect.append(new Option(cfg.name, String(i))));

        if (isSmallDevice) {
            root.querySelector<HTMLInputElement>('[data-key="iterations"]')!.max = String(POINT_CAP);
            root.querySelector<HTMLInputElement>('[data-key="flame_steps"]')!.max = "240";
        }

        const formatValue = (key: string, value: number) => {
            if (["iterations", "particles", "steps", "flame_steps", "julia_iterations", "falloff"].includes(key)) return value.toLocaleString("en-GB");
            if (key === "glow") return String(value);
            if (key === "step_size" || key === "c_re" || key === "c_im") return value.toFixed(3);
            if (key === "initial_extent") return value.toFixed(1);
            return value.toFixed(2);
        };

        const setOutput = (key: string, value: number) => {
            const out = root.querySelector<HTMLOutputElement>(`output[data-for="${key}"]`);
            if (out) out.textContent = formatValue(key, value);
        };

        const isClassic = () => state.family === "strange_attractor" || state.family === "particle_flow_field";

        const dims = (): [number, number] => {
            if (!isClassic()) return [state.res, Math.floor((state.res * 9) / 16)];
            const [sw, sh] = COMPOSITION[state.target];
            const scale = state.res / Math.max(sw, sh);
            return [Math.max(1, Math.round(sw * scale)), Math.max(1, Math.round(sh * scale))];
        };

        const currentJulia = (): JuliaCfg => {
            const base = JULIA[state.julia];
            const p = state.params.julia_filigree;
            const views = base.views.map((view, i) => (i === 0 ? { ...view, angle: p.view_angle, span: p.span } : view));
            return { ...base, c: [p.c_re, p.c_im], iterations: p.julia_iterations, falloff: p.falloff, views };
        };

        const isUnmodifiedPreset = () => {
            const params = state.params[state.family];
            if (state.family === "julia_filigree") {
                const ref = juliaParams(JULIA[state.julia]);
                return Object.entries(ref).every(([k, value]) => params[k] === value);
            }
            const preset = PRESETS[state.family];
            const sameParams = Object.entries(preset.params).every(([k, value]) => k === "flame_steps" || params[k] === value);
            if (state.family === "fractal_flame") return sameParams && state.seeds.fractal_flame === preset.seed;
            return sameParams && state.seeds[state.family] === preset.seed && state.palette === preset.palette && state.glow === preset.glow;
        };

        const displayName = () => {
            const base = state.family === "julia_filigree" ? `Filigree ${JULIA[state.julia].name}` : PRESETS[state.family].name;
            return isUnmodifiedPreset() ? base : `Modified from ${base}`;
        };

        const settingsJson = () => {
            const p = state.params[state.family];
            if (state.family === "julia_filigree") {
                const { name, ...cfg } = currentJulia();
                return { study: name, supersampling: 2, ...cfg };
            }
            if (state.family === "fractal_flame") {
                return {
                    kind: "flame",
                    seed: state.seeds.fractal_flame,
                    span: SILVER.span,
                    angle: p.angle,
                    weights: SILVER.weights,
                    transforms: SILVER.transforms,
                    steps: p.flame_steps,
                    gamma: SILVER.gamma,
                    toe: SILVER.toe,
                    gain: p.gain,
                    detail: SILVER.detail,
                    minimum_sigma: SILVER.minimum_sigma,
                    maximum_sigma: SILVER.maximum_sigma,
                    arc_quiet: SILVER.arc_quiet,
                    nexus_light: SILVER.nexus_light,
                    layered_color: true,
                    gold_gain: p.gold_gain,
                };
            }
            const parameters =
                state.family === "strange_attractor"
                    ? { system: "clifford", a: p.a, b: p.b, c: p.c, d: p.d }
                    : { system: "trigonometric", frequency: p.frequency, phase: p.phase, step_size: p.step_size, initial_extent: p.initial_extent };
            const budget = state.family === "strange_attractor" ? p.iterations : p.particles * p.steps;
            return {
                schema_version: 1,
                name: isUnmodifiedPreset() ? PRESETS[state.family].name : `Playground ${state.family === "strange_attractor" ? "Clifford" : "Flow"} ${state.seeds[state.family]}`,
                family: state.family,
                seed: state.seeds[state.family],
                parameters,
                composition: { desktop: { width: 3840, height: 2160 }, mobile: { width: 1440, height: 3120 } },
                budgets: { preview: budget, final: Math.max(5000000, budget) },
            };
        };

        const compareSource = (): string | null => {
            if (!isUnmodifiedPreset()) return null;
            if (state.family === "strange_attractor" && state.target === "desktop" && state.res === 1280) return `${IMG}clifford-foundation-01-desktop.webp`;
            if (state.family === "particle_flow_field" && state.target === "desktop" && state.res === 1280) return `${IMG}flow-foundation-01-desktop.webp`;
            if (state.family === "fractal_flame") return `${IMG}v1-ethereal-silver.webp`;
            if (state.family === "julia_filigree" && state.julia === 0) return state.res === 800 ? `${IMG}filigree-01-diadem-800.webp` : `${IMG}v1-filigree-diadem.webp`;
            return null;
        };

        const updateCompare = () => {
            const source = compareSource();
            compareToggle.disabled = !source;
            compareNote.textContent = source
                ? "Drag the divider: the live render is on the left, the repository's image on the right."
                : "Available for the original presets: Clifford and Flow at 1280 px desktop, Ethereal Silver and Filigree Diadem.";
            const show = !!source && compareToggle.checked;
            if (source && compareImg.getAttribute("src") !== source) compareImg.src = source;
            compareImg.hidden = !show;
            compareLine.hidden = !show;
            compareTags.forEach((tag) => (tag.hidden = !show));
            compareSliderLabel.hidden = !show;
            stage.style.setProperty("--split", `${compareSlider.value}%`);
        };

        const refreshMeta = () => {
            presetName.textContent = displayName();
            jsonCode.textContent = JSON.stringify(settingsJson(), null, 2);
            updateCompare();
        };

        const syncControls = () => {
            const params = state.params[state.family];
            root.querySelector<HTMLInputElement>(`input[name=family][value=${state.family}]`)!.checked = true;
            root.querySelectorAll<HTMLElement>(".param-group").forEach((group) => {
                group.hidden = group.dataset.family !== state.family;
            });
            sliders.forEach((slider) => {
                const key = slider.dataset.key!;
                const value = key === "glow" ? state.glow : params[key];
                if (value === undefined) return;
                slider.value = String(value);
                setOutput(key, value);
            });
            seedRow.hidden = state.family === "julia_filigree";
            seedInput.value = String(state.seeds[state.family]);
            seedError.hidden = true;
            paletteRow.hidden = !isClassic();
            paletteSelect.value = state.palette;
            juliaSelect.value = String(state.julia);
            mobileRadio.disabled = !isClassic();
            if (!isClassic()) {
                state.target = "desktop";
                root.querySelector<HTMLInputElement>("input[name=target][value=desktop]")!.checked = true;
            }
            resSelect.replaceChildren(
                ...RES_OPTIONS[state.family].map((res) => new Option(`${res} px${res === DEFAULT_RES[state.family] ? " (default)" : ""}`, String(res))),
            );
            resSelect.value = String(state.res);
            refreshMeta();
        };

        let debounce = 0;
        const scheduleRender = (delay = 140) => {
            window.clearTimeout(debounce);
            refreshMeta();
            debounce = window.setTimeout(render, delay);
        };

        async function render() {
            const token = ++renderToken;
            const [w, h] = dims();
            canvas.width = w;
            canvas.height = h;
            stage.dataset.target = state.target;
            ctx.fillStyle = "#000";
            ctx.fillRect(0, 0, w, h);
            progress.value = 0;
            stage.classList.add("is-rendering");
            status.textContent = "Rendering…";
            const t0 = performance.now();
            const p = state.params[state.family];
            const seed = state.seeds[state.family];
            const palette = PALETTES[state.palette];
            const ms = () => Math.round(performance.now() - t0).toLocaleString("en-GB");
            try {
                let summary = "";
                if (state.family === "strange_attractor") {
                    const iterations = Math.min(p.iterations, POINT_CAP);
                    const set = await computeAttractor(p, seed, iterations, token, (f) => (progress.value = f * 35));
                    if (!set) return;
                    transformInPlace(set, w, h, 0.12);
                    await drawPoints(ctx, set, w, h, palette.color, palette.accent, state.glow, token, (f) => (progress.value = 35 + f * 65));
                    summary = `${iterations.toLocaleString("en-GB")} points`;
                } else if (state.family === "particle_flow_field") {
                    let steps = p.steps;
                    if (p.particles * steps > POINT_CAP) steps = Math.max(1, Math.floor(POINT_CAP / p.particles));
                    const set = await computeFlow(p, seed, p.particles, steps, token, (f) => (progress.value = f * 35));
                    if (!set) return;
                    transformInPlace(set, w, h, 0.09);
                    await drawLines(ctx, set, palette.color, palette.accent, state.glow, token, (f) => (progress.value = 35 + f * 65));
                    summary = `${(p.particles * steps).toLocaleString("en-GB")} points`;
                } else if (state.family === "fractal_flame") {
                    const sampler = new FlameSampler(w, seed, p.angle);
                    const total = p.flame_steps + 30;
                    let previewed = false;
                    let last = performance.now();
                    while (sampler.step < total) {
                        sampler.advance();
                        if (performance.now() - last > 40) {
                            progress.value = (sampler.step / total) * 88;
                            if (!previewed && sampler.step > 30 + p.flame_steps * 0.3) {
                                previewed = true;
                                ctx.putImageData(new ImageData(flameFinish(sampler.hist, w, h, p.gain, p.gold_gain), w, h), 0, 0);
                            }
                            await nextFrame();
                            if (token !== renderToken) return;
                            last = performance.now();
                        }
                    }
                    ctx.putImageData(new ImageData(flameFinish(sampler.hist, w, h, p.gain, p.gold_gain), w, h), 0, 0);
                    summary = `${(32768 * p.flame_steps).toLocaleString("en-GB")} samples`;
                } else {
                    const image = await renderJulia(currentJulia(), w, token, (f) => (progress.value = f * 100));
                    if (!image) return;
                    ctx.putImageData(image, 0, 0);
                    summary = `${(w * 2 * h * 2).toLocaleString("en-GB")} sample points`;
                }
                if (token !== renderToken) return;
                lastRender = { points: 0, ms: 0 };
                progress.value = 100;
                stage.classList.remove("is-rendering");
                const capped = state.family === "strange_attractor" ? p.iterations > POINT_CAP : state.family === "particle_flow_field" && p.particles * p.steps > POINT_CAP;
                status.textContent = `Rendered ${summary} at ${w} × ${h} in ${ms()} ms${capped ? " (capped on this device)" : ""}.`;
            } catch (error) {
                stage.classList.remove("is-rendering");
                status.textContent = `Engine error: ${(error as Error).message}`;
            }
        }

        root.querySelectorAll<HTMLInputElement>("input[name=family]").forEach((radio) => {
            radio.addEventListener("change", () => {
                if (!radio.checked) return;
                state.family = radio.value as Family;
                state.res = DEFAULT_RES[state.family];
                if (isClassic()) {
                    state.palette = PRESETS[state.family].palette;
                    state.glow = PRESETS[state.family].glow;
                }
                syncControls();
                scheduleRender(0);
            });
        });

        root.querySelector(".reset-preset")?.addEventListener("click", () => {
            if (state.family === "julia_filigree") {
                state.params.julia_filigree = juliaParams(JULIA[state.julia]);
            } else {
                const preset = PRESETS[state.family];
                state.params[state.family] = { ...preset.params };
                state.seeds[state.family] = preset.seed;
                if (isClassic()) {
                    state.palette = preset.palette;
                    state.glow = preset.glow;
                }
            }
            syncControls();
            scheduleRender(0);
        });

        juliaSelect.addEventListener("change", () => {
            state.julia = Number(juliaSelect.value);
            state.params.julia_filigree = juliaParams(JULIA[state.julia]);
            syncControls();
            scheduleRender(0);
        });

        sliders.forEach((slider) => {
            slider.addEventListener("input", () => {
                const key = slider.dataset.key!;
                const value = Number(slider.value);
                if (key === "glow") state.glow = value;
                else state.params[state.family][key] = value;
                setOutput(key, value);
                scheduleRender(isClassic() ? 140 : 300);
            });
        });

        seedInput.addEventListener("input", () => {
            const raw = seedInput.value.trim();
            const value = Number(raw);
            if (raw === "" || !Number.isInteger(value) || value < 0 || value > MAX_SEED) {
                seedError.textContent = `seed must be an integer between 0 and ${MAX_SEED}`;
                seedError.hidden = false;
                return;
            }
            seedError.hidden = true;
            state.seeds[state.family] = value;
            scheduleRender(300);
        });

        root.querySelector(".random-seed")?.addEventListener("click", () => {
            const buffer = new Uint32Array(1);
            crypto.getRandomValues(buffer);
            state.seeds[state.family] = buffer[0];
            seedInput.value = String(buffer[0]);
            seedError.hidden = true;
            scheduleRender(0);
        });

        paletteSelect.addEventListener("change", () => {
            state.palette = paletteSelect.value;
            scheduleRender(0);
        });

        root.querySelectorAll<HTMLInputElement>("input[name=target]").forEach((radio) => {
            radio.addEventListener("change", () => {
                if (!radio.checked) return;
                state.target = radio.value as "desktop" | "mobile";
                scheduleRender(0);
            });
        });

        resSelect.addEventListener("change", () => {
            state.res = Number(resSelect.value);
            scheduleRender(0);
        });

        compareToggle.addEventListener("change", updateCompare);
        compareSlider.addEventListener("input", updateCompare);

        root.querySelector(".download-btn")?.addEventListener("click", () => {
            canvas.toBlob((blob) => {
                if (!blob) return;
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                const slug = displayName().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
                link.href = url;
                link.download = `${slug}-${canvas.width}x${canvas.height}.png`;
                document.body.append(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(url), 4000);
                status.textContent = `Saved a ${canvas.width} × ${canvas.height} PNG.`;
            }, "image/png");
        });

        root.querySelector(".copy-btn")?.addEventListener("click", async () => {
            const text = JSON.stringify(settingsJson(), null, 2) + "\n";
            try {
                await navigator.clipboard.writeText(text);
                status.textContent = "Settings JSON copied to the clipboard.";
            } catch {
                root.querySelector<HTMLDetailsElement>(".json-panel")!.open = true;
                status.textContent = "Clipboard unavailable: the settings are shown below.";
            }
        });

        const rngCheck = document.querySelector<HTMLElement>(".rng-check");
        if (rngCheck) {
            const value = new PCG64(12345).random();
            const ok = value === 0.22733602246716966 && new FastPCG64(12345).random() === value;
            rngCheck.innerHTML = ok
                ? `<span class="ok">✓</span> <code>default_rng(12345).random()</code> = <code>${value}</code>, as in NumPy.`
                : `<span class="bad">✗</span> RNG self-check failed.`;
        }

        void lastRender;
        state.res = DEFAULT_RES[state.family];
        syncControls();

        const io = new IntersectionObserver(
            (entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                    io.disconnect();
                    render();
                }
            },
            { rootMargin: "400px" },
        );
        io.observe(root);
    }

    /* =========================================================
       HERO — the Clifford preset accumulating behind the title
       ========================================================= */

    const heroCanvas = document.querySelector<HTMLCanvasElement>(".hero-canvas");
    if (heroCanvas) {
        const hctx = heroCanvas.getContext("2d")!;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const total = isSmallDevice ? 60000 : 140000;
        const rng = new PCG64(1729);
        let x = rng.uniform(-0.5, 0.5);
        let y = rng.uniform(-0.5, 0.5);
        const [a, b, c, d] = [-1.4, 1.6, 1.0, 0.7];
        const W = heroCanvas.width, H = heroCanvas.height;
        const sx = (W * 0.86) / 4, sy = (H * 0.86) / 3.4;
        const from: RGB = [24, 126, 255], to: RGB = [232, 60, 184];
        let drawn = 0;
        hctx.fillStyle = "#000";
        hctx.fillRect(0, 0, W, H);
        hctx.globalCompositeOperation = "lighter";
        const batch = reduce ? total : 1800;
        const tick = () => {
            const end = Math.min(total, drawn + batch);
            const [r, g, bl] = lerpColor(from, to, drawn / total);
            hctx.fillStyle = `rgba(${r},${g},${bl},0.32)`;
            for (; drawn < end; drawn++) {
                const nx = Math.sin(a * y) + c * Math.cos(a * x);
                const ny = Math.sin(b * x) + d * Math.cos(b * y);
                x = nx;
                y = ny;
                hctx.fillRect(W / 2 + x * sx, H / 2 - y * sy, 1, 1);
            }
            if (drawn < total) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
    }
</script>

<style>
    :root {
        --bg: #06111e;
        --surface: #091b2b;
        --border: #203f59;
        --heading: #ffffff;
        --text: #d8e4ee;
        --muted: #9eb1c0;
        --subtle: #7890a3;
        --blue: #168dff;
        --blue-light: #65baff;
        --orange: #ff8a00;
        --page-width: 1240px;

        --o-black: #000000;
        --o-blue: rgb(24, 126, 255);
        --o-magenta: rgb(232, 60, 184);
        --o-teal: rgb(20, 220, 188);
        --o-amber: rgb(255, 154, 46);
        --o-silver: #cfe3f2;
        --o-line: rgba(255, 255, 255, 0.1);
        --o-mono: "Cascadia Code", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; background: var(--bg); }

    body {
        min-height: 100vh;
        margin: 0;
        color: var(--text);
        background:
            radial-gradient(circle at 85% 4%, rgba(232, 60, 184, 0.09), transparent 28rem),
            radial-gradient(circle at 8% 45%, rgba(20, 220, 188, 0.05), transparent 30rem),
            var(--bg);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    main,
    footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;
        padding-inline: clamp(1rem, 5vw, 4.5rem);
    }

    a { color: inherit; text-underline-offset: 0.25em; }
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    summary:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }

    h1, h2, h3, p { margin-top: 0; }

    h2 {
        margin-bottom: 1rem;
        color: var(--heading);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.2rem, 5vw, 4rem);
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -0.05em;
    }

    h3 { color: var(--heading); font-size: 1.2rem; }

    code { font-family: var(--o-mono); font-size: 0.88em; color: #bfe9ff; overflow-wrap: anywhere; }

    [hidden] { display: none !important; }

    .eyebrow {
        margin-bottom: 1rem;
        color: var(--orange);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    /* =========================================================
       HERO
       ========================================================= */

    .hero { padding: clamp(3rem, 6vw, 4.5rem) 0; }

    .breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 2rem;
        color: var(--subtle);
        font-size: 0.8rem;
    }

    .breadcrumbs a { text-decoration: none; }
    .breadcrumbs a:hover { color: white; }
    .breadcrumbs strong { color: var(--o-teal); }

    .oled-board {
        position: relative;
        overflow: hidden;
        min-height: clamp(420px, 52vw, 560px);
        margin-bottom: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 26px;
        background: var(--o-black);
        box-shadow: 0 0 0 1px rgba(24, 126, 255, 0.15), 0 30px 80px -30px rgba(232, 60, 184, 0.35);
    }

    .hero-canvas {
        position: absolute;
        top: 50%;
        right: -6%;
        width: min(78%, 900px);
        height: auto;
        transform: translateY(-50%);
        animation: breathe 14s ease-in-out infinite alternate;
    }

    .hero-copy {
        position: relative;
        z-index: 1;
        max-width: 580px;
        padding: clamp(2rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 4rem);
    }

    .board-eyebrow {
        display: inline-block;
        margin-bottom: 1.4rem;
        padding: 0.4rem 0.85rem;
        border: 1px solid rgba(20, 220, 188, 0.5);
        border-radius: 999px;
        color: var(--o-teal);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: rgba(0, 0, 0, 0.6);
    }

    .oled-board h1 {
        display: flex;
        flex-direction: column;
        margin: 0 0 1.3rem;
        color: white;
        font-size: clamp(2.6rem, 7vw, 5.2rem);
        font-weight: 850;
        line-height: 0.98;
        letter-spacing: -0.045em;
    }

    .h1-neon {
        background: linear-gradient(90deg, var(--o-blue), var(--o-magenta) 60%, var(--o-amber));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 0 18px rgba(232, 60, 184, 0.35));
    }

    .hero-subtitle {
        max-width: 500px;
        margin-bottom: 1.4rem;
        color: #c9d6e2;
        font-size: clamp(1rem, 2vw, 1.15rem);
        line-height: 1.65;
        text-shadow: 0 1px 12px #000, 0 0 2px #000;
    }

    .equation {
        display: inline-flex;
        flex-direction: column;
        gap: 0.2rem;
        margin-bottom: 1.6rem;
        padding: 0.7rem 0.95rem;
        border-left: 2px solid var(--o-magenta);
        background: rgba(0, 0, 0, 0.65);
        color: #f1d7ff;
        font-family: var(--o-mono);
        font-size: clamp(0.78rem, 2vw, 0.92rem);
    }

    .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }

    .hero-cta,
    .hero-ghost {
        display: block;
        width: fit-content;
        padding: 0.75rem 1.2rem;
        border-radius: 999px;
        color: white;
        font-weight: 800;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .hero-cta {
        background: linear-gradient(90deg, var(--o-blue), var(--o-magenta));
        box-shadow: 0 0 24px rgba(232, 60, 184, 0.45);
    }

    .hero-ghost { border: 1px solid rgba(255, 255, 255, 0.3); background: rgba(0, 0, 0, 0.55); }
    .hero-cta:hover { transform: translateY(-3px); box-shadow: 0 0 34px rgba(232, 60, 184, 0.7); }
    .hero-ghost:hover { transform: translateY(-3px); border-color: var(--o-teal); }

    @keyframes breathe {
        from { transform: translateY(-50%) scale(1) rotate(0deg); }
        to { transform: translateY(-50%) scale(1.06) rotate(-2.5deg); }
    }

    .hero :global(.skill-links) { justify-content: flex-start; }

    /* =========================================================
       FACTS
       ========================================================= */

    .facts {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        padding-bottom: clamp(3.5rem, 7vw, 5rem);
    }

    .fact {
        padding: 1.1rem 1.2rem;
        border: 1px solid var(--o-line);
        border-radius: 14px;
        background: linear-gradient(160deg, rgba(24, 126, 255, 0.09), rgba(0, 0, 0, 0.6));
        transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .fact:hover { transform: translateY(-3px); border-color: rgba(20, 220, 188, 0.6); }

    .fact span {
        display: block;
        margin-bottom: 0.45rem;
        color: var(--o-teal);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .fact strong { color: white; font-size: 0.95rem; line-height: 1.45; }

    /* =========================================================
       SECTIONS
       ========================================================= */

    .case-section {
        padding: clamp(4rem, 8vw, 6.5rem) 0;
        border-top: 1px solid rgba(32, 63, 89, 0.8);
    }

    .section-heading { max-width: 830px; }
    .centered-heading { margin-inline: auto; text-align: center; }
    .section-heading > p:last-child { color: var(--muted); line-height: 1.7; }

    .panel {
        padding: clamp(1.3rem, 3vw, 1.9rem);
        border: 1px solid var(--o-line);
        border-radius: 16px;
        background: rgba(0, 0, 0, 0.55);
        transition: border-color 0.25s ease;
    }

    .panel:hover { border-color: rgba(24, 126, 255, 0.55); }
    .panel p { color: var(--muted); line-height: 1.7; }
    .panel p:last-child { margin-bottom: 0; }
    .small { font-size: 0.85rem; }

    /* =========================================================
       VOLUME 1 VIEWER
       ========================================================= */

    .v1-viewer {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.8fr);
        gap: clamp(1rem, 2.5vw, 1.8rem);
        margin-top: 2.2rem;
        padding: clamp(0.9rem, 2.5vw, 1.6rem);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        background: var(--o-black);
        box-shadow: 0 30px 80px -40px rgba(207, 227, 242, 0.35);
    }

    .v1-stage {
        position: relative;
        display: grid;
        place-items: center;
        min-width: 0;
        min-height: clamp(220px, 34vw, 470px);
        border-radius: 16px;
        background: #030304;
    }

    .v1-desktop { width: 100%; }

    .v1-main {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
    }

    .v1-phone {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
    }

    .v1-portrait {
        display: block;
        width: auto;
        height: min(92%, 440px);
        max-width: 60%;
        aspect-ratio: 9 / 16;
        object-fit: cover;
        border: 6px solid #1b1d24;
        border-radius: 28px;
        box-shadow: 0 0 0 1px #2a2d38, 0 20px 50px rgba(0, 0, 0, 0.7);
        transform: rotate(-2deg);
    }

    .v1-stage[data-mode="phone"] .v1-desktop { opacity: 0; }
    .v1-stage[data-mode="phone"] .v1-phone { opacity: 1; }
    .v1-desktop { transition: opacity 0.4s ease; }

    .v1-stage.is-swapping .v1-main,
    .v1-stage.is-swapping .v1-portrait { animation: swap-in 0.6s ease both; }

    @keyframes swap-in {
        from { opacity: 0; transform: scale(1.02); }
        to { opacity: 1; transform: scale(1); }
    }

    .v1-stage.is-swapping .v1-portrait { animation-name: swap-in-phone; }

    @keyframes swap-in-phone {
        from { opacity: 0; transform: rotate(-2deg) translateY(10px); }
        to { opacity: 1; transform: rotate(-2deg) translateY(0); }
    }

    .v1-info { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
    .v1-index { margin: 0.4rem 0 0; color: var(--subtle); font-family: var(--o-mono); font-size: 0.8rem; }
    .v1-title { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 400; letter-spacing: -0.03em; }
    .v1-method { margin: 0; color: var(--o-silver); font-size: 0.85rem; font-weight: 700; }
    .v1-detail { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.65; }

    .v1-score { display: grid; gap: 0.4rem; margin-top: auto; padding-top: 0.6rem; }
    .v1-score > span:first-child { color: var(--subtle); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }
    .v1-score .bar { position: relative; height: 10px; border-radius: 999px; background: #15171d; }

    .v1-score i {
        display: block;
        width: var(--score);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--o-blue), var(--o-silver));
        transition: width 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .v1-score b { position: absolute; top: -4px; bottom: -4px; left: 85%; width: 2px; background: var(--o-amber); }
    .v1-score strong { color: white; font-family: var(--o-mono); font-size: 1.1rem; }

    .v1-thumbs {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 0.6rem;
    }

    .v1-thumb {
        display: grid;
        gap: 0.35rem;
        padding: 0;
        border: 0;
        background: none;
        color: var(--muted);
        font: inherit;
        font-size: 0.74rem;
        text-align: left;
        cursor: pointer;
    }

    .v1-thumb img {
        display: block;
        width: 100%;
        height: auto;
        border: 2px solid transparent;
        border-radius: 10px;
        opacity: 0.6;
        transition: opacity 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    }

    .v1-thumb:hover img { opacity: 1; transform: translateY(-2px); }
    .v1-thumb[aria-pressed="true"] img { opacity: 1; border-color: var(--o-silver); }
    .v1-thumb[aria-pressed="true"] { color: white; }

    .deliverables {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.2rem;
    }

    .deliverables article {
        padding: 1rem 1.2rem;
        border: 1px solid var(--o-line);
        border-radius: 14px;
        background: rgba(0, 0, 0, 0.5);
    }

    .deliverables strong { display: block; color: var(--o-silver); font-family: Georgia, serif; font-size: 2rem; font-weight: 400; }
    .deliverables span { color: var(--muted); font-size: 0.82rem; }

    /* =========================================================
       PLAYGROUND
       ========================================================= */

    .playground {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.85fr);
        gap: clamp(1rem, 2.5vw, 1.8rem);
        margin-top: 2.2rem;
        padding: clamp(0.9rem, 2.5vw, 1.6rem);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        background: var(--o-black);
        box-shadow: 0 30px 80px -40px rgba(24, 126, 255, 0.45);
    }

    .stage-wrap { min-width: 0; }

    .stage {
        --split: 50%;
        display: grid;
        place-items: center;
        min-height: clamp(240px, 38vw, 520px);
        padding: clamp(0.6rem, 2vw, 1.2rem);
        border-radius: 18px;
        background: radial-gradient(circle at 50% 40%, rgba(24, 126, 255, 0.08), transparent 70%), #050507;
    }

    .device {
        position: relative;
        overflow: hidden;
        width: 100%;
        border: 3px solid #1b1d24;
        border-radius: 12px;
        background: #000;
        box-shadow: 0 0 0 1px #2a2d38, 0 18px 40px rgba(0, 0, 0, 0.6);
        transition: width 0.35s ease, border-radius 0.35s ease;
    }

    .stage[data-target="mobile"] .device { width: min(46%, 300px); border-width: 6px; border-radius: 30px; }

    .wall-canvas,
    .compare-img { display: block; width: 100%; height: auto; }

    .stage.is-rendering .device { box-shadow: 0 0 0 1px rgba(20, 220, 188, 0.5), 0 0 30px rgba(20, 220, 188, 0.15); }

    .compare-img { position: absolute; inset: 0; height: 100%; object-fit: cover; clip-path: inset(0 0 0 var(--split)); }

    .compare-line {
        position: absolute;
        top: 0;
        bottom: 0;
        left: var(--split);
        width: 2px;
        background: white;
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
        pointer-events: none;
    }

    .compare-tag {
        position: absolute;
        top: 0.5rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.75);
        color: white;
        font-size: 0.68rem;
        font-weight: 700;
    }

    .compare-tag-js { left: 0.5rem; }
    .compare-tag-py { right: 0.5rem; }

    .render-progress {
        display: block;
        width: 100%;
        height: 4px;
        margin-top: 0.8rem;
        border: 0;
        border-radius: 999px;
        overflow: hidden;
        appearance: none;
        background: #15171d;
    }

    .render-progress::-webkit-progress-bar { background: #15171d; }
    .render-progress::-webkit-progress-value { background: linear-gradient(90deg, var(--o-teal), var(--o-blue), var(--o-magenta)); }
    .render-progress::-moz-progress-bar { background: linear-gradient(90deg, var(--o-teal), var(--o-blue), var(--o-magenta)); }

    .render-status { margin: 0.6rem 0 0; color: var(--muted); font-family: var(--o-mono); font-size: 0.78rem; }

    .compare-box { margin-top: 1rem; padding: 0.85rem 1rem; border: 1px dashed rgba(255, 255, 255, 0.16); border-radius: 12px; }
    .compare-box .check { display: flex; align-items: center; gap: 0.6rem; color: white; font-size: 0.88rem; cursor: pointer; }
    .compare-box .check input { width: 18px; height: 18px; accent-color: var(--o-teal); }
    .compare-box .check:has(input:disabled) { opacity: 0.55; cursor: not-allowed; }
    .compare-slider-label { display: grid; gap: 0.3rem; margin-top: 0.7rem; color: var(--muted); font-size: 0.78rem; }
    .compare-note { margin: 0.5rem 0 0; color: var(--subtle); font-size: 0.78rem; line-height: 1.5; }

    .controls { display: flex; flex-direction: column; gap: 0.95rem; min-width: 0; color: var(--text); }

    .segmented {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.35rem;
        margin: 0;
        padding: 0.3rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
    }

    .segmented legend,
    .slider > span,
    .select > span,
    .seed-row label {
        color: var(--subtle);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .segmented legend { padding: 0 0.3rem; }
    .segmented label { position: relative; cursor: pointer; }
    .segmented input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }

    .segmented span {
        display: block;
        padding: 0.55rem 0.4rem;
        border-radius: 9px;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 700;
        text-align: center;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .segmented input:checked + span {
        background: linear-gradient(90deg, rgba(24, 126, 255, 0.35), rgba(232, 60, 184, 0.35));
        color: white;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    }

    .segmented input:disabled + span { opacity: 0.35; }
    .segmented label:has(input:disabled) { cursor: not-allowed; }
    .segmented input:focus-visible + span { outline: 2px solid var(--orange); outline-offset: 2px; }

    .preset-row,
    .seed-row,
    .action-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

    .preset-row { justify-content: space-between; }
    .preset-name { color: white; font-weight: 750; font-size: 0.92rem; }
    .seed-row label { flex-basis: 100%; }

    .seed-input {
        flex: 1 1 120px;
        min-width: 0;
        padding: 0.55rem 0.7rem;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 10px;
        background: #0b0c10;
        color: white;
        font-family: var(--o-mono);
        font-size: 0.92rem;
    }

    .seed-error { margin: -0.4rem 0 0; color: #ff8fa3; font-family: var(--o-mono); font-size: 0.76rem; }

    .ghost-btn,
    .neon-btn {
        padding: 0.55rem 0.85rem;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 10px;
        background: #0e1016;
        color: white;
        font: inherit;
        font-size: 0.82rem;
        font-weight: 750;
        cursor: pointer;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .ghost-btn:hover { border-color: var(--o-teal); transform: translateY(-1px); }

    .neon-btn {
        border-color: transparent;
        background: linear-gradient(90deg, var(--o-blue), var(--o-magenta));
        box-shadow: 0 0 18px rgba(232, 60, 184, 0.35);
    }

    .neon-btn:hover { transform: translateY(-1px); box-shadow: 0 0 26px rgba(232, 60, 184, 0.6); }

    .param-group { display: grid; gap: 0.65rem; }
    .slider { display: grid; gap: 0.25rem; }
    .slider > span { display: flex; justify-content: space-between; gap: 0.5rem; }
    .slider output { color: white; font-family: var(--o-mono); font-size: 0.8rem; letter-spacing: 0; text-transform: none; }
    .slider input { width: 100%; accent-color: var(--o-magenta); }

    .two-col { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 0.8rem; align-items: end; }
    .select { display: grid; gap: 0.3rem; }

    .select select {
        width: 100%;
        padding: 0.55rem 0.6rem;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 10px;
        background: #0b0c10;
        color: white;
        font: inherit;
        font-size: 0.85rem;
    }

    .json-panel { border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; background: #07080b; }
    .json-panel summary { padding: 0.7rem 0.9rem; color: var(--muted); font-size: 0.82rem; font-weight: 700; cursor: pointer; }
    .json-panel pre { max-height: 260px; margin: 0; padding: 0 0.9rem 0.9rem; overflow: auto; font-size: 0.75rem; line-height: 1.5; }

    .port-line { max-width: 900px; margin: 1rem 0 0; color: var(--subtle); font-size: 0.84rem; line-height: 1.6; }
    .rng-check { display: inline; }
    .rng-check :global(.ok) { color: var(--o-teal); font-weight: 900; }
    .rng-check :global(.bad) { color: #ff6b81; font-weight: 900; }

    /* =========================================================
       TIMELINE
       ========================================================= */

    .timeline {
        position: relative;
        display: grid;
        gap: 1.1rem;
        margin: 2.4rem 0 0;
        padding: 0 0 0 2rem;
        list-style: none;
    }

    .timeline::before {
        content: "";
        position: absolute;
        top: 0.4rem;
        bottom: 0.4rem;
        left: 0.45rem;
        width: 2px;
        background: linear-gradient(var(--o-blue), var(--o-magenta) 50%, var(--o-silver));
    }

    .timeline li {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        align-items: center;
        padding: 1.1rem 1.3rem;
        border: 1px solid var(--o-line);
        border-radius: 16px;
        background: rgba(0, 0, 0, 0.5);
        transition: border-color 0.25s ease, transform 0.25s ease;
    }

    .timeline li.has-thumb { grid-template-columns: minmax(0, 1fr) minmax(0, 260px); }
    .timeline li:hover { border-color: rgba(207, 227, 242, 0.45); transform: translateX(4px); }

    .tl-dot {
        position: absolute;
        top: 1.45rem;
        left: -1.95rem;
        width: 14px;
        height: 14px;
        border: 2px solid #000;
        border-radius: 50%;
        background: var(--o-teal);
        box-shadow: 0 0 12px var(--o-teal);
    }

    .timeline li:last-child .tl-dot { background: var(--o-silver); box-shadow: 0 0 16px var(--o-silver); }

    .tl-meta { margin-bottom: 0.35rem; color: var(--subtle); font-size: 0.78rem; }
    .tl-meta time { color: var(--o-amber); font-weight: 800; }
    .timeline h3 { margin-bottom: 0.4rem; font-size: 1.1rem; }
    .timeline article p:last-child { margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.65; }

    .tl-thumb { margin: 0; overflow: hidden; border-radius: 10px; background: #000; }
    .tl-thumb img { display: block; width: 100%; height: auto; transition: transform 0.6s ease; }
    .timeline li:hover .tl-thumb img { transform: scale(1.06); }

    /* =========================================================
       HOW IT WORKS
       ========================================================= */

    .pipeline {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.8rem;
        margin: 2.2rem 0 1.2rem;
        padding: 0;
        list-style: none;
    }

    .pipeline li {
        position: relative;
        display: grid;
        gap: 0.25rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--o-line);
        border-radius: 14px;
        background: rgba(0, 0, 0, 0.5);
    }

    .pipeline li:not(:last-child)::after {
        content: "";
        position: absolute;
        top: 50%;
        right: -0.65rem;
        width: 0.5rem;
        height: 2px;
        background: linear-gradient(90deg, var(--o-blue), var(--o-magenta));
    }

    .pipeline span {
        display: inline-grid;
        place-items: center;
        width: 28px;
        height: 28px;
        margin-bottom: 0.3rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--o-blue), var(--o-magenta));
        color: white;
        font-size: 0.8rem;
        font-weight: 900;
    }

    .pipeline strong { color: white; }
    .pipeline small { color: var(--muted); font-size: 0.8rem; line-height: 1.45; }

    .how-grid,
    .quality-grid,
    .scope-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.2rem;
    }

    .quality-grid,
    .scope-grid { margin-top: 2.2rem; }

    .rule-list { display: grid; gap: 0.45rem; margin: 0; }

    .rule-list div {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 0.8rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--o-line);
        font-size: 0.86rem;
    }

    .rule-list dd { margin: 0; color: var(--muted); }

    .limit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }

    .limit-grid div {
        padding: 0.8rem;
        border: 1px solid rgba(20, 220, 188, 0.25);
        border-radius: 12px;
        background: rgba(20, 220, 188, 0.05);
    }

    .limit-grid strong { display: block; color: var(--o-teal); font-family: var(--o-mono); font-size: 1.05rem; }
    .limit-grid span { color: var(--muted); font-size: 0.78rem; }

    .code-panel { min-width: 0; grid-row: span 2; }

    .code {
        max-width: 100%;
        margin: 0;
        padding: 1rem;
        overflow-x: auto;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        background: #050608;
        font-size: 0.72rem;
        line-height: 1.6;
    }

    .code code { color: #d6e9ff; overflow-wrap: normal; white-space: pre; }

    .tick-list { margin: 0; padding: 0; list-style: none; }
    .tick-list li { position: relative; padding: 0.4rem 0 0.4rem 1.6rem; color: var(--muted); line-height: 1.6; }

    .tick-list li::before {
        content: "";
        position: absolute;
        top: 0.95rem;
        left: 0.2rem;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--o-teal);
        box-shadow: 0 0 10px var(--o-teal);
    }

    /* =========================================================
       QUALITY
       ========================================================= */

    .test-list { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }

    .test-list li {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 2rem;
        gap: 0.7rem;
        align-items: center;
        font-size: 0.8rem;
    }

    .test-count { color: var(--o-teal); font-weight: 800; text-align: right; }

    .test-bar {
