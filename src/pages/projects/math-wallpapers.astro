        { ...JULIA_SHARED, name: "04 · Trefoil", c: [-0.123, 0.745], falloff: 72, color_frequency: 0.055, views: [v(3.35, 1.05, 0.64, 0.5)], cool: [35, 63, 72], warm: [229, 204, 161] },
        { ...JULIA_SHARED, name: "05 · Archipelago", c: [0.285, 0.01], falloff: 95, color_frequency: 0.08, views: [v(3.1, -0.25, 0.63, 0.5)], cool: [60, 64, 84], warm: [234, 211, 189] },
        { ...JULIA_SHARED, name: "06 · Suture", c: [-1.25, 0.05], falloff: 85, color_frequency: 0.045, views: [v(3.4, -0.95, 0.65, 0.5)], cool: [27, 54, 67], warm: [209, 219, 220] },
        { ...JULIA_SHARED, name: "07 · Passage", c: [-0.745, 0.186], falloff: 105, color_frequency: 0.045, views: [v(0.95, 0.05, 0.65, 0.5, -0.75, 0.25)], cool: [22, 70, 83], warm: [227, 211, 177], key: [0.68, 0.47, 0.38, 0.42, 0.35] },
        { ...JULIA_SHARED, name: "08 · Counterpoint", c: [-0.745, 0.186], falloff: 65, color_frequency: 0.06, views: [v(4.3, -0.1, 0.47, 0.69, 0, 0, 0.62), v(3.65, 1.3, 0.76, 0.32)], cool: [34, 76, 86], warm: [232, 207, 158] },
        { ...JULIA_SHARED, name: "09 · Whorl", c: [-0.70176, -0.3842], falloff: 80, color_frequency: 0.05, views: [v(3.2, -0.6, 0.64, 0.5)], cool: [63, 49, 72], warm: [224, 215, 195] },
