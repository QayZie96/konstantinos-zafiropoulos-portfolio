    /* =========================================================
       NUMPY-COMPATIBLE SEEDING (SeedSequence + PCG64)
       ========================================================= */

    const mul32 = (a: number, b: number) => Math.imul(a, b) >>> 0;

    function seedSequenceState(seed: number, words64: number): bigint[] {
        const entropy: number[] = [];
        let s = BigInt(seed);
        if (s === 0n) entropy.push(0);
        while (s > 0n) {
            entropy.push(Number(s & 0xffffffffn));
            s >>= 32n;
        }
        const POOL = 4;
        let hashA = 0x43b0d7e5;
        const hashmix = (value: number) => {
            value = (value ^ hashA) >>> 0;
            hashA = mul32(hashA, 0x931e8875);
            value = mul32(value, hashA);
            return (value ^ (value >>> 16)) >>> 0;
        };
        const mix = (x: number, y: number) => {
            const r = (mul32(0xca01f9dd, x) - mul32(0x4973f715, y)) >>> 0;
            return (r ^ (r >>> 16)) >>> 0;
        };
        const pool: number[] = [];
        for (let i = 0; i < POOL; i++) pool[i] = hashmix(i < entropy.length ? entropy[i] : 0);
        for (let src = 0; src < POOL; src++) {
            for (let dst = 0; dst < POOL; dst++) {
                if (src !== dst) pool[dst] = mix(pool[dst], hashmix(pool[src]));
            }
        }
        for (let src = POOL; src < entropy.length; src++) {
            for (let dst = 0; dst < POOL; dst++) pool[dst] = mix(pool[dst], hashmix(entropy[src]));
        }
        let hashB = 0x8b51f9dd;
        const words: number[] = [];
        for (let i = 0; i < words64 * 2; i++) {
            let value = pool[i % POOL];
            value = (value ^ hashB) >>> 0;
            hashB = mul32(hashB, 0x58f38ded);
            value = mul32(value, hashB);
            words.push((value ^ (value >>> 16)) >>> 0);
        }
        const out: bigint[] = [];
        for (let i = 0; i < words64; i++) out.push((BigInt(words[2 * i + 1]) << 32n) | BigInt(words[2 * i]));
        return out;
    }

    const MASK64 = (1n << 64n) - 1n;
    const MASK128 = (1n << 128n) - 1n;
    const PCG_MULT = (2549297995355413924n << 64n) + 4865540595714422341n;

    class PCG64 {
        state = 0n;
        inc = 0n;
        constructor(seed: number) {
            const v = seedSequenceState(seed, 4);
            this.inc = ((((v[2] << 64n) | v[3]) << 1n) | 1n) & MASK128;
            this.step();
            this.state = (this.state + ((v[0] << 64n) | v[1])) & MASK128;
            this.step();
        }
        step() {
            this.state = (this.state * PCG_MULT + this.inc) & MASK128;
        }
        next64() {
            this.step();
            const s = this.state;
            const x = ((s >> 64n) ^ s) & MASK64;
            const rot = BigInt(Number(s >> 122n));
            return ((x >> rot) | (x << ((64n - rot) & 63n))) & MASK64;
        }
        random() {
            return Number(this.next64() >> 11n) / 9007199254740992;
        }
        uniform(low: number, high: number) {
            return low + (high - low) * this.random();
        }
    }

    // The same generator with the 128-bit state held in 16-bit limbs: identical
    // output, fast enough for the millions of draws a flame needs.
    const toLimbs = (big: bigint) => {
        const limbs = new Float64Array(8);
        for (let i = 0; i < 8; i++) limbs[i] = Number((big >> BigInt(16 * i)) & 0xffffn);
        return limbs;
    };

    class FastPCG64 {
        s: Float64Array;
        incL: Float64Array;
        m = toLimbs(PCG_MULT);
        acc = new Float64Array(8);
        hi = 0;
        lo = 0;
        constructor(seed: number) {
            const ref = new PCG64(seed);
            this.s = toLimbs(ref.state);
            this.incL = toLimbs(ref.inc);
        }
        next64() {
            const s = this.s, m = this.m, acc = this.acc, inc = this.incL;
            for (let k = 0; k < 8; k++) acc[k] = inc[k];
            for (let i = 0; i < 8; i++) {
                const si = s[i];
                if (si === 0) continue;
                for (let j = 0; j < 8 - i; j++) acc[i + j] += si * m[j];
            }
            let carry = 0;
            for (let k = 0; k < 8; k++) {
                const v = acc[k] + carry;
                const low = v % 65536;
                s[k] = low;
                carry = (v - low) / 65536;
            }
            let hi = ((s[7] * 65536 + s[6]) ^ (s[3] * 65536 + s[2])) >>> 0;
            let lo = ((s[5] * 65536 + s[4]) ^ (s[1] * 65536 + s[0])) >>> 0;
            const rot = s[7] >>> 10;
            if (rot >= 32) {
                const t = hi;
                hi = lo;
                lo = t;
            }
            const r = rot & 31;
            if (r) {
                const nh = ((hi >>> r) | (lo << (32 - r))) >>> 0;
                const nl = ((lo >>> r) | (hi << (32 - r))) >>> 0;
                hi = nh;
                lo = nl;
            }
            this.hi = hi;
            this.lo = lo;
        }
        random() {
            this.next64();
            return (this.hi * 2097152 + (this.lo >>> 11)) / 9007199254740992;
        }
    }

