                            <label for="mw-seed">Seed</label>
                            <input id="mw-seed" class="seed-input" type="number" min="0" max="4294967295" step="1" value="1729" inputmode="numeric" />
                            <button type="button" class="ghost-btn random-seed">Random seed</button>
                        </div>
