                            <li>Deterministic compositor with points and lines styles</li>
                            <li><code>mathwall validate</code> and <code>mathwall preview</code> CLI</li>
                            <li>Two candidate presets, two previews, a review rubric and an M1 review</li>
                        </ul>
                    </article>
                    <article class="panel">
                        <h3>Not claimed</h3>
                        <ul>
                            <li>Final-resolution exports or approved artwork</li>
                            <li>A wallpaper collection or anything on sale</li>
                            <li>Physical OLED testing</li>
                            <li>Milestone 2 work, which has not been authorised yet</li>
                        </ul>
                    </article>
                </div>
            </section>

            <section class="case-section skills-section" aria-labelledby="mw-skills">
                <div class="section-heading centered-heading">
                    <p class="eyebrow">06 — Skills demonstrated</p>
                    <h2 id="mw-skills">Reproducible maths, careful limits.</h2>
                    <p>Select any skill to see its evidence across the portfolio.</p>
                </div>

                <SkillLinks
                    skills={[
                        "python",
                        "generative-art",
                        "canvas-graphics",
                        "unit-testing",
                        "data-visualisation",
                        "output-validation",
                        "data-quality",
                        "debugging",
                        "system-architecture",
                        "iterative-development",
                        "documentation",
                        "git-github",
                        "html-css",
                    ]}
                />
            </section>

            <section class="project-end">
                <p class="eyebrow">Portfolio</p>
                <h2>Explore another project.</h2>
                <div class="project-links">
                    <a href="/projects/mandala-generator/">Mandala & Coloring Puzzle Generator <span aria-hidden="true">→</span></a>
                    <a href="/projects/chess-analytics/">Chess analytics <span aria-hidden="true">→</span></a>
                    <a href="/#projects">All projects <span aria-hidden="true">→</span></a>
                </div>
            </section>
        </main>

        <SiteFooter />
    </body>
</html>

<script>
    /* =========================================================
       NUMPY-COMPATIBLE SEEDING (SeedSequence + PCG64)
       Mirrors np.random.default_rng(seed).uniform(low, high).
       ========================================================= */

    const mul32 = (a: number, b: number) => Math.imul(a, b) >>> 0;

    function seedSequenceState(seed: number, words64: number): bigint[] {
        const entropy: number[] = [];
        let s = BigInt(seed);
        if (s === 0n) entropy.push(0);
        while (s > 0n) {
            entropy.push(Number(s & 0xffffffffn));
            s >>= 32n;
        }
        const POOL = 4;
        let hashA = 0x43b0d7e5;
        const hashmix = (value: number) => {
            value = (value ^ hashA) >>> 0;
            hashA = mul32(hashA, 0x931e8875);
            value = mul32(value, hashA);
            return (value ^ (value >>> 16)) >>> 0;
        };
        const mix = (x: number, y: number) => {
            const r = (mul32(0xca01f9dd, x) - mul32(0x4973f715, y)) >>> 0;
            return (r ^ (r >>> 16)) >>> 0;
        };
        const pool: number[] = [];
        for (let i = 0; i < POOL; i++) pool[i] = hashmix(i < entropy.length ? entropy[i] : 0);
        for (let src = 0; src < POOL; src++) {
            for (let dst = 0; dst < POOL; dst++) {
                if (src !== dst) pool[dst] = mix(pool[dst], hashmix(pool[src]));
            }
        }
        for (let src = POOL; src < entropy.length; src++) {
            for (let dst = 0; dst < POOL; dst++) pool[dst] = mix(pool[dst], hashmix(entropy[src]));
        }
        let hashB = 0x8b51f9dd;
        const words: number[] = [];
        for (let i = 0; i < words64 * 2; i++) {
            let value = pool[i % POOL];
            value = (value ^ hashB) >>> 0;
            hashB = mul32(hashB, 0x58f38ded);
            value = mul32(value, hashB);
            words.push((value ^ (value >>> 16)) >>> 0);
        }
        const out: bigint[] = [];
        for (let i = 0; i < words64; i++) out.push((BigInt(words[2 * i + 1]) << 32n) | BigInt(words[2 * i]));
        return out;
    }

    const MASK64 = (1n << 64n) - 1n;
    const MASK128 = (1n << 128n) - 1n;
    const PCG_MULT = (2549297995355413924n << 64n) + 4865540595714422341n;

    class PCG64 {
        state = 0n;
        inc = 0n;
        constructor(seed: number) {
            const v = seedSequenceState(seed, 4);
            this.inc = ((((v[2] << 64n) | v[3]) << 1n) | 1n) & MASK128;
            this.step();
            this.state = (this.state + ((v[0] << 64n) | v[1])) & MASK128;
            this.step();
        }
        step() {
            this.state = (this.state * PCG_MULT + this.inc) & MASK128;
        }
        next64() {
            this.step();
            const s = this.state;
            const x = ((s >> 64n) ^ s) & MASK64;
            const rot = BigInt(Number(s >> 122n));
            return ((x >> rot) | (x << ((64n - rot) & 63n))) & MASK64;
        }
        random() {
            return Number(this.next64() >> 11n) / 9007199254740992;
        }
        uniform(low: number, high: number) {
            return low + (high - low) * this.random();
        }
    }

    /* =========================================================
       PRESETS, PALETTES AND STATE
       ========================================================= */

    type Family = "strange_attractor" | "particle_flow_field";
    type RGB = [number, number, number];

    const PRESETS = {
        strange_attractor: {
            name: "Clifford Foundation 01",
            seed: 1729,
            params: { a: -1.4, b: 1.6, c: 1.0, d: 0.7, iterations: 100000 },
            palette: "clifford",
            glow: 2,
            image: "/images/projects/math-wallpapers/clifford-foundation-01-desktop.webp",
        },
        particle_flow_field: {
            name: "Flow Foundation 01",
            seed: 2718,
            params: { frequency: 2.4, phase: 0.35, step_size: 0.025, initial_extent: 1.6, particles: 400, steps: 250 },
            palette: "flow",
            glow: 1,
            image: "/images/projects/math-wallpapers/flow-foundation-01-desktop.webp",
        },
    } as const;

    const PALETTES: Record<string, { color: RGB; accent: RGB }> = {
        clifford: { color: [24, 126, 255], accent: [232, 60, 184] },
        flow: { color: [20, 220, 188], accent: [255, 154, 46] },
        ice: { color: [150, 205, 255], accent: [235, 250, 255] },
        ember: { color: [255, 64, 32], accent: [255, 214, 92] },
    };

    const COMPOSITION = { desktop: [3840, 2160], mobile: [1440, 3120] } as const;
    const MAX_SEED = 4294967295;

    const isSmallDevice = window.matchMedia("(max-width: 700px), (pointer: coarse)").matches;
    const POINT_CAP = isSmallDevice ? 400000 : 2000000;

    const state = {
        family: "strange_attractor" as Family,
        seeds: { strange_attractor: 1729, particle_flow_field: 2718 } as Record<Family, number>,
        params: {
            strange_attractor: { ...PRESETS.strange_attractor.params },
            particle_flow_field: { ...PRESETS.particle_flow_field.params },
        } as Record<Family, Record<string, number>>,
        palette: "clifford",
        glow: 2,
        target: "desktop" as "desktop" | "mobile",
        res: 1280,
    };

    /* =========================================================
       ENGINES (ports of attractors.py and flow_fields.py)
       ========================================================= */

    const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    let renderToken = 0;

    interface PointSet {
        pts: Float32Array;
        trajectories: number; // 0 for a single attractor trajectory
        steps: number;
        min: [number, number];
        max: [number, number];
    }

    async function computeAttractor(p: Record<string, number>, seed: number, iterations: number, token: number, onProgress: (f: number) => void): Promise<PointSet | null> {
        const rng = new PCG64(seed);
        let x = rng.uniform(-0.5, 0.5);
        let y = rng.uniform(-0.5, 0.5);
        const { a, b, c, d } = p;
        const pts = new Float32Array(iterations * 2);
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        let index = 0;
        while (index < iterations) {
            const end = Math.min(iterations, index + 250000);
            for (; index < end; index++) {
                const nx = Math.sin(a * y) + c * Math.cos(a * x);
                const ny = Math.sin(b * x) + d * Math.cos(b * y);
                if (!Number.isFinite(nx) || !Number.isFinite(ny)) throw new Error(`attractor produced non-finite output at iteration ${index}`);
                pts[index * 2] = nx;
                pts[index * 2 + 1] = ny;
                if (nx < minX) minX = nx;
                if (nx > maxX) maxX = nx;
                if (ny < minY) minY = ny;
                if (ny > maxY) maxY = ny;
                x = nx;
                y = ny;
            }
            onProgress(index / iterations);
            await nextFrame();
            if (token !== renderToken) return null;
        }
        return { pts, trajectories: 0, steps: iterations, min: [minX, minY], max: [maxX, maxY] };
    }

    async function computeFlow(p: Record<string, number>, seed: number, particles: number, steps: number, token: number, onProgress: (f: number) => void): Promise<PointSet | null> {
        const rng = new PCG64(seed);
        const positions = new Float64Array(particles * 2);
        // Row-major fill, exactly like uniform(size=(particle_count, 2)).
        for (let i = 0; i < particles * 2; i++) positions[i] = rng.uniform(-p.initial_extent, p.initial_extent);
        const { frequency, phase, step_size } = p;
        const pts = new Float32Array(particles * steps * 2);
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        const chunk = Math.max(1, Math.floor(200000 / particles));
        for (let step = 0; step < steps; ) {
            const end = Math.min(steps, step + chunk);
            for (; step < end; step++) {
                for (let i = 0; i < particles; i++) {
                    const px = positions[i * 2];
                    const py = positions[i * 2 + 1];
                    let vx = Math.sin(frequency * py + phase);
                    let vy = Math.cos(frequency * px - phase);
                    const speed = Math.hypot(vx, vy);
                    if (speed > 0) {
                        vx /= speed;
                        vy /= speed;
                    }
                    const nx = px + step_size * vx;
                    const ny = py + step_size * vy;
                    if (!Number.isFinite(nx) || !Number.isFinite(ny)) throw new Error(`flow field produced non-finite output at step ${step}`);
                    positions[i * 2] = nx;
                    positions[i * 2 + 1] = ny;
                    const o = (i * steps + step) * 2;
                    pts[o] = nx;
                    pts[o + 1] = ny;
                    if (nx < minX) minX = nx;
                    if (nx > maxX) maxX = nx;
                    if (ny < minY) minY = ny;
                    if (ny > maxY) maxY = ny;
                }
            }
            onProgress(step / steps);
            await nextFrame();
            if (token !== renderToken) return null;
        }
        return { pts, trajectories: particles, steps, min: [minX, minY], max: [maxX, maxY] };
    }

    /* =========================================================
       COMPOSITOR (port of compositor.py)
       ========================================================= */

    function transformInPlace(set: PointSet, width: number, height: number, margin: number) {
        const eps = 2.220446049250313e-16;
        const spanX = Math.max(set.max[0] - set.min[0], eps);
        const spanY = Math.max(set.max[1] - set.min[1], eps);
        const scale = Math.min((width * (1 - 2 * margin)) / spanX, (height * (1 - 2 * margin)) / spanY);
        const cx = (set.min[0] + set.max[0]) / 2;
        const cy = (set.min[1] + set.max[1]) / 2;
        const pts = set.pts;
        for (let i = 0; i < pts.length; i += 2) {
            pts[i] = Math.round((pts[i] - cx) * scale + width * 0.5);
            pts[i + 1] = Math.round(height * 0.5 - (pts[i + 1] - cy) * scale);
        }
    }

    const lerpColor = (from: RGB, to: RGB, f: number): RGB => [0, 1, 2].map((k) => Math.round(from[k] + (to[k] - from[k]) * f)) as RGB;
    const dim = (c: RGB): RGB => c.map((v) => Math.round(v * 0.28)) as RGB;

    function boxBlur(src: Float32Array, w: number, h: number, r: number) {
        const tmp = new Float32Array(src.length);
        const size = 2 * r + 1;
        for (let y = 0; y < h; y++) {
            const row = y * w;
            let acc = 0;
            for (let x = -r; x <= r; x++) acc += src[row + Math.min(w - 1, Math.max(0, x))];
            for (let x = 0; x < w; x++) {
                tmp[row + x] = acc / size;
                acc += src[row + Math.min(w - 1, x + r + 1)] - src[row + Math.max(0, x - r)];
            }
        }
        for (let x = 0; x < w; x++) {
            let acc = 0;
            for (let y = -r; y <= r; y++) acc += tmp[Math.min(h - 1, Math.max(0, y)) * w + x];
            for (let y = 0; y < h; y++) {
                src[y * w + x] = acc / size;
                acc += tmp[Math.min(h - 1, y + r + 1) * w + x] - tmp[Math.max(0, y - r) * w + x];
            }
        }
    }

    // Three box passes approximate Pillow's GaussianBlur(radius=sigma).
    function gaussianApprox(mask: Float32Array, w: number, h: number, sigma: number) {
        const n = 3;
        const ideal = Math.sqrt((12 * sigma * sigma) / n + 1);
        let wl = Math.floor(ideal);
        if (wl % 2 === 0) wl--;
        const wu = wl + 2;
        const m = Math.round((12 * sigma * sigma - n * wl * wl - 4 * n * wl - 3 * n) / (-4 * wl - 4));
        for (let i = 0; i < n; i++) boxBlur(mask, w, h, ((i < m ? wl : wu) - 1) / 2);
    }

    async function drawPoints(ctx: CanvasRenderingContext2D, set: PointSet, w: number, h: number, color: RGB, accent: RGB, glow: number, token: number, onProgress: (f: number) => void) {
        const image = ctx.createImageData(w, h);
        const data = image.data;
        for (let i = 3; i < data.length; i += 4) data[i] = 255;
        const pts = set.pts;
        const n = pts.length / 2;

        if (glow > 0) {
            const mask = new Float32Array(w * h);
            for (let i = 0; i < n; i++) {
                const x = pts[i * 2], y = pts[i * 2 + 1];
                if (x >= 0 && x < w && y >= 0 && y < h) mask[y * w + x] = 255;
            }
            gaussianApprox(mask, w, h, glow);
            const g = dim(color);
            for (let i = 0; i < mask.length; i++) {
                const m = mask[i] / 255;
                if (m > 0.001) {
                    data[i * 4] = g[0] * m;
                    data[i * 4 + 1] = g[1] * m;
                    data[i * 4 + 2] = g[2] * m;
                }
            }
            if (token !== renderToken) return;
        }

        // np.array_split into min(32, n) groups, each with its own ramp colour.
        const groups = Math.min(32, n);
        const base = Math.floor(n / groups);
        const extra = n % groups;
        let start = 0;
        let lastPaint = performance.now();
        for (let gIndex = 0; gIndex < groups; gIndex++) {
            const size = base + (gIndex < extra ? 1 : 0);
            const [r, g, b] = lerpColor(color, accent, gIndex / Math.max(1, groups - 1));
            for (let i = start; i < start + size; i++) {
                const x = pts[i * 2], y = pts[i * 2 + 1];
                if (x >= 0 && x < w && y >= 0 && y < h) {
                    const o = (y * w + x) * 4;
                    data[o] = r;
                    data[o + 1] = g;
                    data[o + 2] = b;
                }
            }
            start += size;
            if (performance.now() - lastPaint > 30 || gIndex === groups - 1) {
                ctx.putImageData(image, 0, 0);
                onProgress((gIndex + 1) / groups);
                await nextFrame();
                if (token !== renderToken) return;
                lastPaint = performance.now();
            }
        }
    }

    async function drawLines(ctx: CanvasRenderingContext2D, set: PointSet, color: RGB, accent: RGB, glow: number, token: number, onProgress: (f: number) => void) {
        const { pts, trajectories, steps } = set;
        ctx.lineJoin = "round";
        ctx.lineCap = "butt";
        const pass = async (isGlow: boolean) => {
            let lastPaint = performance.now();
            if (isGlow) {
                const g = dim(color);
                ctx.strokeStyle = `rgb(${g[0]},${g[1]},${g[2]})`;
                ctx.lineWidth = 1 + 2 * glow;
            } else {
                ctx.lineWidth = 1;
            }
            for (let t = 0; t < trajectories; t++) {
                if (!isGlow) {
                    const [r, g, b] = lerpColor(color, accent, t / Math.max(1, trajectories - 1));
                    ctx.strokeStyle = `rgb(${r},${g},${b})`;
                }
                ctx.beginPath();
                const o = t * steps * 2;
                ctx.moveTo(pts[o] + 0.5, pts[o + 1] + 0.5);
                for (let s = 1; s < steps; s++) ctx.lineTo(pts[o + s * 2] + 0.5, pts[o + s * 2 + 1] + 0.5);
                ctx.stroke();
                if (performance.now() - lastPaint > 24) {
                    onProgress(((isGlow ? 0 : glow > 0 ? 0.5 : 0) + (t / trajectories) * (glow > 0 ? 0.5 : 1)));
                    await nextFrame();
                    if (token !== renderToken) return false;
                    lastPaint = performance.now();
                }
            }
            return true;
        };
        if (glow > 0 && !(await pass(true))) return;
        await pass(false);
        onProgress(1);
    }

    /* =========================================================
       UI WIRING
       ========================================================= */

    const root = document.querySelector<HTMLElement>(".playground");
    if (root) {
        const canvas = root.querySelector<HTMLCanvasElement>(".wall-canvas")!;
        const ctx = canvas.getContext("2d")!;
        const stage = root.querySelector<HTMLElement>(".stage")!;
        const progress = root.querySelector<HTMLProgressElement>(".render-progress")!;
        const status = root.querySelector<HTMLElement>(".render-status")!;
        const seedInput = root.querySelector<HTMLInputElement>(".seed-input")!;
        const seedError = root.querySelector<HTMLElement>(".seed-error")!;
        const presetName = root.querySelector<HTMLElement>(".preset-name")!;
        const paletteSelect = root.querySelector<HTMLSelectElement>(".palette-select")!;
        const resSelect = root.querySelector<HTMLSelectElement>(".res-select")!;
        const jsonCode = root.querySelector<HTMLElement>(".preset-json")!;
        const compareToggle = root.querySelector<HTMLInputElement>(".compare-toggle")!;
        const compareSlider = root.querySelector<HTMLInputElement>(".compare-slider")!;
        const compareSliderLabel = root.querySelector<HTMLElement>(".compare-slider-label")!;
        const compareImg = root.querySelector<HTMLImageElement>(".compare-img")!;
        const compareLine = root.querySelector<HTMLElement>(".compare-line")!;
        const compareTags = root.querySelectorAll<HTMLElement>(".compare-tag");
        const compareNote = root.querySelector<HTMLElement>(".compare-note")!;
        const sliders = root.querySelectorAll<HTMLInputElement>("input[type=range][data-key]");
        let lastRender = { points: 0, ms: 0 };

        if (isSmallDevice) {
            root.querySelector<HTMLOptionElement>(".large-res")?.remove();
            root.querySelectorAll<HTMLInputElement>('[data-key="iterations"]').forEach((el) => (el.max = String(POINT_CAP)));
        }

        const formatValue = (key: string, value: number) => {
            if (key === "iterations" || key === "particles" || key === "steps") return value.toLocaleString("en-GB");
            if (key === "glow") return String(value);
            if (key === "step_size") return value.toFixed(3);
            if (key === "initial_extent") return value.toFixed(1);
            return value.toFixed(2);
        };

        const setOutput = (key: string, value: number) => {
            const out = root.querySelector<HTMLOutputElement>(`output[data-for="${key}"]`);
            if (out) out.textContent = formatValue(key, value);
        };

        const dims = (): [number, number] => {
            const [sw, sh] = COMPOSITION[state.target];
            const scale = state.res / Math.max(sw, sh);
            return [Math.max(1, Math.round(sw * scale)), Math.max(1, Math.round(sh * scale))];
        };

        const isUnmodifiedPreset = () => {
            const preset = PRESETS[state.family];
            const params = state.params[state.family];
            return (
                state.seeds[state.family] === preset.seed &&
                Object.entries(preset.params).every(([k, v]) => params[k] === v) &&
                state.palette === preset.palette &&
                state.glow === preset.glow
            );
        };

        const presetJson = () => {
            const p = state.params[state.family];
            const parameters =
                state.family === "strange_attractor"
                    ? { system: "clifford", a: p.a, b: p.b, c: p.c, d: p.d }
                    : { system: "trigonometric", frequency: p.frequency, phase: p.phase, step_size: p.step_size, initial_extent: p.initial_extent };
            const budget = state.family === "strange_attractor" ? p.iterations : p.particles * p.steps;
            return {
                schema_version: 1,
                name: isUnmodifiedPreset() ? PRESETS[state.family].name : `Playground ${state.family === "strange_attractor" ? "Clifford" : "Flow"} ${state.seeds[state.family]}`,
                family: state.family,
                seed: state.seeds[state.family],
                parameters,
                composition: {
                    desktop: { width: 3840, height: 2160 },
                    mobile: { width: 1440, height: 3120 },
                },
                budgets: { preview: budget, final: Math.max(5000000, budget) },
            };
        };

        const updateCompare = () => {
            const eligible = isUnmodifiedPreset() && state.target === "desktop" && state.res === 1280;
            compareToggle.disabled = !eligible;
            compareNote.textContent = eligible
                ? "Drag the divider: left of it is this page's port, right of it is the repository's PNG."
                : "Available for the unmodified presets at desktop, 1280 px, with the repository palette.";
            const show = eligible && compareToggle.checked;
            compareImg.src = PRESETS[state.family].image;
            compareImg.hidden = !show;
            compareLine.hidden = !show;
            compareTags.forEach((tag) => (tag.hidden = !show));
            compareSliderLabel.hidden = !show;
            const pos = Number(compareSlider.value);
            stage.style.setProperty("--split", `${pos}%`);
        };

        const syncControls = () => {
            const params = state.params[state.family];
            root.querySelector<HTMLInputElement>(`input[name=family][value=${state.family}]`)!.checked = true;
            root.querySelectorAll<HTMLElement>(".param-group").forEach((group) => {
                group.hidden = group.dataset.family !== state.family;
            });
            sliders.forEach((slider) => {
                const key = slider.dataset.key!;
                const value = key === "glow" ? state.glow : params[key];
                if (value === undefined) return;
                slider.value = String(value);
                setOutput(key, value);
            });
            seedInput.value = String(state.seeds[state.family]);
            seedError.hidden = true;
            paletteSelect.value = state.palette;
            presetName.textContent = isUnmodifiedPreset() ? PRESETS[state.family].name : `Modified from ${PRESETS[state.family].name}`;
            jsonCode.textContent = JSON.stringify(presetJson(), null, 2);
            updateCompare();
        };

        let debounce = 0;
        const scheduleRender = (delay = 140) => {
            window.clearTimeout(debounce);
            presetName.textContent = isUnmodifiedPreset() ? PRESETS[state.family].name : `Modified from ${PRESETS[state.family].name}`;
            jsonCode.textContent = JSON.stringify(presetJson(), null, 2);
            updateCompare();
            debounce = window.setTimeout(render, delay);
        };

        async function render() {
            const token = ++renderToken;
            const [w, h] = dims();
            canvas.width = w;
            canvas.height = h;
            stage.dataset.target = state.target;
            ctx.fillStyle = "#000";
            ctx.fillRect(0, 0, w, h);
            progress.value = 0;
            stage.classList.add("is-rendering");
            status.textContent = "Rendering…";
            const t0 = performance.now();
            const p = state.params[state.family];
            const seed = state.seeds[state.family];
            const palette = PALETTES[state.palette];
            try {
                let set: PointSet | null;
                if (state.family === "strange_attractor") {
                    const iterations = Math.min(p.iterations, POINT_CAP);
                    set = await computeAttractor(p, seed, iterations, token, (f) => (progress.value = f * 35));
                    if (!set) return;
                    transformInPlace(set, w, h, 0.12);
                    await drawPoints(ctx, set, w, h, palette.color, palette.accent, state.glow, token, (f) => (progress.value = 35 + f * 65));
                } else {
                    let particles = p.particles;
                    let steps = p.steps;
                    if (particles * steps > POINT_CAP) steps = Math.max(1, Math.floor(POINT_CAP / particles));
                    set = await computeFlow(p, seed, particles, steps, token, (f) => (progress.value = f * 35));
                    if (!set) return;
                    transformInPlace(set, w, h, 0.09);
                    await drawLines(ctx, set, palette.color, palette.accent, state.glow, token, (f) => (progress.value = 35 + f * 65));
                }
                if (token !== renderToken) return;
                const ms = Math.round(performance.now() - t0);
                const points = set.pts.length / 2;
                lastRender = { points, ms };
                progress.value = 100;
                stage.classList.remove("is-rendering");
                const capped = state.family === "strange_attractor" ? p.iterations > POINT_CAP : p.particles * p.steps > POINT_CAP;
                status.textContent = `Rendered ${points.toLocaleString("en-GB")} points at ${w} × ${h} in ${ms.toLocaleString("en-GB")} ms${capped ? " (capped on this device)" : ""}.`;
            } catch (error) {
                stage.classList.remove("is-rendering");
                status.textContent = `Engine error: ${(error as Error).message}`;
            }
        }

        // Family switch
        root.querySelectorAll<HTMLInputElement>("input[name=family]").forEach((radio) => {
            radio.addEventListener("change", () => {
                if (!radio.checked) return;
                state.family = radio.value as Family;
                state.palette = PRESETS[state.family].palette;
                state.glow = PRESETS[state.family].glow;
                syncControls();
                scheduleRender(0);
            });
        });

        root.querySelector(".reset-preset")?.addEventListener("click", () => {
            const preset = PRESETS[state.family];
            state.params[state.family] = { ...preset.params };
            state.seeds[state.family] = preset.seed;
            state.palette = preset.palette;
            state.glow = preset.glow;
            syncControls();
            scheduleRender(0);
        });

        sliders.forEach((slider) => {
            slider.addEventListener("input", () => {
                const key = slider.dataset.key!;
                const value = Number(slider.value);
                if (key === "glow") state.glow = value;
                else state.params[state.family][key] = value;
                setOutput(key, value);
                scheduleRender();
            });
        });

        seedInput.addEventListener("input", () => {
            const raw = seedInput.value.trim();
            const value = Number(raw);
            if (raw === "" || !Number.isInteger(value) || value < 0 || value > MAX_SEED) {
                seedError.textContent = `seed must be an integer between 0 and ${MAX_SEED}`;
                seedError.hidden = false;
                return;
            }
            seedError.hidden = true;
            state.seeds[state.family] = value;
            scheduleRender(250);
        });

        root.querySelector(".random-seed")?.addEventListener("click", () => {
            const buffer = new Uint32Array(1);
            crypto.getRandomValues(buffer);
            state.seeds[state.family] = buffer[0];
            seedInput.value = String(buffer[0]);
            seedError.hidden = true;
            scheduleRender(0);
        });

        paletteSelect.addEventListener("change", () => {
            state.palette = paletteSelect.value;
            scheduleRender(0);
        });

        root.querySelectorAll<HTMLInputElement>("input[name=target]").forEach((radio) => {
            radio.addEventListener("change", () => {
                if (!radio.checked) return;
                state.target = radio.value as "desktop" | "mobile";
                scheduleRender(0);
            });
        });

        resSelect.addEventListener("change", () => {
            state.res = Number(resSelect.value);
            scheduleRender(0);
        });

        compareToggle.addEventListener("change", updateCompare);
        compareSlider.addEventListener("input", updateCompare);

        root.querySelector(".download-btn")?.addEventListener("click", () => {
            canvas.toBlob((blob) => {
                if (!blob) return;
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                const slug = (presetJson().name as string).toLowerCase().replace(/[^a-z0-9]+/g, "-");
                link.href = url;
                link.download = `${slug}-${state.target}-seed-${state.seeds[state.family]}.png`;
                document.body.append(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(url), 4000);
                status.textContent = `Saved ${canvas.width} × ${canvas.height} PNG (${lastRender.points.toLocaleString("en-GB")} points).`;
            }, "image/png");
        });

        root.querySelector(".copy-btn")?.addEventListener("click", async () => {
            const text = JSON.stringify(presetJson(), null, 2) + "\n";
            try {
                await navigator.clipboard.writeText(text);
                status.textContent = "Preset JSON copied. It passes the repository's schema rules.";
            } catch {
                root.querySelector<HTMLDetailsElement>(".json-panel")!.open = true;
                status.textContent = "Clipboard unavailable: the preset JSON is shown below.";
            }
        });

        // RNG self-check against NumPy's documented output.
        const rngCheck = document.querySelector<HTMLElement>(".rng-check");
        if (rngCheck) {
            const value = new PCG64(12345).random();
            const ok = value === 0.22733602246716966;
            const start = new PCG64(1729);
            const sx = start.uniform(-0.5, 0.5);
            const sy = start.uniform(-0.5, 0.5);
            rngCheck.innerHTML = `<span class="${ok ? "ok" : "bad"}">${ok ? "✓" : "✗"}</span> <code>default_rng(12345).random()</code> = <code>${value}</code>${ok ? ", matching NumPy's documentation" : ", which does NOT match NumPy"}. Seed 1729 starts at (${sx.toFixed(6)}, ${sy.toFixed(6)}).`;
        }

        syncControls();

        // Render once the playground scrolls near the viewport.
        const io = new IntersectionObserver(
            (entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                    io.disconnect();
                    render();
                }
            },
            { rootMargin: "400px" },
        );
        io.observe(root);
    }

    /* =========================================================
       HERO — the Clifford preset accumulating behind the title
       ========================================================= */

    const heroCanvas = document.querySelector<HTMLCanvasElement>(".hero-canvas");
    if (heroCanvas) {
        const hctx = heroCanvas.getContext("2d")!;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const total = isSmallDevice ? 60000 : 140000;
        const rng = new PCG64(1729);
        let x = rng.uniform(-0.5, 0.5);
        let y = rng.uniform(-0.5, 0.5);
        const [a, b, c, d] = [-1.4, 1.6, 1.0, 0.7];
        const W = heroCanvas.width, H = heroCanvas.height;
        // The attractor's extent is bounded by 1 + |c| and 1 + |d|.
        const sx = (W * 0.86) / 4, sy = (H * 0.86) / 3.4;
        const from: RGB = [24, 126, 255], to: RGB = [232, 60, 184];
        let drawn = 0;
        hctx.fillStyle = "#000";
        hctx.fillRect(0, 0, W, H);
        hctx.globalCompositeOperation = "lighter";
        const batch = reduce ? total : 1800;
        const tick = () => {
            const end = Math.min(total, drawn + batch);
            const [r, g, bl] = lerpColor(from, to, drawn / total);
            hctx.fillStyle = `rgba(${r},${g},${bl},0.32)`;
            for (; drawn < end; drawn++) {
                const nx = Math.sin(a * y) + c * Math.cos(a * x);
                const ny = Math.sin(b * x) + d * Math.cos(b * y);
                x = nx;
                y = ny;
                hctx.fillRect(W / 2 + x * sx, H / 2 - y * sy, 1, 1);
            }
            if (drawn < total) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
    }
</script>

