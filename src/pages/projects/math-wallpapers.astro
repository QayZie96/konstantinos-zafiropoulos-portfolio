                            <label class="slider"><span>a <output data-for="a">-1.40</output></span><input type="range" data-key="a" min="-3" max="3" step="0.01" value="-1.4" /></label>
                            <label class="slider"><span>b <output data-for="b">1.60</output></span><input type="range" data-key="b" min="-3" max="3" step="0.01" value="1.6" /></label>
                            <label class="slider"><span>c <output data-for="c">1.00</output></span><input type="range" data-key="c" min="-3" max="3" step="0.01" value="1" /></label>
                            <label class="slider"><span>d <output data-for="d">0.70</output></span><input type="range" data-key="d" min="-3" max="3" step="0.01" value="0.7" /></label>
                            <label class="slider"><span>Iterations <output data-for="iterations">100,000</output></span><input type="range" data-key="iterations" min="10000" max="2000000" step="10000" value="100000" /></label>
                        </div>

                        <div class="param-group" data-family="particle_flow_field" hidden>
                            <label class="slider"><span>Frequency <output data-for="frequency">2.40</output></span><input type="range" data-key="frequency" min="0.2" max="20" step="0.05" value="2.4" /></label>
                            <label class="slider"><span>Phase <output data-for="phase">0.35</output></span><input type="range" data-key="phase" min="-6.28" max="6.28" step="0.01" value="0.35" /></label>
