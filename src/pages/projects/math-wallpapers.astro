---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";

const title =
    "Mathematical OLED Wallpapers | Python Generative Art | Konstantinos Zafeiropoulos";

const description =
    "A deterministic Python generator for mathematical OLED wallpapers: Clifford attractors and particle flow fields, validated JSON presets, workload budgets and 57 unit tests, with a live in-browser port.";

const projectFacts = [
    { label: "Type", value: "Personal generative-art project" },
    { label: "Stack", value: "Python 3.11 · NumPy · Pillow" },
    { label: "Engines", value: "Clifford attractor · Trigonometric flow field" },
    { label: "Status", value: "Milestone 1 accepted · exploratory" },
];

const previews = [
    {
        src: "/images/projects/math-wallpapers/clifford-foundation-01-desktop.webp",
        name: "Clifford Foundation 01",
        preset: "presets/candidates/clifford_foundation_01.json",
        alt: "Clifford attractor preview on a pure black background: blue and magenta point clouds form two sweeping folded lobes with dark internal cavities.",
        meta: "seed 1729 · a −1.4 · b 1.6 · c 1.0 · d 0.7 · 100,000 points",
        score: "68.5",
    },
    {
        src: "/images/projects/math-wallpapers/flow-foundation-01-desktop.webp",
        name: "Flow Foundation 01",
        preset: "presets/candidates/flow_foundation_01.json",
        alt: "Particle flow-field preview on a pure black background: turquoise and amber trajectories circulate inside a diagonal grid of rounded diamond cells.",
        meta: "seed 2718 · frequency 2.4 · phase 0.35 · step 0.025 · 400 × 250 points",
        score: "64.5",
    },
];

const validationRules = [
    { field: "schema_version", rule: "Currently 1" },
    { field: "family", rule: "strange_attractor or particle_flow_field" },
    { field: "seed", rule: "Integer 0 – 4,294,967,295" },
    { field: "composition", rule: "desktop + mobile, each side ≤ 8,192 px" },
    { field: "budgets", rule: "preview ≤ final ≤ 10,000,000" },
    { field: "parameters", rule: "Finite numbers only; nesting ≤ 64 levels" },
];

const engineLimits = [
    { value: "5,000,000", label: "Max attractor iterations" },
    { value: "±3.0", label: "Clifford coefficient bounds" },
    { value: "250,000", label: "Max flow particles" },
    { value: "5,000,000", label: "Max flow trajectory points" },
];

const testFiles = [
    { file: "test_presets.py", count: 17, focus: "Schema fields, UTF-8, malformed JSON, NaN, nesting and integer-size limits" },
    { file: "test_attractors.py", count: 11, focus: "Same seed → identical points, recurrence check, coefficient and iteration bounds" },
    { file: "test_flow_fields.py", count: 11, focus: "Normalised vector-field steps, finite output at parameter limits, workload caps" },
    { file: "test_compositor.py", count: 11, focus: "True-black background, identical pixels for identical input, unsafe coordinates" },
    { file: "test_cli.py", count: 7, focus: "validate/preview commands, no tracebacks, refuses to overwrite files" },
];

const codeExcerpt = `x, y = np.random.default_rng(seed).uniform(-0.5, 0.5, size=2)
points = np.empty((iterations, 2), dtype=np.float64)

for index in range(iterations):
    next_x = math.sin(a * y) + c * math.cos(a * x)
    next_y = math.sin(b * x) + d * math.cos(b * y)
    if not math.isfinite(next_x) or not math.isfinite(next_y):
        raise AttractorError(
            f"attractor produced non-finite output at iteration {index}"
        )
    points[index] = (next_x, next_y)
    x, y = next_x, next_y`;
---

<html lang="en">
    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <div class="breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span aria-hidden="true">→</span>
                    <strong>Mathematical OLED Wallpapers</strong>
                </div>

                <div class="oled-board">
                    <canvas class="hero-canvas" width="900" height="560" aria-hidden="true"></canvas>
                    <div class="hero-copy">
                        <p class="board-eyebrow">Personal project · Python · Generative art</p>
                        <h1>
                            <span class="h1-line">Mathematical</span>
                            <span class="h1-neon">OLED Wallpapers</span>
                        </h1>
                        <p class="hero-subtitle">
                            A small offline Python engine that turns a seed and
                            a handful of coefficients into true-black
                            wallpapers. The attractor behind this text is the
                            repository's own preset, re-computed live in your
                            browser.
                        </p>
                        <p class="equation" aria-label="Clifford attractor recurrence">
                            <span>x′ = sin(a·y) + c·cos(a·x)</span>
                            <span>y′ = sin(b·x) + d·cos(b·y)</span>
                        </p>
                        <a class="hero-cta" href="#playground">Open the playground <span aria-hidden="true">↓</span></a>
                    </div>
                </div>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "python",
                        "generative-art",
                        "canvas-graphics",
                        "unit-testing",
                        "data-visualisation",
                        "output-validation",
                        "iterative-development",
                        "documentation",
                    ]}
                />
            </header>

            <section class="facts" aria-label="Project information">
                {projectFacts.map((fact) => (
                    <article class="fact">
                        <span>{fact.label}</span>
                        <strong>{fact.value}</strong>
                    </article>
                ))}
            </section>

            <section class="case-section" id="playground" aria-labelledby="mw-playground">
                <div class="section-heading">
                    <p class="eyebrow">01 — Live playground</p>
                    <h2 id="mw-playground">Run the engine yourself.</h2>
                    <p>
                        Both mathematical engines, ported line by line from <code>attractors.py</code>, <code>flow_fields.py</code> and <code>compositor.py</code> to browser JavaScript.
                        Start from the repository's two real presets, change
                        anything, and download the result as a PNG.
                    </p>
                </div>

                <div class="playground">
                    <div class="stage-wrap">
                        <div class="stage" data-target="desktop">
                            <div class="device">
                                <canvas class="wall-canvas" width="1280" height="720" role="img" aria-label="Generated wallpaper preview"></canvas>
                                <img
                                    class="compare-img"
                                    src={previews[0].src}
                                    alt=""
                                    width="1280"
                                    height="720"
                                    hidden
                                />
                                <span class="compare-line" hidden></span>
                                <span class="compare-tag compare-tag-js" hidden>Browser port</span>
                                <span class="compare-tag compare-tag-py" hidden>Python PNG</span>
                            </div>
                        </div>
                        <progress class="render-progress" max="100" value="0" aria-label="Render progress"></progress>
                        <p class="render-status" role="status" aria-live="polite">Preparing the renderer…</p>

                        <div class="compare-box">
                            <label class="check">
                                <input type="checkbox" class="compare-toggle" />
                                <span>Compare with the Python PNG from the repository</span>
                            </label>
                            <label class="compare-slider-label" hidden>
                                <span>Divider position</span>
                                <input type="range" class="compare-slider" min="0" max="100" value="50" />
                            </label>
                            <p class="compare-note">Available for the unmodified presets at desktop, 1280 px, with the repository palette.</p>
                        </div>
                    </div>

                    <form class="controls" aria-label="Wallpaper controls" onsubmit="return false">
                        <fieldset class="segmented">
                            <legend>Family</legend>
                            <label><input type="radio" name="family" value="strange_attractor" checked /><span>Clifford attractor</span></label>
                            <label><input type="radio" name="family" value="particle_flow_field" /><span>Flow field</span></label>
                        </fieldset>

