---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";

const title =
    "Mathematical OLED Wallpapers | Python Generative Art | Konstantinos Zafeiropoulos";

const description =
    "Mathematical OLED Wallpapers Volume 1: six true-black wallpapers in native 4K, built with a deterministic Python engine (attractors, flow fields, fractal flames, Julia sets) and JWildfire, with 123 tests and a live in-browser playground.";

const IMG = "/images/projects/math-wallpapers/";

const projectFacts = [
    { label: "Type", value: "Personal generative-art project" },
    { label: "Stack", value: "Python · NumPy · Pillow · JWildfire" },
    { label: "Volume 1", value: "6 wallpapers · native 4K + phone" },
    { label: "Status", value: "Release candidate · final sign-off" },
];

const volume = [
    {
        title: "Ethereal Silver",
        slug: "ethereal-silver",
        method: "Fractal-flame IFS · project's own Python renderer",
        detail: "Three weighted maps (swirl, floored inversion, signed square root), seed 4108, 125.8 million samples per 1080p frame, transform-history colour.",
        score: 87.45,
        alt: "Two pale silver-blue vortices intertwine at the centre, wrapped by fine blue arcs and faint gold traces on black.",
    },
    {
        title: "Receding Choir",
        slug: "receding-choir",
        method: "Fractal flame · JWildfire 9.20",
        detail: "Bubble, spherical and bipolar variations; violet membranes over green and silver chambers that recede into shadow.",
        score: 85.6,
        alt: "Rows of dark oval chambers with green and violet light recede diagonally across a smoky purple field.",
    },
    {
        title: "Luminous Crossing",
        slug: "luminous-crossing",
        method: "Fractal flame · JWildfire 9.20",
        detail: "spherical3D_wf and cylindrical variations; an orange bridge crossing bright blue and violet currents.",
        score: 80.5,
        alt: "A glowing orange band crosses the frame diagonally through tangled blue, pink and violet filaments.",
    },
    {
        title: "Cyan Undertow",
        slug: "cyan-undertow",
        method: "Fractal flame · JWildfire 9.20",
        detail: "Wedge and sec branches; red light clusters joined by thin cyan connections in a dark atmosphere.",
        score: 81.85,
        alt: "Scattered red glowing clusters connected by thin cyan threads drift across a near-black background.",
    },
    {
        title: "JulianDisc",
        slug: "juliandisc",
        method: "Fractal flame · JWildfire 9.20",
        detail: "julian (power 52) combined with disc; a crisp asymmetric fan of spectral filaments with open negative space.",
        score: 83.1,
        alt: "A thin, sculptural fan of green, gold and violet filaments curls upward on the right of a black frame.",
    },
    {
        title: "Filigree Diadem",
        slug: "filigree-diadem",
        method: "Julia set · project's own Python renderer",
        detail: "z → z² + c with c = −0.745 + 0.186i, distance-estimated light, teal recesses and warm gold rims.",
        score: 84.2,
        alt: "An upright, lace-like Julia-set jewel in teal and gold sits right of centre on a black field.",
    },
];

const deliverables = [
    { value: "6", label: "Native 3840 × 2160 masters" },
    { value: "6", label: "1080 × 1920 phone companions" },
    { value: "8", label: "Page mathematical-art booklet" },
    { value: "€0", label: "Cloud rendering cost (free tier)" },
];

const timeline = [
    {
        date: "12 Oct",
        branch: "m1-foundation",
        title: "Engine foundation",
        text: "Validated presets, seeded Clifford and flow-field engines, the compositor and CLI. The first two previews scored 68.5 and 64.5.",
        thumb: "clifford-foundation-01-desktop.webp",
    },
    {
        date: "12–13 Oct",
        branch: "m2-artistic-exploration",
        title: "Fourteen candidates, one rubric",
        text: "Eight Clifford attractors and six flow fields, a new vortex-pair flow, softer trajectory ends and Pillow-based glow. Leads such as Tidal Lace 02 reached the high 70s.",
        thumb: "tl-tidal-lace-02.webp",
    },
    {
        date: "17 Oct",
        branch: "art-directed-flow · domain-warped-flow",
        title: "Stretching the flow field",
        text: "Layered-veil and filament finishes for Tidal Lace, art-directed particle seeding with trajectory curation, and bounded domain warping, each with tests and written findings.",
    },
    {
        date: "18 Oct",
        branch: "autonomous-art-director",
        title: "Density rendering",
        text: "Experiment 03: smooth density accumulation and ribbon studies, settling on Nacre 02 at 1920 × 1080.",
        thumb: "tl-nacre-02.webp",
    },
    {
        date: "18 Oct",
        branch: "autonomous-art-director-v2",
        title: "A small digital studio",
        text: "Experiment 04: twelve explorations including the first flame and Julia filigree sketches. Orison 05 rendered at 2560 × 1440.",
        thumb: "tl-orison-05.webp",
    },
    {
        date: "18 Oct",
        branch: "flame-artistic-development",
        title: "Developing the flame",
        text: "Experiment 05: six refinements of the owner-preferred Flame 04, with subpixel deposition, multiscale density estimation and new tone controls. Encounter 05 and Interweave 02.",
        thumb: "tl-encounter-05.webp",
    },
    {
        date: "18 Oct",
        branch: "exchange-quality-proof",
        title: "Ethereal Silver and Filigree",
        text: "Experiment 06 produced Ethereal Silver, the collection's highest-scoring piece, plus nine Julia filigree studies and six subject studies.",
        thumb: "filigree-01-diadem-800.webp",
    },
    {
        date: "19–21 Oct",
        branch: "jwildfire-shortlist-refinement",
        title: "Volume 1",
        text: "Nine hand-picked JWildfire flames refined into 18 variants, rendered on GitHub Actions' free tier. Six works selected, mastered in native 4K, paired with phone crops, a booklet and a five-ZIP package.",
        thumb: "v1-receding-choir.webp",
    },
];

const validationRules = [
    { field: "schema_version", rule: "Currently 1" },
    { field: "family", rule: "strange_attractor or particle_flow_field" },
    { field: "seed", rule: "Integer 0 – 4,294,967,295" },
    { field: "composition", rule: "desktop + mobile, each side ≤ 8,192 px" },
    { field: "budgets", rule: "preview ≤ final ≤ 10,000,000" },
    { field: "parameters", rule: "Finite numbers only; nesting ≤ 64 levels" },
];

const engineLimits = [
    { value: "5,000,000", label: "Max attractor iterations" },
    { value: "±3.0", label: "Clifford coefficient bounds" },
    { value: "250,000", label: "Max flow particles" },
    { value: "1,800 s", label: "Time bound per 4K cloud render" },
];

const testFiles = [
    { file: "test_compositor.py", count: 25 },
    { file: "test_presets.py", count: 22 },
    { file: "test_flow_fields.py", count: 15 },
    { file: "test_attractors.py", count: 11 },
    { file: "test_cli.py", count: 10 },
    { file: "test_filigree_study.py", count: 7 },
    { file: "test_flame05.py", count: 6 },
    { file: "test_subject_study.py", count: 6 },
    { file: "test_art_director_experiment.py", count: 5 },
    { file: "test_studio04.py", count: 5 },
    { file: "test_exchange06.py", count: 4 },
    { file: "test_volume1_expanded.py", count: 4 },
    { file: "test_organic_motion.py", count: 3 },
];

const codeExcerpt = `for step in range(steps + 30):
    choices = rng.choice(3, count, p=cfg["weights"])
    for index, trans in enumerate(cfg["transforms"]):
        selected = choices == index
        a, b, c, d, e, f, variation = trans
        w = (a*z[selected].real + b*z[selected].imag + c) \\
            + 1j*(d*z[selected].real + e*z[selected].imag + f)
        if variation == "swirl":
            angle = np.pi/2 - np.abs(w)**2
            angle += cfg.get("swirl_shear", 0)*np.sin(w.real*2.1 + w.imag*0.7)
            w *= np.exp(1j*angle)
        elif variation == "spherical":
            w /= np.maximum(np.abs(w)**2, 0.04)
        elif variation == "julia":
            w = np.sqrt(w)*rng.choice([-1, 1], selected.sum())
        z[selected] = w`;
---

<html lang="en">
    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <div class="breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span aria-hidden="true">→</span>
                    <strong>Mathematical OLED Wallpapers</strong>
                </div>

                <div class="oled-board">
                    <canvas class="hero-canvas" width="900" height="560" aria-hidden="true"></canvas>
                    <div class="hero-copy">
                        <p class="board-eyebrow">Personal project · Python · Generative art</p>
                        <h1>
                            <span class="h1-line">Mathematical</span>
                            <span class="h1-neon">OLED Wallpapers</span>
                        </h1>
                        <p class="hero-subtitle">
                            True-black wallpapers grown from equations. What
                            began as a seeded Python attractor engine is now
                            Volume 1: six wallpapers mastered in native 4K,
                            reached through eight rounds of exploration.
                        </p>
                        <p class="equation" aria-label="Clifford attractor recurrence">
                            <span>x′ = sin(a·y) + c·cos(a·x)</span>
                            <span>y′ = sin(b·x) + d·cos(b·y)</span>
                        </p>
                        <div class="hero-actions">
                            <a class="hero-cta" href="#volume-1">See Volume 1 <span aria-hidden="true">↓</span></a>
                            <a class="hero-ghost" href="#playground">Open the playground</a>
                        </div>
                    </div>
                </div>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "python",
                        "data-visualisation",
                        "output-validation",
                        "iterative-development",
                        "documentation",
                    ]}
                />
            </header>

            <section class="facts" aria-label="Project information">
                {projectFacts.map((fact) => (
                    <article class="fact">
                        <span>{fact.label}</span>
                        <strong>{fact.value}</strong>
                    </article>
                ))}
            </section>

            <section class="case-section" id="volume-1" aria-labelledby="mw-volume">
                <div class="section-heading">
                    <p class="eyebrow">01 — Volume 1</p>
                    <h2 id="mw-volume">Six mathematical worlds.</h2>
                    <p>
                        Two pieces come from the project's own Python
                        renderers; four are fractal flames chosen by hand from
                        JWildfire's generators, refined and rendered natively.
                        Switch between desktop and phone to see each
                        composition reframed.
                    </p>
                </div>

                <div class="v1-viewer">
                    <div class="v1-stage" data-mode="desktop">
                        <div class="v1-desktop">
                            <img
                                class="v1-main"
                                src={`${IMG}v1-${volume[0].slug}.webp`}
                                alt={volume[0].alt}
                                width="1600"
                                height="900"
                                decoding="async"
                            />
                        </div>
                        <div class="v1-phone" aria-hidden="true">
                            <img
                                class="v1-portrait"
                                src={`${IMG}portrait-${volume[0].slug}.webp`}
                                alt=""
                                width="360"
                                height="640"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    </div>

                    <div class="v1-info">
                        <fieldset class="segmented v1-mode">
                            <legend>View</legend>
                            <label><input type="radio" name="v1-mode" value="desktop" checked /><span>Desktop 4K</span></label>
                            <label><input type="radio" name="v1-mode" value="phone" /><span>Phone 9:16</span></label>
                        </fieldset>
                        <p class="v1-index" aria-live="polite">01 / 06</p>
                        <h3 class="v1-title">{volume[0].title}</h3>
                        <p class="v1-method">{volume[0].method}</p>
                        <p class="v1-detail">{volume[0].detail}</p>
                        <div class="v1-score">
                            <span>Artistic Quality Score</span>
                            <span class="bar"><i style={`--score: ${volume[0].score}%`}></i><b aria-hidden="true"></b></span>
                            <strong class="v1-score-value">{volume[0].score.toFixed(2)}</strong>
                        </div>
                    </div>

                    <div class="v1-thumbs" role="group" aria-label="Choose an artwork">
                        {volume.map((art, i) => (
                            <button
                                type="button"
                                class="v1-thumb"
                                aria-pressed={i === 0 ? "true" : "false"}
                                data-index={i}
                                data-title={art.title}
                                data-slug={art.slug}
                                data-method={art.method}
                                data-detail={art.detail}
                                data-score={art.score}
                                data-alt={art.alt}
                            >
                                <img src={`${IMG}v1-${art.slug}.webp`} alt="" width="1600" height="900" loading="lazy" decoding="async" />
                                <span>{art.title}</span>
                            </button>
                        ))}
                    </div>
                </div>

                <div class="deliverables">
                    {deliverables.map((item) => (
                        <article>
                            <strong>{item.value}</strong>
                            <span>{item.label}</span>
                        </article>
                    ))}
                </div>
            </section>

            <section class="case-section" id="playground" aria-labelledby="mw-playground">
                <div class="section-heading">
                    <p class="eyebrow">02 — Live playground</p>
                    <h2 id="mw-playground">Run the engines yourself.</h2>
                    <p>
                        Four of the project's renderers, from the first Clifford
                        attractor to Ethereal Silver and Filigree Diadem, running
                        in your browser. Start from the real presets, change
                        anything, and download the result as a PNG.
                    </p>
                </div>

                <div class="playground">
                    <div class="stage-wrap">
                        <div class="stage" data-target="desktop">
                            <div class="device">
                                <canvas class="wall-canvas" width="1280" height="720" role="img" aria-label="Generated wallpaper preview"></canvas>
                                <img class="compare-img" src={`${IMG}clifford-foundation-01-desktop.webp`} alt="" width="1280" height="720" hidden />
                                <span class="compare-line" hidden></span>
                                <span class="compare-tag compare-tag-js" hidden>Live render</span>
                                <span class="compare-tag compare-tag-py" hidden>Repository master</span>
                            </div>
                        </div>
                        <progress class="render-progress" max="100" value="0" aria-label="Render progress"></progress>
                        <p class="render-status" role="status" aria-live="polite">Preparing the renderer…</p>

                        <div class="compare-box">
                            <label class="check">
                                <input type="checkbox" class="compare-toggle" />
                                <span>Compare with the repository's own render</span>
                            </label>
                            <label class="compare-slider-label" hidden>
                                <span>Divider position</span>
                                <input type="range" class="compare-slider" min="0" max="100" value="50" />
                            </label>
                            <p class="compare-note">Available for the original presets.</p>
                        </div>
                    </div>

                    <form class="controls" aria-label="Wallpaper controls" onsubmit="return false">
                        <fieldset class="segmented family-picker">
                            <legend>Engine</legend>
                            <label><input type="radio" name="family" value="strange_attractor" checked /><span>Clifford attractor</span></label>
                            <label><input type="radio" name="family" value="particle_flow_field" /><span>Flow field</span></label>
                            <label><input type="radio" name="family" value="fractal_flame" /><span>Fractal flame</span></label>
                            <label><input type="radio" name="family" value="julia_filigree" /><span>Julia filigree</span></label>
                        </fieldset>

                        <div class="preset-row">
                            <span class="preset-name" aria-live="polite">Clifford Foundation 01</span>
                            <button type="button" class="ghost-btn reset-preset">Reset to preset</button>
                        </div>

                        <div class="seed-row">
                            <label for="mw-seed">Seed</label>
                            <input id="mw-seed" class="seed-input" type="number" min="0" max="4294967295" step="1" value="1729" inputmode="numeric" />
                            <button type="button" class="ghost-btn random-seed">Random seed</button>
                        </div>
                        <p class="seed-error" role="alert" hidden></p>

                        <div class="param-group" data-family="strange_attractor">
                            <label class="slider"><span>a <output data-for="a">-1.40</output></span><input type="range" data-key="a" min="-3" max="3" step="0.01" value="-1.4" /></label>
                            <label class="slider"><span>b <output data-for="b">1.60</output></span><input type="range" data-key="b" min="-3" max="3" step="0.01" value="1.6" /></label>
                            <label class="slider"><span>c <output data-for="c">1.00</output></span><input type="range" data-key="c" min="-3" max="3" step="0.01" value="1" /></label>
                            <label class="slider"><span>d <output data-for="d">0.70</output></span><input type="range" data-key="d" min="-3" max="3" step="0.01" value="0.7" /></label>
                            <label class="slider"><span>Iterations <output data-for="iterations">100,000</output></span><input type="range" data-key="iterations" min="10000" max="2000000" step="10000" value="100000" /></label>
                        </div>

                        <div class="param-group" data-family="particle_flow_field" hidden>
                            <label class="slider"><span>Frequency <output data-for="frequency">2.40</output></span><input type="range" data-key="frequency" min="0.2" max="20" step="0.05" value="2.4" /></label>
                            <label class="slider"><span>Phase <output data-for="phase">0.35</output></span><input type="range" data-key="phase" min="-6.28" max="6.28" step="0.01" value="0.35" /></label>
                            <label class="slider"><span>Step size <output data-for="step_size">0.025</output></span><input type="range" data-key="step_size" min="0.005" max="0.25" step="0.005" value="0.025" /></label>
                            <label class="slider"><span>Initial extent <output data-for="initial_extent">1.6</output></span><input type="range" data-key="initial_extent" min="0.1" max="10" step="0.1" value="1.6" /></label>
                            <label class="slider"><span>Particles <output data-for="particles">400</output></span><input type="range" data-key="particles" min="10" max="2000" step="10" value="400" /></label>
                            <label class="slider"><span>Steps per particle <output data-for="steps">250</output></span><input type="range" data-key="steps" min="10" max="1000" step="10" value="250" /></label>
                        </div>

                        <div class="param-group" data-family="fractal_flame" hidden>
                            <label class="slider"><span>Steps per path (× 32,768 paths) <output data-for="flame_steps">360</output></span><input type="range" data-key="flame_steps" min="30" max="960" step="30" value="360" /></label>
                            <label class="slider"><span>Rotation <output data-for="angle">0.20</output></span><input type="range" data-key="angle" min="-3.14" max="3.14" step="0.01" value="0.2" /></label>
                            <label class="slider"><span>Exposure gain <output data-for="gain">2.23</output></span><input type="range" data-key="gain" min="0.8" max="4" step="0.01" value="2.23" /></label>
                            <label class="slider"><span>Gold layer <output data-for="gold_gain">1.00</output></span><input type="range" data-key="gold_gain" min="0" max="1.6" step="0.01" value="1" /></label>
                        </div>

                        <div class="param-group" data-family="julia_filigree" hidden>
                            <label class="select">
                                <span>Filigree study</span>
                                <select class="julia-select"></select>
                            </label>
                            <label class="slider"><span>c (real) <output data-for="c_re">-0.745</output></span><input type="range" data-key="c_re" min="-1.5" max="1.5" step="0.001" value="-0.745" /></label>
                            <label class="slider"><span>c (imaginary) <output data-for="c_im">0.186</output></span><input type="range" data-key="c_im" min="-1.5" max="1.5" step="0.001" value="0.186" /></label>
                            <label class="slider"><span>Rotation <output data-for="view_angle">-1.12</output></span><input type="range" data-key="view_angle" min="-3.14" max="3.14" step="0.01" value="-1.12" /></label>
                            <label class="slider"><span>Span <output data-for="span">3.25</output></span><input type="range" data-key="span" min="0.5" max="5" step="0.05" value="3.25" /></label>
                            <label class="slider"><span>Iterations <output data-for="julia_iterations">360</output></span><input type="range" data-key="julia_iterations" min="60" max="480" step="10" value="360" /></label>
                            <label class="slider"><span>Halo falloff <output data-for="falloff">65</output></span><input type="range" data-key="falloff" min="20" max="140" step="1" value="65" /></label>
                        </div>

                        <div class="two-col palette-row">
                            <label class="select">
                                <span>Palette</span>
                                <select class="palette-select">
                                    <option value="clifford">Repo: blue → magenta</option>
                                    <option value="flow">Repo: turquoise → amber</option>
                                    <option value="ice">Extra: ice</option>
                                    <option value="ember">Extra: ember</option>
                                </select>
                            </label>
                            <label class="slider compact"><span>Glow <output data-for="glow">2</output></span><input type="range" data-key="glow" min="0" max="6" step="1" value="2" /></label>
                        </div>

                        <fieldset class="segmented target-picker">
                            <legend>Composition target</legend>
                            <label><input type="radio" name="target" value="desktop" checked /><span>Desktop 16:9</span></label>
                            <label><input type="radio" name="target" value="mobile" /><span>Phone 13:6</span></label>
                        </fieldset>

                        <label class="select">
                            <span>Output size (width)</span>
                            <select class="res-select"></select>
                        </label>

                        <div class="action-row">
                            <button type="button" class="neon-btn download-btn">Download PNG</button>
                            <button type="button" class="ghost-btn copy-btn">Copy settings JSON</button>
                        </div>

                        <details class="json-panel">
                            <summary>Settings JSON for this design</summary>
                            <pre><code class="preset-json"></code></pre>
                        </details>
                    </form>
                </div>

                <p class="port-line">
                    Browser ports of the Python renderers, seeded exactly like
                    NumPy; the full-resolution masters use far more samples, so
                    fine grain differs. <span class="rng-check" aria-live="polite"></span>
                </p>
            </section>

            <section class="case-section" aria-labelledby="mw-timeline">
                <div class="section-heading">
                    <p class="eyebrow">03 — Exploration timeline</p>
                    <h2 id="mw-timeline">Ten days, ten branches.</h2>
                    <p>
                        Each direction lived on its own Git branch with written
                        findings, so nothing was lost and every image can be
                        traced back to the code and settings that made it.
                    </p>
                </div>

                <ol class="timeline">
                    {timeline.map((item) => (
                        <li class={item.thumb ? "has-thumb" : ""}>
                            <span class="tl-dot" aria-hidden="true"></span>
                            <article>
                                <p class="tl-meta"><time>{item.date}</time> · <code>{item.branch}</code></p>
                                <h3>{item.title}</h3>
                                <p>{item.text}</p>
                            </article>
                            {item.thumb && (
                                <figure class="tl-thumb">
                                    <img src={`${IMG}${item.thumb}`} alt={`Output from the ${item.title} stage`} width="640" height="360" loading="lazy" decoding="async" />
                                </figure>
                            )}
                        </li>
                    ))}
                </ol>
            </section>

            <section class="case-section" aria-labelledby="mw-how">
                <div class="section-heading">
                    <p class="eyebrow">04 — How it works</p>
                    <h2 id="mw-how">Presets in, deterministic pixels out.</h2>
                    <p>
                        Every design is a saved recipe. The engines validate
                        it, sample the mathematics with a seeded generator,
                        and a separate finishing stage turns density into
                        light on a true-black canvas.
                    </p>
                </div>

                <ol class="pipeline" aria-label="Generation pipeline">
                    <li><span>1</span><strong>Recipe JSON</strong><small>validated schema and limits</small></li>
