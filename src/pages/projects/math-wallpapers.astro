    /* =========================================================
       ATTRACTOR AND FLOW ENGINES (attractors.py, flow_fields.py)
       ========================================================= */

    const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    let renderToken = 0;

    interface PointSet {
        pts: Float32Array;
        trajectories: number;
        steps: number;
        min: [number, number];
        max: [number, number];
    }

    async function computeAttractor(p: Record<string, number>, seed: number, iterations: number, token: number, onProgress: (f: number) => void): Promise<PointSet | null> {
        const rng = new PCG64(seed);
        let x = rng.uniform(-0.5, 0.5);
        let y = rng.uniform(-0.5, 0.5);
        const { a, b, c, d } = p;
        const pts = new Float32Array(iterations * 2);
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        let index = 0;
        while (index < iterations) {
            const end = Math.min(iterations, index + 250000);
            for (; index < end; index++) {
                const nx = Math.sin(a * y) + c * Math.cos(a * x);
                const ny = Math.sin(b * x) + d * Math.cos(b * y);
                if (!Number.isFinite(nx) || !Number.isFinite(ny)) throw new Error(`attractor produced non-finite output at iteration ${index}`);
                pts[index * 2] = nx;
                pts[index * 2 + 1] = ny;
                if (nx < minX) minX = nx;
                if (nx > maxX) maxX = nx;
                if (ny < minY) minY = ny;
                if (ny > maxY) maxY = ny;
                x = nx;
                y = ny;
            }
            onProgress(index / iterations);
            await nextFrame();
            if (token !== renderToken) return null;
        }
        return { pts, trajectories: 0, steps: iterations, min: [minX, minY], max: [maxX, maxY] };
    }

    async function computeFlow(p: Record<string, number>, seed: number, particles: number, steps: number, token: number, onProgress: (f: number) => void): Promise<PointSet | null> {
        const rng = new PCG64(seed);
        const positions = new Float64Array(particles * 2);
        for (let i = 0; i < particles * 2; i++) positions[i] = rng.uniform(-p.initial_extent, p.initial_extent);
        const { frequency, phase, step_size } = p;
        const pts = new Float32Array(particles * steps * 2);
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        const chunk = Math.max(1, Math.floor(200000 / particles));
        for (let step = 0; step < steps; ) {
            const end = Math.min(steps, step + chunk);
            for (; step < end; step++) {
                for (let i = 0; i < particles; i++) {
                    const px = positions[i * 2];
                    const py = positions[i * 2 + 1];
                    let vx = Math.sin(frequency * py + phase);
                    let vy = Math.cos(frequency * px - phase);
                    const speed = Math.hypot(vx, vy);
                    if (speed > 0) {
                        vx /= speed;
                        vy /= speed;
                    }
                    const nx = px + step_size * vx;
                    const ny = py + step_size * vy;
                    if (!Number.isFinite(nx) || !Number.isFinite(ny)) throw new Error(`flow field produced non-finite output at step ${step}`);
                    positions[i * 2] = nx;
                    positions[i * 2 + 1] = ny;
                    const o = (i * steps + step) * 2;
                    pts[o] = nx;
                    pts[o + 1] = ny;
                    if (nx < minX) minX = nx;
                    if (nx > maxX) maxX = nx;
                    if (ny < minY) minY = ny;
                    if (ny > maxY) maxY = ny;
                }
            }
            onProgress(step / steps);
            await nextFrame();
            if (token !== renderToken) return null;
        }
        return { pts, trajectories: particles, steps, min: [minX, minY], max: [maxX, maxY] };
    }

    function transformInPlace(set: PointSet, width: number, height: number, margin: number) {
        const eps = 2.220446049250313e-16;
        const spanX = Math.max(set.max[0] - set.min[0], eps);
        const spanY = Math.max(set.max[1] - set.min[1], eps);
        const scale = Math.min((width * (1 - 2 * margin)) / spanX, (height * (1 - 2 * margin)) / spanY);
        const cx = (set.min[0] + set.max[0]) / 2;
        const cy = (set.min[1] + set.max[1]) / 2;
        const pts = set.pts;
        for (let i = 0; i < pts.length; i += 2) {
            pts[i] = Math.round((pts[i] - cx) * scale + width * 0.5);
            pts[i + 1] = Math.round(height * 0.5 - (pts[i + 1] - cy) * scale);
        }
    }

    const lerpColor = (from: RGB, to: RGB, f: number): RGB => [0, 1, 2].map((k) => Math.round(from[k] + (to[k] - from[k]) * f)) as RGB;
    const dim = (c: RGB): RGB => c.map((x) => Math.round(x * 0.28)) as RGB;

    function boxBlur(src: Float32Array, w: number, h: number, r: number) {
        const tmp = new Float32Array(src.length);
        const size = 2 * r + 1;
        for (let y = 0; y < h; y++) {
            const row = y * w;
            let acc = 0;
            for (let x = -r; x <= r; x++) acc += src[row + Math.min(w - 1, Math.max(0, x))];
            for (let x = 0; x < w; x++) {
                tmp[row + x] = acc / size;
                acc += src[row + Math.min(w - 1, x + r + 1)] - src[row + Math.max(0, x - r)];
            }
        }
        for (let x = 0; x < w; x++) {
            let acc = 0;
            for (let y = -r; y <= r; y++) acc += tmp[Math.min(h - 1, Math.max(0, y)) * w + x];
            for (let y = 0; y < h; y++) {
                src[y * w + x] = acc / size;
                acc += tmp[Math.min(h - 1, y + r + 1) * w + x] - tmp[Math.max(0, y - r) * w + x];
            }
        }
    }

    function gaussianApprox(mask: Float32Array, w: number, h: number, sigma: number) {
        const n = 3;
        const ideal = Math.sqrt((12 * sigma * sigma) / n + 1);
        let wl = Math.floor(ideal);
        if (wl % 2 === 0) wl--;
        const wu = wl + 2;
        const m = Math.round((12 * sigma * sigma - n * wl * wl - 4 * n * wl - 3 * n) / (-4 * wl - 4));
        for (let i = 0; i < n; i++) boxBlur(mask, w, h, ((i < m ? wl : wu) - 1) / 2);
    }

    async function drawPoints(ctx: CanvasRenderingContext2D, set: PointSet, w: number, h: number, color: RGB, accent: RGB, glow: number, token: number, onProgress: (f: number) => void) {
        const image = ctx.createImageData(w, h);
        const data = image.data;
        for (let i = 3; i < data.length; i += 4) data[i] = 255;
        const pts = set.pts;
        const n = pts.length / 2;
        if (glow > 0) {
            const mask = new Float32Array(w * h);
            for (let i = 0; i < n; i++) {
                const x = pts[i * 2], y = pts[i * 2 + 1];
                if (x >= 0 && x < w && y >= 0 && y < h) mask[y * w + x] = 255;
            }
            gaussianApprox(mask, w, h, glow);
            const g = dim(color);
            for (let i = 0; i < mask.length; i++) {
                const m = mask[i] / 255;
                if (m > 0.001) {
                    data[i * 4] = g[0] * m;
                    data[i * 4 + 1] = g[1] * m;
                    data[i * 4 + 2] = g[2] * m;
                }
            }
            if (token !== renderToken) return;
        }
        const groups = Math.min(32, n);
        const base = Math.floor(n / groups);
        const extra = n % groups;
        let start = 0;
        let lastPaint = performance.now();
        for (let gIndex = 0; gIndex < groups; gIndex++) {
            const size = base + (gIndex < extra ? 1 : 0);
            const [r, g, b] = lerpColor(color, accent, gIndex / Math.max(1, groups - 1));
            for (let i = start; i < start + size; i++) {
                const x = pts[i * 2], y = pts[i * 2 + 1];
                if (x >= 0 && x < w && y >= 0 && y < h) {
                    const o = (y * w + x) * 4;
                    data[o] = r;
                    data[o + 1] = g;
                    data[o + 2] = b;
                }
            }
            start += size;
            if (performance.now() - lastPaint > 30 || gIndex === groups - 1) {
                ctx.putImageData(image, 0, 0);
                onProgress((gIndex + 1) / groups);
                await nextFrame();
                if (token !== renderToken) return;
                lastPaint = performance.now();
            }
        }
    }

    async function drawLines(ctx: CanvasRenderingContext2D, set: PointSet, color: RGB, accent: RGB, glow: number, token: number, onProgress: (f: number) => void) {
        const { pts, trajectories, steps } = set;
        ctx.lineJoin = "round";
        ctx.lineCap = "butt";
        const pass = async (isGlow: boolean) => {
            let lastPaint = performance.now();
            if (isGlow) {
                const g = dim(color);
                ctx.strokeStyle = `rgb(${g[0]},${g[1]},${g[2]})`;
                ctx.lineWidth = 1 + 2 * glow;
            } else {
                ctx.lineWidth = 1;
            }
            for (let t = 0; t < trajectories; t++) {
                if (!isGlow) {
                    const [r, g, b] = lerpColor(color, accent, t / Math.max(1, trajectories - 1));
                    ctx.strokeStyle = `rgb(${r},${g},${b})`;
                }
                ctx.beginPath();
                const o = t * steps * 2;
                ctx.moveTo(pts[o] + 0.5, pts[o + 1] + 0.5);
                for (let s = 1; s < steps; s++) ctx.lineTo(pts[o + s * 2] + 0.5, pts[o + s * 2 + 1] + 0.5);
                ctx.stroke();
                if (performance.now() - lastPaint > 24) {
                    onProgress((isGlow ? 0 : glow > 0 ? 0.5 : 0) + (t / trajectories) * (glow > 0 ? 0.5 : 1));
                    await nextFrame();
                    if (token !== renderToken) return false;
                    lastPaint = performance.now();
                }
            }
            return true;
        };
        if (glow > 0 && !(await pass(true))) return;
        await pass(false);
        onProgress(1);
    }

    /* =========================================================
       FRACTAL FLAME (experiments/flame05.py: accumulate + finish)
       ========================================================= */

    class FlameSampler {
        width: number;
        height: number;
        hist: Float32Array;
        rng: FastPCG64;
        count = 32768;
        zr: Float64Array;
        zi: Float64Array;
        col: Float64Array;
        choice: Uint8Array;
        step = 0;
        cdf: number[];
        cosA: number;
        sinA: number;
        constructor(width: number, seed: number, angle: number) {
            this.width = width;
            this.height = Math.floor((width * 9) / 16);
            this.hist = new Float32Array(this.width * this.height * 4);
            this.rng = new FastPCG64(seed);
            this.zr = new Float64Array(this.count);
            this.zi = new Float64Array(this.count);
            this.col = new Float64Array(this.count).fill(0.5);
            this.choice = new Uint8Array(this.count);
            // rng.uniform(-1, 1, count) for the real parts, then the imaginary parts.
            for (let i = 0; i < this.count; i++) this.zr[i] = -1 + 2 * this.rng.random();
            for (let i = 0; i < this.count; i++) this.zi[i] = -1 + 2 * this.rng.random();
            const w = SILVER.weights;
            const c0 = w[0], c1 = c0 + w[1], c2 = c1 + w[2];
            this.cdf = [c0 / c2, c1 / c2, c2 / c2];
            this.cosA = Math.cos(angle);
            this.sinA = Math.sin(angle);
        }
        advance() {
            const { count, zr, zi, col, choice, rng, cdf } = this;
            for (let i = 0; i < count; i++) {
                const u = rng.random();
                choice[i] = u >= cdf[0] ? (u >= cdf[1] ? (u >= cdf[2] ? 3 : 2) : 1) : 0;
            }
            const tones = [0.12, 0.68, 0.95];
            for (let t = 0; t < 3; t++) {
                const [a, b, c, d, e, f, variation] = SILVER.transforms[t];
                let bcnt = 0;
                let buf = 0;
                for (let i = 0; i < count; i++) {
                    if (choice[i] !== t) continue;
                    let wr = a * zr[i] + b * zi[i] + c;
                    let wi = d * zr[i] + e * zi[i] + f;
                    if (variation === "swirl") {
                        const ang = Math.PI / 2 - (wr * wr + wi * wi);
                        const ca = Math.cos(ang), sa = Math.sin(ang);
                        const nr = wr * ca - wi * sa;
                        wi = wr * sa + wi * ca;
                        wr = nr;
                    } else if (variation === "spherical") {
                        const den = Math.max(wr * wr + wi * wi, 0.04);
                        wr /= den;
                        wi /= den;
                    } else {
                        const m = Math.hypot(wr, wi);
                        const sr = Math.sqrt((m + wr) / 2);
                        let si = Math.sqrt((m - wr) / 2);
                        if (wi < 0) si = -si;
                        // rng.choice([-1, 1]) -> integers(0, 2): buffered 32-bit Lemire draws.
                        let word: number;
                        if (bcnt === 0) {
                            rng.next64();
                            word = rng.lo;
                            buf = rng.hi;
                            bcnt = 1;
                        } else {
                            word = buf;
                            bcnt = 0;
                        }
                        const sign = word >>> 31 ? 1 : -1;
                        wr = sr * sign;
                        wi = si * sign;
                    }
                    zr[i] = wr;
                    zi[i] = wi;
                    col[i] = (col[i] + tones[t]) * 0.5;
                }
            }
            if (this.step++ < 30) return;
            const { width, height, hist, cosA, sinA } = this;
            const sc = height / SILVER.span, ox = width * 0.65, oy = height * 0.5;
            for (let i = 0; i < count; i++) {
                const qr = zr[i] * cosA - zi[i] * sinA;
                const qi = zr[i] * sinA + zi[i] * cosA;
                const X = qr * sc + ox, Y = oy - qi * sc;
                const ix = Math.floor(X), iy = Math.floor(Y);
                if (ix < 0 || ix >= width - 1 || iy < 0 || iy >= height - 1) continue;
                const fx = X - ix, fy = Y - iy, h = col[i];
                let wm = Math.min(1, Math.max(0, (h - 0.4) / 0.24));
                wm = wm * wm * (3 - 2 * wm);
                const p = (iy * width + ix) * 4;
                const q = p + width * 4;
                const w00 = (1 - fx) * (1 - fy), w10 = fx * (1 - fy), w01 = (1 - fx) * fy, w11 = fx * fy;
                const hh = h * h;
                hist[p] += w00; hist[p + 1] += w00 * h; hist[p + 2] += w00 * hh; hist[p + 3] += w00 * wm;
                hist[p + 4] += w10; hist[p + 5] += w10 * h; hist[p + 6] += w10 * hh; hist[p + 7] += w10 * wm;
                hist[q] += w01; hist[q + 1] += w01 * h; hist[q + 2] += w01 * hh; hist[q + 3] += w01 * wm;
                hist[q + 4] += w11; hist[q + 5] += w11 * h; hist[q + 6] += w11 * hh; hist[q + 7] += w11 * wm;
            }
        }
    }

    function gaussian4(src: Float32Array, w: number, h: number, sigma: number) {
        const radius = Math.max(1, Math.ceil(3 * sigma));
        const k: number[] = [];
        let sum = 0;
        for (let x = -radius; x <= radius; x++) {
            const value = Math.exp(-0.5 * (x / sigma) ** 2);
            k.push(value);
            sum += value;
        }
        for (let i = 0; i < k.length; i++) k[i] /= sum;
        const tmp = new Float32Array(src.length);
        const out = new Float32Array(src.length);
        for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
                let a0 = 0, a1 = 0, a2 = 0, a3 = 0;
                for (let j = -radius; j <= radius; j++) {
                    const xx = x + j;
                    if (xx < 0 || xx >= w) continue;
                    const q = (y * w + xx) * 4, kw = k[j + radius];
                    a0 += src[q] * kw; a1 += src[q + 1] * kw; a2 += src[q + 2] * kw; a3 += src[q + 3] * kw;
                }
                const o = (y * w + x) * 4;
                tmp[o] = a0; tmp[o + 1] = a1; tmp[o + 2] = a2; tmp[o + 3] = a3;
            }
        }
        for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
                let a0 = 0, a1 = 0, a2 = 0, a3 = 0;
                for (let j = -radius; j <= radius; j++) {
                    const yy = y + j;
                    if (yy < 0 || yy >= h) continue;
                    const q = (yy * w + x) * 4, kw = k[j + radius];
                    a0 += tmp[q] * kw; a1 += tmp[q + 1] * kw; a2 += tmp[q + 2] * kw; a3 += tmp[q + 3] * kw;
                }
                const o = (y * w + x) * 4;
                out[o] = a0; out[o + 1] = a1; out[o + 2] = a2; out[o + 3] = a3;
            }
        }
        return out;
    }

    function flameFinish(hist: Float32Array, w: number, h: number, gain: number, goldGain: number) {
        const N = w * h;
        let total = 0;
        for (let i = 0; i < N; i++) total += hist[i * 4];
        const mean = total / w / h;
        const sharp = gaussian4(hist, w, h, SILVER.minimum_sigma);
        const soft = gaussian4(hist, w, h, SILVER.maximum_sigma);
        const field = new Float32Array(N * 4);
        for (let i = 0; i < N; i++) {
            const mix = Math.exp(-sharp[i * 4] / Math.max(mean * 0.3, 1e-10));
            for (let c = 0; c < 4; c++) field[i * 4 + c] = sharp[i * 4 + c] * (1 - mix) + soft[i * 4 + c] * mix;
        }
        const intensity = new Float64Array(N);
        const occupied: number[] = [];
        for (let i = 0; i < N; i++) {
            const value = Math.log1p((field[i * 4] / Math.max(mean, 1e-10)) * 32);
            intensity[i] = value;
            if (value > 0) occupied.push(value);
        }
        let scale = 1;
        if (occupied.length) {
            const sorted = Float64Array.from(occupied).sort();
            const pos = (sorted.length - 1) * 0.9985;
            const lo = Math.floor(pos);
            scale = lo + 1 < sorted.length ? sorted[lo] + (sorted[lo + 1] - sorted[lo]) * (pos - lo) : sorted[lo];
        }
        const out = new Uint8ClampedArray(N * 4);
        for (let i = 0; i < N; i++) {
            const density = field[i * 4];
            const chroma = field[i * 4 + 1] / Math.max(density, 1e-10);
            const relative = density / Math.max(mean, 1e-10);
            let I = Math.pow(intensity[i] / Math.max(scale, 1e-10), SILVER.gamma);
            I *= 1 - Math.exp(-relative / SILVER.toe);
            const ratio = sharp[i * 4] / Math.max(soft[i * 4], 1e-10);
            I *= 1 + SILVER.detail * Math.min(0.8, Math.max(-0.4, ratio - 1));
            const px = i % w, py = Math.floor(i / w);
            const x = (px / w - 0.7) * (w / h), y = py / h - 0.49;
            let outer = Math.min(1, Math.max(0, (Math.sqrt(x * x + y * y) - 0.26) / 0.23));
            outer = outer * outer * (3 - 2 * outer);
            const blue = Math.min(1, Math.max(0, (0.52 - chroma) / 0.18));
            const ang = 0.5 + 0.5 * Math.cos(Math.atan2(y, x) + 0.7);
            I *= 1 - SILVER.arc_quiet * outer * blue * (0.38 + 0.62 * ang * ang);
            I *= 1 + SILVER.nexus_light * Math.exp(-(((px / w - 0.555) / 0.075) ** 2) - ((py / h - 0.5) / 0.125) ** 2);
            const warmD = Math.min(Math.max(field[i * 4 + 3], 0), density);
            const coolD = Math.max(0, density - warmD);
            const wf = warmD / Math.max(density, 1e-10);
            const wl = Math.log1p((warmD / Math.max(mean, 1e-10)) * 32) / Math.max(scale, 1e-10);
            const cl = Math.log1p((coolD / Math.max(mean, 1e-10)) * 32) / Math.max(scale, 1e-10);
            const comb = Math.max(wl + cl, 1e-10);
            const wc = Math.min(1, Math.max(0, wl)), cc = Math.min(1, Math.max(0, cl));
            const gold = [244 + 5 * wc, 178 + 48 * wc, 85 + 88 * wc];
            const bl = [18 + 50 * cc, 85 + 79 * cc, 149 + 52 * cc];
            for (let ch = 0; ch < 3; ch++) {
                let value = ((bl[ch] * cl * (1 - 0.35 * wf) + gold[ch] * wl * goldGain) / comb) * I * gain;
                value = 255 * (1 - Math.exp(-Math.max(value, 0) / 255));
                out[i * 4 + ch] = Math.floor(Math.min(254, Math.max(0, value)));
            }
            out[i * 4 + 3] = 255;
        }
        return out;
    }

    /* =========================================================
       JULIA FILIGREE (experiments/filigree_study.py)
       ========================================================= */

    async function renderJulia(cfg: JuliaCfg, width: number, token: number, onProgress: (f: number) => void) {
        const ss = 2;
        const sw = width * ss;
        const sh = Math.floor((sw * 9) / 16);
        const N = sw * sh;
        const dist = new Float32Array(N), esc = new Float32Array(N), logd = new Float32Array(N);
        const act = new Uint8Array(N);
        const rgb = new Uint8Array(N * 3);
        const [cr, ci] = cfg.c;
        // Lighting keeps the 800-pixel preview's derivative spacing at larger sizes.
        const gradScale = ss * (width / 800);
        let last = performance.now();
        for (let vIndex = 0; vIndex < cfg.views.length; vIndex++) {
            const view = cfg.views[vIndex];
            const cosA = Math.cos(view.angle), sinA = Math.sin(view.angle);
            const scale = sh / view.span;
            for (let py = 0; py < sh; py++) {
                const y = (sh * view.center[1] - py) / scale;
                for (let px = 0; px < sw; px++) {
                    const x = (px - sw * view.center[0]) / scale;
                    let zr = x * cosA - y * sinA + view.offset[0];
                    let zi = x * sinA + y * cosA + view.offset[1];
                    let dr = 1, di = 0, d = 1e-8, e = 0, active = 1;
                    for (let k = 0; k < cfg.iterations; k++) {
                        const ndr = 2 * (zr * dr - zi * di);
                        di = 2 * (zr * di + zi * dr);
                        dr = ndr;
                        const nzr = zr * zr - zi * zi + cr;
                        zi = 2 * zr * zi + ci;
                        zr = nzr;
                        const r = Math.hypot(zr, zi);
                        if (r > 32) {
                            d = (0.5 * r * Math.log(r)) / Math.max(Math.hypot(dr, di), 1e-20);
                            e = k + 1 - Math.log2(Math.max(1, Math.log2(r)));
                            active = 0;
                            break;
                        }
                    }
                    const i = py * sw + px;
                    dist[i] = d;
                    esc[i] = e;
                    act[i] = active;
                    logd[i] = Math.log(d + 0.001);
                }
                if (performance.now() - last > 30) {
                    onProgress(((vIndex + (py / sh) * 0.8) / cfg.views.length));
                    await nextFrame();
                    if (token !== renderToken) return null;
                    last = performance.now();
                }
            }
            const { cool, warm } = cfg;
            for (let py = 0; py < sh; py++) {
                for (let px = 0; px < sw; px++) {
                    const i = py * sw + px;
                    if (act[i]) continue;
                    const band = Math.exp(-dist[i] * cfg.falloff);
                    const gx = (px === 0 ? logd[i + 1] - logd[i] : px === sw - 1 ? logd[i] - logd[i - 1] : (logd[i + 1] - logd[i - 1]) / 2) * gradScale;
                    const gy = (py === 0 ? logd[i + sw] - logd[i] : py === sh - 1 ? logd[i] - logd[i - sw] : (logd[i + sw] - logd[i - sw]) / 2) * gradScale;
                    const norm = Math.sqrt(gx * gx + gy * gy + 0.02);
                    const light = 0.35 + 0.65 * Math.max(0, (-gx * 0.5 - gy * 0.7 + 0.13) / norm);
                    const rc = Math.cos(esc[i] * cfg.rhythm_frequency);
                    const bs = 0.5 + 0.5 * Math.sin(esc[i] * cfg.color_frequency + cfg.color_phase);
                    let f = band * (0.65 + 0.35 * rc * rc) * light * cfg.gain * view.gain;
                    if (cfg.key) {
                        const [kx, ky, sx, sy, amount] = cfg.key;
                        f *= 1 - amount + amount * Math.exp(-(((px / sw - kx) / sx) ** 2) - ((py / sh - ky) / sy) ** 2);
                    }
                    for (let ch = 0; ch < 3; ch++) {
                        const value = Math.floor(Math.min(240, Math.max(0, (cool[ch] + (warm[ch] - cool[ch]) * bs * bs) * f)));
                        if (value > rgb[i * 3 + ch]) rgb[i * 3 + ch] = value;
                    }
                }
            }
        }
        const h = Math.floor((width * 9) / 16);
        const image = new ImageData(width, h);
        const out = image.data;
        for (let y = 0; y < h; y++) {
            for (let x = 0; x < width; x++) {
                const o = (y * width + x) * 4;
                for (let ch = 0; ch < 3; ch++) {
                    const a = ((y * 2) * sw + x * 2) * 3 + ch;
                    out[o + ch] = (rgb[a] + rgb[a + 3] + rgb[a + sw * 3] + rgb[a + sw * 3 + 3] + 2) >> 2;
                }
                out[o + 3] = 255;
            }
        }
        onProgress(1);
        return image;
    }

