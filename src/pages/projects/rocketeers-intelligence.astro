</html>

<script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = <T extends Element = HTMLElement>(r: ParentNode, s: string) => r.querySelector(s) as T | null;
    const $$ = <T extends Element = HTMLElement>(r: ParentNode, s: string) => Array.from(r.querySelectorAll(s)) as T[];
    const setText = (r: ParentNode, k: string, v: string) => { const el = $(r, `[data-out="${k}"]`); if (el) el.textContent = v; };

    /* Count-up */
    const groups = $$(document, "[data-count-group]");
    const run = (g: HTMLElement) => {
        g.classList.add("is-in");
        $$(g, "[data-count]").forEach((el) => {
            const target = Number(el.dataset.count);
            if (reduceMotion || !target) { el.textContent = String(target); return; }
            const t0 = performance.now();
            const tick = (now: number) => {
                const p = Math.min(1, (now - t0) / 1000);
                el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
                if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        });
    };
    if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } }), { threshold: 0.3 });
        groups.forEach((g) => io.observe(g));
    } else groups.forEach(run);

    /* Before / after */
    const ba = $(document, "[data-ba]");
    if (ba) {
        $$<HTMLButtonElement>(ba, "[data-ba-btn]").forEach((b) => b.addEventListener("click", () => {
            $$(ba, "[data-ba-btn]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
            $$(ba, "[data-ba-panel]").forEach((p) => (p.hidden = p.dataset.baPanel !== b.dataset.baBtn));
        }));
    }

    /* Workflow lanes */
    const flow = $(document, "[data-flow]");
    if (flow) {
        const nodes = $$<HTMLButtonElement>(flow, "[data-node]");
        const select = (key: string) => {
            nodes.forEach((n) => n.setAttribute("aria-pressed", String(n.dataset.node === key)));
            $$(flow, "[data-detail]").forEach((d) => (d.hidden = d.dataset.detail !== key));
        };
        nodes.forEach((n) => n.addEventListener("click", () => { stop(); select(n.dataset.node!); }));
        const playBtn = $<HTMLButtonElement>(flow, "[data-flow-play]")!;
        let timer: number | undefined;
        let i = 0;
        const stop = () => {
            window.clearTimeout(timer); timer = undefined;
            playBtn.textContent = "▶ Run the slice";
        };
        const step = () => {
            nodes.forEach((n, j) => { n.classList.toggle("is-done", j < i); n.classList.toggle("is-live", j === i); });
            const n = nodes[i];
            select(n.dataset.node!);
            setText(flow, "flowStatus", `Executing ${i + 1}/${nodes.length}: ${$(n, ".node-name")!.textContent}`);
            i++;
            if (i < nodes.length) timer = window.setTimeout(step, reduceMotion ? 400 : 1500);
            else {
                timer = window.setTimeout(() => {
                    nodes.forEach((x) => { x.classList.remove("is-live"); x.classList.add("is-done"); });
                    setText(flow, "flowStatus", "Round trip complete: run finalised, Sheets synced, reviews stored");
                    stop();
                }, 1200);
            }
        };
        playBtn.addEventListener("click", () => {
            if (timer) { stop(); setText(flow, "flowStatus", "Paused"); return; }
            if (i >= nodes.length) { i = 0; nodes.forEach((x) => x.classList.remove("is-done", "is-live")); }
            playBtn.textContent = "❚❚ Pause";
            step();
        });
    }

    /* Schema diagram: highlight references and draw FK lines */
    const schema = $(document, "[data-schema]");
    if (schema) {
        const map = $(schema, ".schema-map")!;
        const svg = $(schema, ".schema-lines") as unknown as SVGSVGElement;
        const tbls = $$<HTMLButtonElement>(schema, "[data-table]");
        const byId = (id: string) => tbls.find((t) => t.dataset.table === id);
        let active = "asset_discoveries";
        const draw = () => {
            const box = map.getBoundingClientRect();
            svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
            const paths: string[] = [];
            tbls.forEach((t) => {
                (t.dataset.refs || "").split(" ").filter(Boolean).forEach((r) => {
                    const target = byId(r);
                    if (!target || target === t) return;
                    const a = t.getBoundingClientRect(), b = target.getBoundingClientRect();
                    const x1 = a.left + a.width / 2 - box.left, y1 = a.top + a.height / 2 - box.top;
                    const x2 = b.left + b.width / 2 - box.left, y2 = b.top + b.height / 2 - box.top;
                    const hot = t.dataset.table === active || r === active;
                    const mx = (x1 + x2) / 2;
                    paths.push(`<path class="${hot ? "hot" : ""}" d="M${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}" />`);
                });
            });
            svg.innerHTML = paths.join("");
        };
        const select = (id: string) => {
            active = id;
            const refs = (byId(id)?.dataset.refs || "").split(" ");
            tbls.forEach((t) => {
                const tid = t.dataset.table!;
                t.setAttribute("aria-pressed", String(tid === id));
                const related = refs.includes(tid) || (t.dataset.refs || "").split(" ").includes(id);
                t.classList.toggle("is-related", tid !== id && related);
            });
            $$(schema, "[data-tdetail]").forEach((d) => (d.hidden = d.dataset.tdetail !== id));
            draw();
        };
        tbls.forEach((t) => t.addEventListener("click", () => select(t.dataset.table!)));
        window.addEventListener("resize", draw);
        select(active);
        // Fonts or reveal motion can shift layout after load.
        window.setTimeout(draw, 900);
    }

    /* Idempotency lab */
    const idem = $(document, "[data-idem]");
    if (idem) {
        type Counts = Record<string, number>;
        const zero = (): Counts => ({ runs: 0, source_events: 0, assets: 0, asset_discoveries: 0, asset_rights: 0, human_reviews: 0 });
        let c = zero();
        let ran = 0, synced = false, changed = 0;
        const log = $(idem, '[data-out="idemLog"]')!;
        const line = (t: string, tone = "") => {
            const li = document.createElement("li"); li.textContent = t; if (tone) li.dataset.tone = tone;
            log.prepend(li); while (log.children.length > 8) log.lastElementChild?.remove();
        };
        const paint = (prev: Counts) => {
            $$(idem, "[data-counter]").forEach((el) => {
                const k = el.dataset.counter!;
                const d = c[k] - prev[k];
                $(el, "[data-v]")!.textContent = String(c[k]);
                const delta = $(el, "[data-delta]")!;
                delta.textContent = d ? `+${d}` : ran || synced ? "±0" : "";
                el.dataset.tone = d ? "grow" : ran || synced ? "same" : "";
                el.classList.remove("bump"); void (el as HTMLElement).offsetWidth; el.classList.add("bump");
            });
        };
        const act = (a: string) => {
            const prev = { ...c };
            if (a === "run") {
                ran++;
                c.runs++; c.source_events++;
                if (ran === 1) { c.assets = 10; c.asset_discoveries = 10; c.asset_rights = 10; }
                line(`Run ${ran}: RUN-… registered → 1 response stored → 10 rows upserted → ${ran === 1 ? "10 inserted" : "0 inserted, 10 updated in place"} → succeeded`, ran === 1 ? "ok" : "info");
            } else if (a === "sync") {
                if (!ran) { line("No discoveries yet: the sync finds no matching evidence_key rows", "warn"); return; }
                if (!synced) { synced = true; c.human_reviews += 14; line("Sync: 10 relevance + 4 rights decisions → 14 inserted", "ok"); }
                else if (changed) { c.human_reviews += 1; changed = 0; line("Sync: 1 decision differs from the latest → 1 inserted with supersedes_review_id; 13 unchanged", "ok"); }
                else line("Sync: every decision matches the latest review → 0 inserted (inserted = false)", "info");
            } else if (a === "change") {
                if (!synced) { line("Sync once first so there is a review to change", "warn"); return; }
                changed = 1; line("Sheet edit: one relevance_review changed from Reject to Approve (not yet synced)", "warn");
            } else {
                c = zero(); ran = 0; synced = false; changed = 0; log.replaceChildren();
                line("Fresh database: migration applied, 4 sources seeded");
            }
            paint(prev);
        };
        $$<HTMLButtonElement>(idem, "[data-act]").forEach((b) => b.addEventListener("click", () => act(b.dataset.act!)));
        line("Fresh database: migration applied, 4 sources seeded");
    }

    /* Evidence key builder */
    const keylab = $(document, "[data-keylab]");
    if (keylab) {
        const niche = $<HTMLInputElement>(keylab, '[name="k_niche"]')!;
        const obj = $<HTMLInputElement>(keylab, '[name="k_obj"]')!;
        const stored = ["N001|AIC|100001", "N001|AIC|100002", "N001|AIC|100003"];
        const render = () => {
            const key = `${niche.value.trim()}|AIC|${String(obj.value.trim())}`;
            setText(keylab, "key", key);
            const hit = stored.includes(key);
            const v = $(keylab, '[data-out="keyVerdict"]')!;
            v.textContent = hit ? "DO UPDATE: existing discovery refreshed, no new row" : "INSERT: new discovery row for this niche";
            v.dataset.tone = hit ? "same" : "grow";
            setText(keylab, "keyStore", stored.join(", "));
        };
        keylab.addEventListener("input", render);
        render();
    }

    /* Review history */
    const review = $(document, "[data-review]");
    if (review) {
        type Rev = { id: number; type: string; decision: string; sup: number | null };
        const hist: Rev[] = [];
        let n = 0;
        const list = $(review, '[data-out="history"]')!;
        const paint = () => {
            list.replaceChildren(...hist.slice().reverse().map((r) => {
                const li = document.createElement("li");
                li.innerHTML = `<code>#${r.id}</code> <b></b> <span></span>${r.sup ? ` <em>supersedes #${r.sup}</em>` : ""}`;
                li.querySelector("b")!.textContent = r.type;
                li.querySelector("span")!.textContent = r.decision;
                return li;
            }));
        };
        const latest = (type: string) => hist.filter((h) => h.type === type).at(-1);
        $(review, "[data-sync]")!.addEventListener("click", () => {
            let inserted = 0;
            ([["relevance", "rel"], ["rights", "rights"]] as const).forEach(([type, name]) => {
                const decision = $<HTMLSelectElement>(review, `[name="${name}"]`)!.value.trim();
                if (!decision) return;
                const last = latest(type);
                if (!last || last.decision !== decision) {
                    hist.push({ id: ++n, type, decision, sup: last ? last.id : null });
                    inserted++;
                }
            });
            setText(review, "syncMsg", inserted ? `${inserted} review event${inserted > 1 ? "s" : ""} inserted.` : "0 inserted: nothing changed since the last sync.");
            paint();
        });
        setText(review, "syncMsg", "Nothing synced yet.");
    }

    /* Rights protection */
    const rights = $(document, "[data-rights]");
    if (rights) {
        let status = "provider_claim_only";
        const paint = (note: string) => {
            setText(rights, "rstatus", status);
            setText(rights, "rnote", note);
            $(rights, '[data-out="rstatus"]')!.dataset.s = status;
        };
        $$<HTMLButtonElement>(rights, "[data-r]").forEach((b) => b.addEventListener("click", () => {
            const r = b.dataset.r;
            if (r === "verify") { status = "independently_verified"; paint("A reviewer confirmed the rights at the institution."); }
            else if (r === "rerun") {
                paint(status === "independently_verified"
                    ? "Re-ingested claim arrived as provider_claim_only; the CASE expression kept independently_verified."
                    : "Re-ingested claim: status refreshed to provider_claim_only.");
            } else { status = "provider_claim_only"; paint("Captured from the provider's public-domain claim."); }
        }));
    }
</script>

<style>
    :root {
        --bg: #06111e;
        --surface: #091b2b;
        --surface-2: #0b2236;
        --border: #1f3d57;
        --text: #d8e4ee;
        --muted: #9fb2c2;
        --subtle: #7890a3;
        --blue: #168dff;
        --blue-light: #65baff;
        --orange: #ff8a00;
        --green: #26d5a2;
        --amber: #ffc24d;
        --red: #ff6b6b;
        --violet: #a98bff;
        --pg: #5aa2ff;
        --mono: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
        --page-width: 1240px;
    }

    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { scroll-behavior: smooth; background: var(--bg); }

    body {
        min-height: 100vh;
        margin: 0;
        color: var(--text);
        background:
            radial-gradient(circle at 12% 6%, rgba(38, 213, 162, 0.08), transparent 28rem),
            radial-gradient(circle at 90% 10%, rgba(22, 141, 255, 0.13), transparent 30rem),
            radial-gradient(circle at 80% 70%, rgba(169, 139, 255, 0.05), transparent 30rem),
            var(--bg);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    main, footer {
        width: min(100%, var(--page-width));
        margin-inline: auto;
        padding-inline: clamp(1rem, 5vw, 4.5rem);
    }

    a { color: inherit; text-underline-offset: 0.25em; }
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }

    h1, h2, h3, p { margin-top: 0; }
    h1, h3 { color: #fff; }
    h1 {
        max-width: 1000px;
        margin: 0 auto 1.4rem;
        font-size: clamp(2.4rem, 6.4vw, 5.4rem);
        line-height: 1;
        letter-spacing: -0.05em;
        overflow-wrap: anywhere;
    }
    h2 {
        margin-bottom: 1rem;
        color: #fff;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2rem, 4.6vw, 3.6rem);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.045em;
    }
    h3 { font-size: 1.12rem; }
    code, pre { font-family: var(--mono); }
    p code, li code { color: var(--blue-light); font-size: 0.88em; }

    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    .eyebrow { margin-bottom: 1rem; color: var(--orange); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
    .kicker { display: block; margin-bottom: 0.45rem; color: var(--orange); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
    .accent {
        background: linear-gradient(90deg, var(--green), var(--blue-light) 55%, var(--blue));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .muted-note { color: var(--subtle); font-size: 0.8rem; line-height: 1.55; }
    .footnote { max-width: 860px; margin-top: 1.2rem; color: var(--subtle); font-size: 0.84rem; line-height: 1.65; }

    .card {
        padding: clamp(1.1rem, 2.5vw, 1.5rem);
        border: 1px solid var(--border);
        border-radius: 16px;
        background: linear-gradient(160deg, rgba(14, 40, 62, 0.65), rgba(9, 27, 43, 0.85));
        transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }
    .card:hover { border-color: rgba(38, 213, 162, 0.5); transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25); }
    .card p { margin-bottom: 0; color: var(--muted); line-height: 1.65; font-size: 0.92rem; }

    /* HERO */
    .hero { padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2.5rem, 5vw, 4rem); text-align: center; }
    .breadcrumbs { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; color: var(--subtle); font-size: 0.8rem; }
    .breadcrumbs a { text-decoration: none; }
    .breadcrumbs a:hover { color: #fff; }
    .breadcrumbs strong { color: var(--green); }
    .hero-lead { max-width: 820px; margin: 0 auto; color: #dce6ee; font-size: clamp(1.02rem, 1.8vw, 1.2rem); line-height: 1.7; }

    .hero-graph {
        max-width: 860px;
        margin: 2.2rem auto 0;
        padding: 0.8rem;
        border: 1px solid var(--border);
        border-radius: 20px;
        background:
            radial-gradient(circle, rgba(101, 186, 255, 0.12) 1px, transparent 1.5px) 0 0 / 18px 18px,
            rgba(7, 21, 34, 0.75);
    }
    .hero-graph svg { display: block; width: 100%; height: auto; }
    .edge { fill: none; stroke: url(#rg-edge); stroke-width: 2; stroke-dasharray: 5 6; opacity: 0.7; animation: dash 1.6s linear infinite; }
    .edge.back { stroke: var(--orange); opacity: 0.45; }
    .pulse { fill: var(--blue-light); filter: drop-shadow(0 0 6px var(--blue-light)); }
    .pulse.back { fill: var(--orange); filter: drop-shadow(0 0 6px var(--orange)); }
    .gnode rect { fill: #0b2236; stroke: #2b5375; stroke-width: 1.5; }
    .gnode text { fill: #fff; font: 700 14px Inter, system-ui, sans-serif; text-anchor: middle; }
    .gnode text.s { fill: var(--muted); font-size: 10.5px; font-weight: 500; }
    .gnode.n8n rect { stroke: #ff6d5a; }
    .gnode.pg rect { stroke: var(--pg); fill: rgba(90, 162, 255, 0.12); }
    .gnode.api rect { stroke: var(--violet); }
    .gnode.sheet rect { stroke: var(--green); fill: rgba(38, 213, 162, 0.08); }
    @keyframes dash { to { stroke-dashoffset: -22; } }

    .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 2rem; }
    .button {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 46px; padding: 0.8rem 1.2rem;
        border: 1px solid var(--blue); border-radius: 9px;
        color: #fff; font-size: 0.86rem; font-weight: 750; text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .button:hover { transform: translateY(-2px); }
    .button-primary { background: var(--blue); }
    .button-secondary { background: rgba(7, 21, 34, 0.8); }
    .button-secondary:hover { border-color: var(--green); }

    .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; padding-bottom: clamp(3.5rem, 7vw, 5rem); text-align: center; }
    .metric-card { padding: 1.3rem 1rem; border: 1px solid var(--border); border-radius: 14px; background: rgba(9, 27, 43, 0.85); transition: transform 0.25s ease, border-color 0.25s ease; }
    .metric-card:hover { transform: translateY(-3px); border-color: var(--green); }
    .metric-card strong { display: block; margin-bottom: 0.45rem; color: var(--green); font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-variant-numeric: tabular-nums; }
    .metric-card span { color: var(--muted); font-size: 0.82rem; line-height: 1.45; }

    .case-section { padding: clamp(4rem, 8vw, 6.5rem) 0; border-top: 1px solid rgba(31, 61, 87, 0.8); }
    .section-heading { max-width: 820px; margin-bottom: 2.2rem; }
    .section-heading > p:last-child { color: var(--muted); line-height: 1.75; }
    .section-heading.centered { margin-inline: auto; text-align: center; }

    .ctl {
        min-height: 40px; padding: 0.55rem 0.95rem;
        border: 1px solid #2b5375; border-radius: 9px;
        background: var(--surface); color: #e6eef5;
        font: inherit; font-size: 0.82rem; font-weight: 700; cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .ctl:hover { transform: translateY(-1px); border-color: var(--blue-light); }
    .ctl-primary { border-color: var(--blue); background: var(--blue); color: #fff; }

    .code {
        min-width: 0; max-width: 100%; margin: 0; padding: 1rem 1.1rem;
        overflow-x: auto; border: 1px solid #1c3a55; border-radius: 12px;
        background: #040c16; color: #bfe0ff; font-size: 0.74rem; line-height: 1.6; white-space: pre;
    }

    .lab { padding: clamp(1rem, 2.5vw, 1.6rem); border: 1px solid var(--border); border-radius: 20px; background: rgba(7, 21, 34, 0.75); }
    .lab + .lab { margin-top: 1.2rem; }
    .lab p { color: var(--muted); line-height: 1.65; font-size: 0.9rem; }

    /* before / after */
    .ba { max-width: 900px; }
    .ba-toggle { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; padding: 0.3rem; border: 1px solid var(--border); border-radius: 12px; background: rgba(4, 12, 22, 0.6); }
    .seg { padding: 0.55rem 0.9rem; border: 0; border-radius: 9px; background: transparent; color: var(--muted); font: inherit; font-size: 0.84rem; font-weight: 700; cursor: pointer; transition: background 0.2s ease, color 0.2s ease; }
    .seg[aria-pressed="true"] { background: var(--surface-2); color: #fff; box-shadow: inset 0 0 0 1px #2b5375; }
    .ba-panel { margin-top: 1rem; animation: panel-in 0.35s ease both; }
    .ba-list { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
    .ba-list li { padding: 0.8rem 1rem; border: 1px solid var(--border); border-left: 3px solid var(--blue); border-radius: 10px; background: rgba(9, 27, 43, 0.85); color: var(--muted); font-size: 0.9rem; line-height: 1.5; animation: row-in 0.35s ease both; }
    .ba-list li:nth-child(2) { animation-delay: 0.05s; }
    .ba-list li:nth-child(3) { animation-delay: 0.1s; }
    .ba-list li:nth-child(4) { animation-delay: 0.15s; }
    .ba-list li:nth-child(5) { animation-delay: 0.2s; }
    .ba-list b { margin-right: 0.4rem; color: #fff; font-family: var(--mono); font-size: 0.82rem; }
    .ba-list li.bad { border-left-color: var(--red); }
    .ba-list li.good { border-left-color: var(--green); }

    /* workflow */
    .flow { padding: clamp(1rem, 2.5vw, 1.6rem); border: 1px solid var(--border); border-radius: 20px; background: rgba(7, 21, 34, 0.75); }
    .flow-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-bottom: 1.2rem; }
    .flow-status { color: var(--muted); font-family: var(--mono); font-size: 0.78rem; }
    .lane { margin-bottom: 1rem; }
    .lane-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; margin-bottom: 0.5rem; }
    .lane-head strong { color: #fff; font-size: 0.86rem; }
    .lane-head span { color: var(--subtle); font-size: 0.76rem; }
    .nodes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
    .nodes li { position: relative; display: flex; align-items: center; }
    .node {
        display: grid; gap: 0.15rem; min-width: 0; max-width: 220px;
        padding: 0.55rem 0.75rem; border: 1px solid #2b5375; border-left: 3px solid var(--k);
        border-radius: 10px; background: var(--surface); color: #e6eef5;
        font: inherit; text-align: left; cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.25s ease, box-shadow 0.25s ease;
    }
    .node:hover { transform: translateY(-2px); }
    .node-kind { color: var(--k); font-family: var(--mono); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
    .node-name { font-size: 0.78rem; font-weight: 650; line-height: 1.3; }
    .k-postgres { --k: var(--pg); }
    .k-http { --k: var(--violet); }
    .k-code { --k: var(--amber); }
    .k-set { --k: var(--orange); }
    .k-subflow { --k: #ff6d5a; }
    .k-sheets { --k: var(--green); }
    .node[aria-pressed="true"] { border-color: var(--k); background: var(--surface-2); box-shadow: 0 0 0 3px rgba(101, 186, 255, 0.12); }
    .node.is-live { border-color: var(--orange); box-shadow: 0 0 0 4px rgba(255, 138, 0, 0.18), 0 0 24px rgba(255, 138, 0, 0.25); transform: scale(1.04); }
    .node.is-done { background: rgba(38, 213, 162, 0.07); }
    .node.is-done .node-name::after { content: " ✓"; color: var(--green); }
    .node-detail { margin-top: 1.2rem; }
    .detail { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 1.2rem; animation: panel-in 0.35s ease both; }
    .detail p { color: var(--muted); line-height: 1.65; font-size: 0.92rem; }

    /* schema */
    .schema { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.2rem; align-items: start; }
    .schema-map {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-areas:
            "sources . runs"
            ". events ."
            "assets disc rights"
            ". reviews .";
        gap: 1.6rem 0.8rem;
        padding: 1.4rem 1rem;
        border: 1px solid var(--border);
        border-radius: 20px;
        background:
            radial-gradient(circle, rgba(101, 186, 255, 0.1) 1px, transparent 1.5px) 0 0 / 16px 16px,
            rgba(7, 21, 34, 0.75);
    }
    .schema-lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .schema-lines :global(path) { fill: none; stroke: #2b5375; stroke-width: 1.5; stroke-dasharray: 4 5; transition: stroke 0.3s ease; }
    .schema-lines :global(path.hot) { stroke: var(--green); stroke-width: 2; stroke-dasharray: none; filter: drop-shadow(0 0 4px rgba(38, 213, 162, 0.6)); }
    .tbl {
        position: relative; z-index: 1; display: grid; gap: 0.2rem;
        padding: 0.7rem 0.6rem; border: 1px solid #2b5375; border-top: 3px solid var(--pg);
        border-radius: 10px; background: #0a1d2e; color: #fff; font: inherit; text-align: center; cursor: pointer;
        transition: transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1), border-color 0.2s ease, box-shadow 0.25s ease;
    }
    .tbl-name { font-family: var(--mono); font-size: 0.76rem; font-weight: 700; overflow-wrap: anywhere; }
    .tbl-meta { color: var(--subtle); font-size: 0.64rem; }
    .tbl:hover { transform: translateY(-3px) rotate(-1deg); }
    .tbl[aria-pressed="true"] { border-color: var(--green); box-shadow: 0 0 0 4px rgba(38, 213, 162, 0.15); transform: scale(1.05); }
    .tbl.is-related { border-color: var(--blue-light); }
    .tbl-sources { grid-area: sources; }
    .tbl-runs { grid-area: runs; }
    .tbl-source_events { grid-area: events; }
    .tbl-assets { grid-area: assets; }
    .tbl-asset_discoveries { grid-area: disc; }
    .tbl-asset_rights { grid-area: rights; }
    .tbl-human_reviews { grid-area: reviews; border-top-color: var(--green); }
    .schema-detail { padding: clamp(1rem, 2.5vw, 1.5rem); border: 1px solid var(--border); border-radius: 20px; background: rgba(7, 21, 34, 0.75); }
    .tdetail { animation: panel-in 0.35s ease both; }
    .tdetail h3 code { color: var(--green); font-size: 1.15rem; }
    .tdetail p { color: var(--muted); line-height: 1.65; font-size: 0.9rem; }
    .refs code { margin-left: 0.35rem; }
    .cols { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; }
    .cols li {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem;
        padding: 0.5rem 0.65rem; border: 1px solid #1c3a55; border-radius: 8px; background: #071628;
        animation: row-in 0.35s ease both; animation-delay: calc(var(--j) * 40ms);
    }
    .cols .c { color: #e6eef5; font-size: 0.76rem; overflow-wrap: anywhere; }
    .cols .type { color: var(--violet); font-family: var(--mono); font-size: 0.68rem; }
    .cols .note { padding: 0.12rem 0.4rem; border-radius: 5px; background: rgba(120, 144, 163, 0.15); color: var(--muted); font-size: 0.66rem; overflow-wrap: anywhere; }
    .cols .note.pk { background: rgba(255, 194, 77, 0.15); color: var(--amber); }
    .cols .note.fk { background: rgba(101, 186, 255, 0.14); color: var(--blue-light); }
    .cols .note.uq { background: rgba(38, 213, 162, 0.14); color: var(--green); }

    /* idempotency */
    .idem-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.1rem; }
    .counters { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.6rem; }
    .counter { display: grid; gap: 0.2rem; padding: 0.8rem 0.6rem; border: 1px solid #1c3a55; border-radius: 12px; background: #071628; text-align: center; transition: border-color 0.3s ease; }
    .counter code { color: var(--muted); font-size: 0.66rem; overflow-wrap: anywhere; }
    .counter strong { color: #fff; font-size: 1.7rem; font-variant-numeric: tabular-nums; }
    .counter span { min-height: 1.1em; font-family: var(--mono); font-size: 0.72rem; }
    .counter[data-tone="grow"] { border-color: var(--blue); }
    .counter[data-tone="grow"] span { color: var(--blue-light); }
    .counter[data-tone="same"] span { color: var(--green); }
    .counter.bump strong { animation: bump 0.45s cubic-bezier(0.3, 1.6, 0.5, 1); }
    @keyframes bump { 40% { transform: scale(1.18); } }
    .log { display: grid; gap: 0.35rem; min-height: 120px; margin: 1rem 0 0; padding: 0.8rem; border: 1px solid #1c3a55; border-radius: 12px; background: #040c16; list-style: none; font-family: var(--mono); font-size: 0.72rem; line-height: 1.5; }
    .log :global(li) { color: #b9cbd9; overflow-wrap: anywhere; animation: row-in 0.3s ease both; }
    .log :global(li)::before { content: "› "; color: var(--subtle); }
    .log :global(li[data-tone="ok"]) { color: var(--green); }
    .log :global(li[data-tone="info"]) { color: var(--blue-light); }
    .log :global(li[data-tone="warn"]) { color: var(--amber); }

    .keylab, .rights { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.2rem; align-items: center; }
    .key-inputs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
    .lab label { display: grid; gap: 0.3rem; color: var(--muted); font-size: 0.76rem; font-weight: 650; }
    .lab input, .lab select {
        width: 100%; min-width: 0; padding: 0.5rem 0.6rem;
        border: 1px solid #23476a; border-radius: 8px; background: #040c16; color: #e8f1f8;
        font-family: var(--mono); font-size: 0.8rem;
    }
    .key-out, .rights-out { padding: 1rem 1.1rem; border: 1px solid #1c3a55; border-radius: 14px; background: #071628; }
    .key { display: block; margin-bottom: 0.9rem; color: #ffd8a8; font-size: 1.05rem; overflow-wrap: anywhere; }
    .key-out strong, .rights-out strong { display: block; font-family: var(--mono); font-size: 0.86rem; overflow-wrap: anywhere; }
    .key-out strong[data-tone="grow"] { color: var(--blue-light); }
    .key-out strong[data-tone="same"] { color: var(--green); }
    .rights-out strong { color: var(--amber); font-size: 1rem; transition: color 0.3s ease; }
    .rights-out strong[data-s="independently_verified"] { color: var(--green); }
    .rights-out p { margin: 0.5rem 0 0; }

    /* review */
    .review { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 1.2rem; }
    .sheet { display: grid; gap: 0.6rem; min-width: 0; }
    .sheet-head, .sheet-row { display: grid; grid-template-columns: 1.2fr 1.2fr 0.7fr 1fr 1fr; gap: 0.4rem; align-items: center; }
    .sheet-head span { color: var(--subtle); font-family: var(--mono); font-size: 0.62rem; overflow-wrap: anywhere; }
    .sheet-row { padding: 0.6rem; border: 1px solid rgba(38, 213, 162, 0.35); border-radius: 10px; background: rgba(38, 213, 162, 0.05); font-size: 0.78rem; }
    .sheet-row code { color: #ffd8a8; font-size: 0.7rem; overflow-wrap: anywhere; }
    .sheet-row > span { color: #e6eef5; overflow-wrap: anywhere; }
    .sheet-row select { padding: 0.35rem; font-size: 0.72rem; }
    .pill { justify-self: start; padding: 0.15rem 0.45rem; border-radius: 99px; font-size: 0.68rem; font-weight: 700; }
    .pill.pass { background: rgba(38, 213, 162, 0.15); color: var(--green) !important; }
    .sheet .ctl { justify-self: start; }
    .history { min-width: 0; padding: 1rem; border: 1px solid #1c3a55; border-radius: 14px; background: #040c16; }
    .history ol { display: grid; gap: 0.35rem; min-height: 70px; margin: 0; padding: 0; list-style: none; }
    .history :global(li) { padding: 0.45rem 0.55rem; border-radius: 7px; background: #0a1d2e; color: #e6eef5; font-size: 0.76rem; animation: row-in 0.3s ease both; overflow-wrap: anywhere; }
    .history :global(li code) { color: var(--subtle); }
    .history :global(li b) { color: var(--blue-light); font-weight: 600; }
    .history :global(li em) { color: var(--amber); font-style: normal; font-size: 0.7rem; }
    .sync-msg { margin: 0.7rem 0 0; font-size: 0.8rem !important; }

