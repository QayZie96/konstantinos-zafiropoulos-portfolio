---
/* =========================================================
   MARKETPLACE PRODUCT OPPORTUNITY INTELLIGENCE
   (Rocketeers Intelligence) — n8n + PostgreSQL case study

   Facts come from the repository README, the SQL migration
   db/migrations/001_core.sql, compose.yaml, the generator
   scripts and the exported n8n workflows. Credentials,
   hostnames, sheet IDs and .env values are deliberately
   omitted. Sample rows in the labs are illustrative.
   ========================================================= */

import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoHead from "../../components/SeoHead.astro";
import SkillLinks from "../../components/SkillLinks.astro";

const title =
    "Marketplace Opportunity Intelligence | n8n & PostgreSQL | Konstantinos Zafeiropoulos";

const description =
    "An n8n and PostgreSQL pipeline that finds public-domain museum artwork for marketplace product niches, stores provider evidence and rights claims, and syncs human reviews from Google Sheets as append-only history.";

const metrics = [
    { value: "7", label: "PostgreSQL tables in the core migration" },
    { value: "10", label: "Provider assets in the validated astronomy run" },
    { value: "14", label: "Human-review events preserved as history" },
    { value: "0", label: "Duplicate evidence keys after repeated runs" },
];

/* ---------- Workflow nodes (from the generator scripts) ---------- */
const lanes = [
    {
        id: "adapter",
        name: "Archive Adapter - AIC - PostgreSQL v0.1",
        role: "Sub-workflow called by the test and orchestrator",
        nodes: [
            {
                name: "Register Research Run",
                kind: "postgres",
                text: "Inserts the run with status 'running', or resets it if the same external run ID is replayed, and returns the run's UUID.",
                code: `INSERT INTO runs (external_run_id, module, status, input, started_at, completed_at)
VALUES ($1, 'asset_discovery_aic', 'running', $2::jsonb, now(), NULL)
ON CONFLICT (external_run_id) DO UPDATE SET
  status = 'running', input = EXCLUDED.input,
  started_at = now(), completed_at = NULL, …
RETURNING run_id, external_run_id;`,
            },
            {
                name: "Search AIC Public Domain Artworks",
                kind: "http",
                text: "Calls the Art Institute of Chicago public search API with the niche's archive query, a public-domain filter, a result limit and a fixed field list.",
                code: `GET https://api.artic.edu/api/v1/artworks/search
  q = {archive_query}
  query[term][is_public_domain] = true
  limit = {limit}
  fields = id,title,artist_display,date_display,place_of_origin,
           artwork_type_title,image_id,is_public_domain,
           copyright_notice,api_link`,
            },
            {
                name: "Store AIC Source Event",
                kind: "postgres",
                text: "Stores the whole provider response once per request, with the request URL and parameters, linked to the run. Postgres generates a SHA-256 of the payload.",
                code: `INSERT INTO source_events (
  run_id, source_id, event_type, request_method, request_url,
  request_params, response_status, raw_payload, captured_at)
SELECT r.run_id, 'aic', 'api_response', 'GET', $2,
       $3::jsonb, 200, $4::jsonb, now()
FROM runs r WHERE r.external_run_id = $1
RETURNING source_event_id, run_id;`,
            },
            {
                name: "Prepare AIC Records",
                kind: "code",
                text: "Maps each artwork to the normalised contract: canonical record URL, IIIF image URL, provider rights claim and the evidence key that scopes this discovery to the niche.",
                code: `const sourceObjectId = String(row.id);
const sourceUrl = \`https://www.artic.edu/artworks/\${sourceObjectId}\`;
const iiifUrl = row.image_id
  ? \`https://www.artic.edu/iiif/2/\${row.image_id}\` : '';
…
evidence_key: \`\${input.niche_id}|AIC|\${sourceObjectId}\`,
rights_status: row.is_public_domain === true
  ? 'Public Domain' : 'Review Required',`,
            },
            {
                name: "Upsert AIC Asset Discovery and Rights",
                kind: "postgres",
                text: "One statement with three chained CTEs: upsert the asset on its provider ID, upsert the discovery on its evidence key, upsert the rights claim per asset and source. Each is idempotent.",
                code: `WITH asset_upsert AS (
  INSERT INTO assets (…) VALUES (…)
  ON CONFLICT (discovery_source_id, discovery_provider_asset_id)
  DO UPDATE SET … RETURNING asset_id
), discovery_upsert AS (
  INSERT INTO asset_discoveries (…) SELECT … FROM asset_upsert
  ON CONFLICT (evidence_key) DO UPDATE SET …
), rights_upsert AS (
  INSERT INTO asset_rights (…) SELECT … FROM asset_upsert
  ON CONFLICT (asset_id, claim_source_id) DO UPDATE SET
    verification_status = CASE
      WHEN asset_rights.verification_status = 'independently_verified'
        THEN asset_rights.verification_status
      ELSE EXCLUDED.verification_status END, …
)
SELECT … FROM discovery_upsert d JOIN rights_upsert r USING (asset_id);`,
            },
            {
                name: "Finalize AIC Research Run",
                kind: "postgres",
                text: "Marks the run succeeded, records how many asset rows were written and sets the completion time. The table's CHECK constraint forbids a running run with a completion time.",
                code: `UPDATE runs SET
  status = 'succeeded',
  output_summary = jsonb_build_object('provider', 'aic',
                                      'asset_rows', $2::integer),
  completed_at = now()
WHERE external_run_id = $1
RETURNING run_id, status;`,
            },
            {
                name: "Return Normalized AIC Contract",
                kind: "code",
                text: "Returns the same record shape the original Sheets-only adapter produced, plus the database IDs, so callers did not need to change.",
                code: `return records.map((record, index) => ({
  json: {
    ...record.json,
    db_asset_id: databaseRows[index]?.json?.asset_id,
    db_asset_discovery_id: databaseRows[index]?.json?.asset_discovery_id,
    db_asset_rights_id: databaseRows[index]?.json?.asset_rights_id,
  },
}));`,
            },
        ],
    },
    {
        id: "test",
        name: "TEST - AIC PostgreSQL Vertical Slice",
        role: "Manual end-to-end validation run",
        nodes: [
            {
                name: "Create Niche Record",
                kind: "set",
                text: "Defines the test niche: N001 \"Antique Astronomy\", archive query \"astronomy\", ten relevance terms and a timestamped run ID.",
                code: `niche_id        = "N001"
niche           = "Antique Astronomy"
archive_query   = "astronomy"
relevance_terms = "astronomy|celestial|constellation|zodiac|planet|
                   moon|sun|star|comet|telescope"
research_run_id = 'RUN-' + $now.toFormat('yyyyMMdd-HHmmss')`,
            },
            {
                name: "Run AIC PostgreSQL Adapter",
                kind: "subflow",
                text: "Executes the adapter workflow above and receives the normalised records with their database IDs.",
                code: `workflowId: "Archive Adapter - AIC - PostgreSQL v0.1"`,
            },
            {
                name: "Apply Automated Relevance",
                kind: "code",
                text: "A deterministic first pass: Pass if any whole word of the title is a relevance term, otherwise Review. Nothing is rejected automatically.",
                code: `automated_relevance: relevantTerms.some((term) =>
  String(item.json.title || '').toLowerCase()
    .split(/[^a-z0-9]+/).includes(term)
) ? 'Pass' : 'Review',`,
            },
            {
                name: "Persist Automated Relevance",
                kind: "postgres",
                text: "Writes the Pass/Review result onto the discovery row, keyed by its evidence key.",
                code: `UPDATE asset_discoveries
SET automated_relevance = $2, updated_at = now()
WHERE evidence_key = $1
RETURNING asset_discovery_id, evidence_key, automated_relevance;`,
            },
            {
                name: "Sync AIC Evidence to Google Sheets",
                kind: "sheets",
                text: "Mirrors the rows into the existing review sheet, updating rows that match on evidence_key rather than appending duplicates.",
                code: `operation: appendOrUpdate
matchingColumns: ["evidence_key"]
columns: niche_id, niche, source, source_object_id, title,
         artist_display, date_display, …, evidence_key, …`,
            },
        ],
    },
    {
        id: "sync",
        name: "Sync AIC Human Reviews - Sheets to PostgreSQL",
        role: "Brings reviewer decisions back into the database",
        nodes: [
            {
                name: "Read Artwork Review Surface",
                kind: "sheets",
                text: "Reads the same review sheet the evidence was mirrored into.",
                code: `operation: read
(same document and sheet as "Store Artwork Evidence")`,
            },
            {
                name: "Prepare AIC Human Review Events",
                kind: "code",
                text: "Turns each filled-in relevance_review and rights_review cell into a separate review event for that evidence key.",
                code: `if (row.source !== 'Art Institute of Chicago' || !row.evidence_key) continue;
const relevanceDecision = String(row.relevance_review || '').trim();
if (relevanceDecision) reviews.push({ json: {
  evidence_key: row.evidence_key, review_type: 'relevance',
  decision: relevanceDecision, notes: null } });
// …same for rights_review`,
            },
            {
                name: "Persist AIC Human Review History",
                kind: "postgres",
                text: "Inserts a new review only if there is none yet or the decision or notes differ from the latest one, and links it to the review it supersedes. Re-running the sync inserts nothing.",
                code: `WITH target AS (…evidence_key = $1),
latest AS (SELECT … FROM human_reviews … WHERE review_type = $2
           ORDER BY reviewed_at DESC, created_at DESC LIMIT 1),
inserted AS (
  INSERT INTO human_reviews (asset_discovery_id, review_type, decision,
    notes, reviewed_by, reviewed_at, supersedes_review_id)
  SELECT t.asset_discovery_id, $2, $3, $4,
         'google_sheets_sync', now(), l.human_review_id
  FROM target t LEFT JOIN latest l ON true
  WHERE l.human_review_id IS NULL
     OR l.decision IS DISTINCT FROM $3
     OR l.notes IS DISTINCT FROM $4
  RETURNING …, true AS inserted)
SELECT * FROM inserted UNION ALL SELECT …, false AS inserted …;`,
            },
        ],
    },
];

/* ---------- Schema (from db/migrations/001_core.sql) ---------- */
const tables = [
    {
        id: "sources",
        name: "sources",
        why: "A registry of every provider the system may read, with its type, automation level, trust level, terms URL and capabilities. It is seeded with AIC, the Met, Google Trends and Openverse.",
        refs: [],
        cols: [
            ["source_id", "text", "PK"],
            ["source_name", "text", ""],
            ["source_type", "text", "asset_provider · demand_signal · marketplace · discussion"],
            ["enabled", "boolean", ""],
            ["automation_level", "text", "automated · assisted · manual"],
            ["trust_level", "text", "discovery_only · provider_claim · authoritative"],
            ["terms_url", "text", ""],
            ["capabilities", "jsonb", ""],
            ["last_terms_reviewed_at", "timestamptz", ""],
        ],
    },
    {
        id: "runs",
        name: "runs",
        why: "One row per research run: module, input, status, warnings, errors and timings. The external run ID is unique, so replaying a run updates it instead of duplicating it.",
        refs: [],
        cols: [
            ["run_id", "uuid", "PK"],
            ["external_run_id", "text", "UNIQUE"],
            ["module", "text", ""],
            ["status", "text", "running · succeeded · partial · failed · cancelled"],
            ["input · output_summary", "jsonb", ""],
            ["warnings · errors", "jsonb", ""],
            ["started_at · completed_at", "timestamptz", "CHECK running ⇒ no completed_at"],
        ],
    },
    {
        id: "source_events",
        name: "source_events",
        why: "The raw provider response, stored once per request rather than copied into every asset. A generated column hashes the payload, so identical responses are easy to spot.",
        refs: ["runs", "sources"],
        cols: [
            ["source_event_id", "uuid", "PK"],
            ["run_id", "uuid", "FK → runs"],
            ["source_id", "text", "FK → sources"],
            ["request_method · request_url", "text", ""],
            ["request_params · response_headers", "jsonb", ""],
            ["response_status", "integer", ""],
            ["raw_payload", "jsonb", ""],
            ["payload_sha256", "text", "GENERATED sha256(raw_payload)"],
        ],
    },
    {
        id: "assets",
        name: "assets",
        why: "One row per provider artwork. Discovery source and canonical source are separate, so an asset found through an aggregator such as Openverse can point to its authoritative museum record.",
        refs: ["sources", "source_events"],
        cols: [
            ["asset_id", "uuid", "PK"],
            ["discovery_source_id", "text", "FK → sources"],
            ["discovery_provider_asset_id", "text", "UNIQUE with discovery_source_id"],
            ["discovery_source_event_id", "uuid", "FK → source_events"],
            ["canonical_source_id", "text", "FK → sources"],
            ["canonical_provider_asset_id", "text", ""],
            ["title · creator · creation_date · country", "text", ""],
            ["original_record_url · image_url · iiif_url", "text", ""],
            ["width · height", "integer", "CHECK > 0"],
        ],
    },
    {
        id: "asset_discoveries",
        name: "asset_discoveries",
        why: "The join between a run, its evidence and an asset for a specific niche. The evidence key lives here because it identifies a niche/source discovery, not a cross-provider entity.",
        refs: ["assets", "runs", "source_events"],
        cols: [
            ["asset_discovery_id", "uuid", "PK"],
            ["asset_id", "uuid", "FK → assets"],
            ["run_id", "uuid", "FK → runs"],
            ["source_event_id", "uuid", "FK → source_events"],
            ["evidence_key", "text", "UNIQUE"],
            ["niche_id · niche · archive_query", "text", ""],
            ["automated_relevance", "text", "Pass · Review · Reject"],
        ],
    },
    {
        id: "asset_rights",
        name: "asset_rights",
        why: "The provider's licence and public-domain claim per asset and source. A claim is enough during discovery; verification_status records when stronger checking is needed for a shortlisted asset.",
        refs: ["assets", "sources", "source_events"],
        cols: [
            ["asset_rights_id", "uuid", "PK"],
            ["asset_id", "uuid", "FK → assets · UNIQUE with claim_source_id"],
            ["claim_source_id", "text", "FK → sources"],
            ["claim_source_event_id", "uuid", "FK → source_events"],
            ["license_claim · license_uri", "text", ""],
            ["public_domain_claim · commercial_use_claim", "boolean", ""],
            ["verification_status", "text", "provider_claim_only · verification_required · independently_verified · rejected"],
            ["verification_source_id", "text", "FK → sources"],
        ],
    },
    {
        id: "human_reviews",
        name: "human_reviews",
        why: "Append-only reviewer decisions on relevance, rights or shortlisting. Each new decision can point at the one it supersedes, so the full history stays auditable.",
        refs: ["asset_discoveries", "human_reviews"],
        cols: [
            ["human_review_id", "uuid", "PK"],
            ["asset_discovery_id", "uuid", "FK → asset_discoveries"],
            ["review_type", "text", "relevance · rights · shortlist"],
            ["decision · notes", "text", ""],
            ["reviewed_by", "text", ""],
            ["reviewed_at", "timestamptz", "INDEX with discovery + type"],
            ["supersedes_review_id", "uuid", "FK → human_reviews"],
        ],
    },
];

const seeded = [
    { id: "aic", name: "Art Institute of Chicago", type: "asset_provider", enabled: true, trust: "authoritative", note: "Initial PostgreSQL vertical slice" },
    { id: "met", name: "The Metropolitan Museum of Art", type: "asset_provider", enabled: true, trust: "authoritative", note: "Existing adapter; migration deferred to the next milestone" },
    { id: "openverse", name: "Openverse", type: "asset_provider", enabled: false, trust: "discovery_only", note: "Verify shortlisted assets at the original institution" },
    { id: "google_trends", name: "Google Trends", type: "demand_signal", enabled: false, trust: "provider_claim", note: "Planned after the Met migration" },
];

const decisions = [
    { k: "Source of truth", t: "PostgreSQL is authoritative", d: "Runs, raw evidence, assets, rights and reviews live in relational tables with foreign keys and CHECK constraints. Google Sheets is a synchronised review and reporting surface, not the database." },
    { k: "Evidence", t: "Raw payload once per request", d: "The provider response is stored once in source_events with a generated SHA-256, instead of being copied into every asset row." },
    { k: "Identity", t: "Evidence key ≠ entity resolution", d: "niche_id|AIC|object_id scopes a discovery to one niche and source. It deliberately does not claim two providers' records are the same artwork." },
    { k: "Rights", t: "Claims first, verification later", d: "Provider public-domain claims are enough during discovery. A re-run can never downgrade a rights row that was independently verified." },
    { k: "Reviews", t: "Append-only history", d: "Reviewer decisions are inserted, never overwritten, with a link to the decision they supersede. Re-syncing the same sheet changes nothing." },
    { k: "Idempotency", t: "Every write is an upsert on a natural key", d: "external_run_id, (source, provider asset ID), evidence_key and (asset, claim source) are unique, so repeated executions converge instead of duplicating." },
    { k: "Infrastructure", t: "Minimal, private Postgres", d: "Docker Compose runs postgres:17-alpine with a health check, a named volume, migrations mounted read-only and an internal-only network. Secrets come from an untracked .env." },
    { k: "Safety", t: "No credentials in exports", d: "Workflow backups are n8n exports, which do not include credentials. Every workflow was exported inactive." },
];
---

<html lang="en">
    <head>
        <SeoHead {title} {description} type="article" />
    </head>

    <body>
        <main>
            <SiteHeader />

            <header class="hero">
                <div class="breadcrumbs">
                    <a href="/#projects">Projects</a>
                    <span aria-hidden="true">→</span>
                    <strong>Marketplace Opportunity Intelligence</strong>
                </div>

                <p class="eyebrow">n8n · PostgreSQL · Google Sheets · Data pipelines</p>

                <h1>
                    Marketplace Product{" "}
                    <span class="accent">Opportunity Intelligence.</span>
                </h1>

                <p class="hero-lead">
                    A research pipeline for marketplace product ideas: it
                    searches public museum archives for public-domain artwork
                    that fits a product niche, keeps the provider's raw evidence
                    and rights claims, and routes every candidate through human
                    review, with PostgreSQL as the source of truth.
                </p>

                <div class="hero-graph" aria-hidden="true">
                    <svg viewBox="0 0 760 190" preserveAspectRatio="xMidYMid meet">
                        <defs>
                            <linearGradient id="rg-edge" x1="0" x2="1">
                                <stop offset="0" stop-color="#168dff" />
                                <stop offset="1" stop-color="#26d5a2" />
                            </linearGradient>
                        </defs>
                        <path class="edge" d="M110 95 C 170 95, 170 95, 230 95" />
                        <path class="edge" d="M330 95 C 390 95, 390 45, 450 45" />
                        <path class="edge" d="M330 95 C 390 95, 390 145, 450 145" />
                        <path class="edge" d="M550 45 C 610 45, 610 95, 650 95" />
                        <path class="edge" d="M550 145 C 610 145, 610 95, 650 95" />
                        <path class="edge back" d="M700 120 C 700 175, 400 185, 280 120" />
                        <circle class="pulse p1" r="5"><animateMotion dur="3.2s" repeatCount="indefinite" path="M110 95 C 170 95, 170 95, 230 95" /></circle>
                        <circle class="pulse p2" r="5"><animateMotion dur="3.2s" begin="0.8s" repeatCount="indefinite" path="M330 95 C 390 95, 390 45, 450 45" /></circle>
                        <circle class="pulse p3" r="5"><animateMotion dur="3.2s" begin="1.2s" repeatCount="indefinite" path="M330 95 C 390 95, 390 145, 450 145" /></circle>
                        <circle class="pulse p4" r="5"><animateMotion dur="3.2s" begin="1.8s" repeatCount="indefinite" path="M550 145 C 610 145, 610 95, 650 95" /></circle>
                        <circle class="pulse back" r="4"><animateMotion dur="4.5s" begin="2.2s" repeatCount="indefinite" path="M700 120 C 700 175, 400 185, 280 120" /></circle>
                        <g class="gnode"><rect x="10" y="70" width="100" height="50" rx="12" /><text x="60" y="92">Niche</text><text x="60" y="108" class="s">N001</text></g>
                        <g class="gnode n8n"><rect x="230" y="70" width="100" height="50" rx="12" /><text x="280" y="92">n8n</text><text x="280" y="108" class="s">adapter</text></g>
                        <g class="gnode api"><rect x="450" y="20" width="100" height="50" rx="12" /><text x="500" y="42">AIC API</text><text x="500" y="58" class="s">public domain</text></g>
                        <g class="gnode pg"><rect x="450" y="120" width="100" height="50" rx="12" /><text x="500" y="142">PostgreSQL</text><text x="500" y="158" class="s">authoritative</text></g>
                        <g class="gnode sheet"><rect x="650" y="70" width="100" height="50" rx="12" /><text x="700" y="92">Sheets</text><text x="700" y="108" class="s">human review</text></g>
                    </svg>
                </div>

                <SkillLinks
                    variant="hero"
                    skills={[
                        "workflow-automation",
                        "n8n",
                        "postgresql",
                        "sql",
                        "system-architecture",
                        "rest-api-integration",
                        "google-sheets-api",
                        "human-oversight",
                    ]}
                />

                <div class="hero-actions">
                    <a class="button button-primary" href="#schema">Explore the data model ↓</a>
                    <a class="button button-secondary" href="#workflow">Watch the pipeline run ↓</a>
                </div>
            </header>

            <section class="metrics" aria-label="Validated results" data-count-group>
                {metrics.map((m) => (
                    <article class="metric-card">
                        <strong data-count={m.value}>{m.value}</strong>
                        <span>{m.label}</span>
                    </article>
                ))}
            </section>

            <!-- 01 — PROBLEM -->
            <section class="case-section" aria-labelledby="r-why">
                <div class="section-heading">
                    <p class="eyebrow">01 — The problem</p>
                    <h2 id="r-why">A spreadsheet was doing a database's job.</h2>
                    <p>
                        The first version was four n8n workflows (exported from
                        n8n 2.40.7) that searched the Art Institute of Chicago
                        and the Met and wrote straight into Google Sheets. It
                        worked as an MVP, but there was no run history, no record
                        of what a provider actually returned, and no way to
                        audit a reviewer changing their mind.
                    </p>
                </div>

                <div class="ba" data-ba>
                    <div class="ba-toggle" role="group" aria-label="Compare architectures">
                        <button type="button" class="seg" aria-pressed="true" data-ba-btn="before">Before: Sheets-only MVP</button>
                        <button type="button" class="seg" aria-pressed="false" data-ba-btn="after">After: PostgreSQL slice</button>
                    </div>
                    <div class="ba-panels" aria-live="polite">
                        <div class="ba-panel" data-ba-panel="before">
                            <ul class="ba-list">
                                <li><b>MVP 01</b> 18-node workflow: niche → AIC and Met searches → three Sheets writes</li>
                                <li><b>Orchestrator v2</b> 12 nodes calling separate AIC and Met adapters</li>
                                <li class="bad">Raw API responses discarded after mapping</li>
                                <li class="bad">Relevance and rights decisions overwritten in place</li>
                                <li class="bad">No run status, warnings or errors to query</li>
                            </ul>
                        </div>
                        <div class="ba-panel" data-ba-panel="after" hidden>
                            <ul class="ba-list">
                                <li><b>runs</b> every execution registered, finalised and queryable</li>
                                <li><b>source_events</b> raw payload stored once per request, hashed</li>
                                <li><b>assets · discoveries · rights</b> idempotent upserts on natural keys</li>
                                <li class="good">Sheets kept as the review surface people already use</li>
                                <li class="good">Reviews flow back as append-only history</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 02 — WORKFLOW -->
            <section id="workflow" class="case-section" aria-labelledby="r-flow">
                <div class="section-heading">
                    <p class="eyebrow">02 — The vertical slice</p>
                    <h2 id="r-flow">Three n8n workflows, one round trip.</h2>
                    <p>
                        Press play to run the slice node by node, or select any
                        node to read the real query or code behind it (connection
                        details removed).
                    </p>
                </div>

                <div class="flow" data-flow>
                    <div class="flow-bar">
                        <button type="button" class="ctl ctl-primary" data-flow-play>▶ Run the slice</button>
                        <span class="flow-status" data-out="flowStatus" aria-live="polite">Idle</span>
                    </div>
                    {lanes.map((lane, li) => (
                        <div class="lane" data-lane={lane.id}>
                            <div class="lane-head">
                                <strong>{lane.name}</strong>
                                <span>{lane.role}</span>
                            </div>
                            <ol class="nodes">
                                {lane.nodes.map((n, ni) => (
                                    <li>
                                        <button
                                            type="button"
                                            class={`node k-${n.kind}`}
                                            data-node={`${li}-${ni}`}
                                            aria-pressed={li === 0 && ni === 0 ? "true" : "false"}
                                        >
                                            <span class="node-kind">{n.kind}</span>
                                            <span class="node-name">{n.name}</span>
                                        </button>
                                    </li>
                                ))}
                            </ol>
                        </div>
                    ))}
                    <div class="node-detail" aria-live="polite">
                        {lanes.map((lane, li) =>
                            lane.nodes.map((n, ni) => (
                                <div class="detail" data-detail={`${li}-${ni}`} hidden={!(li === 0 && ni === 0)}>
                                    <div>
                                        <span class="kicker">{lane.name}</span>
                                        <h3>{n.name}</h3>
                                        <p>{n.text}</p>
                                    </div>
                                    <pre class="code">{n.code}</pre>
                                </div>
                            )),
                        )}
                    </div>
                </div>
            </section>

            <!-- 03 — SCHEMA -->
            <section id="schema" class="case-section" aria-labelledby="r-schema">
                <div class="section-heading">
                    <p class="eyebrow">03 — Data model</p>
                    <h2 id="r-schema">Seven tables, each with one job.</h2>
                    <p>
                        Select a table to see its columns and constraints from
                        001_core.sql, the tables it references, and why it
                        exists.
                    </p>
                </div>

                <div class="schema" data-schema>
                    <div class="schema-map">
                        <svg class="schema-lines" aria-hidden="true"></svg>
                        {tables.map((t, i) => (
                            <button
                                type="button"
                                class={`tbl tbl-${t.id}`}
                                data-table={t.id}
                                data-refs={t.refs.join(" ")}
                                aria-pressed={i === 4 ? "true" : "false"}
                            >
                                <span class="tbl-name">{t.name}</span>
                                <span class="tbl-meta">{t.cols.length} column groups</span>
                            </button>
                        ))}
                    </div>
                    <div class="schema-detail" aria-live="polite">
                        {tables.map((t, i) => (
                            <div class="tdetail" data-tdetail={t.id} hidden={i !== 4}>
                                <h3><code>{t.name}</code></h3>
                                <p>{t.why}</p>
                                {t.refs.length > 0 && (
                                    <p class="refs">References: {t.refs.map((r) => <code>{r}</code>)}</p>
                                )}
                                <ul class="cols">
                                    {t.cols.map(([c, type, note], j) => (
                                        <li style={`--j:${j}`}>
                                            <code class="c">{c}</code>
                                            <span class="type">{type}</span>
                                            {note && <span class={`note ${note.startsWith("PK") ? "pk" : note.startsWith("FK") ? "fk" : note.startsWith("UNIQUE") ? "uq" : ""}`}>{note}</span>}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </div>
                <p class="footnote">
                    Every foreign key uses <code>ON DELETE RESTRICT</code>, so
                    evidence cannot be deleted out from under the records that
                    cite it.
                </p>
            </section>

            <!-- 04 — IDEMPOTENCY LAB -->
            <section class="case-section" aria-labelledby="r-idem">
